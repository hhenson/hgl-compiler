  %4 each Node(3)
    %0 demo.graph_for::counted [Key, Element] : [Text, Integer] -> None
      start Set(Literal(Int(0)))
      start Let(0, Choose(Has(Literal(Text("started"))), Get(Literal(Text("started"))), Literal(Int(0))))
      start Put(Literal(Text("started")), Add(Local(0), Literal(Int(1))))
      eval Admit([0, 1], [1], [Set(Add(State, Literal(Int(1)))), If(Equal(Input(0, Text), Literal(Text("a"))), [Put(Literal(Text("a")), State)])])
      stop Let(1, Choose(Has(Literal(Text("stopped"))), Get(Literal(Text("stopped"))), Literal(Int(0))))
