assertion 1 @3265..3590
  %0 replay Text [(0, Text("a")), (2, Text("b")), (4, Text("a")), (6, Text("a")), (8, Text("a"))]
  %1 replay Integer [(0, Int(1)), (2, Int(7)), (4, Int(2)), (6, Int(-1)), (8, Int(5))]
  %2 replay Flag [(1, Bool(true)), (3, Bool(true)), (5, Bool(true)), (7, Bool(true)), (9, Bool(true))]
  %3 demo.graph_for::priced [Node(0), Node(1)] : [Text, Integer] -> Some(Dictionary)
    eval Admit([0, 1], [0, 1], [If(Less(Input(1, Integer), Literal(Int(0))), [Remove(Input(0, Text))]), Update(Input(0, Text), Input(1, Integer))])
  %4 each Node(3)
    %0 demo.graph_for::counted [Key, Element] : [Text, Integer] -> None
      start Set(Literal(Int(0)))
      start Let(0, Choose(Has(Literal(Text("started"))), Get(Literal(Text("started"))), Literal(Int(0))))
      start Put(Literal(Text("started")), Add(Local(0), Literal(Int(1))))
      eval Admit([0, 1], [1], [Set(Add(State, Literal(Int(1)))), If(Equal(Input(0, Text), Literal(Text("a"))), [Put(Literal(Text("a")), State)])])
      stop Let(1, Choose(Has(Literal(Text("stopped"))), Get(Literal(Text("stopped"))), Literal(Int(0))))
      stop Put(Literal(Text("stopped")), Add(Local(1), Literal(Int(1))))
  %5 demo.graph_for::stored [Node(2)] : [Flag] -> Some(Integer)
    eval Admit([0], [0], [If(Has(Literal(Text("a"))), [Publish(Get(Literal(Text("a"))))]), Publish(Literal(Int(0)))])
  record Node(5)
  expect [(1, 1), (3, 1), (5, 2), (7, 2), (9, 1)]
