module demo.endpoint_read_forms

fn keyed_read(book: dict<str, i64>, key: str) -> tuple<bool, i64?> {
    when {
        var selector = key
        let entry = book[selector]
        selector = "other"
        let observed: i64? = entry
        return (valid(entry), observed)
    }
}

test a_child_binding_captures_the_dictionary_key {
    assert eval keyed_read(
        book: [["bid": 3, "other": 8], _, _],
        key: ["bid", "absent", "other"],
    ) == [(true, 3), (false, null), (true, 8)]
}

fn unused_child(parts: list<i64, 2>, position: i64) -> i64 {
    when {
        let unused = parts[position]
        return 1
    }
}

test a_child_binding_does_not_read_or_check_its_position {
    assert eval unused_child(parts: [[3, 4]], position: [2]) == [1]
}

fn partial_pairs(step: i64) -> list<tuple<i64, i64>, 2> {
    when {
        let change: delta<tuple<i64, i64>> = if step == 0 { (3, null) } else { (null, 4) }
        return delta<list<tuple<i64, i64>, 2>>(updated: [0: change])
    }
}

fn pair_forms(pairs: list<tuple<i64, i64>, 2>, position: i64) -> tuple<bool, bool> {
    when {
        let child = pairs[position]
        let optional: tuple<i64, i64>? = child
        let outcome: result<tuple<i64, i64>, error> = child
        return (optional != null, is_ok(outcome))
    }
}

fn observe_pair_forms(step: i64, position: i64) -> tuple<bool, bool> =>
    pair_forms(partial_pairs(step), position)

test a_runtime_tuple_child_takes_result_and_nullable_forms {
    assert eval observe_pair_forms(step: [0, 1], position: [0, _]) == [(false, false), (true, true)]
}

fn read_pair(pairs: list<tuple<i64, i64>, 2>, position: i64) -> tuple<i64, i64> {
    when {
        let child = pairs[position]
        return child # consuming read
    }
}

fn plain_pair(step: i64, position: i64) -> tuple<i64, i64> =>
    read_pair(partial_pairs(step), position)

test a_plain_child_failure_points_to_the_read {
    assert eval plain_pair(step: [0], position: [0]) == [(3, 4)]
}

fn gaps(step: i64) -> list<i64> {
    when {
        if step == 0 { return [1] }
        return delta<list<i64>>(updated: [2: 4])
    }
}

fn whole_result(values: list<i64>) -> bool {
    when {
        let outcome: result<list<i64>, error> = values
        return is_ok(outcome)
    }
}

fn observe_list_result(step: i64) -> bool => whole_result(gaps(step))

test a_growing_list_with_a_gap_has_a_result_form {
    assert eval observe_list_result(step: [0, 1]) == [true, false]
}

# ERR-14 and ERR-15: a comparison with null takes the nullable form
# of a runtime-checked child, directly or through its bound endpoint.
fn publish_scalar_child(index: i64, value: i64) -> list<i64, 2> {
    when { return delta<list<i64, 2>>(updated: [index: value]) }
}

fn child_null_forms(parts: list<i64, 2>, index: i64) -> tuple<bool, bool, bool, i64> {
    when {
        let entry = parts[index]
        let direct = parts[index] == null
        let right = entry == null
        let left = null != entry
        if entry != null { return (direct, right, left, entry) }
        return (direct, right, left, -1)
    }
}

fn observe_child_null_forms(index: i64, reading: i64, probe: i64) -> tuple<bool, bool, bool, i64> =>
    child_null_forms(publish_scalar_child(index, reading), probe)

test child_null_checks_read_the_nullable_form {
    assert eval observe_child_null_forms(index: [0, _], reading: [3, _], probe: [0, 1]) ==
        [(false, false, true, 3), (true, true, false, -1)]
}

# ERR-15 and GEN-7: a child whose instance type is nullable compares
# its published payload with null. An unset endpoint still raises.
fn generic_child_is_null<T>(parts: list<T, 2>, index: i64) -> bool {
    when { return parts[index] == null }
}

fn compare_nullable_child(parts: list<i64?, 2>, index: i64) -> bool =>
    generic_child_is_null(parts, index)

fn publish_nullable_child(index: i64) -> list<i64?, 2> {
    when { return delta<list<i64?, 2>>(updated: [index: delta<i64?>()]) }
}

fn compare_partial_nullable_child(index: i64, probe: i64) -> bool =>
    generic_child_is_null(publish_nullable_child(index), probe)

test generic_nullable_child_compares_the_payload {
    assert eval compare_nullable_child(parts: [[null, 3], _], index: [0, 1]) == [true, false]
}

test generic_nullable_child_still_raises_if_unset {
    assert eval compare_partial_nullable_child(index: [0], probe: [1]) == [true]
}

# ERR-15: a candidate that keeps the whole result wins over one that
# takes the child's plain value, including in a generic hook (GEN-7).
operator child_score<T>(value: T) -> i64
impl const fn child_score<T>(value: T) -> i64 => 0
impl const fn child_score(value: i64) -> i64 => value
impl const fn child_score(value: result<i64, error>) -> i64 {
    if is_ok(value) { return 100 + value.value }
    return -100
}

fn concrete_child_score(parts: list<i64, 2>, index: i64) -> tuple<i64, i64> {
    when {
        let entry = parts[index]
        return (child_score(entry), child_score(parts[index]))
    }
}

fn generic_child_score<T>(parts: list<T, 2>, index: i64) -> i64 {
    when {
        let entry = parts[index]
        return child_score(entry)
    }
}

fn observe_concrete_child_scores(index: i64, reading: i64, probe: i64) -> tuple<i64, i64> =>
    concrete_child_score(publish_scalar_child(index, reading), probe)

fn observe_generic_child_score(index: i64, reading: i64, probe: i64) -> i64 =>
    generic_child_score(publish_scalar_child(index, reading), probe)

test child_operator_calls_keep_the_result {
    assert eval observe_concrete_child_scores(index: [0, _], reading: [3, _], probe: [0, 1]) ==
        [(103, 103), (-100, -100)]
    assert eval observe_generic_child_score(index: [0, _], reading: [3, _], probe: [0, 1]) ==
        [103, -100]
}

# ERR-15 and GEN-5: a checked child competes as its payload where the
# operator's candidates ask for an ordinary value.
operator plain_child_score<T>(value: T) -> i64
impl const fn plain_child_score<T>(value: T) -> i64 => 0
impl const fn plain_child_score(value: i64) -> i64 => 1
impl const fn plain_child_score(value: str) -> i64 => 2

fn score_plain_children<T>(parts: list<T, 2>, index: i64) -> i64 {
    when all_valid(parts) {
        let entry = parts[index]
        return plain_child_score(entry) * 10 + plain_child_score(parts[index])
    }
}

fn observe_plain_child_scores(index: i64, reading: i64, probe: i64) -> i64 =>
    score_plain_children(publish_scalar_child(index, reading), probe)

test child_operator_calls_select_the_plain_value_candidate {
    assert eval observe_plain_child_scores(index: [0, 1], reading: [3, 4], probe: [0, 1]) == [_, 11]
}

# ERR-14 and ERR-15: comparing ordinary children consumes each value.
fn equal_children(parts: list<i64, 2>, left: i64, right: i64) -> bool {
    when {
        let first = parts[left]
        let second = parts[right]
        return first == second
    }
}

fn observe_child_equality(index: i64, reading: i64, left: i64, right: i64) -> bool =>
    equal_children(publish_scalar_child(index, reading), left, right)

test child_equality_raises_for_an_unset_operand {
    assert eval observe_child_equality(
        index: [0, 1], reading: [3, 3], left: [0, 0], right: [0, 1],
    ) == [true, true]
    assert raises("value.unset_read") {
        eval observe_child_equality(index: [0], reading: [3], left: [0], right: [1])
    }
}

# ERR-15: taking the value of one ordinary result costs fewer reads
# than consuming two checked children.
operator count_reads<L, R, V>(left: L, right: R, value: V) -> i64
impl const fn count_reads(left: i64, right: i64, value: result<i64, error>) -> i64 => -1
impl const fn count_reads(left: result<i64, error>, right: result<i64, error>, value: i64) -> i64 => value

fn mixed_reads(parts: list<i64, 2>, index: i64) -> i64 {
    when {
        let left = parts[index]
        let value: result<i64, error> = ok(11)
        return count_reads(left, parts[index], value)
    }
}

test fewer_result_reads_includes_checked_children {
    assert eval mixed_reads(parts: [[1, 2]], index: [0]) == [11]
}

fn plain_scalar_child(parts: list<i64, 2>, index: i64) -> i64 {
    when {
        let entry = parts[index]
        return entry # consuming scalar child read
    }
}

fn observe_plain_scalar_child(index: i64, reading: i64, probe: i64) -> i64 =>
    plain_scalar_child(publish_scalar_child(index, reading), probe)

test unset_child_diagnostic_names_the_child {
    assert eval observe_plain_scalar_child(index: [0], reading: [3], probe: [1]) == [3]
}
