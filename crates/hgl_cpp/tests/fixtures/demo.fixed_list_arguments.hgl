module demo.fixed_list_arguments

# TYPE-10: the unsized parameter takes the fixed list's entries.
const fn first_of(items: list<i64>) -> i64 => items[0]
const fn first_any<T>(items: list<T>) -> T => items[0]
const fn passed_on(items: list<i64, 2>) -> i64 => first_of(items)
const fn nested(items: list<list<i64, 2>>) -> i64 => items[2][1]

test ordinary_parameter {
    let items: list<i64, 2> = [3, 4]
    assert first_of(items) == 3
}

test generic_parameter {
    let items: list<i64, 2> = [3, 4]
    assert first_any(items) == 3
}

test fixed_parameter_passed_on {
    assert passed_on([3, 4]) == 3
}

test nested_fixed_elements {
    let items: list<list<i64, 2>, 3> = [[1, 2], [3, 4], [5, 6]]
    assert nested(items) == 6
}

# LIST-2: extend takes its items through a generic native value parameter.
test generic_native_parameter {
    var values: list<i64> = [1]
    let items: list<i64, 2> = [3, 4]
    extend(values, items)
    assert values == [1, 3, 4]
}
