module demo.option_declarations

struct Weight { amount: i64 }

operator weighted{offset: i64}(left: Weight, right: Weight, gain: i64) -> i64
impl const fn weighted{offset: i64}(left: Weight, right: Weight, gain: i64) -> i64 =>
    left.amount * right.amount * gain - offset

impl const fn add_{offset: i64}(left: Weight, right: Weight, gain: i64 = 1) -> i64 =>
    weighted{offset: offset}(left, right, gain)

# EXPR-14 and FN-11: the offset binds in composition. The gain is
# the only input and drives the result in either spelling.
fn lifted_symbol(gain: i64) -> i64 =>
    Weight(amount: 2) +{offset: 2, gain: gain} Weight(amount: 3)

fn lifted_named(gain: i64) -> i64 =>
    add_{offset: 2}(Weight(amount: 2), Weight(amount: 3), gain: gain)

test a_parenthesized_option_is_an_input {
    assert eval lifted_symbol(gain: []) == []
    assert eval lifted_named(gain: []) == []
    assert eval lifted_symbol(gain: [_, 2, 4]) == [_, 10, 22]
    assert eval lifted_named(gain: [_, 2, 4]) == [_, 10, 22]
}

# EXPR-14: a value call gives configuration a value of this invocation.
test value_calls_evaluate_configuration_in_both_spellings {
    let offset = 3
    assert Weight(amount: 2) +{offset: offset, gain: 2} Weight(amount: 3) == 9
    assert add_{offset: offset}(Weight(amount: 2), Weight(amount: 3), gain: 2) == 9
}

# EXPR-10 and EXPR-14: the numeric candidates declare `abs` in braces.
# The candidate for Weight instead declares it as an ordinary input.
impl const fn eq_(lhs: Weight, rhs: Weight, abs: i64 = 0) -> bool =>
    lhs.amount - rhs.amount < abs

fn weight_equal_symbol(tolerance: i64) -> bool =>
    Weight(amount: 5) =={abs: tolerance} Weight(amount: 3)

fn weight_equal_named(tolerance: i64) -> bool =>
    eq_(Weight(amount: 5), Weight(amount: 3), abs: tolerance)

test a_candidate_can_take_an_option_that_is_configuration_elsewhere {
    assert eval weight_equal_symbol(tolerance: [_, 1, 3]) == [_, false, true]
    assert eval weight_equal_named(tolerance: [_, 1, 3]) == [_, false, true]
}

# EXPR-14: the zoned candidate declares `utc` in its parentheses.
const london: zoned_datetime = @2026-09-03T09:30+01:00[Europe/London]
const utc: zoned_datetime = @2026-09-03T08:30+00:00[UTC]
fn zoned_symbol(flag: bool) -> bool => london =={utc: flag} utc
fn zoned_named(flag: bool) -> bool => eq_(london, utc, utc: flag)

test a_connected_utc_option_is_an_ordinary_input {
    assert eval zoned_symbol(flag: [_, false, true]) == [_, false, true]
    assert eval zoned_named(flag: [_, false, true]) == [_, false, true]
}

struct Holidays { closed: date }

impl const fn business_day(calendar: Holidays, day: date) -> bool =>
    day != calendar.closed && business_day(Weekdays(), day)

fn cal(closed: date) -> Holidays {
    when { return Holidays(closed: closed) }
}

# TEN-5, EXPR-10, EXPR-14 and FN-6: the calendar is the only input.
fn settles(const trade: date, closed: date) -> date =>
    trade +{calendar: cal(closed)} 2B

fn settles_named(const trade: date, closed: date) -> date =>
    add_(trade, 2B, calendar: cal(closed))

fn trades(const settlement: date, closed: date) -> date =>
    settlement -{calendar: cal(closed)} 2B

fn trades_named(const settlement: date, closed: date) -> date =>
    sub_(settlement, 2B, calendar: cal(closed))

test connected_calendar_for_addition_symbol {
    assert eval settles(trade: @2026-01-02, closed: []) == []
    assert eval settles(trade: @2026-01-02, closed: [@2026-01-07, @2026-01-05]) ==
        [@2026-01-06, @2026-01-07]
}

test connected_calendar_for_addition_named {
    assert eval settles_named(trade: @2026-01-02, closed: []) == []
    assert eval settles_named(trade: @2026-01-02, closed: [@2026-01-07, @2026-01-05]) ==
        [@2026-01-06, @2026-01-07]
}

test connected_calendar_for_subtraction_symbol {
    assert eval trades(settlement: @2026-01-08, closed: []) == []
    assert eval trades(settlement: @2026-01-08, closed: [@2026-01-07, @2026-01-05]) ==
        [@2026-01-05, @2026-01-06]
}

test connected_calendar_for_subtraction_named {
    assert eval trades_named(settlement: @2026-01-08, closed: []) == []
    assert eval trades_named(settlement: @2026-01-08, closed: [@2026-01-07, @2026-01-05]) ==
        [@2026-01-05, @2026-01-06]
}
