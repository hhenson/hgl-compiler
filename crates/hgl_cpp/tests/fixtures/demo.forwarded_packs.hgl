module demo.forwarded_packs

const fn receive(a: i64, b: i64, c: i64) -> i64 => a * 100 + b * 10 + c

const fn relay<...Args, ...Fields>(values: ...Args, fields: ...{Fields}) -> i64 =>
    receive(...values, b: 2, ...fields)

test forwards {
    assert relay(1, c: 3) == 123
    assert relay(3, a: 1) == 123
}

operator pick<T>(value: T) -> i64
impl const fn pick(value: str) -> i64 => 4
impl const fn pick(value: i64) -> i64 => 5
const fn relay_operator<...Args>(operands: ...Args) -> i64 => pick(...operands)

test forward_operator {
    assert relay_operator("str") == 4
    assert relay_operator(2) == 5
}

const fn relay_callback<R, ...Ps, ...As>(
    f: const fn(...{Ps}) -> R, operands: ...{As for f},
) -> R requires each key in arg_keys(As) { As[key] == Ps[key] }
    => f(...operands)

const fn callback_target(price: f64, weight: f64 = 2.0) -> f64 => price * weight

test forward_callback {
    assert relay_callback(callback_target, 3.0) == 6.0
    assert relay_callback(callback_target, 3.0, weight: 4.0) == 12.0
}

operator render<...Args, ...Fields>(format: str, values: ...Args, fields: ...{Fields}) -> i64
impl const fn render<...Args, ...Fields>(format: str, values: ...Args, fields: ...{Fields}) -> i64 => 42

const fn forward_both<...Args, ...Fields>(format: str, values: ...Args, fields: ...{Fields}) -> i64 =>
    render(format, ...values, ...fields)

test forward_empty_and_mixed_operator_packs {
    assert forward_both("empty") == 42
    assert forward_both("mixed", 3, key: 4) == 42
}

const fn multiply(price: f64, factor: f64) -> f64 => price * factor
fn graph_relay<...Args>(args: ...Args) -> f64 => multiply(...args)

test forward_connections {
    assert eval graph_relay([2.0], [3.0]) == [6.0]
}

const fn generic_id<T>(value: T) -> T => value
const fn nested_relay<...Args>(values: ...Args) -> i64 =>
    generic_id(receive(...values))

const fn relay_again<...Args>(values: ...Args) -> i64 =>
    nested_relay(...values)

test forward_nested {
    assert relay_again(1, 2, 3) == 123
}

const fn needs_value(value: i64) -> result<i64, i64> => ok(value)
const fn tag_relay<...Args>(values: ...Args) -> bool =>
    is_ok(needs_value(...values))

test forward_tag_result {
    assert tag_relay(1)
}

operator match_arg<T>(value: T) -> f64
impl const fn match_arg(value: str) -> f64 => 1.0
impl const fn match_arg(value: f64) -> f64 => value

operator with_callback<...Ps, ...As>(
    f: const fn(...{Ps}) -> f64, fixed: str, fields: ...{As for f},
) -> i64 requires each key in arg_keys(As) { As[key] == Ps[key] }

impl const fn with_callback<...Ps, ...As>(
    f: const fn(...{Ps}) -> f64, fixed: str, fields: ...{As for f},
) -> i64 requires each key in arg_keys(As) { As[key] == Ps[key] } => 77

const fn relay_dependent_operator<...Args>(values: ...Args) -> i64 =>
    with_callback(match_arg, ...values)

test forward_dependent_operator {
    assert relay_dependent_operator("fixed", 3.0) == 77
}

const fn local_inference<...Args>(values: ...Args) -> i64 {
    let item = generic_id(...values)
    return item + 1
}

test forward_local_inference {
    assert local_inference(2) == 3
}

fn graph_context<...Args>(values: ...Args) -> i64 {
    let item = generic_id(...values)
    return item + 1
}

test forward_graph_inference {
    assert eval graph_context([2]) == [3]
}

fn node_context<...Args>(values: ...Args) -> i64 {
    when {
        let item = generic_id(...values)
        return item + 1
    }
}

test forward_hook_inference {
    assert eval node_context([2, 3]) == [3, 4]
}

# FN-14, FN-19: an anonymous body may forward its enclosing pack,
# including when only a more deeply nested function reads the entries.
const fn apply_one(f: const fn(i64) -> i64) -> i64 => f(1)
const fn captured<...A>(values: ...A) -> i64 =>
    apply_one(fn(x) => receive(x, ...values))
const fn nested_capture<...A>(values: ...A) -> i64 =>
    apply_one(fn(x) => apply_one(fn(y) => receive(x + y, ...values)))
const fn named_capture<...A>(offset: i64, fields: ...{A}) -> i64 =>
    apply_one(fn(x) => receive(x + offset, ...fields))

test forwarded_anonymous_captures {
    assert captured(2, 3) == 123
    assert captured(4, 5) == 145
    assert nested_capture(2, 3) == 223
    assert named_capture(0, b: 2, c: 3) == 123
    assert named_capture(2, c: 4, b: 6) == 364
}

# FN-17: the written names of a callback template bind the spread.
const fn pair(a: i64, b: i64) -> i64 => a * 10 + b
const fn named_template<...F>(f: const fn(a: i64, b: i64) -> i64, fields: ...{F}) -> i64 =>
    f(...fields)

test forwarded_named_template {
    assert named_template(pair, b: 2, a: 1) == 12
}

# FN-19, TYPE-5: named entries bind struct fields. An explicit field and
# inferred or written generic arguments use ordinary construction rules.
struct Point {
    x: i64
    y: i64
}
struct Box<T> { value: T }

const fn make_point<...F>(fields: ...{F}) -> Point => Point(...fields)
const fn make_with_x<...F>(fields: ...{F}) -> Point => Point(...fields, x: 3)
const fn make_string_box<...F>(fields: ...{F}) -> Box<str> => Box<str>(...fields)
const fn infer_box<...F>(fields: ...{F}) -> str {
    let boxed = Box(...fields)
    return boxed.value
}

test forwarded_named_fields {
    assert make_point(y: 2, x: 1).x == 1
    assert make_with_x(y: 2).y == 2
    assert make_string_box(value: "text").value == "text"
    assert infer_box(value: "inferred") == "inferred"
}

# UNIT-7, FN-19: defaults can supply concrete forwarding calls.
const fn parameter_default(value: i64 = relay(1, c: 3)) -> i64 => value
struct FieldDefault { value: i64 = relay(4, c: 5) }

test default_forwarding_roots {
    assert parameter_default() == 123
    assert FieldDefault().value == 425
}

# FN-8: a homogeneous pack supplies the same declared entry type to
# both the forwarded call and its lowered input slots.
const fn receives_nullable(value: i64?) -> bool => value == null
const fn relay_nullable(values: ...i64?) -> bool => receives_nullable(...values)

test forwarded_homogeneous_shape {
    assert relay_nullable(null)
    assert !relay_nullable(2)
}

# FN-14, FN-19: the held entry of a temporal callback stays a connection.
fn apply_connection(callback: fn(f64) -> f64, input: f64) -> f64 => callback(input)
fn captured_connection<...A>(input: f64, values: ...A) -> f64 =>
    apply_connection(fn(x) => multiply(x, ...values), input)

test forwarded_connection_capture {
    assert eval captured_connection([2.0], [3.0]) == [6.0]
}
