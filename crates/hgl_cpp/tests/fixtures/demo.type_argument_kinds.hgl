module demo.type_argument_kinds

# GEN-14: a known value slot uses the ordinary constant named Type.
const Type: i64 = 2
struct Sized<const count: i64> { value: i64 }
const fn read(value: Sized<Type>) -> i64 => value.value
test value_named_type {
    let present: Sized<Type> = Sized<Type>(value: 12)
    let absent: Sized<Type>? = null
    assert read(present) == 12
    assert absent == null
}

# GEN-14: a known callable type slot still denotes the descriptor.
const fn same<T>(value: T) -> T => value
operator identity<T>(value: T) -> T
impl const fn identity<T>(value: T) -> T => value
const fn count<const N: i64>() -> i64 => N
const fn unsettled<N>() -> i64 => 1
test callable_type_slots {
    assert same<Type>(type(1)) == type(1)
    assert identity<Type>(type(1)) == type(1)
    assert count<Type>() == 2
    assert unsettled<Type>() == 1
}
