module demo.exact_candidates

operator pick<T>(value: T) -> i64
impl const fn pick(value: i64) -> i64 => 1
impl const fn pick(value: i64?) -> i64 => 2

operator choose<T>(value: T) -> i64
impl const fn choose<T>(value: T) -> i64 => 1
impl const fn choose(value: i64?) -> i64 => 2

operator anywhere<T>(value: T) -> i64
impl const fn anywhere<T>(value: T) -> i64 => 1
impl const fn anywhere(value: i64?) -> i64 => 2
impl const fn anywhere(value: any) -> i64 => 3

operator pick_delta<T>(value: T) -> i64
impl const fn pick_delta<T>(value: T) -> i64 => 1
impl const fn pick_delta(value: delta<set<i64>?>) -> i64 => 2

operator pick_float<T>(value: T) -> i64
impl const fn pick_float(value: f64) -> i64 => 1
impl const fn pick_float(value: f64?) -> i64 => 2

abstract struct Shape { id: i64 }
struct Round: Shape { radius: f64 }
operator kind<T>(value: T) -> i64
impl const fn kind(value: Round) -> i64 => 1
impl const fn kind(value: Shape) -> i64 => 2

test exact_types {
    let number: i64 = 7
    let maybe: i64? = 7
    let circle = Round(id: 1, radius: 1.5)
    let changes = delta<set<i64>>(added: [1])
    let maybe_changes = delta<set<i64>?>(value: changes)
    assert pick(number) == 1
    assert pick(maybe) == 2
    assert choose(number) == 1
    assert anywhere(number) == 1
    assert kind(circle) == 1
    assert pick_delta(changes) == 1
    assert pick_delta(maybe_changes) == 2
    assert pick_float(1) == 1
    assert pick_float(1.0) == 1
}

operator pick_instance<T>(value: T) -> i64
impl const fn pick_instance<T>(value: T?) -> i64 => 1
impl const fn pick_instance<T>(value: T) -> i64 requires T == i64 => 2
const fn instance_in_value<T>(value: T) -> i64 => pick_instance(value)
fn instance_in_graph<T>(value: T) -> i64 => pick_instance(value)

test conditioned_exact_candidates_select_in_each_instance {
    assert instance_in_value(5) == 2
    assert instance_in_value("s") == 1
    assert eval instance_in_graph(value: [5]) == [2]
    assert eval instance_in_graph(value: ["s"]) == [1]
}

operator from_input<R, F, K>(f: fn(F) -> i64, x: R, k: K) -> i64
impl fn from_input<R>(f: fn(R) -> i64, x: R, k: i64) -> i64 => f(x)
impl fn from_input<R>(f: fn(R?) -> i64, x: R, k: i64?) -> i64 => f(x) + 100
fn exact_callback_inputs(value: i64, key: i64) -> i64 => from_input(fn(x) => 3, value, key)

operator nullable_input<R, F>(f: fn(F) -> i64, x: R?) -> i64
impl fn nullable_input<R>(f: fn(R) -> i64, x: R?) -> i64 => 3
impl fn nullable_input<R>(f: fn(R?) -> i64, x: R?) -> i64 => f(x) + 100
fn from_nullable(value: i64?) -> i64 => nullable_input(fn(x) => 3, value)

test inferred_callback_inputs {
    assert eval exact_callback_inputs(value: [7], key: [2]) == [3]
    assert eval from_nullable(value: [7]) == [3]
}

struct Label { number: i64 }
impl const fn convert(value: Label) -> str => "payload"
impl const fn convert(value: Label?) -> str => "nullable"

test format_selects_the_payload_conversion {
    let present: Label? = Label(number: 7)
    let absent: Label? = null
    assert convert<str>(present) == "nullable"
    assert format("{}", present) == "payload"
    assert format("{}", absent) == "null"
}
