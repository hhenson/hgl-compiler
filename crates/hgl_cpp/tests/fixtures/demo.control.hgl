module demo.control

# Control flow over connections in a graph: each branch of an `if` or a
# `switch` over a connection is a child graph that exists while it is
# selected (CTRL-2, CTRL-13 to CTRL-15). Each test's expectation is the
# language's.

fn count_publications(value: i64) -> i64 {
    state count: i64 = 0
    when {
        count += 1
        return count
    }
}

fn halved(divisor: f64) -> f64 {
    when { return divisor / 2.0 }
}

fn overflow_on_large(value: i64) {
    when { let checked = value * 4611686018427387904 }
}

fn sample_on_probe(watched: i64, probe: bool) -> i64 {
    when modified(probe) && valid() {
        return watched
    }
}

# CTRL-2, CTRL-3: the branch starts fresh on re-entry, and an `if` with no
# `else` never ticks while its condition is false.
fn count_inside_branch(enabled: bool, value: i64) -> i64 {
    if enabled { count_publications(value) }
}

test a_conditional_child_restarts_only_after_leaving_its_branch {
    assert eval(count_inside_branch(
        enabled: [true, true, false, _, true, _],
        value:   [10,   20,   30,    40, 50,  60])) ==
                 [1,    2,    _,     _,  1,   2]
}

test a_branch_runs_once_with_the_values_held_when_it_starts {
    assert eval(count_inside_branch(
        enabled: [false, true, false, true],
        value:   [   10,    _,     _,    _])) ==
                 [    _,    1,     _,    1]
}

# CTRL-2: "Producers composed outside the conditional keep their own
# lifetime"; the branch takes the connection whole (CTRL-7).
fn count_outside_branch(enabled: bool, value: i64) -> i64 {
    let count = count_publications(value)
    if enabled { count }
}

test an_outer_producer_keeps_its_lifetime_across_branches {
    assert eval(count_outside_branch(
        enabled: [true, true, false, _, true, _],
        value:   [10,   20,   30,    40, 50,  60])) ==
                 [1,    2,    _,     _,  5,   6]
}

# CTRL-5, CTRL-14: the continuation is the other branch.
fn bypass_ratio(bypass: bool, divisor: f64) -> f64 {
    if bypass { return divisor }
    return halved(divisor)
}

test an_early_return_skips_the_continuation {
    assert eval(bypass_ratio(
        bypass:  [true, false, true, false],
        divisor: [0.0,  3.0,   0.0,  2.0])) ==
                 [0.0,  1.5,   0.0,  1.0]
}

# CTRL-6, CTRL-14, CTRL-15: a `switch` assigns a `var` in each case.
fn switch_input(route: str, left: i64, right: i64, fallback: i64) -> i64 {
    var selected = fallback
    switch route {
        case "left": selected = left
        case "right": selected = right
        default: selected = fallback
    }
    return selected
}

test a_switch_forwards_the_selected_connection {
    assert eval(switch_input(
        route:    ["left", "right", _, "other", _, "left"],
        left:     [1,      2,       3, 4,       5, 6],
        right:    [10,     20,      _, 40,     50, 60],
        fallback: [100,    200,   300, 400,   500, 600])) ==
                  [1,      20,      _, 400,   500, 6]
}

# A selected connection's value is read when it is sampled later.
fn sample_selection(use_left: bool, left: i64, right: i64, probe: bool) -> i64 {
    let selected = if use_left { left } else { right }
    return sample_on_probe(selected, probe)
}

test a_probe_reads_a_selected_producer_that_stayed_quiet {
    assert eval(sample_selection(
        use_left: [true, false,    _, _, true,    _],
        left:     [   7,     _,    _, 9,    _,    _],
        right:    [  20,     _,    _, _,    _,    _],
        probe:    [true,     _, true, _,    _, true],
    )) ==         [   7,     _,   20, _,    _,    9]
}

# CTRL-3: "an omitted false branch performs no conditional work".
fn guarded(open: bool, value: i64) -> i64 {
    if open { overflow_on_large(value) }
    return value
}

test an_outputless_branch_runs_only_while_selected {
    assert eval(guarded(open: [false, false, true], value: [1, 5, 0])) == [1, 5, 0]
    assert raises("numeric.out_of_range") {
        assert eval(guarded(open: [false, true], value: [5, 5])) == [5, 5]
    }
}

# An `else if` is the one statement of the `else`.
fn three_way(a: bool, b: bool, x: i64, y: i64, z: i64) -> i64 {
    if a { x } else if b { y } else { z }
}

test an_else_if_chain_selects_in_order {
    assert eval(three_way(
        a: [true, false, false, true],
        b: [true, true,  false,  _],
        x: [1,    2,     3,     4],
        y: [10,   20,    30,    40],
        z: [100,  200,   300,   400])) == [1, 20, 300, 4]
}

# An ordinary value a branch reads is its configuration.
fn scaled(open: bool, value: i64, const factor: i64) -> i64 {
    let offset = factor + 1
    if open { value * factor + offset }
}

test a_branch_reads_ordinary_values {
    assert eval(scaled(open: [true, true, false, true], value: [1, 2, 3, 4], factor: 3)) ==
        [7, 10, _, 16]
}

# CTRL-14: a branch that does not assign the `var` gives its binding
# before.
fn adjusted(rising: bool, price: i64) -> i64 {
    var chosen = price
    if rising { chosen = count_publications(price) }
    return chosen
}

test a_var_keeps_its_binding_where_the_branch_does_not_assign_it {
    assert eval(adjusted(rising: [false, true, _, false, true], price: [10, 20, 30, 40, 50])) ==
        [10, 1, 2, 40, 1]
}

# CTRL-14: "With none before, every branch that does not return assigns
# it".
fn either(rising: bool, price: i64) -> i64 {
    var chosen: i64
    if rising { chosen = price + 1 } else { chosen = price - 1 }
    return chosen
}

test a_var_with_no_value_is_given_one_by_each_branch {
    assert eval(either(rising: [true, false, _], price: [10, 20, 30])) == [11, 19, 29]
}

# CTRL-5: a case that returns, and one that goes on.
fn routed(route: i64, value: i64) -> i64 {
    switch route {
        case 1: return value
        case 2: return count_publications(value)
        default: {}
    }
    return value + 100
}

test a_switch_returns_from_a_case_or_goes_on {
    assert eval(routed(route: [1, 2, _, 3, 2], value: [5, 6, 7, 8, 9])) == [5, 1, 2, 108, 1]
}

# A condition that is a lifted call.
fn large(value: i64) -> i64 {
    if value > 10 { count_publications(value) } else { value }
}

test a_lifted_condition_selects {
    assert eval(large(value: [1, 20, 30, 2, 40])) == [1, 1, 2, 2, 1]
}

# A temporal `if` with a `return` under a wiring-time `if` has what
# follows both.
fn chosen_by_config(const wide: bool, open: bool, value: i64) -> i64 {
    if wide {
        if open { return value }
    }
    return value + 1
}

test a_return_under_a_wiring_time_if_has_its_continuation {
    assert eval(chosen_by_config(wide: true, open: [true, false, true], value: [1, 2, 3])) ==
        [1, 3, 3]
    assert eval(chosen_by_config(wide: false, open: [true, false, true], value: [1, 2, 3])) ==
        [2, 3, 4]
}

# CTRL-10: "A branch that returns from the function gives the `if` no
# value".
fn early(open: bool, value: i64) -> i64 {
    let v = if open { return value } else { value + 5 }
    return v * 2
}

test a_let_of_a_returning_if_returns_or_goes_on {
    assert eval(early(open: [true, false, _, true], value: [1, 2, 3, 4])) == [1, 14, 16, 4]
}

# CTRL-6: a `switch` with no `default` runs the case each value has.
fn unmatched(route: str, value: i64) -> i64 {
    var out = value
    switch route {
        case "a": out = value + 1
        case "b": out = value + 2
    }
    return out
}

test a_switch_with_no_default_runs_a_case_each_value_has {
    assert eval(unmatched(route: ["a", "b", _], value: [1, 2, 3])) == [2, 4, 5]
}

# A temporal `if` in a loop unrolled while the graph is built: each pass
# configures its own branches.
fn gated_product(open: bool, price: i64, const factors: list<i64>) -> i64 {
    var running = price
    for factor in factors {
        if open { running = running * factor }
    }
    return running
}

test a_branch_in_an_unrolled_loop_is_configured_for_its_pass {
    assert eval(gated_product(open: [true, false, true], price: [1, 2, 3], factors: [2, 5])) ==
        [10, 2, 30]
}

# CTRL-1, CTRL-13: a wiring-time condition composes one branch, and a
# branch that is a connection never ticks where it is not composed.
fn sized(price: i64, const wide: bool) -> i64 {
    if wide { count_publications(price) } else { price }
}

fn gated_by_config(price: i64, const open: bool) -> i64 {
    let chosen = if open { price }
    return chosen
}

fn mixed(price: i64, const wide: bool) -> i64 {
    if wide {
        let counted = count_publications(price)
        counted
    } else { 5 }
}

test a_wiring_time_if_composes_one_branch {
    assert eval(sized(price: [10, 20, _, 30], wide: true)) == [1, 2, _, 3]
    assert eval(sized(price: [10, 20, _, 30], wide: false)) == [10, 20, _, 30]
    assert eval(gated_by_config(price: [10, 20], open: true)) == [10, 20]
    assert eval(gated_by_config(price: [10, 20], open: false)) == [_, _]
    assert eval(mixed(price: [10, 20], wide: true)) == [1, 2]
    assert eval(mixed(price: [10, 20], wide: false)) == [5, _]
}
