module demo.pack_reads

# FN-19 and GEN-17: read entries under constant names and positions.
const first: i64 = 0
const price_key: str = "price"

const fn positional<...As>(args: ...As) -> i64 => args[first + 1]
const fn named<...As>(args: ...{As}) -> i64 => args[price_key]
const fn by_key<const key: str, ...As>(args: ...{As}) -> i64 => args[key]
const fn homogeneous(args: ...i64) -> i64 => args[0]

test ordinary_pack_entries {
    assert positional("unread", 3) == 3
    assert named(ignored: "unread", price: 7) == 7
    assert by_key<"other">(other: 5) == 5
    assert homogeneous(6, 9) == 6
}

const fn apply(f: const fn(i64) -> i64) -> i64 => f(1)
const fn captured<...As>(args: ...As) -> i64 => apply(fn(x) => x + args[0])

test captured_pack_entry {
    assert captured(4) == 5
    assert captured(7) == 8
}

fn graph_named<...As>(args: ...{As}) -> i64 => args[price_key]
fn graph_positional<...As>(args: ...As) -> i64 => args[0]

test graph_connections_keep_their_key {
    assert eval graph_named(price: [3, 7]) == [3, 7]
    assert eval graph_positional([4, 5]) == [4, 5]
}

# TIME-3 and TIME-4: the default admission includes the fitted pack inputs.
fn first_when_admitted<...As>(args: ...As) -> i64 {
    when { return args[0] }
}

test node_admits_a_pack_entry {
    assert eval first_when_admitted([_, 7], [2, 3]) == [_, 7]
}

fn first_with_manual_admission(trigger: i64, args: ...i64) -> i64 {
    # expect-error(phase, "payload.unguarded")
    when modified(trigger) && valid([]) { return args[0] }
}

test absent_positional_key {
    # expect-error(type, "pack.name")
    assert positional(3) == 3
}

test absent_named_key {
    # expect-error(type, "pack.name")
    assert named(other: 7) == 7
}

test absent_generic_key {
    # expect-error(type, "pack.name")
    assert by_key<"other">(price: 5) == 5
}

# expect-error(type, "type.mismatch")
const fn runtime_key(key: i64, args: ...i64) -> i64 => args[key]

# expect-error(type, "type.mismatch")
const fn wrong_kind(args: ...i64) -> i64 => args[false]

# FN-19: a key reads the fitted type of its own entry on each call.
const fn entry_type<...As>(args: ...{As}) -> As[price_key] => (args)[price_key]

test each_entry_keeps_its_type {
    assert entry_type(price: 13) == 13
    assert entry_type(price: "label") == "label"
}
