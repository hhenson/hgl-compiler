module demo.function_arguments

use demo.callback_library as lib

const fn apply(f: const fn(i64) -> i64, input: i64 = 3) -> i64 => f(input)

const fn increment(input: i64) -> i64 => input + 1

const fn double<T>(input: T) -> T requires T in {i64, f64} => input + input

operator triple<T>(input: T) -> T
impl const fn triple(input: i64) -> i64 => input * 3

const fn relay(f: const fn(i64) -> i64, input: i64) -> i64 => apply(f, input)

const fn through_lambda(f: const fn(i64) -> i64, input: i64) -> i64 =>
    apply(fn(n) => f(n), input)

const fn via_capture(input: i64) -> i64 {
    let increment_by = input + 1
    return relay(fn(n) => n + increment_by, input)
}

const fn transitive_capture(input: i64) -> i64 {
    let increment_by = input + 1
    return through_lambda(fn(n) => n + increment_by, input)
}

fn hooked(input: i64) -> i64 {
    when {
        let increment_by = 2
        return apply(fn(n) => n + increment_by, input)
    }
}

fn guarded_hook(input: i64) -> i64 {
    when valid([]) {
        if valid(input) { return apply(fn(n) => n + input, 1) }
    }
}

# ERR-14, FN-14: an anonymous value helper borrows the child the let holds.
fn captured_list_child(parts: list<i64, 2>) -> i64 {
    when all_valid(parts) {
        let entry = parts[0]
        return apply(fn(n) => n + entry, 1)
    }
}

fn captured_tuple_child(pair: tuple<i64, i64>) -> i64 {
    when all_valid(pair) {
        let entry = pair[0]
        return apply(fn(n) => n + entry, 1)
    }
}

fn captured_row(rows: list<tuple<i64, i64>, 2>, position: i64) -> i64 {
    when {
        let row = rows[position]
        return apply(fn(n) => n + row[0], 1)
    }
}

fn delayed_child(parts: list<i64, 2>, position: i64, read: bool) -> i64 {
    when {
        var selector = position
        let entry = parts[selector]
        selector = 0
        return lib::apply_if(fn(n) => n + entry, read)
    }
}

# ERR-14 and FN-14: the callback binds a child of its captured input.
fn binds_inside_callback(parts: list<i64, 2>) -> i64 {
    when all_valid(parts) {
        return apply(fn(n) {
            let entry = parts[0]
            return n + entry
        }, 1)
    }
}

fn binds_inside_nested_callback(parts: list<i64, 2>) -> i64 {
    when all_valid(parts) {
        return apply(fn(n) => apply(fn(m) {
            let entry = parts[0]
            return m + entry
        }, n), 1)
    }
}

fn observes_inside_callback(parts: list<i64, 2>, position: i64, inspect: bool) -> i64 {
    when {
        return apply(fn(n) {
            let entry = parts[position]
            if inspect && valid(entry) { return n + entry }
            return -1
        }, 1)
    }
}

fn sample(f: const fn(i64) -> i64, const input: i64) -> i64 {
    yield 1s: f(input)
}

fn map_graph(f: fn(i64) -> i64, input: i64) -> i64 => f(input)

fn live_double(input: i64) -> i64 {
    when { return input + input }
}

operator live_transform(input: i64) -> i64
impl fn live_transform(input: i64) -> i64 {
    when { return input + 5 }
}

fn live_lambda(input: i64) -> i64 => map_graph(fn(n) => live_double(n), input)

fn live_capture(input: i64, offset: i64) -> i64 =>
    map_graph(fn(n) => live_double(n) + offset, input)

fn conditional_graph(f: fn(i64) -> i64, input: i64, choose: bool) -> i64 =>
    if choose { f(input) } else { input }

fn conditional_capture(input: i64, offset: i64, choose: bool) -> i64 =>
    conditional_graph(fn(n) => n + offset, input, choose)

fn lift_value(f: const fn(i64) -> i64, input: i64) -> i64 => f(input)

fn lifted_lambda(input: i64) -> i64 {
    let offset = 3
    return lift_value(fn(n) => n + offset, input)
}

const fn apply_optional(f: const fn(i64?) -> i64) -> i64 => f()

fn apply_lifted(f: const fn(i64, i64?) -> i64, input: i64) -> i64 => f(input)

fn apply_lifted_input(f: const fn(i64, i64?) -> i64, input: i64, extra: i64?) -> i64 =>
    f(input, extra)

fn optional_callbacks(input: i64) -> i64 =>
    apply_lifted(fn(n, extra) => if extra == null { n + 1 } else { n + extra }, input)

fn nullable_inputs(input: i64, extra: i64?) -> i64 =>
    apply_lifted_input(fn(n, bias) => if bias == null { n + 1 } else { n + bias }, input, extra)

operator dispatch(f: const fn(i64) -> i64, x: i64) -> i64
impl const fn dispatch(f: const fn(i64) -> i64, x: i64) -> i64 => f(x)

operator dispatch_generic<T, R>(f: const fn(T) -> R, x: T) -> R
impl const fn dispatch_generic<T, R>(f: const fn(T) -> R, x: T) -> R => f(x)

const fn shows_text(x: str) -> bool => x != ""

const fn identity<T>(x: T) -> T => x

const fn forward_to_operator(f: const fn(i64) -> i64, x: i64) -> i64 =>
    dispatch(f, x)

const fn capture_in_operator(x: i64) -> i64 {
    let bump = x + 2
    return dispatch(fn(y) => y + bump, x)
}

operator dispatch_live(f: fn(i64) -> i64, x: i64) -> i64
impl fn dispatch_live(f: fn(i64) -> i64, x: i64) -> i64 => f(x)

fn operator_graph(x: i64, offset: i64) -> i64 =>
    dispatch_live(fn(y) => live_double(y) + offset, x)

const fn generic_lambda<T>(x: T) -> T requires T in {i64, f64} =>
    dispatch_generic(fn(n: T) => n + n, x)

fn invoke_scalar(f: const fn(i64) -> i64) -> i64 {
    let adjusted = f(1)
    return adjusted
}

fn captured_scalar(input: i64) -> i64 => invoke_scalar(fn(n) => n + input)

test ordinary_callbacks {
    assert apply(increment) == 4
    assert apply(double<i64>, 4) == 8
    assert apply(double, 3) == 6
    assert apply(lib::plus<2>, 3) == 5
    assert apply(lib::with_default, 3) == 7
    assert relay(triple, 4) == 12
    assert through_lambda(increment, 4) == 5
    assert through_lambda(triple, 4) == 12
    assert via_capture(4) == 9
    assert transitive_capture(4) == 9
    assert apply_optional(fn(n) => if n == null { 7 } else { n }) == 7
    assert dispatch(increment, 3) == 4
    assert dispatch(x: 3, f: fn(y) => y * 2) == 6
    assert capture_in_operator(4) == 10
    assert forward_to_operator(increment, 4) == 5
    assert dispatch_generic(shows_text, "yes")
    assert dispatch_generic(identity, 7) == 7
    assert generic_lambda(4) == 8
    assert generic_lambda(1.5) == 3.0
}

test temporal_callbacks {
    assert eval map_graph(live_double, input: [2, 3]) == [4, 6]
    assert eval map_graph(live_transform, input: [2, 3]) == [7, 8]
    assert eval map_graph(triple, input: [2, 3]) == [6, 9]
    assert eval apply(increment, input: [2, 3]) == [3, 4]
    assert eval hooked(input: [2, 3]) == [4, 5]
    assert eval guarded_hook(input: [2, 3]) == [3, 4]
    assert eval sample(increment, input: 10) == [1s: 11]
    assert eval live_lambda(input: [2, 3]) == [4, 6]
    assert eval live_capture(input: [2, 3], offset: [1, 2]) == [5, 8]
    assert eval conditional_capture(input: [2, 3], offset: [1, 2], choose: [true, false]) == [3, 3]
    assert eval lifted_lambda(input: [2, 3]) == [5, 6]
    assert eval optional_callbacks(input: [2, 3]) == [3, 4]
    assert eval nullable_inputs(input: [2, 3], extra: [_, 9]) == [3, 12]
    assert eval operator_graph(x: [2, 3], offset: [1, 2]) == [5, 8]
    assert eval captured_scalar(input: [2, 3]) == [3, 4]
}

test bound_child_captures {
    assert eval captured_list_child(parts: [[3, 4]]) == [4]
    assert eval captured_tuple_child(pair: [(3, 4)]) == [4]
    assert eval captured_row(rows: [[(3, 4), (5, 6)]], position: [1]) == [6]
    assert eval delayed_child(parts: [[3, 4]], position: [1], read: [true]) == [5]
    assert eval delayed_child(parts: [[3, 4]], position: [2], read: [false]) == [-1]
    assert raises("value.unset_read") {
        eval delayed_child(parts: [delta<list<i64, 2>>(updated: [0: 3])], position: [1], read: [true])
    }
    assert eval binds_inside_callback(parts: [[3, 4]]) == [4]
    assert eval binds_inside_nested_callback(parts: [[3, 4]]) == [4]
    assert eval observes_inside_callback(
        parts: [delta<list<i64, 2>>(updated: [0: 3]), _, _],
        position: [0, 1, 2],
        inspect: [true, _, false],
    ) == [4, -1, -1]
}

# FN-17, GEN-8: the specification's explicit generic operator reference.
const fn widened(f: const fn(i64) -> f64, x: i64) -> f64 => f(x)
const fn eight() -> f64 => widened(convert<f64>, 8)

operator classify_text<R, V>(value: V) -> R
impl const fn classify_text(value: i64) -> str => "integer"
impl const fn classify_text(value: f64) -> str => "float"

const fn describe<V>(f: const fn(V) -> str, value: V) -> str => f(value)
const fn describe_named(f: const fn(value: i64) -> str, value: i64) -> str => f(value: value)

# GEN-5 and FN-17: a result read at an ordinary call would allow both
# candidates, but the callback's declared result itself must fit.
operator exact_result<R, V>(value: V) -> R
impl const fn exact_result(value: i64) -> f64 => 18.0
impl const fn exact_result(value: i64) -> f64? => 19.0

operator signed<const positive: bool = true, T>(value: T) -> T
impl const fn signed<const positive: bool = true>(value: i64) -> i64
    requires positive == true => value
impl const fn signed<const positive: bool = true>(value: i64) -> i64
    requires positive == false => -value

# FN-17, GEN-8 and EXPR-5: a written or defaulted integer literal
# takes the selected option's f64 type.
operator option_bias<const enabled: bool, const amount: i64 = 3>(value: i64) -> f64
impl const fn option_bias<T, const enabled: T, const amount: f64 = 3.0>(value: i64) -> f64 => amount

operator list_bias<const enabled: bool, const amounts: list<i64> = [3]>(value: i64) -> f64
impl const fn list_bias<T, const enabled: T, const amounts: list<f64> = [3.0]>(value: i64) -> f64 => amounts[0]

operator nested_bias<const enabled: bool, const amounts: list<list<i64>> = [[3]]>(value: i64) -> f64
impl const fn nested_bias<T, const enabled: T, const amounts: list<list<f64>> = [[3.0]]>(value: i64) -> f64 => amounts[0][0]

operator pair_bias<const First: i64, const Pair: tuple<i64, i64> = (First, 3)>(value: i64) -> f64
impl const fn pair_bias<const First: i64, const Pair: tuple<i64, f64> = (First, 3.0)>(value: i64) -> f64 =>
    convert<f64>(Pair[0]) + Pair[1]

operator option_infers<const enabled: bool>(value: i64) -> i64
impl const fn option_infers<T, const enabled: T>(value: i64) -> i64 => value

operator selected_live<R, V>(value: V) -> R
impl fn selected_live(value: i64) -> i64 {
    when { return value + 10 }
}
impl const fn selected_live(value: i64) -> i64 => value + 100

fn map_widened(f: fn(i64) -> f64, value: i64) -> f64 => f(value)
fn lifted_convert(value: i64) -> f64 => map_widened(convert<f64>, value)
fn composed_operator(value: i64) -> i64 => map_graph(selected_live<i64>, value)

test explicit_operator_callbacks {
    assert eight() == 8.0
    assert describe(classify_text<str>, 8) == "integer"
    assert describe(classify_text<str>, 8.5) == "float"
    assert describe(classify_text, 8) == "integer"
    assert describe_named(classify_text<str>, 8) == "integer"
    assert widened(exact_result<f64>, 8) == 18.0
    assert apply(signed<false>, 8) == -8
    assert apply(signed, 8) == 8
    assert widened(option_bias<true>, 8) == 3.0
    assert widened(option_bias<true, 3>, 8) == 3.0
    assert widened(list_bias<true>, 8) == 3.0
    assert widened(list_bias<true, [3]>, 8) == 3.0
    assert widened(nested_bias<true>, 8) == 3.0
    assert widened(nested_bias<true, [[3]]>, 8) == 3.0
    assert widened(pair_bias<5>, 8) == 8.0
    assert widened(pair_bias<5, (5, 3)>, 8) == 8.0
    assert apply(option_infers<true>, 8) == 8
    assert eval lifted_convert(value: [2, 3]) == [2.0, 3.0]
    assert eval composed_operator(value: [2, 3]) == [12, 13]
}

operator double_member<T>(value: T) -> T
impl fn double_member(value: i64) -> i64 => value * 2

fn sum_mapped_pairs(left: list<i64, 2>, right: list<i64, 2>) -> list<i64, 2> =>
    map(add_<i64, i64, i64>, left, right)

fn multiply_mapped(values: list<f64, 2>, factor: f64) -> list<f64, 2> =>
    map(mul_<f64, f64, f64>, values, factor)

fn double_mapped(values: list<i64, 2>) -> list<i64, 2> =>
    map(double_member<i64>, value: values)

fn forward_member<R, ...Ps, ...As>(f: fn(...{Ps}) -> R, args: ...{As for f}) -> R =>
    f(...args)

fn double_forwarded(value: i64) -> i64 => forward_member(double_member<i64>, value)

operator choose_member<R>(value: any) -> R
impl fn choose_member(value: i64) -> i64 => value + 1
impl fn choose_member(value: f64) -> i64 => 7

fn choose_forwarded_integer(value: i64) -> i64 => forward_member(choose_member<i64>, value)
fn choose_forwarded_float(value: f64) -> i64 => forward_member(choose_member<i64>, value)

# MAP-2 and FN-17: an explicit operator supplies the member types. Map
# fits its split and whole arguments separately, while a direct
# forwarding call uses the same operator reference with a whole input
# or supplies the type of a public `any` parameter.
test explicit_operator_callbacks_with_split_inputs {
    assert eval sum_mapped_pairs(left: [[1, 2]], right: [[3, 4]]) == [[4, 6]]
    assert eval multiply_mapped(values: [[2.0, 3.0]], factor: [4.0]) == [[8.0, 12.0]]
    assert eval double_mapped(values: [[2, 3]]) == [[4, 6]]
    assert eval double_forwarded(value: [3]) == [6]
    assert eval choose_forwarded_integer(value: [3]) == [4]
    assert eval choose_forwarded_float(value: [3.0]) == [7]
}

fn sum_bare_pairs(left: list<i64, 2>, right: list<i64, 2>) -> list<i64, 2> =>
    map(add_, left, right)

fn multiply_bare(values: list<f64, 2>, factor: f64) -> list<f64, 2> =>
    map(mul_, values, factor)

fn double_bare(values: list<i64, 2>) -> list<i64, 2> =>
    map(double_member, value: values)

fn identity_bare(values: list<i64, 2>) -> list<i64, 2> =>
    map(identity, values)

fn whole_forwarded(values: list<i64, 2>) -> list<i64, 2> =>
    forward_member(identity, values)

fn first_if<T>(enabled: bool, values: list<T, 2>) -> T =>
    if enabled { values[0] } else { values[1] }

fn explicit_whole_list(enabled: list<bool, 2>, values: list<i64, 2>) -> list<i64, 2> =>
    map(first_if<i64>, enabled, values)

# GEN-3, FN-17, MAP-2: a bare callback takes member types from the
# declared split alternatives. Ordinary forwarding supplies whole types.
test bare_callbacks_with_split_inputs {
    assert eval sum_bare_pairs(left: [[1, 2]], right: [[3, 4]]) == [[4, 6]]
    assert eval multiply_bare(values: [[2.0, 3.0]], factor: [4.0]) == [[8.0, 12.0]]
    assert eval double_bare(values: [[2, 3]]) == [[4, 6]]
    assert eval identity_bare(values: [[2, 3]]) == [[2, 3]]
    assert eval whole_forwarded(values: [[2, 3]]) == [[2, 3]]
    assert eval explicit_whole_list(enabled: [[true, false]], values: [[2, 3]]) == [[2, 3]]
}

# GEN-5, GEN-6 and FN-17: each candidate derives callback types from its
# own alternatives. The mode selects the candidate before another
# candidate's narrower pattern can determine the type of the bare name.
operator choose_input<M, R, ...Ps, ...As>(
    mode: M, f: const fn(...{Ps}) -> R, args: ...{As for f}) -> i64
impl fn choose_input<R, ...Ps, ...As>(
    mode: i64, f: const fn(...{Ps}) -> R, args: ...{As for f}) -> i64
    requires each k in arg_keys(As) { As[k] in {Ps[k]} } => 1
impl fn choose_input<R, ...Ps, ...As>(
    mode: str, f: const fn(...{Ps}) -> R, args: ...{As for f}) -> i64
    requires each k in arg_keys(As) { As[k] in {list<Ps[k], 2>} } => 2

fn choose_whole(items: list<i64, 2>) -> i64 => choose_input(7, identity, items)
fn choose_split(items: list<i64, 2>) -> i64 => choose_input("split", identity, items)
fn choose_generic<T>(items: list<T, 2>) -> i64 => choose_input(7, identity, items)

test bare_callbacks_use_their_own_candidate_evidence {
    assert eval choose_whole(items: [[2, 3]]) == [1]
    assert eval choose_split(items: [[2, 3]]) == [2]
    assert eval choose_generic<i64>(items: [[2, 3]]) == [1]
}

# GEN-2, GEN-3 and FN-17: written and ordinary-input bindings stay fixed
# when the enclosing declaration's alternatives supply callback inputs.
operator list_only<T>(items: T) -> i64
impl fn list_only(items: list<i64, 2>) -> i64 => items[0]
operator dict_only<T>(items: T) -> i64
impl fn dict_only(items: dict<str, i64>) -> i64 => 3

fn sized_callback<const N: i64, R, ...Ps, ...As>(f: fn(...{Ps}) -> R, args: ...{As for f}) -> i64
    requires each k in arg_keys(As) { As[k] in {Ps[k], list<Ps[k], N>} } => 70
fn keyed_callback<K, R, ...Ps, ...As>(mark: K, f: fn(...{Ps}) -> R, args: ...{As for f}) -> i64
    requires each k in arg_keys(As) { As[k] in {Ps[k], dict<K, Ps[k]>} } => 72

fn list_binding(items: list<i64, 2>) -> i64 => sized_callback<3>(list_only, items)
fn dict_binding(items: dict<str, i64>) -> i64 => keyed_callback(3, dict_only, items)
fn list_split(items: list<i64, 2>) -> i64 => sized_callback<2>(identity, items)
fn dict_split(items: dict<str, i64>) -> i64 => keyed_callback("key", identity, items)

# GEN-3 and FN-17: the callback has a generic, but the list input is
# already fixed by its declaration or by the receiving result type.
fn fixed_list<const N: i64 = 0>(items: list<i64, 2>) -> i64 => N
fn first_item<T>(items: list<T, 2>) -> T => items[0]
fn sized_i64_callback<const N: i64, ...Ps, ...As>(f: fn(...{Ps}) -> i64, args: ...{As for f}) -> i64
    requires each k in arg_keys(As) { As[k] in {Ps[k], list<Ps[k], N>} } => 71

fn fixed_list_binding(items: list<i64, 2>) -> i64 => sized_callback<2>(fixed_list, items)
fn result_list_binding(items: list<i64, 2>) -> i64 => sized_i64_callback<2>(first_item, items)

# The fixed input stays whole when another input of the same callback
# still needs to learn its type from a split argument.
fn fixed_and_inferred<T>(whole: list<i64, 2>, value: T) -> T => value
fn mixed_callback<R, ...Ps, ...As>(f: fn(...{Ps}) -> R, args: ...{As for f}) -> i64
    requires each k in arg_keys(As) { As[k] in {Ps[k], list<Ps[k], 2>} }
          && R == str => 73
fn mixed_list_binding(items: list<i64, 2>, words: list<str, 2>) -> i64 =>
    mixed_callback(fixed_and_inferred, whole: items, value: words)

# GEN-2 and FN-17: this reflected callback determines the earlier
# fixed callback's template even when that callback is written first.
operator then_apply<R, ...Ps, ...As>(
    g: fn(R) -> R, f: fn(...{Ps}) -> R, args: ...{As for f}) -> i64
impl fn then_apply<R, ...Ps, ...As>(
    g: fn(R) -> R, f: fn(...{Ps}) -> R, args: ...{As for f}) -> i64
    requires each k in arg_keys(As) { As[k] in {Ps[k]} } => 1

fn callback_order(value: i64) -> i64 => then_apply(identity, identity, value)

# MAP-2: the ordinary Core candidate splits values and supplies the
# fixed table whole despite the callback's unrelated generic.
const fn scale_with_table<T>(x: i64, table: list<i64, 2>, factor: T) -> i64 => x + table[1]
fn map_with_whole_table(values: list<i64, 2>, table: list<i64, 2>) -> list<i64, 2> =>
    map(scale_with_table, values, table, 3)

test bare_callbacks_keep_known_outer_bindings {
    assert eval list_binding(items: [[5, 6]]) == [70]
    assert eval dict_binding(items: [["a": 8]]) == [72]
    assert eval list_split(items: [[5, 6]]) == [70]
    assert eval dict_split(items: [["a": 8]]) == [72]
    assert eval fixed_list_binding(items: [[5, 6]]) == [70]
    assert eval result_list_binding(items: [[5, 6]]) == [71]
    assert eval mixed_list_binding(items: [[5, 6]], words: [["a", "b"]]) == [73]
    assert eval callback_order(value: [4]) == [1]
    assert eval map_with_whole_table(values: [[1, 2]], table: [[10, 20]]) == [[21, 22]]
}
