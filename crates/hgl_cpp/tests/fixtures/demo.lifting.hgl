module demo.lifting

# The lifted calls and captures the cpp target writes, with the temporal
# forms of `error` and `result` and a `?` in a `when`. Its goldens are
# under `tests/goldens/demo.lifting`.

# A value function with a default, lifted over its inputs (FN-6, FN-11).
const fn scaled(value: i64, factor: i64 = 2, offset: i64 = 0) -> i64 =>
    value * factor + offset

# A value function with configuration, given in an eval (TST-8).
const fn multiplied(value: i64, const factor: i64) -> i64 => value * factor

# A graph whose lifted call gives a connection to a parameter with a
# default, and leaves another out.
fn scaled_by(value: i64, factor: i64) -> i64 {
    return scaled(value, factor)
}

# An outputless helper, which lifts to a sink (FN-6): it fails where it is
# given zero.
const fn check(value: i64) {
    let quotient = 1 // value
}

fn checked(value: i64) {
    check(value)
}

# The error a capture of the sink publishes (ERR-7), described.
fn describe(failure: error, sample: i64) -> str {
    when modified(sample) && valid([]) {
        if valid(failure) {
            let code = failure.code
            if code == null { return "uncoded" }
            if modified(failure) { return code }
            return "retained"
        }
        return "clear"
    }
}

fn checked_errors(value: i64) -> str {
    let boundary = capture(check, value)
    return describe(boundary.error, value)
}

# A node that fails on a negative input with `?` (ERR-5), and returns its
# outcome as data too.
const fn attempt(value: i64) -> result<i64, error> {
    if value < 0 { return err(error(message: "negative input", code: "numeric.out_of_range")) }
    return ok(value * 10)
}

fn raised(value: i64) -> i64 {
    when { return attempt(value)? }
}

fn returned(value: i64) -> result<i64, error> {
    when { return attempt(value) }
}

fn outcome(taken: result<i64, error>) -> str {
    when {
        if is_err(taken) { return taken.error.message }
        return "ok"
    }
}

fn outcomes(value: i64) -> str {
    return outcome(returned(value))
}

# A capture of a node given configuration, and of a graph (ERR-7).
fn shifted(value: i64, const by: i64) -> i64 {
    when { return attempt(value)? + by }
}

fn shifted_values(value: i64) -> i64 {
    let boundary = capture(shifted, value, 5)
    return boundary.value
}

fn guarded(value: i64) -> i64 {
    return raised(value)
}

fn guarded_values(value: i64) -> i64 {
    return capture(guarded, value).value
}

# ERR-8: "Earlier writes remain visible": what the node published before
# it failed stands.
fn write_then_fail(value: i64) -> i64 {
    inject out
    when {
        out = value
        let tenfold = attempt(value)?
        out = tenfold
    }
}

fn written_values(value: i64) -> i64 {
    let boundary = capture(write_then_fail, value)
    return boundary.value
}

# ERR-8: a retained error raised again with `?` keeps where it first
# failed: its node, phase and time.
fn raise_again(first: error, repeat: bool) -> error {
    when modified(first) && valid(first) { return first }
    when modified(repeat) && valid(first) {
        let failure: result<error, error> = err(first)
        return failure?
    }
}

fn handled(value: i64, repeat: bool) -> error {
    let inner = capture(raised, value)
    return raise_again(inner.error, repeat)
}

fn kept_time(first: error, repeated: error) -> datetime {
    when modified(repeated) && valid(first, repeated) {
        let original = first.context
        let again = repeated.context
        if original == null || again == null { return never }
        if original.node != again.node || original.phase != again.phase { return never }
        return again.evaluation_time
    }
}

fn provenance(value: i64, repeat: bool) -> datetime {
    let outer = capture(handled, value, repeat)
    return kept_time(outer.value, outer.error)
}

test a_default_binds_until_its_input_publishes {
    assert eval(scaled_by(value: [1, _, 3], factor: [_, 4, _])) == [2, 4, 12]
    assert eval(scaled(value: [1, 2], factor: [_, 3], offset: [1])) == [3, 7]
    assert eval(scaled(value: [1, 2])) == [2, 4]
}

test an_evals_configuration_is_evaluated_once {
    var count = 0
    assert eval(multiplied(value: [1, 2], factor: {
        count += 1
        count + 2
    })) == [3, 6]
    assert count == 1
}

test a_sink_fails_and_a_capture_of_it_publishes_the_error {
    eval(checked(value: [1, 2]))
    assert raises("numeric.division_by_zero") {
        eval(checked(value: [1, 0]))
    }
    assert eval(checked_errors(value: [1, 0, 2])) == ["clear", "numeric.division_by_zero", "retained"]
}

test a_failure_and_a_returned_error_are_told_apart {
    assert eval(outcomes(value: [1, -1])) == ["ok", "negative input"]
    assert raises("numeric.out_of_range") {
        eval(raised(value: [1, -1]))
    }
}

test a_capture_keeps_the_child_live {
    assert eval(shifted_values(value: [1, -1, 2])) == [15, _, 25]
    assert eval(guarded_values(value: [1, -1, 2])) == [10, _, 20]
}

test an_earlier_write_stands {
    assert eval(written_values(value: [1, -2, 3])) == [10, -2, 30]
}

test a_raised_error_keeps_its_provenance {
    let first = earliest_start + 1us
    assert eval(provenance(value: [8, -1], repeat: [_, _, _, true])) == [_, _, _, first]
}
