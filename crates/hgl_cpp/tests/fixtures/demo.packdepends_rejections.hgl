module demo.packdepends_rejections

use demo.packdepends::{call_shape, choose, membership, scaled}

const fn required_scale(price: f64, factor: f64) -> f64 => price * factor

# FN-8: the callback's matching rules still require a nondefaulted input.
test missing_required_parameter {
    # expect-error(type, "argument.missing")
    assert call_shape(required_scale, 2.0) == 11
}

test unknown_callback_parameter {
    # expect-error(name, "argument.unknown")
    assert call_shape(scaled, price: 2.0, rate: 3.0) == 11
}

# GEN-17: the type of the argument is held in As, and the equality tests it.
test argument_type_fails_equality {
    # expect-error(constraint, "requires.unmet")
    assert call_shape(scaled, "label", factor: 3.0) == 11
}

test argument_type_fails_membership {
    let prices: dict<i64, f64> = [1: 2.0]
    # expect-error(constraint, "requires.unmet")
    assert membership<str>(scaled, prices, factor: 3.0) == 25
}

# FN-8: the second named pack is ambiguous even if the first has a callback.
# expect-error(type, "pack.duplicate")
operator duplicate<...Ps, ...As, ...Bs>(f: const fn(...{Ps}) -> f64, first: ...{As for f}, second: ...{Bs})

# GEN-10: an omitted default is no argument towards the pack's cardinality.
const fn need_two<...Ps, ...As>(f: const fn(...{Ps}) -> f64, args: ...{As for f}{2}) -> i64 => 31

test too_few_given_arguments {
    # expect-error(type, "pack.cardinality")
    assert need_two(scaled, 2.0) == 31
}

const fn inspect<...Ps>(f: const fn(...{Ps}) -> f64) -> i64 => 1

operator alone(item: f64) -> f64
impl const fn alone(value: f64) -> f64 => value

# FN-17: a result type cannot select a reflected callback, even when the
# operator has exactly one candidate.
test no_parameter_type_for_lone_candidate {
    # expect-error(type, "generic.unresolved")
    assert inspect(alone) == 1
}

test no_parameter_type_for_multiple_candidates {
    # expect-error(type, "generic.unresolved")
    assert inspect(choose) == 1
}
