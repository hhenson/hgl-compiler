module demo.ranges

const fn range_sum(first: i64, last: i64) -> i64 {
    var total = 0
    for i in first..<last {
        total = total + i
    }
    return total
}

const fn squares(n: i64) -> list<i64> => [for i in 0..<n: i * i]
const fn fixed_squares() -> list<i64, 3> => [for i in 1..<4: i * i]
const fn empty_fixed() -> list<i64, 0> => [for i in 3..<2: i]
const fn copied(values: list<i64>) -> list<i64> => [for x in values: x + 1]

fn graph_range_sum() -> i64 {
    var total = 0
    for i in 1..<4 {
        total = total + i
    }
    return total
}

fn graph_range(x: i64) -> list<i64, 3> => [for i in 0..<3: x + i]
fn graph_fixed(xs: list<i64, 3>) -> list<i64, 3> => [for x in xs: x * 2]

test iterate_ranges {
    assert range_sum(-2, 2) == -2
    assert range_sum(3, 1) == 0
    assert range_sum(9223372036854775806, 9223372036854775807) == 9223372036854775806
}

test collect_value_lists {
    assert squares(4) == [0, 1, 4, 9]
    assert fixed_squares()[2] == 9
    assert empty_fixed() == []
    assert copied([1, 3]) == [2, 4]
}

test value_loops_compose {
    assert eval graph_range_sum() == [6]
}

test list_loops_compose {
    assert eval graph_range([2, 4]) == [[2, 3, 4], [4, 5, 6]]
    assert eval graph_fixed([[1, 2, 3], [4, 5, 6]]) == [[2, 4, 6], [8, 10, 12]]
}

const fn generic_squares<const N: i64>() -> list<i64, N> => [for i in 0..<N: i * i]
const fn generic_shift<const First: i64, const Last: i64>() -> list<i64, Last - First> =>
    [for i in First..<Last: i + 1]

test generic_fixed_extents {
    assert generic_squares<3>()[2] == 4
    assert generic_shift<2, 4>()[1] == 4
}

const fn observe_bounds() -> i64 {
    var order = 0
    var total = 0
    for i in ({
        order = order * 10 + 1
        1
    })..<({
        order = order * 10 + 2
        4
    }) {
        total = total + i
    }
    let items = [for i in ({
        order = order * 10 + 3
        3
    })..<({
        order = order * 10 + 4
        2
    }): i]
    return if items == [] { order * 10 + total } else { -1 }
}

test bounds_evaluate_once_in_order {
    assert observe_bounds() == 12346
}
