module demo.references

# The `ref` parameters and results the cpp target writes (FN-16, TIME-10;
# core's END-10), and what an ordinary reader of a `ref` result observes.
# Its goldens are under `tests/goldens/demo.references`.

# Two `ref` parameters, one of which the result designates: returning a
# whole `ref` parameter samples what it designates.
fn pick(flag: bool, ref low: i64, ref high: i64) -> ref i64 {
    when modified(flag) {
        if flag { return high }
        return low
    }
}

# An ordinary reader.
fn follow(item: i64) -> i64 {
    when { return item }
}

fn picked(flag: bool, low: i64, high: i64) -> i64 => follow(pick(flag, low, high))

test a_reader_observes_the_input_designated {
    assert eval(picked(
        flag: [false, _, true,  _],
        low:  [    1, 2,    3,  _],
        high: [   10, _,    _, 11],
    )) ==     [    1, 2,   10, 11]
}

test an_eval_records_a_ref_result_as_a_reader_does {
    assert eval(pick(flag: [true, _], low: [1, 2], high: [3, _])) == [3, _]
}

# `valid` of a `ref` parameter is whether a reference is present, and a
# node subscribed to one is woken where it is given a designation.
fn present(probe: bool, ref target: i64) -> i64 {
    state wakes: i64 = 0
    when modified(target) { wakes += 1 }
    when modified(probe) && valid(probe) {
        if valid(target) { return wakes }
        return -1
    }
}

test a_ref_parameter_is_present_and_wakes_once {
    assert eval(present(probe: [true, true, true], target: [_, 7, 8])) == [1, 1, 1]
}

# A generic relay: each instance is a node of its own (GEN-2).
fn sampled<T>(take: bool, ref target: T) -> ref T {
    when modified(take) { return target }
}

fn sample_picked(take: bool, flag: bool, low: i64, high: i64) -> i64 =>
    follow(sampled(take, pick(flag, low, high)))

test a_relay_keeps_what_it_sampled {
    assert eval(sample_picked(
        take: [true,    _,  _, true],
        flag: [false, true, _,    _],
        low:  [    1,    2, 3,    _],
        high: [   10,    _, 11,   _],
    )) ==     [    1,    2, 3,   11]
}

# An input that is no `ref` parameter, designated: its reader follows a
# re-binding of it, and `invalidate(out)` leaves the result designating
# nothing, which no later re-binding moves.
fn choose(flag: i64, low: i64, high: i64) -> ref i64 {
    inject out
    when modified(flag) {
        if flag == 1 { out = low }
        if flag == 2 { return high }
        if flag == 0 { invalidate(out) }
    }
}

fn chosen(flag: i64, sel: bool, a: i64, b: i64, high: i64) -> i64 =>
    follow(choose(flag, pick(sel, a, b), high))

test a_designated_input_is_followed_through_its_rebinding {
    assert eval(chosen(
        flag: [    1, _,    _,  _,   2,   _, 0,     _,   1],
        sel:  [false, _, true,  _,   _,   _, _, false,   _],
        a:    [    1, 2,    _,  3,   _,   _, _,     4,   _],
        b:    [   10, _,    _, 11,   _,   _, _,     _,   _],
        high: [  100, _,    _,  _,   _, 101, _,   102,   _],
    )) ==     [    1, 2,   10, 11, 100, 101, _,     _,   4]
}

# A position of a fixed list designated, known when the `return` runs:
# its reader follows the element named, and a re-binding of the list,
# which runs no handler of the node.
fn route(idx: i64, items: list<i64, 2>) -> ref i64 {
    when modified(idx) { return items[idx] }
}

fn set_item(slot: i64, reading: i64) -> list<i64, 2> {
    when { return delta<list<i64, 2>>(updated: [slot: reading]) }
}

fn pick_list(flag: bool, ref low: list<i64, 2>, ref high: list<i64, 2>) -> ref list<i64, 2> {
    when modified(flag) {
        if flag { return high }
        return low
    }
}

fn routed(idx: i64, flag: bool, low_slot: i64, low: i64, high_slot: i64, high: i64) -> i64 =>
    follow(route(idx, pick_list(flag, set_item(low_slot, low), set_item(high_slot, high))))

test a_designated_position_is_followed_through_its_rebinding {
    assert eval(routed(
        idx:       [    1,  _,    _,  0,  _],
        flag:      [false,  _, true,  _,  _],
        low_slot:  [    1,  0,    _,  _,  0],
        low:       [   10, 11,    _,  _, 12],
        high_slot: [    1,  _,    0,  _,  _],
        high:      [   20,  _,   21,  _,  _],
    )) ==          [   10,  _,   20, 21,  _]
}

# EXPR-3: "An index outside a list ... fails where it is evaluated", as
# the child at it does.
test a_designated_position_outside_the_list_fails {
    assert raises("value.index_out_of_range") {
        eval(route(idx: [2], items: [[1, 2]]))
    }
}

# A dictionary's entry selected in a graph (EXPR-7: "Temporal dictionary
# key selection may give a reference, a designation of the keyed child"):
# its reader follows the entry the key names, is not valid while the
# dictionary holds none for it (TIME-1), and follows one added later.
fn write_entry(changed_key: str, price: i64?) -> dict<str, i64> {
    when {
        if price == null { return delta<dict<str, i64>>(removed: [changed_key]) }
        return delta<dict<str, i64>>(updated: [changed_key: price])
    }
}

fn selected(key: str, changed_key: str, price: i64?) -> i64 =>
    follow(write_entry(changed_key, price)[key])

test a_selected_entry_is_followed_through_its_key {
    assert eval(selected(
        key:         ["A",   _, "B",   _,    _,   _, "C",   _],
        changed_key: ["A", "B",   _, "A",  "B", "B",   _, "C"],
        price:       [  7,  20,   _,   8, null,  22,   _,  30],
    )) ==            [  7,   _,  20,   _,    _,  22,   _,  30]
}

fn present_item(probe: bool, item: i64) -> bool {
    when modified(probe) && valid(probe) { return valid(item) }
}

fn selected_present(probe: bool, key: str, changed_key: str, price: i64?) -> bool =>
    present_item(probe, write_entry(changed_key, price)[key])

test a_selected_entry_the_dictionary_lacks_is_not_valid {
    assert eval(selected_present(
        probe:       [true,  true,  true, true],
        key:         [ "A",     _,   "C",    _],
        changed_key: [ "A",   "A",     _,  "C"],
        price:       [   1,  null,     _,    3],
    )) ==            [true, false, false, true]
}

# The key a value, wired as a constant connection (FN-3).
fn entry_a(changed_key: str, price: i64?) -> i64 => follow(write_entry(changed_key, price)["A"])

test an_entry_at_a_value_key_is_followed {
    assert eval(entry_a(changed_key: ["B", "A", "A"], price: [1, 2, 3])) == [_, 2, 3]
}

# A `ref` parameter that holds no reference, `return`ed: the result is
# given the empty reference, which designates nothing (the owner's
# decision of 2026-11-21), and its reader is not valid from then on. Its
# handler's header decides whether it runs: one with no validity selector
# does, and one whose header is `valid(target)` does not.
fn withdrawn(on: bool, ref low: i64) -> ref i64 {
    inject out
    when modified(on) {
        if on { return low }
        invalidate(out)
    }
}

fn handed(take: bool, ref target: i64) -> ref i64 {
    when modified(take) { return target }
}

fn handed_on(take: bool, on: bool, low: i64) -> i64 => follow(handed(take, withdrawn(on, low)))

test an_empty_reference_is_handed_on {
    assert eval(handed_on(
        take: [   _, true,     _, true, _],
        on:   [true,    _, false,    _, _],
        low:  [   1,    _,     _,    _, 5],
    )) ==     [   _,    1,     _,    _, _]
}

fn handed_if_valid(take: bool, ref target: i64) -> ref i64 {
    when modified(take) && valid(target) { return target }
}

fn handed_on_if_valid(take: bool, on: bool, low: i64) -> i64 =>
    follow(handed_if_valid(take, withdrawn(on, low)))

test a_header_that_asks_valid_runs_no_handler_for_an_empty_reference {
    assert eval(handed_on_if_valid(
        take: [   _, true,     _, true, _],
        on:   [true,    _, false,    _, _],
        low:  [   1,    _,     _,    _, 5],
    )) ==     [   _,    1,     _,    _, 5]
}

fn holds_one(take: bool, ref target: i64) -> bool {
    when modified(take) { return valid(target) }
}

fn holds_withdrawn(take: bool, on: bool, low: i64) -> bool => holds_one(take, withdrawn(on, low))

test valid_of_a_ref_parameter_that_holds_no_reference_is_false {
    assert eval(holds_withdrawn(
        take: [   _, true,     _,  true],
        on:   [true,    _, false,     _],
        low:  [   1,    _,     _,     _],
    )) ==     [   _, true,     _, false]
}

# The empty reference handed on, given to a lifted call and to a branch:
# each reads the endpoint it designates, which is not valid.
fn handed_doubled(take: bool, on: bool, low: i64) -> i64 => handed(take, withdrawn(on, low)) * 2

test a_lifted_call_of_an_empty_reference_is_silent {
    assert eval(handed_doubled(
        take: [   _, true,     _, true, _],
        on:   [true,    _, false,    _, _],
        low:  [   1,    _,     _,    _, 5],
    )) ==     [   _,    2,     _,    _, _]
}

fn handed_or_low(chooses: bool, take: bool, on: bool, low: i64) -> i64 {
    let given = handed(take, withdrawn(on, low))
    return follow(if chooses { given } else { low })
}

test a_branch_given_an_empty_reference_is_silent {
    assert eval(handed_or_low(
        chooses: [true,    _,     _,    _, _],
        take: [   _, true,     _, true, _],
        on:   [true,    _, false,    _, _],
        low:  [   1,    _,     _,    _, 5],
    )) ==     [   _,    1,     _,    _, _]
}
