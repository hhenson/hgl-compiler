module demo.any_laws

# GEN-10: the existential sees every capture in declared pack order.
const fn has_integer<...Ts>(items: ...Ts) -> i64
    requires any T in types(Ts) { T == i64 } => 7

# GEN-3: the first positive match binds U without a requested result type.
struct Chosen<T> {
    marker: i64
    value: T? = null
}
const fn choose<U, ...Ts>(items: ...Ts) -> Chosen<U>
    requires any T in ((types((Ts)))) { T == list<U> } => Chosen<U>(marker: 11)
const fn integer_choice(value: Chosen<i64>) -> i64 => value.marker

# GEN-3, UNIT-13: inequality operands may be named module constants.
const LIMIT: i64 = 2
const fn outside_limit<const N: i64>() -> i64 requires N != LIMIT => N

# GEN-3, GEN-10: a nested const generic can be on either equality side.
const fn arity_left<const N: i64, ...Ts>(items: ...Ts) -> i64
    requires any T in types(Ts) { list<i64, N> == T } => N
const fn arity_right<const N: i64, ...Ts>(items: ...Ts) -> i64
    requires any T in types(Ts) { T == list<i64, N> } => N

# GEN-18 and RED-7: both laws are defaults of compile-time bool options.
const fn lawful<V,
    const associative: bool = associative(f),
    const commutative: bool = commutative(f),
>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires associative && commutative => f(a, b)

const fn forward<V>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires associative(f) && commutative(f) => lawful(f, a, b)
const fn ordinary(a: i64, b: i64) -> i64 => a + b

operator tree<V, const law: bool = associative(f)>(f: const fn(V, V) -> V, a: V, b: V) -> V
impl const fn tree<V, const law: bool = associative(f)>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires law => f(a, b)
const fn forward_tree<V>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires associative(f) => tree(f, a, b)

const fn declared_law<V>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires associative(f) && commutative(f) => f(a, b)

/** GEN-10: a later matching pack entry satisfies the existential. */
test any_match { assert has_integer("first", true, 3) == 7 }

/** GEN-3, UNIT-13: the named constant is read as a value. */
test named_inequality { assert outside_limit<3>() == 3 }

/** GEN-3, GEN-10: infer a const length without using an expected result type. */
test inferred_length {
    let pair: list<i64, 2> = [1, 2]
    assert arity_left(pair) == 2
    assert arity_right(pair) == 2
}

/** GEN-3, GEN-10: the first list fixes the otherwise unresolved U. */
test first_match { assert integer_choice(choose(true, [1], ["later"])) == 11 }

/** GEN-18, RED-7: Core publishes both numeric domains' addition laws. */
test core_addition {
    assert lawful(add_, 2, 3) == 5
    assert lawful(add_, 2.0, 3.0) == 5.0
}

/** GEN-18, RED-7: multiplication has both laws over both numeric domains. */
test core_multiplication {
    assert lawful(mul_, 2, 3) == 6
    assert lawful(mul_, 2.0, 3.0) == 6.0
}

/** GEN-18: the caller may answer for an ordinary or anonymous function. */
test explicit_law {
    assert lawful{associative: true, commutative: true}(ordinary, 2, 3) == 5
    assert lawful{associative: true, commutative: true}(fn(a, b) => a + b, 2, 3) == 5
}

/** GEN-18, FN-17: a forwarded function retains the public operator identity. */
test forwarded_law {
    assert forward(add_, 2, 3) == 5
    assert forward_tree(mul_, 2, 3) == 6
}

/** GEN-18: direct predicates use the supplied function's declared laws. */
test direct_law { assert declared_law(add_, 2, 3) == 5 }

# GEN-10: none and no matching element are both false.
test empty_any {
    # expect-error(constraint, "requires.unmet")
    assert has_integer() == 7
}
test unmatched_any {
    # expect-error(constraint, "requires.unmet")
    assert has_integer("only", true) == 7
}

# GEN-10: a false existential is the cause of its missing result binding.
test unmatched_binding_any {
    # expect-error(constraint, "requires.unmet")
    let selected = choose(true, 1)
}

test named_inequality_rejects_equal {
    # expect-error(constraint, "requires.unmet")
    assert outside_limit<2>() == 2
}

test supplied_length_is_preserved {
    let pair: list<i64, 2> = [1, 2]
    # expect-error(constraint, "requires.unmet")
    assert arity_left<3>(pair) == 3
}

# GEN-18: invalid law operands reject at declaration, without a call.
# expect-error(type, "type.mismatch")
const fn law_on_value(a: i64) -> i64 requires associative(a) => a
# expect-error(type, "type.mismatch")
const fn law_on_type<T>(a: T) -> T requires commutative(T) => a

# GEN-18: a named function, an anonymous function and missing metadata have no law.
test ordinary_has_no_law {
    # expect-error(constraint, "requires.unmet")
    assert lawful(ordinary, 2, 3) == 5
}
test anonymous_has_no_law {
    # expect-error(constraint, "requires.unmet")
    assert lawful(fn(a, b) => a + b, 2, 3) == 5
}
test undeclared_law {
    # expect-error(constraint, "requires.unmet")
    assert lawful(sub_, 2, 3) == -1
}
test forwarded_absent_law {
    # expect-error(constraint, "requires.unmet")
    assert forward(ordinary, 2, 3) == 5
}
test forwarded_absent_candidate {
    # expect-error(constraint, "requires.unmet")
    assert forward_tree(ordinary, 2, 3) == 5
}
test false_override {
    # expect-error(constraint, "requires.unmet")
    assert lawful{associative: false}(add_, 2, 3) == 5
}


# GEN-7/GEN-18: both candidates are selected under a bool membership.
operator either<V, const law: bool = associative(f)>(f: const fn(V, V) -> V, a: V, b: V) -> V
impl const fn either<V, const law: bool = associative(f)>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires law => f(a, b)
impl const fn either<V, const law: bool = associative(f)>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires !law => f(b, a)
const fn either_forward<V, const law: bool = associative(f)>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires law in {true, false} => either{law: law}(f, a, b)
const fn negative_forward<V>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires !(associative(f)) => either(f, a, b)
const fn negative_bool_forward<V, const enabled: bool>(f: const fn(V, V) -> V, a: V, b: V) -> V
    requires !((enabled)) => either{law: enabled}(f, a, b)
const fn difference(a: i64, b: i64) -> i64 => a - b

/** GEN-3, GEN-7, GEN-18: the forwarded bool membership selects each branch. */
test explicit_bool_membership {
    assert either_forward(add_, 5, 2) == 7
    assert either_forward(difference, 5, 2) == -3
    assert negative_forward(difference, 5, 2) == -3
    assert negative_bool_forward{enabled: false}(difference, 5, 2) == -3
}

# GEN-7/GEN-18 ruling: one law-dependent candidate needs a stated guarantee.
# expect-error(operator, "operator.no_candidate")
const fn missing_guarantee<V>(f: const fn(V, V) -> V, a: V, b: V) -> V => tree(f, a, b)


# GEN-7/GEN-18: the union of two candidates does not admit an unconstrained body.
# expect-error(operator, "operator.no_candidate")
const fn missing_both_guarantees<V>(f: const fn(V, V) -> V, a: V, b: V) -> V => either(f, a, b)

test negative_guarantee_rejects_an_associative_function {
    # expect-error(constraint, "requires.unmet")
    assert negative_forward(add_, 5, 2) == 7
}

# GEN-3, GEN-15: nested grouping preserves the negative bool requirement.
test negative_bool_guarantee_rejects_true {
    # expect-error(constraint, "requires.unmet")
    assert negative_bool_forward{enabled: true}(difference, 5, 2) == -3
}
