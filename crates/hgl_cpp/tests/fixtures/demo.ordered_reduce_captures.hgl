module demo.ordered_reduce_captures

fn digits(values: list<i64>) -> i64 {
    let factor = 2
    return reduce(fn(acc: i64, member: i64) => acc * 10 + member * factor, values, 0)
}

# FN-14 and RED-5: a value capture is held while the fold visits each position.
test an_ordered_fold_captures_a_value {
    assert eval digits(values: [[], [1, 2], delta<list<i64>>(updated: [0: 3])]) ==
        [0, 24, 64]
}

fn scaled(values: list<i64>, scale: i64) -> i64 =>
    reduce(fn(acc: i64, member: i64) => acc + member * scale, values, 0)

# FN-14 and RED-5: the captured connection ticks independently of the list.
test an_ordered_fold_captures_a_connection {
    assert eval scaled(
        values: [
            [1, 2, 3],
            _,
            delta<list<i64>>(updated: [1: 4]),
            delta<list<i64>>(removed: [0]),
            delta<list<i64>>(updated: [0: 2]),
            _,
        ],
        scale: [2, 3, _, 4, _, 5],
    ) == [12, 18, 24, 28, 36, 45]
}

fn biased(values: list<i64>, scale: i64, seed: i64) -> i64 {
    let bias = 7
    return reduce(fn(acc: i64, member: i64) => acc + member * scale + bias, values, seed)
}

# RED-5: either input can change beside the value capture, and the seed gates the fold.
test an_ordered_fold_captures_a_value_and_a_connection {
    assert eval biased(
        values: [[1, 2], _, delta<list<i64>>(updated: [1: 3]), _, []],
        scale: [2, _, 4, _, 5],
        seed: [10, 11, _, 12, _],
    ) == [30, 31, 41, 42, 12]
    assert eval biased(values: [[2], _], scale: [3, _], seed: [_, 10]) == [_, 23]
}

fn count_step(acc: i64, member: i64, scale: i64) -> i64 {
    state visits: i64 = 0
    when {
        visits += 1
        return acc + member * scale + visits
    }
}

fn counted(values: list<i64>, scale: i64) -> i64 =>
    reduce(fn(acc: i64, member: i64) => count_step(acc, member, scale), values, 10)

# RED-2 and RED-5: withdrawal drops callback state, even with a live capture.
test a_returning_member_restarts_its_callback {
    assert eval counted(
        values: [
            [2],
            _,
            delta<list<i64>>(updated: [0: 3]),
            delta<list<i64>>(removed: [0]),
            delta<list<i64>>(updated: [0: 4]),
            _,
        ],
        scale: [2, 3, _, _, 4, 5],
    ) == [15, 18, 22, 10, 27, 32]
}

fn return_capture(values: list<i64>, scale: i64) -> i64 =>
    reduce(fn(acc: i64, member: i64) => scale, values, 0)

# FN-14 and RED-5: the callback may return its captured connection.
test a_callback_can_return_its_capture {
    assert eval return_capture(values: [[1], _, []], scale: [7, 8, _]) == [7, 8, 0]
}
