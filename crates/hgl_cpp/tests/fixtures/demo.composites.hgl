module demo.composites

# Structs, sets, dictionaries and deltas as values, and tests of them, as
# the cpp target writes them (TYPE-3 to TYPE-6, TYPE-14, TYPE-16, EXPR-3,
# ERR-6, CTRL-12).

enum Side { buy, sell = 5 }

# UNIT-6: a struct may name a type declared after it.
struct Line {
    start: Point
    end: Point = Point(x: 1.0)
    class: i64 = 3
    note: str? = null
}

struct Point {
    x: f64
    y: f64 = 0.0
}

struct Book {
    owner: str
    tags: set<str> = []
    prices: dict<str, i64> = []
    side: Side? = null
    points: list<Point> = []
}

struct Box<T> {
    value: T
    count: i64 = 0
}

struct Empty {}

# A struct's generic parameter of an enum's type.
struct Sided<const side: Side> {
    count: i64 = 0
}

# A field of a result whose failure is no `error`.
struct Outcome {
    kept: result<i64, str>
}

struct Flags {
    on: list<bool>
    first: bool
}

# TYPE-3: a struct is a value where an abstract struct it inherits from is
# expected, through any number of parents.
abstract struct Base {
    id: i64
}

abstract struct Shape : Base {
    name: str = "shape"
}

struct Round : Shape {
    radius: f64
}

struct Tagged<T> : Shape {
    tag: T
}

# An abstract struct with an optional field.
abstract struct Noted {
    note: str? = null
}

struct Memo : Noted {}

# A parent's arguments, a list's size among them, given through two levels.
abstract struct Holder<T> {
    value: T
}

abstract struct Sized<const n: i64> : Holder<list<i64, n>> {}

struct Pair : Sized<2> {}

const fn held(holder: Holder<list<i64, 2>>) -> list<i64, 2> => holder.value

# A struct named `std`: the module's C++ names the standard library's
# names from the global namespace.
struct std {
    x: i64
}

# TYPE-4: an optional field's default that is not null, an empty
# collection: a field of a generic struct's and one a parent declares
# among them.
struct Stocked {
    items: list<i64>? = []
    tags: set<str>? = []
    book: dict<str, i64>? = []
    kept: atomic<list<i64>>? = []
}

struct Shelf<T> {
    items: list<T>? = []
}

abstract struct Slot<T> {
    held: T?
}

struct Filled : Slot<list<i64>> {
    held = []
}

# TYPE-16: a nullable's delta is no nullable: a dictionary's value of it,
# and a struct's delta's property for a nullable field.
struct Reading {
    level: i64?
}

const fn look(book: dict<str, delta<i64?>>, key: str) -> delta<i64?>? => get(book, key)

const fn published_null() -> delta<Reading> => delta<Reading>(level: delta<i64?>())

const fn unchanged() -> delta<Reading> => delta<Reading>()

# GEN-4: a candidate of an operator over a struct.
impl const fn add_(lhs: Point, rhs: Point) -> Point => Point(x: lhs.x + rhs.x, y: lhs.y + rhs.y)

const fn origin() -> Point => Point(x: 0.0)

# EXPR-3: a field of a `var` is a place.
const fn moved(point: Point, by: f64) -> Point {
    var next = point
    next.x += by
    next.y = next.y + by
    return next
}

const fn stretched(line: Line, by: f64) -> Line {
    var next = line
    next.end.x += by
    next.class = 4
    return next
}

const fn points() -> list<Point> => [Point(x: 1.0, y: 2.0), Point(x: 3.0)]

# A field of an element of a list a call gives.
const fn first_x() -> f64 => points()[0].x

const fn named(shape: Shape) -> str => shape.name

const fn same(lhs: Shape, rhs: Shape) -> bool => lhs == rhs

const fn as_base(shape: Shape) -> Base => shape

const fn base_id(base: Base) -> i64 => base.id

# TYPE-5: written arguments evaluate once in source order; a field's
# default only where it is left out.
const fn written_order() -> Point {
    var at = 1.0
    return Point(y: {
        at = 2.0
        at
    }, x: at)
}

const fn read_before() -> Point {
    var at = 1.0
    return Point(x: at, y: {
        at = 5.0
        at
    })
}

# EXPR-3: "A key the dictionary has not is added"; a compound assignment
# reads the place first.
const fn counted(words: list<str>) -> dict<str, i64> {
    var counts: dict<str, i64> = []
    for word in words {
        if get(counts, word) == null {
            counts[word] = 1
        } else {
            counts[word] += 1
        }
    }
    return counts
}

const fn bumped(book: dict<str, i64>, key: str) -> dict<str, i64> {
    var changed = book
    changed[key] += 1
    return changed
}

# CTRL-12: a set and a dictionary in no order.
const fn total(book: dict<str, i64>) -> i64 {
    var sum = 0
    for key, value in book {
        sum += value
    }
    return sum
}

const fn size(members: set<f64>) -> i64 {
    var count = 0
    for member in members {
        count += 1
    }
    return count
}

const fn holds(members: set<str>, wanted: str) -> bool {
    for member in members {
        if member == wanted {
            return true
        }
    }
    return false
}

# A set a call gives, looped over: it is held whole for the loop.
const fn tags() -> set<str> => ["a", "b"]

const fn tag_count() -> i64 {
    var count = 0
    for tag in tags() {
        count += 1
    }
    return count
}

# A dictionary changed while it is looped over: the loop runs over what it
# held when it began.
const fn doubled_all(book: dict<str, i64>) -> dict<str, i64> {
    var changed = book
    for key, value in changed {
        changed[key] = value * 2
        changed["extra"] = 0
    }
    return changed
}

# The dictionary a struct holds, read through it.
const fn price_of(book: Book, key: str) -> i64 => book.prices[key]

const fn first_price(books: list<Book>) -> i64 => books[0].prices["a"]

# A field of an element of a dictionary of structs, a place.
const fn moved_in(book: dict<str, Point>) -> dict<str, Point> {
    var changed = book
    changed["a"].x = 9.0
    return changed
}

# TYPE-16: deltas as values, and their properties.
const fn arrived(change: delta<set<str>>) -> set<str> => change.added

const fn joined(name: str) -> delta<set<str>> => delta<set<str>>(added: [name])

const fn cleared() -> delta<f64?> => delta<f64?>()

const fn seven() -> delta<i64?> => delta<i64?>(value: 7)

const fn booked() -> delta<dict<str, i64>> => delta<dict<str, i64>>(updated: ["a": 1], removed: ["b"])

const fn listed() -> delta<list<i64>> => delta<list<i64>>(updated: [0: 4], removed: [1])

const fn nudged() -> delta<Point> => delta<Point>(x: 1.0)

# A list's delta whose properties are held in the order written, one
# running statements.
const fn listed_in_order() -> delta<list<i64>> {
    var at = 0
    return delta<list<i64>>(removed: [at], updated: [{
        at = 2
        at
    }: 9])
}

const fn pair_change() -> delta<tuple<f64, i64>> => (1.0, null)

# TYPE-7: an enum's member made from its number or its name.
const fn side_of(number: i64) -> Side => Side(number)

const fn side_named(name: str) -> Side => Side(name)

# TYPE-2: a zone and a time of day in it.
const fn london() -> timezone => @[Europe/London]

const fn opening() -> zoned_time => @09:30[Europe/London]

# TYPE-14: a `T?` compared with a `T`.
const fn is_one(value: i64?) -> bool => value == 1

# FN-15: a `var` parameter's place beside an argument that runs
# statements: the place is taken where the call is made.
const fn bump(var count: i64, by: i64) {
    count = by
}

const fn bump_after_growth() -> list<i64> {
    var items = [10]
    bump(items[0], {
        items = [20, 30]
        1
    })
    return items
}

# Core's OPS-6: a list of structs as a list of their parent.
const fn as_shapes(rounds: list<Round>) -> list<Shape> => convert<list<Shape>>(rounds)

test structs_are_values {
    let point = Point(y: 2.0, x: 1.0)
    assert point.x == 1.0 && point.y == 2.0
    assert origin() == Point(x: 0.0, y: 0.0)
    assert moved(point, 1.5) == Point(x: 2.5, y: 3.5)
    assert point == Point(x: 1.0, y: 2.0)
    assert point + Point(x: 3.0) == Point(x: 4.0, y: 2.0)
    assert first_x() == 1.0
    assert Empty() == Empty()
    assert Outcome(kept: ok(1)) == Outcome(kept: ok(1))
    assert Outcome(kept: err("no")) != Outcome(kept: ok(1))
    assert Sided<Side.sell>(count: 2).count == 2
}

test fields_default_and_nest {
    let line = Line(start: origin())
    assert line.end == Point(x: 1.0, y: 0.0)
    assert line.class == 3
    assert line.note == null
    let longer = stretched(line, 2.0)
    assert longer.end.x == 3.0 && longer.class == 4
    assert line.end.x == 1.0
    assert Line(start: origin(), note: "n").note != null
}

test a_struct_holding_nan_is_not_equal_to_itself {
    let odd = Point(x: 0.0 / 0.0)
    assert odd != odd
    assert [odd] != [odd]
}

test generic_and_abstract_structs {
    assert Box(value: 3) == Box(value: 3, count: 0)
    assert Box(value: "a").count == 0
    let round = Round(id: 1, radius: 2.0)
    assert named(round) == "shape"
    assert same(round, Round(id: 1, radius: 2.0))
    assert !same(round, Round(id: 2, radius: 2.0))
    assert !same(Tagged(id: 1, tag: 1), Tagged(id: 1, tag: 1.0))
    assert !same(round, Tagged(id: 1, tag: 2.0))
    assert base_id(as_base(round)) == 1
    assert base_id(round) == 1
    assert as_shapes([round])[0].name == "shape"
    assert held(Pair(value: [1, 2])) == [1, 2]
}

test arguments_are_evaluated_in_the_order_written {
    assert written_order() == Point(x: 2.0, y: 2.0)
    assert read_before() == Point(x: 1.0, y: 5.0)
}

test sets_have_no_order {
    let made: set<i64> = [3, 1, 2]
    assert made == [1, 2, 3]
    assert made != [1, 2]
    let empty: set<str> = []
    assert empty == []
    assert size([0.0, -0.0, 1.0]) == 2
    let books: set<Point> = [Point(x: 1.0), Point(x: 1.0, y: 0.0)]
    assert books == [Point(x: 1.0)]
    assert holds(["a", "b"], "b") && !holds(["a"], "b")
    assert tag_count() == 2
}

test dictionaries_read_add_and_loop {
    let book: dict<str, i64> = ["a": 1, "b": 2]
    assert book["a"] == 1
    assert book == ["b": 2, "a": 1]
    assert get(book, "c") == null
    let found: i64? = get(book, "b")
    assert found == 2
    # ERR-6: a strict read distinguishes a held null from an absent key.
    let maybes: dict<str, i64?> = ["a": null, "b": 2]
    assert maybes["a"] == null && maybes["b"] == 2
    assert raises("value.missing_key") { let absent = maybes["c"] }
    assert total(book) == 3
    assert counted(["x", "y", "x"]) == ["x": 2, "y": 1]
    assert bumped(book, "b") == ["a": 1, "b": 3]
    assert doubled_all(["a": 1]) == ["a": 2, "extra": 0]
    let shelf = Book(owner: "o", prices: ["a": 5])
    assert price_of(shelf, "a") == 5
    assert first_price([shelf]) == 5
    assert moved_in(["a": Point(x: 1.0)]) == ["a": Point(x: 9.0)]
    let odd: dict<str, f64> = ["n": 0.0 / 0.0]
    assert odd != odd
}

test a_missing_key_fails {
    let book: dict<str, i64> = ["a": 1]
    assert raises("value.missing_key") {
        let none = book["b"]
    }
    assert raises("value.missing_key") {
        let more = bumped(book, "b")
    }
}

const fn failing() -> i64 => [1][5]

# EXPR-3: the key is added where the value is assigned; a value that
# fails adds none.
test a_failing_value_adds_no_key {
    var book: dict<str, i64> = ["a": 1]
    assert raises("value.index_out_of_range") {
        book["b"] = failing()
    }
    assert book == ["a": 1]
    var rows: list<dict<str, i64>> = [["a": 1]]
    assert raises("value.index_out_of_range") {
        rows[0]["b"] = {
            let none = 0
            failing()
        }
    }
    assert rows == [["a": 1]]
}

# EXPR-2: a dictionary's place is checked before its key is evaluated.
test a_dictionarys_place_comes_before_its_key {
    var rows: list<dict<str, i64>> = [["a": 1]]
    var seen = 0
    assert raises("value.index_out_of_range") {
        rows[5][{
            seen = 1
            "b"
        }] = 1
    }
    assert seen == 0
    let names: dict<str, str> = ["a": "b"]
    assert raises("value.index_out_of_range") {
        rows[5][names["missing"]] = 1
    }
    rows[0][names["a"]] = 2
    assert rows == [["a": 1, "b": 2]]
}

test deltas_are_values {
    assert arrived(joined("a")) == ["a"]
    assert joined("a").removed == []
    assert cleared().value == null
    assert seven().value == 7
    assert booked().updated == ["a": 1]
    assert booked().removed == ["b"]
    assert listed().updated == [0: 4]
    assert listed().removed == [1]
    assert listed().size_modified == null
    assert listed_in_order().removed == [0] && listed_in_order().updated == [2: 9]
    assert nudged().x == 1.0
    assert nudged().y == null
    assert pair_change() == (1.0, null)
}

test enums_zones_and_nullables {
    assert side_of(5) == Side.sell
    assert side_named("buy") == Side.buy
    assert london() == @[Europe/London]
    assert opening() == @09:30[Europe/London]
    assert opening() != @09:30[UTC]
    assert is_one(1)
    # The left operand runs first, and replaces what the right one reads.
    var noted: Noted = Memo(note: "a")
    assert {
        noted = Memo(note: "b")
        "b"
    } == noted.note
    assert !is_one(2)
    assert !is_one(null)
}

# An element of a `list<bool>` is held as the `bool` it was when it was
# read, before a later field's block changes the list.
test bits_are_held_as_they_were_read {
    var on = [true, false]
    let made = Flags(first: on[1], on: {
        on[1] = true
        on
    })
    assert !made.first && made.on == [true, true]
    let members: set<bool> = [true, false, true]
    assert members == [false, true]
}

test a_var_place_is_taken_where_the_call_is_made {
    assert bump_after_growth() == [1, 30]
    # EXPR-2: the list's place is checked before a later index runs.
    var rows = [[1]]
    var seen = 0
    assert raises("value.index_out_of_range") {
        bump(rows[5][{
            seen = 1
            0
        }], 1)
    }
    assert seen == 0
}

test a_nullable_delta_is_no_nullable {
    let book: dict<str, delta<i64?>> = ["a": delta<i64?>()]
    assert get(book, "a") != null
    assert look(book, "a") == delta<i64?>()
    assert look(book, "missing") == null
    assert published_null().level != null
    assert unchanged().level == null
    assert published_null().level == delta<i64?>()
    assert unchanged().level != delta<i64?>()
    assert delta<Reading>(level: delta<i64?>(value: 2)).level == delta<i64?>(value: 2)
    # Each side is held, in the order written, where one runs statements.
    var reads = 0
    assert {
        reads += 1
        published_null().level
    } == delta<i64?>()
    assert unchanged().level != {
        reads += 1
        delta<i64?>()
    }
    assert reads == 2
}

test an_empty_default_of_an_optional_collection_is_the_collection {
    assert Stocked().items != null && Stocked().tags != null && Stocked().book != null
    assert Stocked().kept != null
    assert Shelf<i64>().items != null
    assert Filled().held != null
    assert std(x: 2).x == 2
}
