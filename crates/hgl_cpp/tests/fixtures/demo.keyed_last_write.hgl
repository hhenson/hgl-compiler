module demo.keyed_last_write

fn rewrite_new(step: i64) -> dict<i64, i64> {
    inject out
    when {
        if step == 1 { return [1: 10] }
        if step == 2 {
            out = delta<dict<i64, i64>>(updated: [7: 1])
            out = delta<dict<i64, i64>>(removed: [7])
            out = delta<dict<i64, i64>>(updated: [7: 2])
        }
    }
}

fn rewrite_held(step: i64) -> dict<i64, i64> {
    inject out
    when {
        if step == 1 { return [1: 10] }
        if step == 2 {
            out = delta<dict<i64, i64>>(removed: [1])
            out = delta<dict<i64, i64>>(updated: [1: 11])
            out = delta<dict<i64, i64>>(removed: [1])
            out = delta<dict<i64, i64>>(updated: [1: 12])
        }
    }
}

fn relay(book: dict<i64, i64>) -> dict<i64, i64> {
    when { return delta_value(book) }
}

fn relay_new(step: i64) -> dict<i64, i64> => relay(rewrite_new(step))
fn relay_held(step: i64) -> dict<i64, i64> => relay(rewrite_held(step))

# TIME-7: the delta and its consumer see the new key's final value.
test last_write_of_a_new_key_is_published {
    assert eval rewrite_new(step: [1, 2]) == [[1: 10], delta<dict<i64, i64>>(updated: [7: 2])]
    assert eval relay_new(step: [1, 2]) == [[1: 10], delta<dict<i64, i64>>(updated: [7: 2])]
}

# TIME-7: a held key cleared and written twice publishes its final value.
test last_write_of_a_held_key_is_published {
    assert eval rewrite_held(step: [1, 2]) == [[1: 10], delta<dict<i64, i64>>(updated: [1: 12])]
    assert eval relay_held(step: [1, 2]) == [[1: 10], delta<dict<i64, i64>>(updated: [1: 12])]
}

fn dictionary_controls(step: i64) -> dict<i64, i64> {
    inject out
    when {
        if step == 1 { return [1: 10, 2: 20] }
        if step == 2 { return delta<dict<i64, i64>>(updated: [7: 2]) }
        if step == 3 {
            out = delta<dict<i64, i64>>(updated: [8: 3])
            out = delta<dict<i64, i64>>(updated: [9: 4])
        }
        if step == 4 {
            out = delta<dict<i64, i64>>(removed: [2])
            out = delta<dict<i64, i64>>(updated: [2: 21])
        }
    }
}

fn set_control(step: i64) -> set<i64> {
    inject out
    when {
        if step == 1 { return [1] }
        if step == 2 {
            out = delta<set<i64>>(added: [7])
            out = delta<set<i64>>(removed: [7])
            out = delta<set<i64>>(added: [7])
        }
    }
}

# TIME-7: publish distinct dictionary updates and the final value of a restored key.
test dictionary_controls_publish_their_changes {
    assert eval dictionary_controls(step: [1, 2, 3, 4]) == [
        [1: 10, 2: 20],
        delta<dict<i64, i64>>(updated: [7: 2]),
        delta<dict<i64, i64>>(updated: [8: 3, 9: 4]),
        delta<dict<i64, i64>>(updated: [2: 21]),
    ]
}

# TIME-7: a set member added again after removal appears in the final delta.
test set_control_publishes_the_last_addition {
    assert eval set_control(step: [1, 2]) == [[1], delta<set<i64>>(added: [7])]
}
