module examples.pack_forms

# The FN-19 example from functions-and-phases, with executable cases below.

const fn squares(n: i64) -> list<i64> => [for i in 0..<n: i * i]

const fn below(n: i64) -> i64 {
    var sum = 0
    for i in 0..<n { sum += i }
    return sum
}

fn doubled(prices: list<f64, 3>) -> list<f64, 3> => [for i in 0..<3: prices[i] * 2.0]

fn scaled(price: f64, factor: f64) -> f64 => price * factor

fn passed_on<R, ...Ps, ...As>(f: fn(...{Ps}) -> R, args: ...{As for f}) -> R
    requires each arg in arg_keys(As) { As[arg] == Ps[arg] }
{
    let given = {for arg in arg_keys(Ps): args[arg]}
    return f(...given)
}

fn tagged<R, ...Ps, ...As, const key: str = "key">(
    f: fn(...{Ps}) -> R,
    args: ...{As for f without key},
) -> R {
    let given = {for arg in arg_keys(Ps):
        if arg == key { "fixed" } else if arg in arg_keys(As) { args[arg] }}
    return f(...given)
}

fn weighted(price: f64, weight: f64 = 1.0) -> f64 => price * weight

fn labelled(key: str, price: f64) -> str => key

fn total(scale: f64, values: ...f64) -> f64 {
    when {
        var sum = 0.0
        for value in values { sum += value }
        return sum * scale
    }
}

fn one(price: f64, factor: f64) -> f64 => passed_on(scaled, price, factor)

fn two(price: f64) -> str => tagged(labelled, price)

fn four(price: f64) -> f64 => tagged(weighted, price)

fn three(a: f64, b: f64) -> f64 => passed_on(total, 2.0, a, b)

test range_forms {
    assert squares(4) == [0, 1, 4, 9]
    let empty: list<i64> = []
    assert squares(0) == empty
    assert below(4) == 6
    assert eval doubled(prices: [[2.0, 3.0, 4.0]]) == [[4.0, 6.0, 8.0]]
}

test a_bound_pack_forwards_to_a_graph_or_node {
    assert eval one(price: [2.0], factor: [3.0]) == [6.0]
    assert eval two(price: [2.0, 3.0]) == ["fixed"]
    assert eval three(a: [2.0], b: [3.0]) == [10.0]
    assert eval four(price: [2.0, 3.0]) == [2.0, 3.0]
}

struct Point {
    x: i64
    y: i64
}

const fn construct<...A>(args: ...{A}) -> Point {
    let fields = {for key in arg_keys(A): args[key] + 1}
    return Point(...fields)
}

const fn combine(a: i64, b: i64, c: i64) -> i64 => a * 100 + b * 10 + c

const fn bind_separately<...A>(args: ...A) -> i64 {
    let first = {for key in arg_keys(A): if key == 0 { args[key] }}
    let rest = {for key in arg_keys(A): if key == 1 { args[key] }}
    let explicit = first[0] + rest[1]
    return combine(...first, ...rest, b: explicit)
}

const fn bind_once<...A>(args: ...A) -> i64 {
    var count = 0
    let given = {for key in arg_keys(A): if key >= 0 {
        count += 1
        args[key]
    }}
    let again = given
    let first = again[0]
    return combine(...again, c: count + first)
}

test a_bound_pack_can_be_indexed_and_spread {
    let p = construct(y: 5, x: 2)
    assert p.x == 3
    assert p.y == 6
    assert bind_separately(2, 5) == 275
    assert bind_once(2, 5) == 254
}

const fn duplicate<...A>(args: ...{A}) -> i64 {
    let given = {for key in arg_keys(A): args[key]}
    return combine(...given, a: 9)
}

const fn missing<...A>(args: ...A) -> i64 {
    let given = {for key in arg_keys(A): if key == 0 { args[key] }}
    return given[1]
}

test a_written_argument_cannot_also_be_spread {
    # expect-error(name, "argument.duplicate")
    assert duplicate(a: 1, b: 2, c: 3) == 0
}

test a_skipped_entry_has_no_key {
    # expect-error(type, "pack.name")
    assert missing(1, 2) == 0
}

const fn rebind_homogeneous(values: ...i64) -> i64 {
    let given = values
    return combine(...given, c: 0)
}

const fn rebind_reflected<...A>(values: ...A) -> i64 {
    let given = values
    let again = given
    return combine(...again, c: 0) + again[0]
}

test binding_an_existing_pack_keeps_its_entries {
    assert rebind_homogeneous(1, 2) == 120
    assert rebind_reflected(1, 2) == 121
}

fn graph_accumulate(values: ...i64) -> i64 {
    let given = values
    var sum = given[0]
    for value in given { sum = sum + value }
    return sum
}

test a_graph_pack_loop_carries_a_connection {
    assert eval graph_accumulate([1, 3], [2, 4]) == [4, 10]
}

const fn call_local(f: const fn() -> i64) -> i64 => f()

const fn selected_if_has_context<...A>(items: ...A) -> i64 {
    let given = {for key in arg_keys(A): call_local(fn() {
        let value: i64? = if key == 1 { 5 }
        return if value == null { 3 } else { 4 }
    })}
    return combine(...given)
}

const fn selected_if_lacks_context<...A>(items: ...A) -> i64 {
    let given = {for key in arg_keys(A): call_local(fn() {
        let value = if key == 1 { 5 }
        return if value == null { 3 } else { 4 }
    })}
    return combine(...given)
}

test an_unselected_if_needs_a_nullable_place {
    assert selected_if_has_context(0, 0, 0) == 343
}

test an_unselected_if_cannot_infer_its_type {
    # expect-error(type, "null.context_type")
    assert selected_if_lacks_context(0, 0, 0) == 0
}

# expect-error(type, "type.mismatch")
const fn not_a_runtime_value(items: ...i64) -> str => items

const fn list_entry(values: list<i64>) -> i64 => values[0]

const fn pack_has_no_ordinary_annotation(items: ...i64) -> i64 {
    # expect-error(type, "type.mismatch")
    let text: str = items
    return 0
}

# expect-error(type, "type.mismatch")
const fn pack_entry_keeps_its_type(items: ...i64) -> str => items[0]

# expect-error(type, "type.mismatch")
const fn pack_is_not_a_list_argument(items: ...i64) -> i64 => list_entry(items)

# expect-error(type, "type.mismatch")
const fn pack_is_not_a_list_result(items: ...i64) -> list<i64> => items

# expect-error(type, "type.mismatch")
const fn pack_key_must_be_constant(key: i64, items: ...i64) -> i64 => items[key]

# expect-error(type, "type.mismatch")
const fn named_pack_is_not_a_bool<...A>(items: ...{A}) -> bool => items
