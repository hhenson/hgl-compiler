module demo.written_pack_types

# GEN-8 and GEN-17: a call writes a type under a reflected pack key.

const item_key: str = "item"
const missing_key: str = "missing"
const fn num(item: i64) -> i64 => item
const fn words(item: str) -> i64 => 0
const fn extra(other: i64) -> i64 => other
const fn identity<T>(value: T) -> T => value
const fn one<T>() -> i64 => 1

const fn reflected<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] =>
    identity<Ps[item_key]>(item)

const fn nested<...Ps>(f: const fn(...{Ps}) -> i64, items: list<Ps[item_key]>) -> list<Ps[item_key]> =>
    identity<list<Ps[item_key]>>(items)

const fn chosen<const key: str, ...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[key]) -> Ps[key] =>
    identity<Ps[key]>(item)

fn reflected_graph<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] =>
    identity<Ps[item_key]>(item)

fn reflected_graph_i64(item: i64) -> i64 => reflected_graph(num, item)

const fn missing<...Ps>(f: const fn(...{Ps}) -> i64) -> i64 => one<Ps[missing_key]>()

test direct_and_nested_type_arguments {
    assert reflected(num, 7) == 7
    assert reflected(words, "value") == "value"
    assert nested(num, [2, 4]) == [2, 4]
    assert chosen<"other">(extra, 5) == 5
}

test reflected_type_argument_on_a_connection {
    assert eval reflected_graph_i64([2, 3]) == [2, 3]
}

# GEN-7, GEN-8 and GEN-17: the operator selects from the enclosing pack's
# actual member type, whether the call writes the type or infers it.
operator select_member<T>(value: T) -> T
impl const fn select_member<T>(value: T) -> T => value
impl const fn select_member(value: i64) -> i64 => value + 1

const fn explicit_member<const key: str, ...Ps>(
    f: const fn(...{Ps}) -> i64, item: Ps[key]
) -> Ps[key] => select_member<Ps[key]>(item)

const fn inferred_member<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] =>
    select_member(item)

# A single generic candidate still needs the member type at instantiation.
operator pick<T>(value: T) -> T
impl const fn pick<T>(value: T) -> T => value

const fn explicit_pick<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] =>
    pick<Ps[item_key]>(item)

const fn inferred_pick<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] =>
    pick(item)

test operator_reflected_member_types {
    assert explicit_member<"other">(extra, 7) == 8
    assert explicit_member<"item">(words, "text") == "text"
    assert inferred_member(num, 8) == 9
    assert inferred_member(words, "value") == "value"
    assert explicit_pick(num, 10) == 10
    assert inferred_pick(num, 11) == 11
}

# GEN-3 and GEN-7: a member's equality or finite membership makes
# an arithmetic candidate known before a concrete instance supplies it.
const fn real_item(item: f64) -> i64 => 0
const fn add_integer<...Ps>(
    f: const fn(...{Ps}) -> i64, a: Ps[item_key], b: Ps[item_key]
) -> Ps[item_key] requires Ps[item_key] == i64 => a + b

const fn add_number<const key: str, ...Ps>(
    f: const fn(...{Ps}) -> i64, a: Ps[key], b: Ps[key]
) -> Ps[key] requires Ps[key] in {i64, f64} => a + b

const fn add_member_bound<T, ...Ps>(
    f: const fn(...{Ps}) -> i64, t: T, a: Ps[item_key]
) -> Ps[item_key] requires Ps[item_key] == T && Ps[item_key] in {i64, f64} => a + a

const fn add_parameter_bound<T, ...Ps>(
    f: const fn(...{Ps}) -> i64, t: T, a: Ps[item_key]
) -> Ps[item_key] requires T in {i64, f64} && Ps[item_key] == T => a + a

const fn chained_arithmetic<...Ps>(f: const fn(...{Ps}) -> i64, a: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {i64, f64} => (a + a) * a

const fn arithmetic_via_local<...Ps>(f: const fn(...{Ps}) -> i64, a: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {i64, f64} {
    let difference = a - a
    return difference - a
}

test reflected_member_arithmetic {
    assert add_integer(num, 2, 3) == 5
    assert add_number<"item">(num, 3, 4) == 7
    assert add_number<"item">(real_item, 1.5, 2.5) == 4.0
    assert add_member_bound(num, 0, 3) == 6
    assert add_member_bound(real_item, 0.0, 1.5) == 3.0
    assert add_parameter_bound(num, 0, 4) == 8
    assert add_parameter_bound(real_item, 0.0, 2.5) == 5.0
    assert chained_arithmetic(num, 3) == 18
    assert chained_arithmetic(real_item, 1.5) == 4.5
    assert arithmetic_via_local(num, 5) == -5
    assert arithmetic_via_local(real_item, 2.5) == -2.5
}

fn operator_graph<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] =>
    select_member<Ps[item_key]>(item)

fn operator_graph_i64(item: i64) -> i64 => operator_graph(num, item)

test operator_reflected_member_on_a_connection {
    assert eval operator_graph_i64([2, 3]) == [3, 4]
}

test unknown_written_member {
    # expect-error(type, "pack.name")
    assert missing(num) == 1
}

# GEN-3 and GEN-7: the generic body needs evidence for the reflected type.
const fn exact<T>(value: T) -> T requires T == i64 => value
const fn exact_list<T>(value: T) -> T requires T == list<i64, 2> => value

struct Boxed<const N: i64> {
    items: list<i64, N>
}

const fn exact_box<T>(value: T) -> T requires T == tuple<Boxed<2>, str> => value
const fn pair(item: list<i64, 2>) -> i64 => item[0] + item[1]
const fn boxed_shape(item: tuple<Boxed<2>, str>) -> i64 => 0
const fn known<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] requires i64 == Ps[item_key] =>
    exact<Ps[item_key]>(item)

const fn fixed_key<const key: str, ...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[key]) -> Ps[key]
    requires key == "item" && Ps[key] == i64 => exact<Ps[key]>(item)

test a_stated_member_type_admits_the_call {
    assert known(num, 8) == 8
    assert fixed_key<"item">(num, 9) == 9
}

# expect-error(constraint, "requires.unmet")
const fn unstated<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] => exact<Ps[item_key]>(item)

test a_false_member_constraint_rejects {
    # expect-error(constraint, "requires.unmet")
    assert known(words, "value") == "value"
}

# GEN-3, GEN-7 and GEN-17: a member's stated key and type use the same bindings.
const fn sized_member<const N: i64, ...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires N == 2 && Ps[item_key] == list<i64, N> => exact_list<Ps[item_key]>(item)

const fn fixed_default<const key: str = "item", const N: i64 = 2, ...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[key]) -> Ps[key]
    requires key == "item" && N == 2 && Ps[key] == list<i64, N> => exact_list<Ps[key]>(item)

const fn nested_value<const N: i64, ...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires N == 2 && Ps[item_key] == tuple<Boxed<N>, str> => exact_box<Ps[item_key]>(item)

const fn member_of_finite_sizes<const N: i64, ...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires N in {2} && Ps[item_key] == list<i64, N> => exact_list<Ps[item_key]>(item)

test stated_member_types_use_bound_values {
    assert sized_member<2>(pair, [2, 3]) == [2, 3]
    assert fixed_default(pair, [4, 5]) == [4, 5]
    let boxed = Boxed<2>(items: [1, 6])
    assert nested_value<2>(boxed_shape, (boxed, "tag")) == (boxed, "tag")
    assert member_of_finite_sizes<2>(pair, [7, 9]) == [7, 9]
}

# GEN-8: a caller can override a default, so it proves no requirement in the body.
# expect-error(constraint, "requires.unmet")
const fn unconstrained_default<const N: i64 = 2, ...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] requires Ps[item_key] == list<i64, N> => exact_list<Ps[item_key]>(item)

# GEN-10 and GEN-17: an equality over each key proves the type at any known key.
const fn every_integer<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires each key in arg_keys(Ps) { i64 == Ps[key] } => exact<Ps[item_key]>(item)

const fn every_sized<const N: i64, ...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires N == 2 && each key in arg_keys(Ps) { Ps[key] == list<i64, N> } => exact_list<Ps[item_key]>(item)

const fn exact_number<T>(value: T) -> T requires T in {i64, f64} => value

const fn either_number<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {i64, f64} => exact_number<Ps[item_key]>(item)

const fn every_number<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires each key in arg_keys(Ps) { Ps[key] in {i64, f64} } => exact_number<Ps[item_key]>(item) + item

const fn narrowed_wide_first<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {str, f64} && Ps[item_key] in {f64} => exact_number<Ps[item_key]>(item)

const fn narrowed_narrow_first<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {f64} && Ps[item_key] in {str, f64} => exact_number<Ps[item_key]>(item)

const fn narrowed_each_first<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires each key in arg_keys(Ps) { Ps[key] in {str, f64} } && Ps[item_key] in {f64}
    => exact_number<Ps[item_key]>(item) + item

const fn narrowed_key_first<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {f64} && each key in arg_keys(Ps) { Ps[key] in {str, f64} }
    => exact_number<Ps[item_key]>(item) + item

const fn narrowed_delta_either_first<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {delta<T>, f64} && Ps[item_key] in {i64, f64} => exact_number<Ps[item_key]>(item)

const fn narrowed_delta_either_second<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {i64, f64} && Ps[item_key] in {delta<T>, f64} => exact_number<Ps[item_key]>(item)

const fn exact_str<T>(value: T) -> T requires T == str => value

const fn narrowed_disjoint_list_delta_first<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {list<delta<T>>, f64} && Ps[item_key] in {str, f64} => exact_number<Ps[item_key]>(item)

const fn narrowed_disjoint_list_delta_second<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {str, f64} && Ps[item_key] in {list<delta<T>>, f64} => exact_number<Ps[item_key]>(item)

# TYPE-16, GEN-7: the nullable's delta keeps the inner list delta's identity.
const fn nested_nullable_delta<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {list<T>, str} && Ps[item_key] in {delta<delta<list<i64>>?>, str} => exact_str<Ps[item_key]>(item)

# GEN-3, GEN-7, GEN-17: only f64 satisfies both memberships and the equality.
const fn overlap_member<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires T in {i64, f64} && Ps[item_key] == T && Ps[item_key] in {str, f64}
    => exact_number<Ps[item_key]>(item) - item

const fn float_only<T>(value: T) -> T requires T == f64 => value

const fn overlap_parameter<T, ...Ps>(f: const fn(...{Ps}) -> i64, value: T) -> T
    requires Ps[item_key] in {str, f64} && T in {f64, i64} && T == Ps[item_key]
    => float_only<T>(value)

const fn shared_parameter<T, U, ...Ps>(f: const fn(...{Ps}) -> i64, value: T, other: U) -> T
    requires T in {i64, f64} && U in {str, f64} && T == Ps[item_key] && U == Ps[item_key]
    => float_only<T>(value)

const fn narrowed_disjoint_atomic_opt_first<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {atomic<T?>, str} && Ps[item_key] in {i64, str} => exact_str<Ps[item_key]>(item)

const fn narrowed_disjoint_atomic_opt_second<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {i64, str} && Ps[item_key] in {atomic<T?>, str} => exact_str<Ps[item_key]>(item)

# GEN-3, GEN-5, GEN-7, GEN-17: two open memberships imply the same T.
const fn require_same<A, B>(a: A, b: B) -> A requires A == B => a

operator select_same<A, B>(a: A, b: B) -> A
impl const fn select_same<X>(a: X, b: X) -> X => b
impl const fn select_same(a: i64, b: i64) -> i64 => a + b

const fn open_member_fn<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires Ps[item_key] in {T, str} && Ps[item_key] in {T, f64}
    => require_same<Ps[item_key], T>(item, t)

const fn open_member_op<T, ...Ps>(f: const fn(...{Ps}) -> i64, t: T, item: Ps[item_key]) -> Ps[item_key]
    requires each k in arg_keys(Ps) { Ps[k] in {T, f64} } && Ps[item_key] in {T, str}
    => select_same(item, t)

test each_proves_the_member_type {
    assert open_member_fn(words, "first", "second") == "second"
    assert open_member_fn(real_item, 1.5, 3.5) == 3.5
    assert open_member_op(words, "first", "second") == "first"
    assert open_member_op(num, 5, 7) == 12
    assert every_integer(num, 11) == 11
    assert every_sized<2>(pair, [3, 4]) == [3, 4]
    assert either_number(num, 11) == 11
    assert either_number(real_item, 1.5) == 1.5
    assert every_number(num, 12) == 24
    assert every_number(real_item, 2.5) == 5.0
    assert narrowed_wide_first(real_item, 1.5) == 1.5
    assert narrowed_narrow_first(real_item, 1.5) == 1.5
    assert narrowed_each_first(real_item, 2.5) == 5.0
    assert narrowed_key_first(real_item, 2.5) == 5.0
    assert narrowed_delta_either_first(num, 2, 3) == 3
    assert narrowed_delta_either_first(real_item, 2, 1.5) == 1.5
    assert narrowed_delta_either_second(num, 2, 3) == 3
    assert narrowed_delta_either_second(real_item, 2, 1.5) == 1.5
    assert narrowed_disjoint_list_delta_first(real_item, 2, 1.5) == 1.5
    assert narrowed_disjoint_list_delta_second(real_item, 2, 1.5) == 1.5
    assert nested_nullable_delta(words, 2, "nested") == "nested"
    assert overlap_member(real_item, 1.5, 3.5) == 0.0
    assert overlap_parameter(real_item, 3.5) == 3.5
    assert shared_parameter(real_item, 1.5, 3.5) == 1.5
    assert narrowed_disjoint_atomic_opt_first(words, 2, "ok") == "ok"
    assert narrowed_disjoint_atomic_opt_second(words, 2, "ok") == "ok"
}

test a_nonmatching_member_rejects_the_universal_requirement {
    # expect-error(constraint, "requires.unmet")
    assert every_integer(words, "value") == "value"
}

# A known false requirement still rejects in the presence of an existential.
# expect-error(constraint, "requires.unmet")
const fn known_false<...Ps>(f: const fn(...{Ps}) -> i64, item: Ps[item_key]) -> Ps[item_key] requires Ps[item_key] == str && any key in arg_keys(Ps) { Ps[key] == i64 } => exact<Ps[item_key]>(item)

# GEN-3, GEN-10 and GEN-17: the concrete named and positional keys
# specialize nominal value arguments when the call checks its requirement.
struct NamedField<const Key: str> { value: i64 }
struct IndexedField<const Index: i64> { value: i64 }
const fn named_field(item: NamedField<item_key>) -> i64 => item.value
const fn check_named<...Ps>(f: const fn(...{Ps}) -> i64) -> bool
    requires each k in arg_keys(Ps) { Ps[k] == NamedField<k> } => true
const fn check_positions<...Ps>(fields: ...Ps) -> bool
    requires each k in arg_keys(Ps) { Ps[k] in {IndexedField<k>} } => true

test concrete_keys_supply_nominal_arguments_at_the_call {
    assert check_named(named_field)
    assert check_positions(IndexedField<0>(value: 4), IndexedField<1>(value: 8))
}
