module demo.store.nullable

# A present null succeeds in the explicitly typed store result (CAP-6).
fn stored_nullable(value: i64?) -> bool {
    inject global_state
    when {
        let missing: result<i64?, error> = get<i64?>(global_state, "missing")
        put(global_state, "nullable", value)
        let saved: result<i64?, error> = get<i64?>(global_state, "nullable")
        return is_err(missing) && is_ok(saved) && saved.value == null
    }
}

test a_written_null_is_a_success {
    assert eval stored_nullable(value: [null, 7]) == [true, false]
}

# GEN-2 and GEN-8: the key does not supply the result's type parameter.
test an_unwritten_store_read_rejects {
    fn inferred_read(value: i64?) -> bool {
        inject global_state
        when {
            put(global_state, "k", value)
            # expect-error(type, "generic.unresolved")
            let saved: i64? = get(global_state, "k")
            return saved == null
        }
    }
    assert eval inferred_read(value: [7]) == [false]
}
