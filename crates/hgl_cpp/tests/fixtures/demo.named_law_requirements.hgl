module demo.named_law_requirements

# GEN-16, UNIT-10: these names resolve to the user's operators.
operator associative<T>(x: T) -> bool
impl const fn associative(x: i64) -> bool => x > 0
operator commutative<T>(x: T) -> bool
impl const fn commutative(x: i64) -> bool => x > 0

const fn by_name<V>(x: V) -> bool requires associative(V) => associative(x)
const fn by_arrow<V>(x: V) -> bool requires commutative(V) -> bool => commutative(x)

operator retained<V>(x: V) -> bool
impl const fn retained<V>(x: V) -> bool
    requires associative(V) && commutative(V) => associative(x) && commutative(x)

/** GEN-16, UNIT-10: callability is independent of the operator's bool result. */
test named_requirements {
    assert by_name(1)
    assert !by_name(-1)
    assert by_arrow(2)
    assert !by_arrow(-2)
    assert retained(3)
    assert !retained(-3)
}

test missing_function_requirement {
    # expect-error(constraint, "requires.unmet")
    assert by_name("no candidate")
}

test missing_candidate_requirement {
    # expect-error(operator, "operator.no_candidate")
    assert retained("no candidate")
}
