module demo.categories

struct Point {
    x: f64
    y: f64
}

struct Label {
    text: str
}

operator shown<T>(value: T) -> str
impl const fn shown<T>(value: T) -> str requires T in struct => "a struct"
impl const fn shown(value: Point) -> str => "a point"
impl const fn shown<...Ts>(value: tuple<Ts>) -> str => "a tuple"

test selection {
    assert shown(Label(text: "a")) == "a struct"
    assert shown(Point(x: 1.0, y: 2.0)) == "a point"
    assert shown((1, "a")) == "a tuple"
}

# GEN-3: enum membership is distinct from struct membership.
enum Tag { first, second }
operator kind<T>(value: T) -> str
impl const fn kind<T>(value: T) -> str requires T in enum => "enum"
impl const fn kind<T>(value: T) -> str requires T in struct => "struct"
test nominal_categories {
    assert kind(Tag.first) == "enum"
    assert kind(Label(text: "a")) == "struct"
}

# GEN-10: ordinary specialization and an independently typed callback
# retain the whole tuple sequence, with no extra tuple nesting.
const fn echo<...Ts>(value: tuple<Ts>) -> tuple<Ts> => value
const fn forward<...Us>(value: tuple<Us>) -> tuple<Us> => echo(value)
const fn suffix<...Us>(value: tuple<Us, str>) -> tuple<Us, str> => echo(value)
const fn prefix<...Us>(value: tuple<i64, Us>) -> tuple<i64, Us> => echo(value)
const fn repeated<...Us>(value: tuple<Us, Us>) -> tuple<Us, Us> => echo(value)
const fn apply(f: const fn(tuple<i64, str>) -> tuple<i64, str>, value: tuple<i64, str>) -> tuple<i64, str> => f(value)
test specialized_tuples {
    let direct: tuple<i64, str> = echo((1, "a"))
    let forwarded: tuple<i64, str> = forward((2, "b"))
    let callback: tuple<i64, str> = apply(echo, (3, "c"))
    let last: tuple<i64, str> = suffix((4, "d"))
    let first: tuple<i64, str, bool> = prefix((5, "e", true))
    let twice: tuple<i64, str, i64, str> = repeated((6, "f", 7, "g"))
    assert direct[0] == 1
    assert forwarded[0] == 2
    assert callback[0] == 3
    assert last[0] == 4
    assert first[1] == "e"
    assert twice[2] == 7
}

# GEN-3 and GEN-5: concrete specialization still outranks a category.
const fn forwarded_category<T>(value: T) -> str requires T in struct => shown(value)
test category_instances {
    assert forwarded_category(Label(text: "a")) == "a struct"
    assert forwarded_category(Point(x: 1.0, y: 2.0)) == "a point"
}

# GEN-3 and GEN-10: a forwarded tuple proves its each-category bound.
const fn structures<...Ts>(value: tuple<Ts>) -> bool
    requires each T in types(Ts) { T in struct } => true
const fn bounded<...Us>(value: tuple<Us>) -> bool
    requires each U in types(Us) { U in struct } => structures(value)
test tuple_category_requirements {
    assert bounded((Label(text: "a"), Point(x: 1.0, y: 2.0)))
}

# GEN-10 and FN-1: the same pack types specialize a temporal function.
fn temporal_echo<...Ts>(value: tuple<Ts>) -> tuple<Ts> {
    when all_valid(value) { return value }
}
test temporal_tuple {
    assert eval temporal_echo(value: [(1, "a"), (2, "b")]) == [(1, "a"), (2, "b")]
}

# GEN-3, GEN-7, GEN-10: rejected forms are checked independently (TST-12).
const fn only_struct<T>(value: T) -> bool requires T in struct => true
const fn only_enum<T>(value: T) -> bool requires T in enum => true
const fn pair<...Ts{2}>(value: tuple<Ts>) -> tuple<Ts> => value

# expect-error(operator, "operator.no_candidate")
const fn rejected_i64() -> str => shown(1)
# expect-error(operator, "operator.no_candidate")
const fn rejected_scalar_category() -> str => kind(1)
# expect-error(constraint, "requires.unmet")
const fn rejected_struct() -> bool => only_struct(1)
# expect-error(constraint, "requires.unmet")
const fn rejected_enum() -> bool => only_enum(Label(text: "a"))
# expect-error(constraint, "requires.unmet")
const fn missing_category_bound<T>(value: T) -> bool => only_struct(value)
# expect-error(constraint, "requires.unmet")
const fn missing_pack_bound<...Us>(value: tuple<Us>) -> bool => structures(value)
# expect-error(type, "pack.cardinality")
const fn rejected_pack_count() -> tuple<i64> => pair((1,))
# expect-error(type, "type.not_a_type")
const fn pack_is_not_one_type<...Ts>(value: list<Ts>) -> bool => true
