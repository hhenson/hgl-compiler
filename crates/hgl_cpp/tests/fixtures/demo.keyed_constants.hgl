module demo.keyed part constants

fn constant_members() -> set<i64> {
    let members: set<i64> = [2, 3]
    return relay_members(members)
}

fn constant_empty_members() -> set<i64> => []

fn constant_empty_book() -> dict<str, i64> => []

fn constant_groups() -> dict<str, set<i64>> {
    let groups: dict<str, set<i64>> = ["both": [2, 3], "none": []]
    return groups
}

# FN-3: ordinary set and dictionary values become one publication in a
# connection place, including an empty collection and nested values.
test constant_keyed_collections_publish_on_graph_start {
    assert eval constant_members() == [[2, 3]]
    assert eval constant_empty_members() == [[]]
    assert eval constant_empty_book() == [[]]
    assert eval constant_groups() == [["both": [2, 3], "none": []]]
}
