module demo.value_candidate_defaults

# EXPR-5, TYPE-14, UNIT-8: a generic explicit null default takes the
# concrete selected nullable parameter type, as an implicit null does.
const fn maybe<T>(value: T, other: T? = null) -> T? => other
const fn implicit<T>(value: T, other: T?) -> T? => other
const fn read<T>(value: T, other: T? = null) -> T => other
struct Record { value: i64 }

test scalar_null_defaults {
    assert maybe(1) == null
    assert maybe(1.0) == null
    assert maybe(true) == null
    assert maybe("text") == null
    assert implicit(1) == null
    assert implicit(1.0) == null
    assert maybe(1, 7) == 7
    assert maybe(1.0, 2.5) == 2.5
}
test composite_null_defaults {
    assert maybe([1, 2]) == null
    assert maybe((1, true)) == null
    assert maybe(Record(value: 1)) == null
}
# ERR-12: supplying an omitted null still fails when its payload is read.
test nullable_reads {
    assert raises("value.null") { read(1) }
    assert raises("value.null") { read(1.0) }
    assert read(1, 7) == 7
}

operator maybe_candidate<T>(value: T, other: T? = null) -> T?
impl const fn maybe_candidate<T>(value: T, other: T? = null) -> T? => other
test candidate_null_defaults {
    assert maybe_candidate(1) == null
    assert maybe_candidate(1.0) == null
    assert maybe_candidate(1, 7) == 7
}

# GEN-6, UNIT-8, RED-5: the selected ordinary signature owns omission.
operator selected<T, const ordered: bool = false>(value: T, zero: T? = null) -> T
impl const fn selected<const ordered: bool = false>(value: i64, zero: i64? = null) -> i64
    requires !ordered => value
impl const fn selected<const ordered: bool = false>(value: i64, zero: i64) -> i64
    requires ordered => zero + value
operator choose<T>(value: T, zero: T? = null) -> T
impl const fn choose<T>(value: T, zero: T? = null) -> T => value
impl const fn choose(value: i64, zero: i64) -> i64 => value + zero

test selected_controls {
    assert selected(1) == 1
    assert selected{ordered: true}(1, 2) == 3
    assert selected{ordered: true}(zero: 2, value: 1) == 3
    assert choose(1, 2) == 3
}
test missing_ordered_zero {
    # expect-error(type, "argument.missing")
    assert selected{ordered: true}(1) == 3
}
test missing_named_zero {
    # expect-error(type, "argument.missing")
    assert selected{ordered: true}(value: 1) == 3
}
test missing_typed_zero {
    let value: i64 = 1
    # expect-error(type, "argument.missing")
    assert selected{ordered: true}(value) == 3
}
test missing_most_specific_zero {
    # expect-error(type, "argument.missing")
    assert choose(1) == 1
}

operator defaulted<T>(value: T, zero: T? = null) -> T
impl const fn defaulted(value: i64, zero: i64 = 7) -> i64 => value + zero
operator optional<T>(value: T, zero: T? = null) -> T
impl const fn optional(value: i64, zero: i64?) -> i64 => value
operator configured<T>{amount: i64 = 7}(value: T) -> T
impl const fn configured{amount: i64}(value: i64) -> i64 => value + amount

test other_defaults {
    assert defaulted(1) == 8
    assert optional(1) == 1
    assert configured(1) == 8
    assert configured{amount: 2}(1) == 3
}

# FN-17: a supplied static callback is present before runtime erasure.
const fn plus(a: i64, b: i64) -> i64 => a + b
operator fold<T, C>(f: const fn(T, T) -> T, items: C, zero: T? = null) -> T
impl const fn fold<T>(f: const fn(T, T) -> T, items: list<T>, zero: T) -> T =>
    f(f(zero, items[0]), items[1])
test callback_control { assert fold(plus, [1, 2], 3) == 6 }
test callback_missing_zero {
    # expect-error(type, "argument.missing")
    assert fold(plus, [1, 2]) == 3
}
