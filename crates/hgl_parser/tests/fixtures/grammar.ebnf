# control-flow-and-sources.md
block = "{", [ NL ], [ statement, { NL, statement }, [ NL ] ], "}" ;
statement = local_decl | assignment | return_statement | expression | state_decl | cache_decl | inject_decl | lifecycle_block | when_statement | for_statement | while_statement | yield_statement | switch_statement | assert_statement ;
return_statement = "return", [ expression ] ;
if_expression = "if", expression, block, [ "else", ( block | if_expression ) ] ;
for_statement = "for", iteration_pattern, "in", expression, block ;
iteration_pattern = IDENTIFIER, [ ",", IDENTIFIER ] ;
while_statement = "while", [ expression ], block ;
yield_statement = "yield", expression, ":", expression ;
switch_statement = "switch", expression, "{", [ NL ], { switch_case, [ NL ] }, [ switch_default, [ NL ] ], "}" ;
switch_case = "case", const_expression, ":", [ NL ], [ statement, { NL, statement } ] ;
switch_default = "default", ":", [ NL ], [ statement, { NL, statement } ] ;
# errors-and-diagnostics.md
warning_annotation = "@", "suppress_warning", "(", STRING_LITERAL, ")" ;
# expressions-and-bindings.md
expression = or_expr ;
or_expr = and_expr, { "||", [ operator_configuration ], and_expr } ;
and_expr = equality_expr, { "&&", [ operator_configuration ], equality_expr } ;
equality_expr = comparison_expr, { ( "==" | "!=" ), [ operator_configuration ], comparison_expr } ;
comparison_expr = additive_expr, { ( "<" | "<=" | ">" | ">=" | "<=>" ), [ operator_configuration ], additive_expr } ;
additive_expr = multiplicative_expr, { ( "+" | "-" ), [ operator_configuration ], multiplicative_expr } ;
multiplicative_expr = unary_expr, { ( "*" | "/" | "//" | "%" ), [ operator_configuration ], unary_expr } ;
unary_expr = ( "-" | "!" ), [ operator_configuration ], unary_expr | postfix_expr ;
operator_configuration = "{", configuration_argument, { ",", configuration_argument }, [ "," ], "}" ;
configuration_argument = member_name, ":", expression ;
postfix_expr = primary_expr, { call_suffix | index_suffix | member_suffix | "?" } ;
call_suffix = "(", [ arguments ], ")" ;
index_suffix = "[", expression, "]" ;
member_suffix = ".", member_name ;
primary_expr = literal | IDENTIFIER | qualified_name | implied_member | "(", expression, ")" | tuple_literal | sequence_literal | typed_constructor | delta_constructor | type_call | function_expr | if_expression | eval_expression | block ;
arguments = argument, { ",", argument }, [ "," ] ;
argument = [ member_name, ":" ], expression ;
tuple_literal = "(", expression, ",", [ expression, { ",", expression }, [ "," ] ], ")" ;
sequence_literal = "[", [ sequence_entries ], "]" ;
sequence_entries = sequence_values | sequence_pairs ;
sequence_values = sequence_item, { ",", sequence_item }, [ "," ] ;
sequence_pairs = sequence_pair, { ",", sequence_pair }, [ "," ] ;
sequence_pair = sequence_item, ":", sequence_item ;
sequence_item = expression | "_" ;
typed_constructor = ( IDENTIFIER | qualified_name ), generic_arguments, "(", [ arguments ], ")" ;
type_call = ( "str" | "bytes" | "any" | "error" ), "(", [ arguments ], ")" ;
implied_member = ".", member_name ;
local_decl = ( "let" | "var" ), IDENTIFIER, [ ":", type ], "=", expression | "var", IDENTIFIER, ":", type ;
assignment = place, assignment_operator, expression ;
place = IDENTIFIER, { index_suffix | member_suffix } ;
assignment_operator = "=" | "+=" | "-=" | "*=" | "/=" | "//=" | "%=" ;
const_expression = expression ;
delta_constructor = "delta", "<", type, ">", "(", [ delta_arguments ], ")" ;
delta_arguments = delta_argument, { ",", delta_argument }, [ "," ] ;
delta_argument = member_name, ":", expression ;
# functions-and-phases.md
function_decl = { warning_annotation, NL }, ( [ "export" | "impl" ], "fn" | [ "export" ], "const", "fn" ), callable_name, [ generic_parameters ], function_signature, [ requires_clause ], function_body ;
function_signature = "(", [ parameters ], ")", [ "->", type ] ;
parameters = parameter, { ",", parameter }, [ "," ] ;
parameter = IDENTIFIER, ":", type | "const", IDENTIFIER, ":", value_type, [ "=", const_expression ] | IDENTIFIER, ":", value_type, "=", const_expression | [ "const" ], IDENTIFIER, ":", pack, [ "=", const_expression ] ;
pack = "...", type, [ cardinality ] | "...", "{", type, "}", [ cardinality ] ;
function_body = "=>", expression | block ;
function_expr = "fn", "(", [ lambda_parameters ], ")", [ "->", type ], ( "=>", expression | block ) ;
lambda_parameters = lambda_parameter, { ",", lambda_parameter }, [ "," ] ;
lambda_parameter = IDENTIFIER, [ ":", type ] ;
# generics-and-operators.md
generic_parameters = "<", generic_parameter, { ",", generic_parameter }, [ "," ], ">" ;
generic_parameter = IDENTIFIER | "...", IDENTIFIER, [ cardinality ] | "const", IDENTIFIER, ":", value_type ;
cardinality = "{", INTEGER_LITERAL, [ ":", ( INTEGER_LITERAL | "*" ) ], "}" ;
generic_arguments = "<", generic_argument, { ",", generic_argument }, [ "," ], ">" ;
generic_argument = type | const_expression ;
requires_clause = "requires", constraint_expression ;
constraint_expression = constraint_or ;
constraint_or = constraint_and, { "||", constraint_and } ;
constraint_and = constraint_term, { "&&", constraint_term } ;
constraint_term = "!", constraint_term | "(", constraint_expression, ")" | constraint_relation | constraint_call | "each", IDENTIFIER, "in", constraint_operand, "{", constraint_expression, "}" ;
constraint_relation = constraint_operand, ( "==" | "in" | "is" ), constraint_operand ;
constraint_operand = type | additive_expr | constraint_set ;
constraint_set = "{", constraint_operand, { ",", constraint_operand }, [ "," ], "}" ;
constraint_call = ( IDENTIFIER | qualified_name ), "(", [ constraint_operand, { ",", constraint_operand } ], ")", [ "->", type ] ;
operator_decl = "operator", callable_name, [ generic_parameters ], function_signature, [ requires_clause ], { operator_properties } ;
operator_properties = "properties", "<", value_type, { ",", value_type }, ">", "{", operator_property, { ",", operator_property }, [ "," ], "}" ;
operator_property = "associative" | "commutative" | "identity", "=", const_expression ;
instantiate_decl = "instantiate", instantiation, { ",", instantiation }, [ "," ] ;
instantiation = callable_name, "<", materialization_argument, { ",", materialization_argument }, [ "," ], ">" ;
materialization_argument = type | const_expression | "_" ;
# native-boundaries.md
native_type_decl = [ "export" ], "native", "type", IDENTIFIER ;
native_function_decl = "native", [ "const" ], "fn", callable_name, [ generic_parameters ], function_signature, [ requires_clause ], [ native_contract_body ] ;
native_contract_body = "{", [ NL ], { ( inject_decl, [ ";" ] | native_hook ), [ NL ] }, "}" ;
native_hook = ( "start" | "when" | "stop" ), ";" ;
# source-text.md
NL = ? one or more significant line breaks after continuation handling ? ;
EOF = ? end of the source file ? ;
literal = INTEGER_LITERAL | FLOAT_LITERAL | STRING_LITERAL | TEMPORAL_LITERAL | "true" | "false" | "null" ;
# temporal-model.md
state_decl = "state", IDENTIFIER, [ ":", value_type ], "=", expression ;
cache_decl = "cache", IDENTIFIER, [ ":", value_type ], "=", expression ;
inject_decl = "inject", IDENTIFIER, { ",", IDENTIFIER }, [ "," ] ;
lifecycle_block = ( "start" | "stop" ), block ;
when_statement = "when", [ expression ], block ;
# tests-and-eval.md
test_decl = "test", IDENTIFIER, block ;
test_context = "test", "{", [ NL ], [ test_item, { NL, test_item }, [ NL ] ], "}" ;
test_item = function_decl | struct_decl | enum_decl | test_decl ;
assert_statement = "assert", ( expression | raises_assertion ) ;
raises_assertion = "raises", "(", expression, ")", block ;
eval_expression = "eval", "(", expression, { ",", argument }, [ "," ], ")" ;
expect_error = "#", gap, "expect-error", "(", gap, error_category, gap, ",", gap, STRING_LITERAL, gap, ")", gap ;
gap = { ? U+0020 or U+0009 ? } ;
error_category = ? a source category of the diagnostic catalog ? ;
# types-and-values.md
type = type_base, [ "?" ] ;
type_base = scalar_type | named_type | tuple_type | list_type | set_type | dict_type | rolling_type | ref_type | "signal" | "atomic", "<", value_type, ">" | result_type | "error" | delta_type ;
value_type = value_type_base, [ "?" ] ;
value_type_base = scalar_type | named_type | value_tuple_type | value_list_type | set_type | value_dict_type | result_type | "error" | delta_type ;
scalar_type = "bool" | "i64" | "f64" | "str" | "bytes" | "any" | "date" | "time" | "datetime" | "duration" | "civil_datetime" | "timezone" | "zoned_datetime" | "zoned_time" ;
named_type = ( IDENTIFIER | qualified_name ), [ generic_arguments ] ;
tuple_type = "tuple", "<", type, { ",", type }, ">" ;
value_tuple_type = "tuple", "<", value_type, { ",", value_type }, ">" ;
list_type = "list", "<", type, [ ",", size_expression ], ">" ;
value_list_type = "list", "<", value_type, [ ",", size_expression ], ">" ;
size_expression = additive_expr | "unbounded" ;
set_type = "set", "<", value_type, ">" ;
dict_type = "dict", "<", value_type, ",", type, ">" ;
value_dict_type = "dict", "<", value_type, ",", value_type, ">" ;
rolling_type = "rolling", "<", value_type, ",", const_expression, [ ",", const_expression ], ">" ;
ref_type = "ref", "<", type, ">" ;
result_type = "result", "<", value_type, ",", value_type, ">" ;
delta_type = "delta", "<", type, ">" ;
struct_decl = [ "export" ], [ "abstract" ], "struct", IDENTIFIER, [ generic_parameters ], [ ":", named_type, { ",", named_type } ], [ requires_clause ], "{", [ NL ], [ struct_member, { NL, struct_member }, [ NL ] ], "}" ;
struct_member = member_name, ":", type, [ "=", const_expression ] | member_name, "=", const_expression ;
enum_decl = [ "export" ], "enum", IDENTIFIER, "{", [ NL ], [ enum_member, { ",", [ NL ], enum_member }, [ "," ] ], [ NL ], "}" ;
enum_member = member_name, [ "=", const_expression ] ;
# units-and-names.md
source_file = [ NL ], module_decl, { NL, top_level_item }, [ NL ], EOF ;
module_decl = "module", module_path, [ "part", IDENTIFIER ] ;
module_path = IDENTIFIER, { ".", IDENTIFIER } ;
qualified_name = IDENTIFIER, "::", import_name ;
use_decl = "use", module_path, ( "::", import_set | "as", IDENTIFIER ) ;
import_set = "{", import_name, { ",", import_name }, [ "," ], "}" ;
import_name = IDENTIFIER ;
top_level_item = use_decl | declaration ;
declaration = function_decl | struct_decl | enum_decl | operator_decl | instantiate_decl | native_type_decl | native_function_decl | test_decl | test_context ;
member_name = IDENTIFIER | ? a hard reserved word ? ;
callable_name = IDENTIFIER ;
