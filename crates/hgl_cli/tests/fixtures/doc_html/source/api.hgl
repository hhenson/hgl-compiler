/** Reference for the guide, including `increment`. */
module guide.api
use guide.types as foreign
use guide.types::{shared}

/**
Describe the `shared` value and the `foreign::Side.buy` case.

`guide.types.Side.sell` uses its full name. `value` is the parameter.
`hidden_elsewhere` stays code. See also `private_marker`.

Args:
    offset: The **offset** to apply.
    value: The input value.

    The options are evaluated once.

**Further reading**:
    See `shared` for another example.

Notes:
    | Setting | Meaning |
    | --- | --- |
    | Default | One |

    <script>alert("escaped")</script>
    [External label](https://example.invalid/external)
    ![External picture](https://example.invalid/picture.png)

    Inline formula $`shared`$ with a formula and diagram below:

    ~~~math
    a^2+b^2=c^2
    ~~~

    ~~~math
    \kern{-1em}
    ~~~

    ~~~mermaid
    graph LR; A --> B
    ~~~

    ~~~mermaid
    %%{init: {"htmlLabels": true, "flowchart": {"htmlLabels": true}, "themeCSS": ".hgl-theme-override { color: red; }", "themeVariables": {"primaryColor": "#010203"}, "fontFamily": "hgl-font-override", "securityLevel": "loose"}}%%
    flowchart LR
        A["<b>bold</b>"] --> B["plain"]
        click A href "https://renderer-probe.invalid/"
    ~~~

    ~~~mermaid
    %%{init: {"journey": {"textPlacement": "fo"}}}%%
    journey
        title Daily work
        section Morning
            Read notes: 3: Reader
    ~~~

    Unrenderable source stays visible:

    ~~~math
    \badHglCommand{b}
    ~~~

    ~~~math
    \rule[-100000em]{1em}{1em}
    ~~~

    ~~~math
    \kern{-100000em}
    ~~~

    ~~~math
    \raisebox{100000em}{x}
    ~~~

    ~~~mermaid
    not a diagram
    ~~~

Examples:
    ~~~hgl
    assert increment(2) == 3
    ~~~
*/
export const fn increment{const offset: i64 = 1}(value: i64) -> i64 => value + offset

/**
Choose the result for the argument.

Type Args:
    T: The value type, independent of the candidate.
*/
export operator choose<T>(value: T) -> i64
/** The integer candidate. */
impl const fn choose(value: i64) -> i64 => value
/** The text candidate. */
impl const fn choose(value: str) -> i64 => 0

/** Private implementation detail. */
const private_marker: i64 = 11
