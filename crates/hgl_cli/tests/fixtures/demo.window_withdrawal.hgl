module demo.window_withdrawal

# END-4, END-5, TYPE-11: an explicit withdrawal discards window payload and
# delta. A later arrival begins a new history. The last action wins.
fn owned_window(action: i64) -> rolling_window<i64, 3, 2> {
    inject out
    when {
        if action == -1 { invalidate(out) }
        if action == -2 {
            out = 71
            invalidate(out)
        }
        if action == -3 {
            invalidate(out)
            out = 80
            return 81
        }
        if action >= 0 { return action }
    }
}

fn current_window(w: rolling_window<i64, 3, 2>) -> list<i64> {
    when all_valid(w) { return w }
}
fn held_window(action: i64) -> list<i64> => current_window(owned_window(action))

fn read_status(clock: bool, w: rolling_window<i64, 3, 2>) -> i64 {
    when modified(clock) && valid([]) {
        if !valid(w) {
            if modified(w) { return -1 }
            return 0
        }
        if all_valid(w) { return 2 }
        return 1
    }
}
fn window_status(clock: bool, action: i64) -> i64 => read_status(clock, owned_window(action))

test withdrawal_forgets_held_samples_and_restarts_the_minimum {
    assert eval(held_window(action: [1, 2, -1, -1, 3, 4])) == [_, [1, 2], _, _, _, [3, 4]]
    assert eval(window_status(clock: [true, true, true, true, true, true],
                              action: [1, 2, -1, -1, 3, 4])) == [1, 2, 0, 0, 1, 2]
}

test last_window_action_decides_the_only_arrival {
    assert eval(held_window(action: [1, 2, -2, 3, 4, -3, 5])) ==
        [_, [1, 2], _, _, [3, 4], _, [81, 5]]
}

fn timed_owned(action: i64) -> rolling_window<i64, 3us, 0us> {
    inject out
    when {
        if action < 0 { invalidate(out) } else { return action }
    }
}
fn timed_status(clock: bool, window: rolling_window<i64, 3us, 0us>) -> i64 {
    when modified(clock) && valid([]) {
        if !valid(window) {
            if modified(window) { return -1 }
            return 0
        }
        if all_valid(window) { return 2 }
        return 1
    }
}
fn timed_view(clock: bool, action: i64) -> i64 => timed_status(clock, timed_owned(action))

test forgotten_samples_never_wake_the_window_at_their_old_expiry {
    assert eval(timed_view(clock: [true, true, true, true, true, true, true, true, true, true],
                           action: [1, -1, -1, _, _, 2, _, _, _, _])) ==
        [2, 0, 0, 0, 0, 2, 2, 2, 2, 1]
    assert eval(timed_view(clock: [true, true, true, true, true, true],
                           action: [1, _, _, _, -1, 2])) == [2, 2, 2, 2, 0, 2]
}

const fn value_or_code(outcome: result<i64, error>) -> str {
    if is_ok(outcome) { return convert<str>(outcome.value) }
    let code = outcome.error.code
    if code == null { return "no code" }
    return code
}

fn arrival(readings: rolling_window<i64, 3, 2>) -> i64 {
    when modified(readings) { return delta_value(readings) }
}

fn departure(readings: rolling_window<i64, 3, 2>) -> str {
    when modified(readings) { return value_or_code(removed_value(readings)) }
}

fn window_departure(action: i64) -> str => departure(owned_window(action))
fn window_arrival(action: i64) -> i64 => arrival(owned_window(action))

# END-4, END-9: recovery has its own delta and no removal from the old
# window. A later arrival at the full window drops the real oldest sample.
test a_new_window_has_no_departure_from_the_old_history {
    assert eval(window_arrival(action: [1, 2, 3, -3, 5, 6, 7])) == [1, 2, 3, 81, 5, 6, 7]
    assert eval(window_departure(action: [1, 2, 3, -3, 5, 6, 7])) ==
        ["value.unset_read", "value.unset_read", "value.unset_read", "value.unset_read",
         "value.unset_read", "value.unset_read", "81"]
}

fn on_window_wake(w: rolling_window<i64, 3, 2>) -> bool {
    when valid([]) { return valid(w) }
}
fn active_window(action: i64) -> bool => on_window_wake(owned_window(action))

# END-4: active subscribers see a transition to invalid exactly once.
test only_a_real_withdrawal_notifies_an_active_subscriber {
    assert eval(active_window(action: [-2, -1, 1, -1, -1, 2])) == [false, _, true, false, _, true]
}
