module demo.lift

const fn scale(value: f64, factor: f64 = 2.0) -> f64 => value * factor
const fn doubled(value: i64) -> i64 => value * 2

fn relay(value: i64) -> i64 {
    when { return value }
}

fn summed(left: i64, right: i64) -> i64 => left + right
fn scaled(price: f64, factor: f64) -> f64 => scale(price, factor)
fn half_configured(price: f64) -> f64 => scale(price, 3.0)
fn defaulted(price: f64) -> f64 => scale(price)
fn nested(left: i64, right: i64) -> i64 => doubled(relay(left) + right) + 1
fn twice(left: i64, right: i64) -> i64 => (left + right) + (left + right)
fn positive(price: f64) -> bool => price > 0.0
fn fixed(value: i64, const factor: i64) -> i64 => relay(value) + doubled(factor)
const fn label(value: i64, text: str = "{NAME}") -> str => text
fn labelled(value: i64) -> str => label(value)
const fn note(value: i64) {}
fn watched(value: i64) -> i64 {
    note(value)
    return value
}

test lifts {
    assert eval(doubled(value: [1, _, 3])) == [2, _, 6]
    assert eval(summed(left: [1, _, 3], right: [_, 10])) == [_, 11, 13]
    assert eval(scaled(price: [1.0, _, 3.0, 3.0], factor: [_, 4.0])) ==
        [2.0, 4.0, 12.0, 12.0]
    assert eval(half_configured(price: [1.0, 2.0])) == [3.0, 6.0]
    assert eval(defaulted(price: [1.5])) == [3.0]
    assert eval(nested(left: [1, 2], right: [10])) == [23, 25]
    assert eval(twice(left: [1, 2], right: [10])) == [22, 24]
    assert eval(positive(price: [1.0, -1.0])) == [true, false]
    assert eval(fixed(value: [1, 2], factor: 5)) == [11, 12]
    assert eval(scale(value: [1.0, _, 3.0], factor: [_, 4.0])) == [2.0, 4.0, 12.0]
    assert eval(watched(value: [1, 2])) == [1, 2]
    assert eval(labelled(value: [1])) == ["{NAME}"]
}
