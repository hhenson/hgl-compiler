module demo.scalars_wave3

# TYPE-2: "Two `zoned_datetime` values are equal when both their instants
# and their zone names are: one instant in two zones, or under two
# aliases of one zone, is two values. Compared as UTC, they are equal
# when their instants are. That comparison is written `a =={utc: true}
# b`". OPS-2: "The option is `utc`, a `bool` that is false unless given
# ... declared by the candidates of `eq_` and `ne_` for two zoned
# datetimes."

# In a value function: the option left out, given as a literal, as a
# parameter, through a generic value parameter, and by name.
const fn same(a: zoned_datetime, b: zoned_datetime) -> bool => a == b
const fn apart(a: zoned_datetime, b: zoned_datetime) -> bool => a != b
const fn same_instant(a: zoned_datetime, b: zoned_datetime) -> bool => a =={utc: true} b
const fn other_instant(a: zoned_datetime, b: zoned_datetime) -> bool => a !={utc: true} b
const fn same_as(a: zoned_datetime, b: zoned_datetime, as_utc: bool) -> bool => a =={utc: as_utc} b
const fn same_by<const as_utc: bool>(a: zoned_datetime, b: zoned_datetime) -> bool =>
    a =={utc: as_utc} b
const fn named(a: zoned_datetime, b: zoned_datetime, as_utc: bool) -> bool => eq_(a, b, utc: as_utc)
const fn named_apart(a: zoned_datetime, b: zoned_datetime, as_utc: bool) -> bool =>
    ne_(a, b, utc: as_utc)

# In a node: EXPR-14, "In a value function or runtime hook, evaluate it
# for the current invocation", so the option may be what an input holds.
fn compared(a: zoned_datetime, b: zoned_datetime) -> bool {
    when { return a == b }
}
fn compared_as_utc(a: zoned_datetime, b: zoned_datetime) -> bool {
    when { return a =={utc: true} b }
}
fn compared_by(a: zoned_datetime, b: zoned_datetime, flag: bool) -> bool {
    when { return a !={utc: flag} b }
}
fn compared_with<const as_utc: bool>(a: zoned_datetime, b: zoned_datetime) -> bool {
    when { return a =={utc: as_utc} b }
}

# In a graph the comparison is lifted (FN-6). EXPR-14: "Scalar operator
# configuration binds during graph construction in temporal
# composition": the option is configuration of the node. A call by name
# given a connection takes it as an input, and FN-11: "A lifted argument
# with a declared default does not require a valid input: bind the
# default when that input is invalid."
fn wired(a: zoned_datetime, b: zoned_datetime) -> bool => a == b
fn wired_as_utc(a: zoned_datetime, b: zoned_datetime) -> bool => a =={utc: true} b
fn wired_by(a: zoned_datetime, b: zoned_datetime, const as_utc: bool) -> bool => a !={utc: as_utc} b
fn wired_with<const as_utc: bool>(a: zoned_datetime, b: zoned_datetime) -> bool =>
    a =={utc: as_utc} b
fn wired_named(a: zoned_datetime, b: zoned_datetime, flag: bool) -> bool => eq_(a, b, utc: flag)

# A nullable zoned datetime tested against null is one after (ERR-12),
# and compared as any is.
const fn same_when_given(b: zoned_datetime, a: zoned_datetime?) -> bool {
    if a == null { return false }
    return a =={utc: true} b
}
fn compared_when_given(b: zoned_datetime, a: zoned_datetime?) -> bool {
    when {
        if a == null { return false }
        return a == b
    }
}

test zoned_datetimes_are_equal_by_instant_and_zone {
    let london = @2026-09-03T09:30+01:00[Europe/London]
    let utc = @2026-09-03T08:30+00:00[UTC]
    # Europe/Jersey is a link to Europe/London: "Zone aliases are
    # distinct names".
    let jersey = @2026-09-03T09:30+01:00[Europe/Jersey]
    let hour_on = @2026-09-03T09:30+00:00[UTC]
    assert same(london, @2026-09-03T09:30+01:00[Europe/London])
    assert !same(london, utc) && apart(london, utc)
    assert !same(london, jersey) && apart(london, jersey)
    assert !same(utc, hour_on) && apart(utc, hour_on)
    assert london != utc
    assert !(london == jersey)
}

test zoned_datetimes_compared_as_utc_are_equal_by_instant {
    let london = @2026-09-03T09:30+01:00[Europe/London]
    let utc = @2026-09-03T08:30+00:00[UTC]
    let jersey = @2026-09-03T09:30+01:00[Europe/Jersey]
    let hour_on = @2026-09-03T09:30+00:00[UTC]
    assert same_instant(london, utc) && !other_instant(london, utc)
    assert same_instant(london, jersey) && !other_instant(london, jersey)
    assert !same_instant(london, hour_on) && other_instant(london, hour_on)
    assert same_as(london, utc, true) && !same_as(london, utc, false)
    assert same_by<true>(london, utc) && !same_by<false>(london, utc)
    assert named(london, utc, true) && !named(london, utc, false)
    assert !named_apart(london, utc, true) && named_apart(london, utc, false)
    assert london =={utc: true} utc
    assert london !={utc: false} utc
    assert london !={utc: true} hour_on
    assert same_when_given(utc, london) && !same_when_given(utc, null)
}

test zoned_datetimes_are_compared_in_a_node_and_a_graph {
    let london = @2026-09-03T09:30+01:00[Europe/London]
    let utc = @2026-09-03T08:30+00:00[UTC]
    assert eval compared(a: [london, _], b: [utc, london]) == [false, true]
    assert eval compared_as_utc(a: [london, _], b: [utc, london]) == [true, true]
    assert eval compared_by(a: [london, _], b: [utc, _], flag: [true, false]) == [false, true]
    assert eval compared_with<true>(a: [london], b: [utc]) == [true]
    assert eval compared_with<false>(a: [london], b: [utc]) == [false]
    assert eval wired(a: [london, _], b: [utc, london]) == [false, true]
    assert eval wired_as_utc(a: [london, _], b: [utc, london]) == [true, true]
    assert eval wired_by(a: [london], b: [utc], as_utc: true) == [false]
    assert eval wired_by(a: [london], b: [utc], as_utc: false) == [true]
    assert eval wired_with<true>(a: [london], b: [utc]) == [true]
    assert eval wired_with<false>(a: [london], b: [utc]) == [false]
    # The option's input is invalid at first: `utc` is then false.
    assert eval wired_named(a: [london, _, _], b: [utc, _, _], flag: [_, true, false]) ==
        [false, true, false]
    assert eval compared_when_given(b: [london, _, utc], a: [null, london, _]) == [false, true, false]
}

# OPS-2: "Two structs are equal when ... each field is equal as `==` of
# the field's type has it", "two lists ... when ... each position is
# equal", "two dictionaries when they have the same keys and each value
# is equal; two sets when they have the same members". A zoned datetime
# held in one is compared by instant and zone: one instant in two zones
# is two members and two keys (TYPE-2).
struct Meeting {
    at: zoned_datetime
}

const fn same_meeting(a: Meeting, b: Meeting) -> bool => a == b
const fn same_list(a: list<zoned_datetime>, b: list<zoned_datetime>) -> bool => a == b
const fn same_set(a: set<zoned_datetime>, b: set<zoned_datetime>) -> bool => a == b
const fn same_values<T>(a: T, b: T) -> bool => a == b
const fn found(values: dict<zoned_datetime, i64>, key: zoned_datetime) -> i64 {
    let value = get(values, key)
    if value == null { return 0 }
    return value
}

test a_zoned_datetime_held_in_a_value_is_compared_by_instant_and_zone {
    let london = @2026-09-03T09:30+01:00[Europe/London]
    let utc = @2026-09-03T08:30+00:00[UTC]
    let jersey = @2026-09-03T09:30+01:00[Europe/Jersey]
    assert same_meeting(Meeting(at: london), Meeting(at: london))
    assert !same_meeting(Meeting(at: london), Meeting(at: utc))
    assert same_list([london, utc], [london, utc])
    assert !same_list([london], [jersey])
    assert !same_values(london, utc)
    assert same_values(london, london)
    let both: set<zoned_datetime> = [london, utc]
    let one: set<zoned_datetime> = [london]
    let twice: set<zoned_datetime> = [london, london]
    assert !same_set(both, one)
    assert same_set(twice, one)
    let keyed: dict<zoned_datetime, i64> = [london: 1, utc: 2]
    assert found(keyed, london) == 1
    assert found(keyed, utc) == 2
    assert found(keyed, jersey) == 0
    assert keyed[utc] == 2
}

# OPS-10: "A `zoned_datetime` with a `duration` added or taken away is
# the instant that far away, in the same zone: its wall clock and offset
# are the zone's at that instant". TYPE-2: "A duration added to a zoned
# datetime, or taken from one, moves its instant, not its wall clock."
# London's clocks go forward at 01:00 UTC on 29 March 2026 and back at
# 01:00 UTC on 25 October 2026; New York's go forward at 07:00 UTC on
# 8 March 2026.
const fn later(at: zoned_datetime, by: duration) -> zoned_datetime => at + by
const fn earlier(at: zoned_datetime, by: duration) -> zoned_datetime => at - by
fn moved(at: zoned_datetime, by: duration) -> zoned_datetime {
    when { return by + at }
}
fn moved_back(at: zoned_datetime, by: duration) -> zoned_datetime {
    when { return at - by }
}
fn shifted(at: zoned_datetime, by: duration) -> zoned_datetime => at + by

test a_duration_moves_a_zoned_instant_across_a_change_of_offset {
    let spring = @2026-03-28T12:00+00:00[Europe/London]
    let autumn = @2026-10-24T12:00+01:00[Europe/London]
    # A day is 86,400 seconds: 13:00 on the wall clock after the clocks
    # go forward, 11:00 after they go back, and not 12:00.
    assert later(spring, 1d) == @2026-03-29T13:00+01:00[Europe/London]
    assert later(spring, 1d) != @2026-03-29T12:00+01:00[Europe/London]
    assert later(spring, 1d) =={utc: true} @2026-03-29T12:00+00:00[UTC]
    assert later(autumn, 1d) == @2026-10-25T11:00+00:00[Europe/London]
    assert earlier(@2026-03-29T13:00+01:00[Europe/London], 1d) == spring
    assert earlier(@2026-10-25T11:00+00:00[Europe/London], 1d) == autumn
    # The hour the clocks repeat: an hour after the first 01:30 is the
    # second, and an hour before the second the first.
    assert later(@2026-10-25T01:30+01:00[Europe/London], 1h) == @2026-10-25T01:30+00:00[Europe/London]
    assert earlier(@2026-10-25T01:30+00:00[Europe/London], 1h) == @2026-10-25T01:30+01:00[Europe/London]
    # The hour the clocks skip: 00:30 and an hour is 02:30.
    assert later(@2026-03-29T00:30+00:00[Europe/London], 1h) == @2026-03-29T02:30+01:00[Europe/London]
    assert later(@2026-03-07T12:00-05:00[America/New_York], 1d) ==
        @2026-03-08T13:00-04:00[America/New_York]
    assert eval moved(at: [spring, autumn], by: [1d]) ==
        [@2026-03-29T13:00+01:00[Europe/London], @2026-10-25T11:00+00:00[Europe/London]]
    assert eval moved_back(at: [@2026-03-29T13:00+01:00[Europe/London]], by: [1d]) == [spring]
    assert eval shifted(at: [spring, autumn], by: [1d]) ==
        [@2026-03-29T13:00+01:00[Europe/London], @2026-10-25T11:00+00:00[Europe/London]]
    # OPS-10: an instant result "outside its type's range is an HGL error
    # with code `numeric.out_of_range`".
    assert raises("numeric.out_of_range") { later(@9999-12-31T23:30+00:00[UTC], 1h) }
}

# OPS-2: "`<`, `<=`, `>`, `>=`, and `<=>` compare two values of one type
# among `str`, `bool`, `date`, `time`, `datetime`, `civil_datetime`, and
# `duration`." A `datetime` is a UTC instant (TYPE-2), whatever offset
# its literal is written with.
const fn day_order(a: date, b: date) -> CmpResult => a <=> b
const fn time_before(a: time, b: time) -> bool => a < b
const fn instant_order(a: datetime, b: datetime) -> CmpResult => a <=> b
const fn civil_not_after(a: civil_datetime, b: civil_datetime) -> bool => a <= b
const fn longer(a: duration, b: duration) -> bool => a > b
const fn not_shorter(a: duration, b: duration) -> bool => a >= b
fn not_before(a: datetime, b: datetime) -> bool {
    when { return a >= b }
}
fn span_order(a: duration, b: duration) -> CmpResult => a <=> b

test the_temporal_scalars_are_ordered {
    assert day_order(@0001-01-01, @9999-12-31) == .less
    assert day_order(@2026-09-03, @2026-09-03) == .equivalent
    assert time_before(@00:00, @23:59:59.999999) && !time_before(@09:30, @09:30)
    assert instant_order(@2026-09-03T09:30+01:00, @2026-09-03T08:30Z) == .equivalent
    assert instant_order(@2026-09-03T09:30+01:00, @2026-09-03T09:00Z) == .less
    assert civil_not_after(@2026-09-03T09:30, @2026-09-03T09:30)
    assert !civil_not_after(@2026-09-03T09:30:00.000001, @2026-09-03T09:30)
    assert longer(1s, 999999us) && !longer(-1us, 0s)
    assert not_shorter(0s, 0s) && !not_shorter(-1d, 1us)
    assert @2026-09-03 < @2026-09-04 && @23:00 > @01:00 && 1h <= 60m
    assert eval not_before(a: [@2026-09-03T09:30+01:00, @2026-09-03T08:00Z], b: [@2026-09-03T08:30Z]) ==
        [true, false]
    assert eval span_order(a: [1s, -1s, 60s], b: [1m]) == [.less, .less, .equivalent]
}

# OPS-1: "`*` | `str` and `i64`, in either order | `str`": the text that
# many times, core's "string repetition".
const fn repeated(text: str, count: i64) -> str => text * count
const fn repeated_before(count: i64, text: str) -> str => count * text
fn wired_repeat(text: str, count: i64) -> str => text * count

test a_string_times_a_count_is_repeated {
    assert repeated("ab", 2) == "abab"
    assert repeated("ab", 1) == "ab"
    assert repeated("ab", 0) == ""
    assert repeated("", 3) == ""
    assert repeated("h\u{e9}", 2) == "h\u{e9}h\u{e9}"
    assert repeated_before(3, "x") == "xxx"
    assert "ab" * 2 == 2 * "ab"
    assert eval wired_repeat(text: ["ab", _, "c"], count: [2, 0, _]) == ["abab", "", ""]
}
