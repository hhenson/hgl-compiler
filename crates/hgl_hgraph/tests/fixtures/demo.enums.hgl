module demo.enums

const fn opposite(side: Side) -> Side {
    if side == .buy { return .sell }
    if side == Side.sell { return .buy }
    return side
}

fn flipped(side: Side) -> Side => opposite(side)

enum Side { buy, sell = 5, hold }
enum Odd { mro, _x_, class, hgl_mro, name }

const fn numbered(number: i64) -> Side => Side(number)
const fn named(text: str) -> Side => Side(text)
const fn odd(text: str) -> Odd => Odd(text)

fn chosen(value: i64, const other: Side) -> Side {
    when {
        if value == 0 { return Side.buy }
        return other
    }
}

fn fixed(side: Side) -> bool => side == .hold

test enums {
    assert opposite(.buy) == .sell
    assert opposite(Side.sell) == Side.buy
    assert opposite(.hold) == .hold
    # A member by its number, and by its exact name.
    assert Side(5) == .sell
    assert Side("hold") == Side(6)
    assert numbered(0) == .buy
    assert named("sell") == .sell
    # Names Python's `Enum` keeps for itself, and a keyword.
    assert odd("mro") == .mro
    assert odd("_x_") == Odd._x_
    assert odd("class") == .class
    assert odd("hgl_mro") == .hgl_mro
    assert odd("mro") != odd("hgl_mro")
    assert odd("name") == .name
    assert eval(flipped(side: [.buy, _, .sell, .hold])) == [.sell, _, .buy, .hold]
    assert eval(chosen(value: [0, 7], other: .hold)) == [.buy, .hold]
    assert eval(fixed(side: [.buy, .hold])) == [false, true]
}
