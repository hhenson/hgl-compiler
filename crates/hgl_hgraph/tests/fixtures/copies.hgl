module demo.copies

# The owner's rule for a `var` (the compiler's issue 151): it is changed
# where it is, and a copy is made where a reference to what it holds is
# made and it then changes, and where a reference is kept.

struct Book {
    orders: list<i64>
    name: str
}

# A result that is the function's own, and one that is a part of what it
# was given.
const fn built(count: i64) -> list<i64> {
    var out: list<i64> = []
    var i: i64 = 0
    while i < count {
        append(out, i)
        i += 1
    }
    return out
}
const fn first_row(rows: list<list<i64>>) -> list<i64> => rows[0]
const fn through(values: list<i64>) -> list<i64> {
    let named = values
    return named
}
const fn made() -> list<i64> {
    let fresh = [1, 2]
    return fresh
}

# A `var` parameter and what it is also given: the owner's first case.
const fn push_all(var items: list<list<i64>>, more: list<list<i64>>) {
    for row in more { append(items, row) }
}
const fn both(var left: list<i64>, var right: list<i64>) {
    append(left, 1)
    append(right, 2)
}

# A `let` that is read after its place changed: in the rest of its
# block, and the next time round a loop.
const fn latest(count: i64) -> list<i64> {
    var rows: list<list<i64>> = [[0]]
    var seen: list<i64> = []
    var i: i64 = 0
    while i < count {
        let last = rows[i]
        append(rows, [i + 1])
        append(rows[i], 9)
        extend(seen, last)
        i += 1
    }
    return seen
}
const fn chosen(flag: bool) -> list<i64> {
    var left: list<i64> = [1]
    var right: list<i64> = [2]
    let picked = if flag { left } else { right }
    append(left, 9)
    append(right, 9)
    return picked
}
# A `let` whose place is changed no more while the name is in scope is a
# reference: it reads the place's own list.
const fn peeked() -> i64 {
    var rows: list<list<i64>> = [[1], [2]]
    append(rows, [3])
    let last = rows[2]
    return last[0]
}
const fn summed(rows: list<list<i64>>) -> i64 {
    var total: i64 = 0
    for row in rows {
        for value in row { total += value }
    }
    return total
}

test what_is_kept_is_a_copy {
    # A function's own result is the caller's: growing it changes no other.
    var mine: list<i64> = built(2)
    append(mine, 9)
    assert mine == [0, 1, 9] && built(2) == [0, 1]
    assert made() == [1, 2]
    # A part of what a function was given comes back as a copy.
    var rows: list<list<i64>> = [[1], [2]]
    var row: list<i64> = first_row(rows)
    append(row, 5)
    var named: list<i64> = through(row)
    append(named, 6)
    assert rows == [[1], [2]] && row == [1, 5] && named == [1, 5, 6]
    # What a place is assigned, and what is put inside one, is a copy.
    let source = [7, 8]
    var book = Book(orders: source, name: "a")
    append(book.orders, 9)
    book.orders[0] = 0
    assert source == [7, 8] && book.orders == [0, 8, 9]
    var books: dict<str, list<i64>> = []
    books["a"] = source
    append(books["a"], 1)
    assert source == [7, 8] && books == ["a": [7, 8, 1]]
}

test a_reference_is_copied_where_its_place_changes {
    assert latest(2) == [0, 1]
    assert chosen(true) == [1] && chosen(false) == [2]
    var rows: list<list<i64>> = [[1], [2]]
    assert peeked() == 3 && summed(rows) == 3
    # The call has a `var` reference to what it is also given.
    push_all(rows, rows)
    assert rows == [[1], [2], [1], [2]]
    append(rows[0], 4)
    assert rows == [[1, 4], [2], [1], [2]]
    # Two `var` parameters given one place: each has a value of its own,
    # and the place is given them in the order of the parameters.
    var twice: list<i64> = [0]
    both(twice, twice)
    assert twice == [0, 2]
}
