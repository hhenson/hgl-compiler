module demo.generics_fixes_wave3

# How a candidate is selected for each instance of a generic function,
# where a generic parameter of that function selects it.

operator kind_of<T>(value: T) -> i64
impl const fn kind_of(value: i64) -> i64 => 1
impl const fn kind_of<T>(value: T) -> i64 requires !(T == i64) => 2

# GEN-3: "under negation/disjunction it only tests already-resolved
# data": `!(T == i64)` is not told of `U` while `U` is not given. Each
# instance selects its own candidate (GEN-5: "Concrete types outrank
# variables"), through another instance too, in a graph, and for a
# symbol: core's `<` is for a `T` among the ordered types.
const fn wrap<U>(value: U) -> i64 => kind_of(value)
const fn twice<U>(value: U) -> i64 => kind_of(value) + kind_of(value)
const fn relay<V>(value: V) -> i64 => wrap(value)
fn wired<U>(value: U) -> i64 => kind_of(value)
const fn less<T>(a: T, b: T) -> bool => a < b

test a_type_parameter_selects_a_candidate_for_each_instance {
    assert wrap(5) == 1
    assert wrap(true) == 2
    assert wrap("s") == 2
    assert twice(5) == 2
    assert twice(1.5) == 4
    assert relay(5) == 1
    assert relay(false) == 2
    assert eval(wired(value: [5, 6])) == [1, 1]
    assert eval(wired(value: [true])) == [2]
    assert less(1, 2)
    assert !less("b", "a")
}

# GEN-6: "A call admits the candidate only where that holds for the
# parameter's value at the call, a default included." Core's division
# selects by its `zero` option, which a generic value parameter gives.
const fn ratio<const Z: ZeroPolicy>(a: f64, b: f64) -> f64 => div_(a, b, zero: Z)
const fn checked<const Z: ZeroPolicy>(a: f64, b: f64) -> result<f64, error> => div_(a, b, zero: Z)
const fn quietly<const Z: ZeroPolicy = .nan>(a: f64, b: f64) -> f64 => ratio<Z>(a, b)

test an_option_a_generic_parameter_gives_selects_for_each_instance {
    assert ratio<.ieee>(1.0, 4.0) == 0.25
    assert ratio<.ieee>(1.0, 0.0) > 1.0e300
    let nan = ratio<.nan>(1.0, 0.0)
    assert nan != nan
    let failed = quietly(1.0, 0.0)
    assert failed != failed
    assert is_err(checked<.error>(1.0, 0.0))
    assert is_ok(checked<.error>(1.0, 2.0))
}

# UNIT-13: "A constant is read by its name wherever an ordinary value
# is": in a `requires`, compared with a generic value parameter, and in
# the set it is compared with.
const THREE: i64 = 3
const fn named<const N: i64>(v: i64) -> i64 requires N == THREE => v + N
const fn among<const N: i64>(v: i64) -> i64 requires N in {THREE, 5} => v + N

test a_constant_in_a_requires_is_read_by_its_name {
    assert named<3>(1) == 4
    assert among<5>(1) == 6
}
