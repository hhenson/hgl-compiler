module m
fn both(flag: bool, a: i64, b: i64) -> i64 {
    var chosen = a
    let taken = if flag {
        chosen = b
        a
    } else {
        a
    }
    return chosen + taken
}
fn both_var(flag: bool, a: i64, b: i64) -> i64 {
    var chosen = a
    var taken = if flag { chosen = b
 a } else { a }
    return chosen + taken
}
fn nested_let(outer: bool, flag: bool, a: i64, b: i64) -> i64 {
    var chosen = a
    if outer {
        let taken = if flag { chosen = b
 a } else { a }
    }
    return chosen
}
fn twice<const k: i64>(route: i64, a: i64) -> i64 {
    switch route {
        case k: return a * 10
        case 1: return a * 100
        default: return a
    }
}
fn at_one(route: i64, a: i64) -> i64 => twice<1>(route, a)
