module unwritten

const fn digits(values: list<i64>) -> i64 {
    var code: i64 = 0
    for value in values { code = code * 10 + value }
    return code
}

fn edited(command: i64) -> list<i64> {
    inject out
    when {
        if command == 0 { return [1, 2, 3] }
        # TYPE-16 does not say what an entry at or past the size written
        # with it is.
        if command == 1 { return delta<list<i64>>(updated: [4: 1], size_modified: 2) }
        # EXPR-3: "An index outside a list fails where it is evaluated".
        out[5] = 1
    }
}

fn digits_of(command: i64) -> i64 => digits(edited(command))

test an_entry_past_the_size_written_with_it {
    let taken = eval(digits_of(command: [0, 1]))
}

test a_position_of_out_past_the_list {
    let taken = eval(digits_of(command: [0, 2]))
}

# An empty list assigned to a position of `out`, which has no port of its
# own where the assignment is written.
fn rows(command: i64) -> list<list<i64>> {
    inject out
    when {
        if command == 0 { return delta<list<list<i64>>>(size_modified: 1) }
        out[0] = []
    }
}

const fn width(values: list<list<i64>>) -> i64 {
    var count: i64 = 0
    for row in values { count += 1 }
    return count
}

fn row_width(command: i64) -> i64 => width(rows(command))

test an_empty_list_assigned_to_a_position_of_out {
    let taken = eval(row_width(command: [0, 1]))
}
