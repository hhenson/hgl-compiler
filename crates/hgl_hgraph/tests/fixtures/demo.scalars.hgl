module demo.scalars

# TYPE-1, TYPE-2, TYPE-17: each scalar as a temporal input and result.
fn pass_bool(value: bool) -> bool { when { return delta_value(value) } }
fn pass_i64(value: i64) -> i64 { when { return delta_value(value) } }
fn pass_f64(value: f64) -> f64 { when { return delta_value(value) } }
fn pass_str(value: str) -> str { when { return delta_value(value) } }
fn pass_bytes(value: bytes) -> bytes { when { return delta_value(value) } }
fn pass_date(value: date) -> date { when { return delta_value(value) } }
fn pass_time(value: time) -> time { when { return delta_value(value) } }
fn pass_instant(value: datetime) -> datetime { when { return delta_value(value) } }
fn pass_civil(value: civil_datetime) -> civil_datetime { when { return delta_value(value) } }
fn pass_duration(value: duration) -> duration { when { return delta_value(value) } }
fn pass_tenor(value: tenor) -> tenor { when { return delta_value(value) } }
fn pass_zone(value: timezone) -> timezone { when { return delta_value(value) } }
fn pass_zoned(value: zoned_datetime) -> zoned_datetime { when { return delta_value(value) } }
fn pass_zoned_time(value: zoned_time) -> zoned_time { when { return delta_value(value) } }

# TYPE-14: a temporal `T?` of each scalar this file adds.
fn maybe_bytes(value: bytes?) -> bytes? { when { return delta_value(value) } }
fn maybe_tenor(value: tenor?) -> tenor? { when { return delta_value(value) } }
fn maybe_zone(value: timezone?) -> timezone? { when { return delta_value(value) } }
fn maybe_zoned(value: zoned_datetime?) -> zoned_datetime? { when { return delta_value(value) } }
fn maybe_zoned_time(value: zoned_time?) -> zoned_time? { when { return delta_value(value) } }

# A scalar as configuration of a node.
fn zoned_on(tick: bool, const zone: timezone, const lag: tenor) -> tenor {
    when {
        if zone == @[Europe/London] { return lag }
        return -lag
    }
}

# OPS-1: a zoned datetime and a duration, lifted.
const fn later(at: zoned_datetime, by: duration) -> zoned_datetime => at + by
const fn earlier(at: zoned_datetime, by: duration) -> zoned_datetime => at - by

# TYPE-1, TYPE-2, TYPE-17: each scalar is published and read back whole.
test scalars_are_temporal_values {
    assert eval pass_bool(value: [false, true]) == [false, true]
    assert eval pass_i64(value: [0, -9223372036854775807 - 1]) == [0, -9223372036854775807 - 1]
    assert eval pass_f64(value: [0.0, -0.0, 1.5]) == [0.0, -0.0, 1.5]
    assert signed(-0.0) == "-0.0" && signed(0.0) == "0.0"
    assert eval passed_sign(value: [0.0, -0.0, 1.5]) == [signed(0.0), signed(-0.0), signed(1.5)]
    assert eval pass_str(value: ["", "h\u{e9}"]) == ["", "h\u{e9}"]
    assert eval pass_bytes(value: [convert<bytes>(""), convert<bytes>("h\u{e9}")]) ==
        [convert<bytes>(""), convert<bytes>("h\u{e9}")]
    assert eval pass_date(value: [@0001-01-01, @9999-12-31]) == [@0001-01-01, @9999-12-31]
    assert eval pass_time(value: [@00:00, @23:59:59.999999]) == [@00:00, @23:59:59.999999]
    assert eval pass_instant(value: [@2026-09-03T09:30+01:00]) == [@2026-09-03T08:30Z]
    assert eval pass_civil(value: [@2026-09-03T09:30]) == [@2026-09-03T09:30]
    assert eval pass_duration(value: [0s, -1us, 106751991d]) == [0s, -1us, 106751991d]
    assert eval pass_tenor(value: [0D, 1Y, 2B]) == [0D, 12M, 2B]
    assert eval pass_zone(value: [@[Europe/London], @[Europe/Jersey]]) ==
        [@[Europe/London], @[Europe/Jersey]]
    assert eval pass_zoned(value: [@2026-09-03T09:30+01:00[Europe/London]]) ==
        [@2026-09-03T08:30+01:00[Europe/London] + 1h]
    assert eval pass_zoned_time(value: [@09:30[Europe/London]]) == [@09:30[Europe/London]]
}

# TYPE-14: a null and a value of each, published.
test nullable_scalars_are_temporal_values {
    let empty = convert<bytes>("")
    assert eval maybe_bytes(value: [empty, null, empty]) == [empty, null, empty]
    assert eval maybe_tenor(value: [null, 0D, 0B]) == [null, 0D, 0B]
    assert eval maybe_zone(value: [@[UTC], null]) == [@[UTC], null]
    assert eval maybe_zoned(value: [null, @2026-01-01T00:00Z[UTC]]) == [null, @2026-01-01T00:00Z[UTC]]
    assert eval maybe_zoned_time(value: [@12:00[UTC], null]) == [@12:00[UTC], null]
}

# A scalar given to a node as configuration.
test scalars_configure_a_node {
    assert eval zoned_on(tick: [true], zone: @[Europe/London], lag: 2B) == [2B]
    assert eval zoned_on(tick: [true], zone: @[Europe/Jersey], lag: 1M) == [-1M]
}

# TYPE-2: "Zone aliases are distinct names". Europe/Jersey is a link to
# Europe/London. Two zoned datetimes are compared by core's candidates,
# which take the option `utc` (`demo.scalars_wave3`).
test a_zone_is_its_name {
    assert @[Europe/London] == @[Europe/London]
    assert @[Europe/London] != @[Europe/Jersey]
    assert @09:30[Europe/London] != @09:30[Europe/Jersey]
}

# LEX-12: the offset is consistent with the zone where the instant it
# gives has it there: either offset of a time repeated as the clocks go
# back. OPS-1: a duration is elapsed time, so an hour after the first
# 01:30 is the second, and the offset is the zone's at the instant.
test an_offset_is_the_zones_own {
    let first = @2026-10-25T01:30+01:00[Europe/London]
    let second = @2026-10-25T01:30+00:00[Europe/London]
    assert eval later(at: [first, _, second], by: [1h]) == [second, _, second + 1h]
    assert eval earlier(at: [second], by: [1h]) == [first]
}

# What a probe reads of `watched` each time it ticks: its retained
# payload, or null while it is invalid.
fn held<T>(watched: T, probe: bool) -> T? {
    when modified(probe) && valid([]) {
        if valid(watched) { return watched }
        return null
    }
}

# NUM-2: floating arithmetic "preserves IEEE special values, including
# signed zero", and `-0.0 == 0.0` holds, so a trace compares the two
# equal. OPS-6: their text differs, `-0.0` "after a `-` where its sign is
# negative", so a trace of the text tells them apart.
const fn signed(value: f64) -> str => convert<str>(value)
const fn signed_held(value: f64?) -> str {
    if value == null { return "null" }
    return convert<str>(value)
}
fn passed_sign(value: f64) -> str => signed(pass_f64(value))
fn held_sign(watched: f64, probe: bool) -> str => signed_held(held(watched, probe))

# What either input waking the node sees of `watched`.
fn observed<T>(watched: T, probe: bool) -> str {
    when valid([]) {
        if !valid(watched) { return "invalid" }
        if modified(watched) { return "published" }
        return "retained"
    }
}

# The same, with the payload and the delta as text.
fn described(watched: i64, probe: bool) -> str {
    when valid([]) {
        if !valid(watched) { return "invalid" }
        if modified(watched) { return "published " + convert<str>(delta_value(watched)) }
        return "retained " + convert<str>(watched)
    }
}

fn relay<T>(value: T) -> T { when { return value } }

# `watched` bound to a node's output, not to the eval's input.
fn described_through(value: i64, probe: bool) -> str => described(relay(value), probe)

fn nonfinite(numerator: f64) -> f64 {
    when { return numerator /{zero: .ieee} 0.0 }
}

fn held_text(watched: f64, probe: bool) -> str {
    when modified(probe) && valid([]) {
        if valid(watched) { return convert<str>(watched) }
        return "invalid"
    }
}

fn held_nonfinite(numerator: f64, probe: bool) -> str => held_text(nonfinite(numerator), probe)

fn held_null(probe: bool, watched: i64?) -> str {
    when modified(probe) && valid([]) {
        if !valid(watched) { return "invalid" }
        if watched == null { return "null" }
        return "value"
    }
}

# TIME-1: "A temporal endpoint has validity, modification at the current
# evaluation time, retained data, and publication-delta observations.
# Silence is not a value. An equal publication may still be a new tick."
# At the fifth cycle nothing ticks, and the node is not run.
test an_endpoint_is_observed_four_ways {
    assert eval described(watched: [_, 7, _, 7, _, _], probe: [true, _, true, _, _, true]) ==
        ["invalid", "published 7", "retained 7", "published 7", _, "retained 7"]
    assert eval described_through(value: [_, 7, _, 7, _, _], probe: [true, _, true, _, _, true]) ==
        ["invalid", "published 7", "retained 7", "published 7", _, "retained 7"]
}

# END-1: "A scalar publication makes the endpoint valid and retains its
# payload, including false, zero, empty text, null, NaN, or infinity.
# Silence preserves validity and the retained payload."
test a_publication_is_valid_and_retained {
    assert eval held(watched: [_, false, _], probe: [true, true, true]) == [null, false, false]
    assert eval held(watched: [_, 0, _], probe: [true, true, true]) == [null, 0, 0]
    assert eval held(watched: [_, -0.0, _], probe: [true, true, true]) == [null, -0.0, -0.0]
    assert eval held_sign(watched: [_, -0.0, _], probe: [true, true, true]) ==
        ["null", signed(-0.0), signed(-0.0)]
    assert eval held(watched: [_, "", _], probe: [true, true, true]) == [null, "", ""]
    let empty = convert<bytes>("")
    assert eval held(watched: [_, empty, _], probe: [true, true, true]) == [null, empty, empty]
    assert eval held(watched: [_, 0s, _], probe: [true, true, true]) == [null, 0s, 0s]
    assert eval held(watched: [_, 0D, _], probe: [true, true, true]) == [null, 0D, 0D]
    assert eval held(watched: [_, @[UTC], _], probe: [true, true, true]) == [null, @[UTC], @[UTC]]
    assert eval held_null(watched: [_, null, _, 7], probe: [true, true, true, true]) ==
        ["invalid", "null", "null", "value"]
    assert eval held_nonfinite(numerator: [_, 0.0, _, 1.0, -1.0], probe: [true, true, true, true, true]) ==
        ["invalid", "nan", "nan", "inf", "-inf"]
}

# END-2: "A scalar publication marks its endpoint modified for the
# current cycle, including when the payload repeats. An idle cycle leaves
# the endpoint unmodified and preserves its retained payload. A fixed,
# directly bound input observes its output's state."
test a_publication_is_modified_an_equal_one_included {
    let at = @2026-09-03T09:30+01:00[Europe/London]
    assert eval observed(watched: [false, _, false], probe: [_, true, _]) ==
        ["published", "retained", "published"]
    assert eval observed(watched: [1M, _, 1M], probe: [_, true, _]) ==
        ["published", "retained", "published"]
    assert eval observed(watched: [at, _, at], probe: [_, true, _]) ==
        ["published", "retained", "published"]
    assert eval held(watched: [at, _, at], probe: [_, true, true]) == [_, at, at]
    assert eval relay(value: [2B, 2B, _, 2B]) == [2B, 2B, _, 2B]
}

# NUM-8: "Value and temporal execution preserve the same numerical
# outcomes". Each computation below is called as a value function, and
# lifted over connections of the same operands. Options left out take
# the defaults their candidates declare: `/` of two `f64` `zero: .ieee`,
# `==` no tolerance.
const fn blend(a: f64, b: f64) -> f64 => (a + b) / 3.0
const fn mixed(count: i64, rate: f64) -> f64 => count * rate - 0.1
const fn whole(a: i64, b: i64) -> i64 => a // b * b + a % b
const fn rounded(value: f64) -> i64 => convert<i64>(value, rounding: .half_even, invalid: .fail)
const fn ratio(a: f64, b: f64) -> str => convert<str>(a / b)
const fn same(a: f64, b: f64) -> bool => a == b
const fn near(a: f64, b: f64) -> bool => a =={abs: 1e-9} b
const fn grown(value: i64) -> i64 => value + 1
const fn stretched(span: duration, by: f64) -> duration => span * by

test value_and_temporal_numbers_agree {
    assert blend(0.1, 0.2) == 0.10000000000000002
    assert eval blend(a: [0.1, 1e308], b: [0.2, 1e308]) == [blend(0.1, 0.2), blend(1e308, 1e308)]
    assert mixed(3, 0.1) == 0.20000000000000004
    assert eval mixed(count: [3, -9007199254740993], rate: [0.1, 1.0]) ==
        [mixed(3, 0.1), mixed(-9007199254740993, 1.0)]
    assert whole(-7, 2) == -7
    assert eval whole(a: [-7, 7], b: [2, -2]) == [whole(-7, 2), whole(7, -2)]
    assert rounded(2.5) == 2 && rounded(-3.5) == -4
    assert eval rounded(value: [2.5, -3.5]) == [rounded(2.5), rounded(-3.5)]
    assert ratio(0.0, 0.0) == "nan" && ratio(1.0, -0.0) == "-inf"
    assert eval ratio(a: [0.0, 1.0, 1.0], b: [0.0, -0.0, 3.0]) ==
        [ratio(0.0, 0.0), ratio(1.0, -0.0), ratio(1.0, 3.0)]
    assert !same(0.1 + 0.2, 0.3) && near(0.1 + 0.2, 0.3)
    assert eval same(a: [0.1 + 0.2], b: [0.3]) == [false]
    assert eval near(a: [0.1 + 0.2], b: [0.3]) == [true]
    assert stretched(3us, 0.5) == 2us
    assert eval stretched(span: [3us, 1us], by: [0.5]) == [stretched(3us, 0.5), stretched(1us, 0.5)]
}

# NUM-8: an outcome outside the type's range is the same error both ways.
test value_and_temporal_errors_agree {
    assert raises("numeric.out_of_range") { grown(9223372036854775807) }
    assert raises("numeric.out_of_range") { eval grown(value: [1, 9223372036854775807]) }
}
