module m
struct Book {
    prices: rolling_window<f64, 3, 1>
    last: f64
}
fn collect(price: f64) -> rolling_window<f64, 3, 1> {
    when { return price }
}
fn arrived(prices: rolling_window<f64, 3, 1>) -> f64 {
    when { return delta_value(prices) }
}
fn booked(price: f64) -> Book {
    when { return delta<Book>(prices: price, last: price) }
}
fn last(book: Book) -> f64 {
    when valid(book.last) { return book.last }
}
fn routed(flag: bool, price: f64) -> f64 {
    let w = collect(price)
    if flag { return arrived(w) } else { return 0.0 }
}
fn routed_book(flag: bool, price: f64) -> f64 {
    let b = booked(price)
    if flag { return last(b) } else { return 0.0 }
}
fn keyed(key: str, price: f64) -> dict<str, rolling_window<f64, 3, 1>> {
    when { return delta<dict<str, rolling_window<f64, 3, 1>>>(updated: [key: price]) }
}
fn watched(prices: rolling_window<f64, 3, 1>) {
    when { let seen = delta_value(prices) }
}
fn each(key: str, price: f64) {
    for name, window in keyed(key, price) { watched(window) }
}
fn twice(price: f64) -> rolling_window<f64, 3, 1> {
    inject out
    when {
        out = price
        out = price + 1.0
    }
}
fn looped(price: f64) -> rolling_window<f64, 3, 1> {
    inject out
    when {
        for step in [1.0, 2.0] { out = price + step }
    }
}
fn then_returned(price: f64) -> Book {
    inject out
    when { out = delta<Book>(last: price) }
    when { return delta<Book>(prices: price) }
}
fn returns(price: f64) -> rolling_window<f64, 3, 1> {
    when {
        if price < 0.0 { return 0.0 }
        return price
    }
}
