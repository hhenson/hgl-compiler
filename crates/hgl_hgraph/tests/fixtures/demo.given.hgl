module demo.given

fn pass(value: i64) -> i64 {
    when { return delta_value(value) }
}

const fn ticks(seen: list<tuple<datetime, i64>>) -> i64 {
    var count = 0
    for tick in seen { count += 1 }
    return count
}

const fn total(seen: list<tuple<datetime, i64>>) -> i64 {
    var sum = 0
    for tick in seen { sum += tick[1] }
    return sum
}

# The instants are in time order, a smallest step for each
# position apart.
const fn ordered(seen: list<tuple<datetime, i64>>) -> bool => seen[0][0] < seen[1][0]

test given {
    assert ticks(eval pass(value: [7, _, 7, 9])) == 3
    let seen = eval pass(value: [_, 1, _, 2])
    assert total(seen) == 3
    assert ordered(seen)
    assert ticks(eval pass(value: [_, _])) == 0
}
