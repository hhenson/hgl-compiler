module demo.entries

# A function whose result cannot be the dictionary: it is lent it.
const fn count_of(counts: dict<str, i64>, name: str) -> i64 {
    let found = get(counts, name)
    if found != null { return found }
    return 0
}

# A dictionary built an entry at a time, each read and then assigned.
const fn counted(names: list<str>) -> dict<str, i64> {
    var counts: dict<str, i64> = []
    for name in names {
        counts[name] = count_of(counts, name) + 1
    }
    return counts
}

const fn same<T>(value: T) -> T { return value }

# A `var` parameter's element is assigned by making a new list:
# where the call fails the caller's list is as it was (FN-15).
const fn replaced(var items: list<i64>, value: i64) { items[0] = value }

const fn failing(var items: list<i64>, zero: i64) {
    items[0] = 9
    let quotient = 1 //{zero: .fail} zero
}

test entries {
    # A `let` is the dictionary as it was, however the place changes.
    var book: dict<str, i64> = ["a": 1]
    let before = book
    book["b"] = 2
    assert before == ["a": 1]
    assert book == ["a": 1, "b": 2]
    assert count_of(book, "b") == 2
    let through = same(book)
    book["a"] = 5
    assert through == ["a": 1, "b": 2]
    assert book == ["a": 5, "b": 2]
    assert counted(["x", "y", "x"]) == ["x": 2, "y": 1]
    # An element of a list.
    var items: list<i64> = [1, 2, 3]
    let was = items
    items[1] = 9
    items[1] += 1
    assert was == [1, 2, 3]
    assert items == [1, 10, 3]
    replaced(items, 7)
    assert items == [7, 10, 3]
    # FN-15: "A function that fails leaves the place holding what its
    # parameter held when it failed: no change it had made is undone."
    assert raises("numeric.division_by_zero") { failing(items, 0) }
    assert items == [9, 10, 3]
    # A collection inside another is given a new value, and what
    # took it before is as it was.
    var rows: dict<str, list<i64>> = ["a": [1]]
    let row = rows["a"]
    rows["a"][0] = 2
    rows["b"] = items
    items[0] = 0
    assert row == [1]
    assert rows == ["a": [2], "b": [9, 10, 3]]
}
