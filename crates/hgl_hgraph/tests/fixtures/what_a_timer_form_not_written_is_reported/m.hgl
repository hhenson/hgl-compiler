module m
fn started(value: i64) -> bool {
    state seen: bool = false
    inject scheduler
    start {
        seen = modified([])
        schedule(scheduler, 1s)
    }
    when { return seen }
}
fn stopped(value: i64) -> bool {
    state seen: bool = false
    inject alarm
    start { schedule(alarm, 1s) }
    when { return seen }
    stop { seen = !modified([]) }
}
const EVERY: duration = 2s
const NONE: duration = 0s
const fn zero(scheduler: Scheduler) { schedule(scheduler, 0s) }
const fn given(scheduler: Scheduler, delay: duration) { schedule(scheduler, delay, tag: "t") }
const fn constant_zero(alarm: Alarm) { schedule(alarm, NONE) }
const fn more_than_zero(alarm: Alarm) {
    schedule(alarm, 1s)
    schedule(alarm, EVERY)
    schedule(alarm, never)
    schedule(alarm, 1s + 1s)
    schedule(alarm, TWO * 2)
    schedule(alarm, -(1s - 2s))
}
const TWO: duration = 1s + 1s
const fn cancelled(alarm: Alarm) { schedule(alarm, 1s - 1s) }
