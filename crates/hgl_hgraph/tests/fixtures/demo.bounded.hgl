module demo.bounded
fn pass(value: i64) -> i64 {
    when { return delta_value(value) }
}
const fn first(seen: list<tuple<datetime, i64>>) -> datetime => seen[0][0]
const later: datetime = earliest_start + 10us
test a_run_is_bounded {
    assert eval{length: 2us} pass(value: [1, 2, 3, 4, 5]) == [1, 2]
    assert eval{end: earliest_start + 3us} pass(value: [1, 2, 3, 4, 5]) == [1, 2, 3]
    assert eval pass(value: [1, 2, 3]) == [1, 2, 3]
    # A run that ends where it starts has no cycle.
    assert eval{length: 0us} pass(value: [1, 2, 3]) == []
    # TST-6: the first cell of a trace is at the run's start.
    assert first(eval{start: later} pass(value: [7])) == later
    assert first(eval pass(value: [7])) == earliest_start
    assert eval{start: later, length: 2us} pass(value: [1, 2, 3]) == [1, 2]
    # The cells of a run with a later start are counted from that start.
    let day: datetime = @2026-09-03T09:30:00Z
    assert eval{start: day} pass(value: [1, _, 3]) == [1, _, 3]
    assert first(eval{start: day} pass(value: [7])) == day
    # A trace that is only given to a `const fn` is not written dense:
    # a publication a second after the start is a million cells on.
    assert first(eval slow()) == earliest_start + 1s
}
fn slow() -> i64 {
    yield 1s: 1
}
