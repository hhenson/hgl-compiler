module demo.defaults

const fn base() -> i64 => 2

const fn scale(value: i64, factor: i64 = base()) -> i64 => value * factor

fn offset(value: i64, const by: i64 = 10) -> i64 {
    when { return value + by }
}

fn wired(value: i64) -> i64 => offset(value)

test defaults {
    assert scale(3) == 6
    assert scale(3, 5) == 15
    assert eval(offset(value: [1])) == [11]
    assert eval(offset(value: [1], by: 1)) == [2]
    assert eval(wired(value: [5])) == [15]
}
