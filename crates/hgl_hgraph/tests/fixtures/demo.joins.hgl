module demo.joins

operator join_<L, R, O>(lhs: L, rhs: R) -> O

# A node, with state and a start.
impl fn join_(lhs: i64, rhs: i64) -> i64 {
    state seen: i64 = 0
    start { seen = 100 }
    when valid(lhs, rhs) {
        seen = seen + 1
        return lhs + rhs + seen
    }
}
# A value candidate of the same parameter types.
impl const fn join_(lhs: i64, rhs: i64) -> i64 => lhs - rhs
# A graph, of the node.
impl fn join_(lhs: i64, rhs: bool) -> i64 => join_(lhs, lhs)
# A value candidate alone: lifted in a graph.
impl const fn join_(lhs: str, rhs: str) -> str => lhs + rhs

export const fn plain(a: i64, b: i64) -> i64 => join_(a, b)
