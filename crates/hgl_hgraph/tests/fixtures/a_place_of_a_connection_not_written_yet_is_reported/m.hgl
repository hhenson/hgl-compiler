module m
struct Quote {
    bid: i64
    ask: i64
}
fn atomic_quote(a: i64) -> atomic<Quote> {
    when { return Quote(bid: a, ask: a) }
}
fn atomic_placed(a: i64, b: i64) -> i64 {
    var quote = atomic_quote(a)
    quote.bid = b
    return quote.bid
}
fn keyed(a: i64) -> dict<str, i64> {
    when { return ["a": a] }
}
fn keyed_placed(a: i64, b: i64) -> i64 {
    var book = keyed(a)
    book["b"] = b
    return book["a"]
}
fn grown(a: i64) -> list<i64> {
    when { return [a] }
}
fn grown_placed(a: i64, b: i64) -> i64 {
    var rows = grown(a)
    rows[0] = b
    return rows[0]
}
