module demo.validity_wave3

# TIME-9: "`all_valid` is true where every one is, by its own `valid`,
# one level deep, an optional child aside: one whose type is `T?`, or a
# field that TYPE-4 makes optional, is not asked." TIME-1: "In the value
# it reads, an optional child (TIME-9) that is not valid is null, and
# `valid` of that child tells it from a published null (TYPE-15)."

struct Noted {
    bid: i64
    note: str?
}

# The bid alone, then a published null note, then a note.
fn write_noted(step: i64) -> Noted {
    when {
        if step == 0 { return delta<Noted>(bid: 5) }
        if step == 1 { return delta<Noted>(note: delta<str?>()) }
        return delta<Noted>(note: delta<str?>(value: "n"))
    }
}

const fn note_of(quote: Noted) -> str {
    let note = quote.note
    if note == null { return "null" }
    return note
}

fn read_noted(probe: bool, quote: Noted) -> list<bool, 3> {
    when modified(probe) && valid([]) {
        return [valid(quote), all_valid(quote), valid(quote.note)]
    }
}

fn noted_validity(probe: bool, step: i64) -> list<bool, 3> => read_noted(probe, write_noted(step))

test a_struct_is_all_valid_without_its_optional_field {
    assert eval noted_validity(
        probe: [true, true, true, true],
        step:  [   _,    0,    1,    2],
    ) == [[false, false, false], [true, true, false], [true, true, true], [true, true, true]]
}

# The whole value under `all_valid`: the note null where it is not
# valid, and where a null is published.
fn whole_noted(quote: Noted) -> str {
    when all_valid(quote) { return note_of(quote) }
}

fn whole_noted_of(step: i64) -> str => whole_noted(write_noted(step))

test a_whole_struct_reads_null_for_an_optional_field_not_valid {
    assert eval whole_noted_of(step: [0, 1, 2]) == ["null", "null", "n"]
}

# The note alone is no all valid struct: its bid is required.
fn note_first(step: i64) -> Noted {
    when {
        if step == 0 { return delta<Noted>(note: delta<str?>(value: "n")) }
        return delta<Noted>(bid: 1)
    }
}

fn note_first_validity(probe: bool, step: i64) -> list<bool, 3> =>
    read_noted(probe, note_first(step))

test a_required_field_is_still_asked {
    assert eval note_first_validity(
        probe: [true, true],
        step:  [   0,    1],
    ) == [[true, false, true], [true, true, true]]
}

# Two optional fields beside two required ones.
struct Level {
    price: i64
    size: i64
    venue: str?
    flag: bool?
}

fn write_level(step: i64) -> Level {
    when {
        if step == 0 { return delta<Level>(price: 1) }
        if step == 1 { return delta<Level>(venue: delta<str?>(value: "x")) }
        return delta<Level>(size: 2)
    }
}

fn level_all_valid(probe: bool, level: Level) -> bool {
    when modified(probe) && valid([]) { return all_valid(level) }
}

fn level_validity(probe: bool, step: i64) -> bool => level_all_valid(probe, write_level(step))

test only_the_required_fields_are_asked {
    assert eval level_validity(
        probe: [true, true, true],
        step:  [   0,    1,    2],
    ) == [false, false, true]
}

# Every field optional: `all_valid` asks none, and is the struct's
# `valid` (TIME-9, proposed: "`all_valid` of a collection that is not
# valid is false").
struct Tags {
    first: str?
    second: str?
}

fn write_tags(step: i64) -> Tags {
    when { return delta<Tags>(first: delta<str?>(value: "a")) }
}

fn tags_validity_of(probe: bool, tags: Tags) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [valid(tags), all_valid(tags)] }
}

fn tags_validity(probe: bool, step: i64) -> list<bool, 2> =>
    tags_validity_of(probe, write_tags(step))

test a_struct_of_optional_fields_is_all_valid_once_valid {
    assert eval tags_validity(probe: [true, true], step: [_, 0]) == [[false, false], [true, true]]
}

# TYPE-4: "the `value: T` of a `Box<i64?>`" is optional.
struct Box<T> {
    value: T
    tag: i64
}

fn write_box(tag: i64) -> Box<i64?> {
    when { return delta<Box<i64?>>(tag: tag) }
}

const fn boxed_or(boxed: Box<i64?>) -> i64 {
    let value = boxed.value
    if value == null { return -boxed.tag }
    return value
}

fn read_box(boxed: Box<i64?>) -> i64 {
    when all_valid(boxed) { return boxed_or(boxed) }
}

fn box_read(tag: i64) -> i64 => read_box(write_box(tag))

test a_generic_field_given_a_nullable_is_optional {
    assert eval box_read(tag: [3]) == [-3]
}

# A tuple's position of a `T?`.
fn write_first(value: i64) -> tuple<i64, str?> {
    when {
        let only_first: delta<tuple<i64, str?>> = (value, null)
        return only_first
    }
}

const fn second_or(pair: tuple<i64, str?>) -> str {
    let second = pair[1]
    if second == null { return "none" }
    return second
}

fn pair_read(probe: bool, pair: tuple<i64, str?>) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [all_valid(pair), valid(pair[1])] }
}

fn pair_whole(pair: tuple<i64, str?>) -> str {
    when all_valid(pair) { return second_or(pair) }
}

fn pair_validity(probe: bool, value: i64) -> list<bool, 2> => pair_read(probe, write_first(value))

fn pair_whole_of(value: i64) -> str => pair_whole(write_first(value))

test a_tuple_is_all_valid_without_its_optional_position {
    assert eval pair_validity(probe: [true, true], value: [_, 4]) == [[false, false], [true, false]]
    assert eval pair_whole_of(value: [4]) == ["none"]
}

# A fixed list of `i64?`: every element optional.
fn write_slot(slot: i64, reading: i64) -> list<i64?, 2> {
    when { return delta<list<i64?, 2>>(updated: [slot: delta<i64?>(value: reading)]) }
}

const fn nulls(values: list<i64?, 2>) -> i64 {
    var count: i64 = 0
    for value in values {
        if value == null { count += 1 }
    }
    return count
}

fn slots_read(probe: bool, values: list<i64?, 2>) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [all_valid(values), valid(values[1])] }
}

fn slots_whole(values: list<i64?, 2>) -> i64 {
    when all_valid(values) { return nulls(values) }
}

fn slots_validity(probe: bool, slot: i64, reading: i64) -> list<bool, 2> =>
    slots_read(probe, write_slot(slot, reading))

fn slots_whole_of(slot: i64, reading: i64) -> i64 => slots_whole(write_slot(slot, reading))

test a_fixed_list_of_optionals_is_all_valid_once_valid {
    assert eval slots_validity(
        probe:   [true, true, true],
        slot:    [   _,    0,    1],
        reading: [   _,    7,    8],
    ) == [[false, false], [true, false], [true, true]]
    assert eval slots_whole_of(slot: [0, 1], reading: [7, 8]) == [1, 0]
}

# A growing list of `i64?` with a gap: all valid, the gap null.
fn maybes(command: i64) -> list<i64?> {
    when {
        if command == 0 { return delta<list<i64?>>(updated: [0: delta<i64?>(value: 1)]) }
        return delta<list<i64?>>(updated: [2: delta<i64?>(value: 3)])
    }
}

const fn count_nulls(values: list<i64?>) -> i64 {
    var count: i64 = 0
    for value in values {
        if value == null { count += 1 }
    }
    return count
}

fn maybes_read(probe: bool, values: list<i64?>) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [all_valid(values), valid(values[1])] }
}

fn maybes_whole(values: list<i64?>) -> i64 {
    when all_valid(values) { return count_nulls(values) }
}

fn maybes_validity(probe: bool, command: i64) -> list<bool, 2> => maybes_read(probe, maybes(command))

fn maybes_whole_of(command: i64) -> i64 => maybes_whole(maybes(command))

test a_growing_list_of_optionals_is_all_valid_with_a_gap {
    assert eval maybes_validity(probe: [true, true], command: [0, 1]) == [[true, false], [true, false]]
    assert eval maybes_whole_of(command: [0, 1]) == [0, 1]
}

# A dictionary of `i64?`: every entry optional.
fn book(price: i64) -> dict<str, i64?> {
    when {
        if price < 0 { return delta<dict<str, i64?>>(updated: ["a": delta<i64?>()]) }
        return delta<dict<str, i64?>>(updated: ["a": delta<i64?>(value: price)])
    }
}

fn book_read(probe: bool, entries: dict<str, i64?>) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [valid(entries), all_valid(entries)] }
}

fn book_validity(probe: bool, price: i64) -> list<bool, 2> => book_read(probe, book(price))

test a_dictionary_of_optionals_is_all_valid_once_valid {
    assert eval book_validity(probe: [true, true, true], price: [_, -1, 4]) == [
        [false, false],
        [true, true],
        [true, true],
    ]
}

# A child that is a struct: `all_valid(rows[0])` asks its own required
# fields alone, and `all_valid(rows)` each row's `valid`.
fn write_row(step: i64) -> list<Noted, 2> {
    when {
        if step == 0 { return delta<list<Noted, 2>>(updated: [0: delta<Noted>(bid: 1)]) }
        return delta<list<Noted, 2>>(updated: [1: delta<Noted>(note: delta<str?>(value: "n"))])
    }
}

fn rows_read(probe: bool, rows: list<Noted, 2>) -> list<bool, 3> {
    when modified(probe) && valid([]) {
        return [all_valid(rows[0]), all_valid(rows[1]), all_valid(rows)]
    }
}

fn rows_validity(probe: bool, step: i64) -> list<bool, 3> => rows_read(probe, write_row(step))

test a_childs_all_valid_asks_its_required_fields {
    assert eval rows_validity(probe: [true, true], step: [0, 1]) == [
        [true, false, false],
        [true, false, true],
    ]
}

# A struct within: one level deep, the inner struct by its own `valid`.
struct Pair {
    bid: i64
    ask: i64
}

struct Outer {
    inner: Pair
    tag: str?
}

fn write_outer(price: i64) -> Outer {
    when { return delta<Outer>(inner: delta<Pair>(bid: price)) }
}

fn outer_read(probe: bool, outer: Outer) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [all_valid(outer), all_valid(outer.inner)] }
}

fn outer_validity(probe: bool, price: i64) -> list<bool, 2> => outer_read(probe, write_outer(price))

test all_valid_is_one_level_deep_beside_an_optional_field {
    assert eval outer_validity(probe: [true, true], price: [_, 1]) == [[false, false], [true, false]]
}

# `all_valid(out)`, of a struct with an optional field.
fn self_noted(bid: i64) -> Noted {
    inject out
    when {
        let before = all_valid(out)
        out = delta<Noted>(bid: bid)
        if before { out = delta<Noted>(note: delta<str?>(value: "again")) }
    }
}

const fn note_or_none(quote: Noted) -> str => note_of(quote)

fn self_noted_note(bid: i64) -> str => note_or_none(self_noted(bid))

test all_valid_of_out_asks_its_required_fields {
    assert eval self_noted_note(bid: [1, 2]) == ["null", "again"]
}

# Two inputs of one struct type, each by its own `all_valid`.
fn both_noted(first: Noted, second: Noted) -> list<str, 2> {
    when all_valid(first) && all_valid(second) { return [note_of(first), note_of(second)] }
}

fn both_of(first: i64, second: i64) -> list<str, 2> =>
    both_noted(write_noted(first), write_noted(second))

test two_structs_are_each_asked {
    assert eval both_of(first: [0, _, 2], second: [_, 0, _]) == [
        _,
        ["null", "null"],
        ["n", "null"],
    ]
}

# FN-12: "A struct, a tuple and a fixed-size list need `all_valid`, and
# an optional child that is not valid is passed as null." FN-11: "one
# that is valid and not all valid binds no fallback, and the helper is
# not invoked."
fn one_side(is_bid: bool, price: i64) -> Pair {
    when {
        if is_bid { return delta<Pair>(bid: price) }
        return delta<Pair>(ask: price)
    }
}

const fn spread(pair: Pair) -> i64 => pair.ask - pair.bid

fn lifted_spread(is_bid: bool, price: i64) -> i64 => spread(one_side(is_bid, price))

fn lifted_note(step: i64) -> str => note_of(write_noted(step))

test a_lifted_helper_waits_for_all_valid {
    assert eval lifted_spread(is_bid: [true, false], price: [1, 4]) == [_, 3]
    assert eval lifted_note(step: [0, 1, 2]) == ["null", "null", "n"]
}

const fn first_plus(pair: tuple<i64, i64>) -> i64 => pair[0] + pair[1]

fn one_position(first: bool, value: i64) -> tuple<i64, i64> {
    when {
        let only_first: delta<tuple<i64, i64>> = (value, null)
        let only_second: delta<tuple<i64, i64>> = (null, value)
        if first { return only_first }
        return only_second
    }
}

fn lifted_tuple(first: bool, value: i64) -> i64 => first_plus(one_position(first, value))

const fn pair_sum(values: list<i64, 2>) -> i64 => values[0] + values[1]

fn one_slot(slot: i64, reading: i64) -> list<i64, 2> {
    when { return delta<list<i64, 2>>(updated: [slot: reading]) }
}

fn lifted_slots(slot: i64, reading: i64) -> i64 => pair_sum(one_slot(slot, reading))

test a_lifted_tuple_and_fixed_list_wait_for_all_valid {
    assert eval lifted_tuple(first: [true, false], value: [1, 2]) == [_, 3]
    assert eval lifted_slots(slot: [0, 1], reading: [1, 2]) == [_, 3]
}

const fn spread_or(probe: bool, pair: Pair = Pair(bid: 0, ask: -1)) -> i64 => pair.ask - pair.bid

fn lifted_fallback(probe: bool, is_bid: bool, price: i64) -> i64 =>
    spread_or(probe, one_side(is_bid, price))

test a_lifted_default_is_bound_only_where_the_input_is_not_valid {
    assert eval lifted_fallback(
        probe:  [true, true,  true],
        is_bid: [   _, true, false],
        price:  [   _,    1,     4],
    )  ==       [  -1,    _,     3]
}

# TYPE-16: "A `removed` that names a key a dictionary does not hold is
# ignored, and is no failure, as one that names a member a set does not
# hold is." Core's END-3 has the same.
#
# TIME-7: "A delta that names no change, `delta<set<i64>>()`,
# `delta<dict<str, i64>>()` or `delta<list<i64>>()`, ticks only where it
# changes validity. Where a `list<V>`, a dictionary or a set is not valid,
# never published or invalidated, it makes the value valid and empty, and
# ticks. Where it is valid the delta changes nothing, and is no tick ...
# Where that leaves nothing to publish, a set given the members it holds,
# or an empty list or dictionary given to a valid empty one, the value is
# unchanged, and it is no tick", and "A delta whose every entry is
# ignored, the removal of a key, a member or a position that is not held
# (TYPE-16), names no change too".

# TIME-7's worked example (`examples.empty_deltas`, its `woken` and
# `watched` here `members_woken` and `members_watched`), for a set, and
# as it says "A `list<i64>` written `delta<list<i64>>()`, and a
# `dict<str, i64>` written `delta<dict<str, i64>>()`, tick alike", for a
# dictionary and a list: 0 writes a delta that names no change, 1 a
# whole empty value, 2 a delta that adds, and 3 invalidates.
fn publish_members(step: i64) -> set<i64> {
    inject out
    when {
        if step == 0 { return delta<set<i64>>() }
        if step == 1 { return [] }
        if step == 2 { return delta<set<i64>>(added: [1]) }
        invalidate(out)
    }
}

fn members_woken(members: set<i64>) -> bool {
    when valid([]) { return valid(members) }
}

fn members_watched(step: i64) -> bool => members_woken(publish_members(step))

const fn member_count(members: set<i64>) -> i64 {
    var count: i64 = 0
    for member in members { count += 1 }
    return count
}

fn members_counted(step: i64) -> i64 => member_count(publish_members(step))

test an_empty_set_delta_ticks_only_where_it_makes_the_set_valid {
    assert eval members_watched(step: [0, 0, 1, 2, 0, 3, 0]) == [true, _, _, true, _, false, true]
    assert eval publish_members(step: [0, 0, 2, 0, 3, 0]) == [
        delta<set<i64>>(),
        _,
        delta<set<i64>>(added: [1]),
        _,
        _,
        delta<set<i64>>(),
    ]
    # Made valid after the invalidation, the set is empty.
    assert eval members_counted(step: [2, 3, 0]) == [1, _, 0]
}

fn publish_book(step: i64) -> dict<str, i64> {
    inject out
    when {
        if step == 0 { return delta<dict<str, i64>>() }
        if step == 1 { return [] }
        if step == 2 { return delta<dict<str, i64>>(updated: ["a": 1]) }
        invalidate(out)
    }
}

fn book_woken(prices: dict<str, i64>) -> bool {
    when valid([]) { return valid(prices) }
}

fn book_watched(step: i64) -> bool => book_woken(publish_book(step))

const fn entry_count(prices: dict<str, i64>) -> i64 {
    var count: i64 = 0
    for key, price in prices { count += 1 }
    return count
}

fn book_counted(step: i64) -> i64 => entry_count(publish_book(step))

test an_empty_dictionary_delta_ticks_only_where_it_makes_the_dictionary_valid {
    assert eval book_watched(step: [0, 0, 1, 2, 0, 3, 0]) == [true, _, _, true, _, false, true]
    assert eval publish_book(step: [0, 0, 2, 0, 3, 0]) == [
        delta<dict<str, i64>>(),
        _,
        delta<dict<str, i64>>(updated: ["a": 1]),
        _,
        _,
        delta<dict<str, i64>>(),
    ]
    assert eval book_counted(step: [2, 3, 0]) == [1, _, 0]
}

fn publish_readings(step: i64) -> list<i64> {
    inject out
    when {
        if step == 0 { return delta<list<i64>>() }
        if step == 1 { return [] }
        if step == 2 { return delta<list<i64>>(updated: [0: 1]) }
        invalidate(out)
    }
}

fn readings_woken(readings: list<i64>) -> bool {
    when valid([]) { return valid(readings) }
}

fn readings_watched(step: i64) -> bool => readings_woken(publish_readings(step))

const fn reading_count(readings: list<i64>) -> i64 {
    var count: i64 = 0
    for reading in readings { count += 1 }
    return count
}

fn readings_counted(step: i64) -> i64 => reading_count(publish_readings(step))

test an_empty_list_delta_ticks_only_where_it_makes_the_list_valid {
    assert eval readings_watched(step: [0, 0, 1, 2, 0, 3, 0]) == [true, _, _, true, _, false, true]
    assert eval readings_counted(step: [2, 3, 0]) == [1, _, 0]
}

# From a trace's cell, TST-5: "A cell that is a delta naming no change
# is a tick only where it makes the value valid, as such a `return` is
# (TIME-7): given to a valid input it wakes no reader".
fn relay_book(entries: dict<str, i64>) -> dict<str, i64> {
    when { return delta_value(entries) }
}

test a_cell_that_names_no_change_ticks_only_where_it_makes_the_input_valid {
    assert eval relay_book(entries: [
        delta<dict<str, i64>>(),
        delta<dict<str, i64>>(),
        delta<dict<str, i64>>(updated: ["a": 1]),
    ]) == [
        delta<dict<str, i64>>(),
        _,
        delta<dict<str, i64>>(updated: ["a": 1]),
    ]
}

# TIME-7: a delta whose every entry is an ignored removal names no
# change. A removal beside a change keeps the change.
fn edit_book(command: i64) -> dict<str, i64> {
    when {
        if command == 0 { return delta<dict<str, i64>>(updated: ["a": 1]) }
        if command == 1 { return delta<dict<str, i64>>(removed: ["zz"]) }
        return delta<dict<str, i64>>(updated: ["b": 2], removed: ["zz", "a"])
    }
}

fn book_valid(probe: bool, entries: dict<str, i64>) -> bool {
    when modified(probe) && valid([]) { return valid(entries) }
}

fn edit_book_valid(probe: bool, command: i64) -> bool => book_valid(probe, edit_book(command))

test removing_a_key_the_dictionary_does_not_hold_is_ignored {
    assert eval edit_book(command: [0, 1, 2]) == [
        delta<dict<str, i64>>(updated: ["a": 1]),
        _,
        delta<dict<str, i64>>(updated: ["b": 2], removed: ["a"]),
    ]
    # Where the dictionary is not valid, it is made valid and empty.
    assert eval edit_book(command: [1, 1, 0]) == [
        delta<dict<str, i64>>(),
        _,
        delta<dict<str, i64>>(updated: ["a": 1]),
    ]
    assert eval edit_book_valid(probe: [true, true], command: [_, 1]) == [false, true]
}

test a_cell_that_removes_a_key_not_held_is_ignored {
    assert eval relay_book(entries: [
        delta<dict<str, i64>>(updated: ["a": 1]),
        delta<dict<str, i64>>(removed: ["zz"]),
        delta<dict<str, i64>>(removed: ["a"]),
    ]) == [
        delta<dict<str, i64>>(updated: ["a": 1]),
        _,
        delta<dict<str, i64>>(removed: ["a"]),
    ]
}

# A delta read from an input names a key removed that the node's own
# dictionary never held: hgraph's `REMOVE` there fails the run, and the
# rule has it ignored.
fn relay_after_first(entries: dict<str, i64>) -> dict<str, i64> {
    state seen: i64 = 0
    when {
        seen += 1
        if seen > 1 { return delta_value(entries) }
    }
}

fn late_relay(command: i64) -> dict<str, i64> => relay_after_first(edit_book(command))

test a_relayed_removal_of_a_key_never_held_is_ignored {
    assert eval late_relay(command: [0, 2]) == [
        _,
        delta<dict<str, i64>>(updated: ["b": 2]),
    ]
}

# `out` written twice in one evaluation: the removal of a key not held
# leaves what the first write published.
fn written_twice(command: i64) -> dict<i64, str> {
    inject out
    when {
        if command == 0 {
            out = delta<dict<i64, str>>(removed: [9])
            return
        }
        out = delta<dict<i64, str>>(updated: [command: "x"])
        out = delta<dict<i64, str>>(removed: [9])
    }
}

test an_ignored_removal_after_a_write_keeps_the_write {
    assert eval written_twice(command: [0, 1, 0]) == [
        delta<dict<i64, str>>(),
        delta<dict<i64, str>>(updated: [1: "x"]),
        _,
    ]
}

# An enum's key the dictionary does not hold, beside one it holds.
enum Venue { north, south, east }

fn venues(command: i64) -> dict<Venue, i64> {
    when {
        if command == 0 { return delta<dict<Venue, i64>>(updated: [Venue.north: 1, Venue.south: 2]) }
        if command == 1 { return delta<dict<Venue, i64>>(removed: [Venue.east]) }
        return delta<dict<Venue, i64>>(removed: [Venue.east, Venue.north])
    }
}

test removing_an_enum_key_not_held_is_ignored {
    assert eval venues(command: [0, 1, 2]) == [
        delta<dict<Venue, i64>>(updated: [Venue.north: 1, Venue.south: 2]),
        _,
        delta<dict<Venue, i64>>(removed: [Venue.north]),
    ]
}

# A set's member it does not hold, from a node, from a cell and from a
# relayed delta, and a set that is not valid.
fn edit_members(command: i64) -> set<i64> {
    when {
        if command == 0 { return delta<set<i64>>(added: [1]) }
        if command == 1 { return delta<set<i64>>(removed: [9]) }
        return delta<set<i64>>(removed: [1, 9])
    }
}

fn relay_members(members: set<i64>) -> set<i64> {
    when { return delta_value(members) }
}

fn relayed_members(command: i64) -> set<i64> => relay_members(edit_members(command))

test removing_a_member_the_set_does_not_hold_is_ignored {
    assert eval edit_members(command: [1, 0, 1, 2, 2]) == [
        delta<set<i64>>(),
        delta<set<i64>>(added: [1]),
        _,
        delta<set<i64>>(removed: [1]),
        _,
    ]
    assert eval relayed_members(command: [0, 1, 2]) == [
        delta<set<i64>>(added: [1]),
        _,
        delta<set<i64>>(removed: [1]),
    ]
    assert eval relay_members(members: [delta<set<i64>>(added: [2]), delta<set<i64>>(removed: [7])]) == [
        delta<set<i64>>(added: [2]),
        _,
    ]
}

# A list's position that holds no value, removed: no tick where the list
# is valid.
fn gap_then_removal(step: i64) -> list<i64> {
    when {
        if step == 0 { return [1, 2] }
        if step == 1 { return delta<list<i64>>(updated: [3: 5]) }
        return delta<list<i64>>(removed: [2, 9])
    }
}

test removing_a_position_that_holds_no_value_is_no_tick {
    assert eval gap_then_removal(step: [0, 1, 2]) == [
        delta<list<i64>>(updated: [0: 1, 1: 2], size_modified: 2),
        delta<list<i64>>(updated: [3: 5], size_modified: 4),
        _,
    ]
    assert eval readings_watched(step: [2, 0, 0]) == [true, _, _]
}

# Nested: a dictionary of dictionaries and of sets, a struct's field, a
# tuple's position and a fixed list's element. Each is made valid and
# empty where a delta that names no change is published to it and it is
# not valid, and is otherwise no tick.
fn nested_books(command: i64) -> dict<str, dict<str, i64>> {
    when {
        if command == 0 {
            return delta<dict<str, dict<str, i64>>>(updated: ["a": delta<dict<str, i64>>(updated: ["x": 1])])
        }
        if command == 1 {
            return delta<dict<str, dict<str, i64>>>(updated: ["a": delta<dict<str, i64>>(removed: ["zz"])])
        }
        return delta<dict<str, dict<str, i64>>>(updated: ["b": delta<dict<str, i64>>(removed: ["zz"])])
    }
}

test a_nested_dictionarys_removal_not_held_is_ignored {
    assert eval nested_books(command: [0, 1, 2, 2]) == [
        delta<dict<str, dict<str, i64>>>(updated: ["a": delta<dict<str, i64>>(updated: ["x": 1])]),
        _,
        delta<dict<str, dict<str, i64>>>(updated: ["b": delta<dict<str, i64>>()]),
        _,
    ]
}

fn relay_nested(books: dict<str, dict<str, i64>>) -> dict<str, dict<str, i64>> {
    state seen: i64 = 0
    when {
        seen += 1
        if seen > 1 { return delta_value(books) }
    }
}

fn nested_removal(command: i64) -> dict<str, dict<str, i64>> {
    when {
        if command == 0 {
            return delta<dict<str, dict<str, i64>>>(updated: ["a": delta<dict<str, i64>>(updated: ["x": 1])])
        }
        return delta<dict<str, dict<str, i64>>>(updated: ["a": delta<dict<str, i64>>(removed: ["x"])])
    }
}

fn nested_late(command: i64) -> dict<str, dict<str, i64>> => relay_nested(nested_removal(command))

test a_relayed_nested_removal_never_held_is_ignored {
    assert eval nested_late(command: [0, 1]) == [
        _,
        delta<dict<str, dict<str, i64>>>(updated: ["a": delta<dict<str, i64>>()]),
    ]
}

fn tagged(command: i64) -> dict<str, set<i64>> {
    when {
        if command == 0 { return delta<dict<str, set<i64>>>(updated: ["a": delta<set<i64>>(added: [1])]) }
        return delta<dict<str, set<i64>>>(updated: ["a": delta<set<i64>>(removed: [9])])
    }
}

test a_set_within_a_dictionary_ignores_a_member_not_held {
    assert eval tagged(command: [0, 1]) == [
        delta<dict<str, set<i64>>>(updated: ["a": delta<set<i64>>(added: [1])]),
        _,
    ]
}

struct Ledger {
    entries: dict<str, i64>
    members: set<i64>
    count: i64
}

fn edit_ledger(command: i64) -> Ledger {
    when {
        if command == 0 {
            return delta<Ledger>(entries: delta<dict<str, i64>>(updated: ["x": 1]), count: 1)
        }
        if command == 1 { return delta<Ledger>(entries: delta<dict<str, i64>>(removed: ["zz"])) }
        return delta<Ledger>(members: delta<set<i64>>(removed: [9]))
    }
}

test a_structs_field_ignores_a_removal_not_held {
    assert eval edit_ledger(command: [0, 1, 2, 2]) == [
        delta<Ledger>(entries: delta<dict<str, i64>>(updated: ["x": 1]), count: 1),
        _,
        delta<Ledger>(members: delta<set<i64>>()),
        _,
    ]
}

fn edit_pair(command: i64) -> tuple<i64, set<i64>> {
    when {
        let first: delta<tuple<i64, set<i64>>> = (1, null)
        let absent: delta<tuple<i64, set<i64>>> = (null, delta<set<i64>>(removed: [9]))
        if command == 0 { return first }
        return absent
    }
}

test a_tuples_position_ignores_a_removal_not_held {
    let first: delta<tuple<i64, set<i64>>> = (1, null)
    let made_valid: delta<tuple<i64, set<i64>>> = (null, delta<set<i64>>())
    assert eval edit_pair(command: [0, 1, 1]) == [first, made_valid, _]
}

fn edit_slots(command: i64) -> list<set<i64>, 2> {
    when {
        if command == 0 { return delta<list<set<i64>, 2>>(updated: [0: delta<set<i64>>(added: [1])]) }
        return delta<list<set<i64>, 2>>(updated: [1: delta<set<i64>>(removed: [9])])
    }
}

test a_fixed_lists_element_ignores_a_removal_not_held {
    assert eval edit_slots(command: [0, 1, 1]) == [
        delta<list<set<i64>, 2>>(updated: [0: delta<set<i64>>(added: [1])]),
        delta<list<set<i64>, 2>>(updated: [1: delta<set<i64>>()]),
        _,
    ]
}

# A source's, and a generic node's.
fn removing_source() -> dict<str, i64> {
    {
        yield 0s: delta<dict<str, i64>>(removed: ["zz"])
        yield 1s: delta<dict<str, i64>>(updated: ["a": 1])
        yield 2s: delta<dict<str, i64>>(removed: ["zz"])
    }
}

fn relay_any<V>(entries: dict<str, V>) -> dict<str, V> {
    when { return delta_value(entries) }
}

fn relayed_any(command: i64) -> dict<str, i64> => relay_any(edit_book(command))

test a_sources_and_a_generic_nodes_removal_not_held_is_ignored {
    assert eval{length: 3s} removing_source() == [
        0s: delta<dict<str, i64>>(),
        1s: delta<dict<str, i64>>(updated: ["a": 1]),
    ]
    assert eval relayed_any(command: [0, 1, 2]) == [
        delta<dict<str, i64>>(updated: ["a": 1]),
        _,
        delta<dict<str, i64>>(updated: ["b": 2], removed: ["a"]),
    ]
}

# A struct's field that is a dictionary of dictionaries, given only the
# removal of a key it does not hold.
struct Shelf {
    books: dict<str, dict<str, i64>>
    count: i64
}

fn edit_shelf(command: i64) -> Shelf {
    when {
        if command == 0 {
            return delta<Shelf>(books: delta<dict<str, dict<str, i64>>>(updated: ["a": delta<dict<str, i64>>(updated: ["x": 1])]))
        }
        return delta<Shelf>(books: delta<dict<str, dict<str, i64>>>(removed: ["zz"]))
    }
}

test a_nested_dictionarys_removal_within_a_struct_is_no_tick {
    assert eval edit_shelf(command: [0, 1]) == [
        delta<Shelf>(books: delta<dict<str, dict<str, i64>>>(updated: ["a": delta<dict<str, i64>>(updated: ["x": 1])])),
        _,
    ]
}

# TIME-1: a struct, a tuple or a fixed list read whole "requires
# `all_valid` of it. So does one of a child that is a struct, a tuple or
# a fixed list ... Elsewhere, `rows[i]` read whole, it is checked when it
# runs: one that is not all valid fails it (`value.unset_read`), or gives
# an `err` where its place takes a `result` (ERR-14)."
fn write_pair_rows(step: i64) -> list<Pair, 2> {
    when {
        if step == 0 { return delta<list<Pair, 2>>(updated: [0: delta<Pair>(bid: 1, ask: 2)]) }
        return delta<list<Pair, 2>>(updated: [1: delta<Pair>(bid: 3)])
    }
}

fn row_at(rows: list<Pair, 2>, slot: i64) -> i64 {
    when { return spread(rows[slot]) }
}

fn row_outcome(rows: list<Pair, 2>, slot: i64) -> str {
    when {
        let row: result<Pair, error> = rows[slot]
        if is_ok(row) { return "ok" }
        let code = row.error.code
        if code == null { return "none" }
        return code
    }
}

fn first_row(rows: list<Pair, 2>) -> i64 {
    when all_valid(rows[0]) { return spread(rows[0]) }
}

fn row_at_of(step: i64, slot: i64) -> i64 => row_at(write_pair_rows(step), slot)

fn row_outcome_of(step: i64, slot: i64) -> str => row_outcome(write_pair_rows(step), slot)

fn first_row_of(step: i64) -> i64 => first_row(write_pair_rows(step))

test a_child_read_whole_at_a_runtime_index_is_checked_when_it_runs {
    assert eval row_at_of(step: [0, 1], slot: [0, _]) == [1, 1]
    assert raises("value.unset_read") { eval row_at_of(step: [0, 1], slot: [0, 1]) }
    assert eval row_outcome_of(step: [0, 1], slot: [0, 1]) == ["ok", "value.unset_read"]
    assert eval first_row_of(step: [0, 1]) == [1, 1]
}

fn write_tuple_rows(step: i64) -> list<tuple<i64, i64>, 1> {
    when {
        let first: delta<tuple<i64, i64>> = (step, null)
        return delta<list<tuple<i64, i64>, 1>>(updated: [0: first])
    }
}

fn tuple_row(rows: list<tuple<i64, i64>, 1>, slot: i64) -> result<tuple<i64, i64>, error> {
    when { return rows[slot] }
}

const fn outcome_of(outcome: result<tuple<i64, i64>, error>) -> bool => is_ok(outcome)

fn tuple_row_of(step: i64) -> bool => outcome_of(tuple_row(write_tuple_rows(step), 0))

test a_tuple_child_not_all_valid_at_a_runtime_index_gives_an_err {
    assert eval tuple_row_of(step: [5]) == [false]
}
