module demo.captures

# ERR-7 and ERR-8: `capture(callable, args...)` in a graph, of a node and
# of a graph, nested.

const fn checked(value: i64) -> result<i64, error> {
    if value < 0 { return err(error(message: "negative", code: "demo.negative")) }
    return ok(value)
}

fn checked_node(value: i64) -> i64 {
    when { return checked(value)? }
}

fn doubled(value: i64) -> i64 {
    return checked_node(value) * 2
}

# ERR-7: "capturing a graph covers failures that leave that subgraph".
fn doubled_or_silent(value: i64) -> i64 {
    let boundary = capture(doubled, value)
    return boundary.value
}

test a_captured_graph_keeps_running {
    assert eval(doubled_or_silent(value: [1, -1, 3])) == [2, _, 6]
}

fn is_negative(failure: error) -> bool {
    when { return failure == error(message: "negative", code: "demo.negative") }
}

# ERR-7: the call's arguments are "positional or named".
fn failures(value: i64) -> bool {
    let boundary = capture(checked_node, value: value)
    return is_negative(boundary.error)
}

test a_captured_error_keeps_its_message_and_code {
    assert eval(failures(value: [1, -1, 2, -5])) == [_, true, _, true]
}

fn raise_again(first: error, repeat: bool) -> error {
    when modified(first) && valid(first) { return first }
    when modified(repeat) && valid(first) {
        let failure: result<error, error> = err(first)
        return failure?
    }
}

fn handled(value: i64, repeat: bool) -> error {
    let inner = capture(checked_node, value)
    return raise_again(inner.error, repeat)
}

fn seen_outside(value: i64, repeat: bool) -> bool {
    let outer = capture(handled, value, repeat)
    return is_negative(outer.error)
}

# ERR-8: "The nearest boundary consumes the event once", and propagating
# a retained error with `?` "makes a new failure event".
test the_nearest_capture_consumes_a_failure {
    assert eval(seen_outside(value: [8, -1], repeat: [_, _, _, true])) == [_, _, _, true]
}
