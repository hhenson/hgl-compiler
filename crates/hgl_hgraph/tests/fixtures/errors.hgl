module demo.errors

# ERR-4, ERR-7, ERR-8, ERR-11 and TYPE-13: an error's context, captures of
# a graph given a wiring-time value and of a lifted value function, start
# and stop failures a capture's evaluation triggers, a temporal `result`,
# and the non-finite numbers, which are data.

const fn checked(value: i64) -> result<i64, error> {
    if value < 0 { return err(error(message: "negative", code: "demo.negative")) }
    return ok(value)
}

fn checked_node(value: i64) -> i64 {
    when { return checked(value)? }
}

fn forward(value: i64) -> i64 {
    when { return value }
}

# ---- ERR-4: an error's context ----

fn constructed_context(value: i64) -> bool {
    when { return error(message: "made").context == null }
}

# ERR-4: "a constructed error has none".
test a_constructed_error_has_no_context {
    assert eval(constructed_context(value: [1])) == [true]
}

fn described(failure: error) -> str {
    when {
        let context = failure.context
        if context == null { return "none" }
        if context.node == "" { return "no node" }
        return context.phase
    }
}

fn failed_at(failure: error) -> datetime? {
    when {
        let context = failure.context
        if context == null { return null }
        return context.evaluation_time
    }
}

fn captured_phase(value: i64) -> str {
    let boundary = capture(checked_node, value)
    return described(boundary.error)
}

fn captured_time(value: i64) -> datetime? {
    let boundary = capture(checked_node, value)
    return failed_at(boundary.error)
}

# ERR-4: "On first graph failure, attach original node identity, phase,
# and evaluation time": the node, the phase `"evaluate"` and the cycle the
# failure was met in.
test a_captured_error_has_its_node_phase_and_time {
    assert eval(captured_phase(value: [1, -1, 2])) == [_, "evaluate", _]
    assert eval(captured_time(value: [1, 2, -1])) == [_, _, earliest_start + 2us]
}

fn raise_again(first: error, repeat: bool) -> error {
    when modified(first) && valid(first) { return first }
    when modified(repeat) && valid(first) {
        let failure: result<error, error> = err(first)
        return failure?
    }
}

fn handled(value: i64, repeat: bool) -> error {
    let inner = capture(checked_node, value)
    return raise_again(inner.error, repeat)
}

fn same_context(first: error, repeated: error) -> bool {
    when modified(repeated) && valid(first, repeated) {
        let original = first.context
        let again = repeated.context
        if original == null || again == null { return false }
        return original == again
    }
}

fn kept_context(value: i64, repeat: bool) -> bool {
    let outer = capture(handled, value, repeat)
    return same_context(outer.value, outer.error)
}

# ERR-4: "propagation/capture preserve them"; OPS-2: two contexts compare
# by value.
test a_propagated_error_keeps_an_equal_context {
    assert eval(kept_context(value: [8, -1], repeat: [_, _, true])) == [_, _, true]
}

# ---- ERR-7: a capture of a graph given a wiring-time value ----

fn scaled(value: i64, const by: i64) -> i64 {
    return checked_node(value) * by
}

fn scaled_by_three(value: i64) -> i64 {
    let boundary = capture(scaled, value, 3)
    return boundary.value
}

# ERR-7: "capturing a graph covers failures that leave that subgraph",
# here a graph that takes a `const` parameter.
test a_captured_graph_given_a_constant_runs_on {
    assert eval(scaled_by_three(value: [1, -1, 2])) == [3, _, 6]
}

fn offset(value: i64, const by: i64, const plus: i64 = 10) -> i64 {
    return checked_node(value) * by + plus
}

fn offsets(value: i64, const by: i64) -> i64 {
    let boundary = capture(offset, by: by, value: forward(value))
    return boundary.value
}

# ERR-7: the call's arguments are "positional or named", in any order; a
# `const` parameter of the enclosing graph, a connection that is a call,
# and a default left out.
test a_captured_graph_takes_named_constants_and_defaults {
    assert eval(offsets(value: [1, -1, 2], by: 2)) == [12, _, 14]
}

fn both(value: i64) -> i64 {
    let two = capture(scaled, value, 2)
    let five = capture(scaled, value, 5)
    return two.value + five.value
}

# Each capture binds its own value.
test two_captures_bind_their_own_constants {
    assert eval(both(value: [1, -1, 2])) == [7, _, 14]
}

fn is_negative(failure: error) -> bool {
    when { return failure == error(message: "negative", code: "demo.negative") }
}

fn scaled_failures(value: i64) -> bool {
    let boundary = capture(scaled, value, 4)
    return is_negative(boundary.error)
}

test a_captured_graph_given_a_constant_gives_its_errors {
    assert eval(scaled_failures(value: [1, -1, 2, -3])) == [_, true, _, true]
}

fn dropped(value: i64) { when { } }

fn sink_of(value: i64, const by: i64) {
    dropped(checked_node(value) * by)
}

fn sink_failures(value: i64) -> bool {
    let boundary = capture(sink_of, value, 2)
    return is_negative(boundary.error)
}

# ERR-7: "outputless calls expose only `.error`".
test an_outputless_graph_given_a_constant_gives_its_errors {
    assert eval(sink_failures(value: [1, -1, 2])) == [_, true, _]
}

# ---- ERR-7: a capture of a lifted value function ----

const fn hundredth(value: i64) -> i64 => 100 // value

fn hundredths(value: i64) -> i64 {
    let boundary = capture(hundredth, value)
    return boundary.value
}

fn coded(failure: error) -> str {
    when {
        let code = failure.code
        if code == null { return "none" }
        return code
    }
}

fn hundredth_failures(value: i64) -> str {
    let boundary = capture(hundredth, value)
    return coded(boundary.error)
}

# FN-6: a value function given a connection is lifted, and ERR-7 captures
# its node: a zero divisor fails one evaluation, which the capture ends.
test a_captured_lifted_function_runs_on {
    assert eval(hundredths(value: [4, 0, 5])) == [25, _, 20]
    assert eval(hundredth_failures(value: [4, 0, 5, 0])) ==
        [_, "numeric.division_by_zero", _, "numeric.division_by_zero"]
}

# ---- ERR-8: lifecycle work triggered during evaluation ----

fn divide_at_start(value: i64, const divisor: i64) -> i64 {
    start { let inverse = 1 // divisor }
    when { return value }
}

fn divide_at_stop(value: i64, const divisor: i64) -> i64 {
    when { return value }
    stop { let inverse = 1 // divisor }
}

fn started(value: i64, flag: bool) -> i64 {
    if flag { return divide_at_start(value, 0) }
    return value
}

fn captured_start(value: i64, flag: bool) -> i64 {
    let boundary = capture(started, value, flag)
    return boundary.value
}

fn stopped(value: i64, flag: bool) -> i64 {
    if flag { return divide_at_stop(value, 0) }
    return value
}

fn captured_stop(value: i64, flag: bool) -> i64 {
    let boundary = capture(stopped, value, flag)
    return boundary.value
}

fn nested_start(value: i64, flag: bool) -> i64 {
    let outer = capture(captured_start, value, flag)
    return outer.value
}

# ERR-8: "Start/stop failures escape, including lifecycle work triggered
# during evaluation": a branch of a `switch` that the capture's evaluation
# starts, or stops, fails, and the run fails with it, through every
# capture around it.
test a_triggered_start_or_stop_failure_escapes {
    assert eval(captured_start(value: [1, 2], flag: [false, false])) == [1, 2]
    assert raises("numeric.division_by_zero") {
        eval(captured_start(value: [1, 2, 3], flag: [false, true, false]))
    }
    assert raises("numeric.division_by_zero") {
        eval(captured_stop(value: [1, 2, 3], flag: [true, false, false]))
    }
    assert raises("numeric.division_by_zero") {
        eval(nested_start(value: [1, 2, 3], flag: [false, true, false]))
    }
}

fn evaluated(value: i64, flag: bool) -> i64 {
    if flag { return checked_node(value) }
    return value
}

fn switched_phase(value: i64, flag: bool) -> str {
    let boundary = capture(evaluated, value, flag)
    return described(boundary.error)
}

# An evaluation failure inside a selected branch is captured as any is.
test an_evaluation_failure_in_a_branch_is_captured {
    assert eval(switched_phase(value: [1, -2, 3], flag: [true, _, _])) == [_, "evaluate", _]
}

# ---- TYPE-13 and ERR-3: a temporal `result` ----

fn outcome(value: i64) -> result<i64, error> {
    when { return checked(value) }
}

fn failed(value: result<i64, error>) -> bool => is_err(value)

fn outcomes(value: i64) -> bool {
    let boundary = capture(outcome, value)
    return failed(boundary.value)
}

# TYPE-13: "Result and error envelopes are ordinary atomic values": a
# `result` is an output and an input, published whole. ERR-3: "In
# composition a test of a connection is an ordinary lifted call (FN-6)".
test a_result_is_an_input_and_an_output {
    assert eval(outcome(value: [1, -1, -1])) == [
        ok(1),
        err(error(message: "negative", code: "demo.negative")),
        err(error(message: "negative", code: "demo.negative")),
    ]
    assert eval(failed(value: [ok(1), err(error(message: "x")), ok(2)])) == [false, true, false]
    assert eval(outcomes(value: [1, -1, 2])) == [false, true, false]
}

# ---- ERR-11: NaN, infinity and an unordered outcome are data ----

fn quotient(numerator: f64) -> f64 {
    when { return numerator / 0.0 }
}

const fn ratio(numerator: f64, denominator: f64) -> f64 => numerator / denominator

fn named(value: f64, failure: error) -> str {
    when modified(value) && valid(value) {
        if valid(failure) { return "failed" }
        if value != value { return "NaN" }
        let infinity: f64 = 1.0 / 0.0
        if value == infinity { return "+infinity" }
        if value == -infinity { return "-infinity" }
        return "finite"
    }
}

fn nonfinite(numerator: f64) -> str {
    let boundary = capture(quotient, numerator)
    return named(boundary.value, boundary.error)
}

fn lifted_nonfinite(numerator: f64) -> str {
    let boundary = capture(ratio, numerator, 0.0)
    return named(boundary.value, boundary.error)
}

fn compared(value: f64) -> CmpResult {
    when { return value <=> 1.0 }
}

fn ordered(numerator: f64) -> CmpResult {
    let boundary = capture(compared, quotient(numerator))
    return boundary.value
}

# ERR-11: "NaN, infinity, and an unordered comparison outcome are ordinary
# data, not execution errors or silence": each publishes, in a node and in
# a lifted value function, and no capture sees a failure.
test nonfinite_numbers_and_unordered_outcomes_are_data {
    assert eval(nonfinite(numerator: [0.0, 1.0, -1.0, 2.0])) ==
        ["NaN", "+infinity", "-infinity", "+infinity"]
    assert eval(lifted_nonfinite(numerator: [0.0, 1.0, -1.0])) == ["NaN", "+infinity", "-infinity"]
    assert eval(ordered(numerator: [0.0, 1.0, -1.0])) ==
        [CmpResult.unordered, CmpResult.greater, CmpResult.less]
}
