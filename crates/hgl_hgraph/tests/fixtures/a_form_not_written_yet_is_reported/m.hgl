module m
struct Quote {
    bid: f64
}
fn gated(value: i64, gate: bool) -> i64 {
    inject scheduler
    when { return value }
}
fn maybe(value: i64?) -> i64 {
    when { return 1 }
}
fn pass(value: i64) -> i64 {
    when { return value }
}
fn summed(left: i64, right: i64) -> i64 => left + right
fn stopped(value: i64) -> i64 {
    inject out
    when { return value }
    stop { let last = out }
}
fn defaulted(value: i64 = 2) -> i64 {
    when { return value }
}
const fn packed(rest: ...i64) -> i64 => 1
const fn lone(value: i64) -> i64 => value
test timed {
    assert eval pass(value: [0s: 7]) == [0s: 7]
    let wired = lone(7)
    assert eval lone(value: [1]) == [1]
}
fn chosen(flag: bool, value: i64) -> i64 {
    if flag {
        return pass(value)
    }
    return value
}
# A struct as a temporal input, which is written (TYPE-9),
# and one made in a graph, which is not.
fn quoted(quote: Quote) -> f64 {
    when all_valid(quote) { return quote.bid }
}
fn fixed(value: f64) -> f64 => quoted(Quote(bid: 1.0))
# A generic struct made where its arguments are the
# function's own generic parameters.
struct Held<T> { value: T }
const fn wrap<T>(value: T) -> Held<T> => Held(value: value)
# An atomic tuple as a temporal input (TYPE-9).
fn paired(pair: atomic<tuple<f64, f64>>) -> f64 {
    when { return 1.0 }
}
