module demo.vals

operator join<L, R, O>(lhs: L, rhs: R) -> O
impl const fn join(lhs: i64, rhs: i64) -> i64 => lhs * 10 + rhs
impl const fn join(lhs: str, rhs: str) -> str => lhs + rhs
# A candidate that states a requirement of its own.
impl const fn join<T>(lhs: list<T>, rhs: list<T>) -> list<T>
    requires join(T, T) -> T => [join(lhs[0], rhs[0])]

# A required operation, by name and by symbol.
const fn twice<T>(value: T) -> T requires join(T, T) -> T => join(value, value)
const fn sum<T>(a: T, b: T) -> T requires add_(T, T) -> T => a + b
# One that hands its requirement on.
const fn outer<U>(value: U) -> U requires join(U, U) -> U => twice(twice(value))
# One with no requirement.
const fn same<T>(value: T) -> T => value
# One with no requirement of its own, which is written once, and
# calls one that requires with whole arguments: nothing else asks
# for `sum` of two `str`.
const fn paired<T>(value: T) -> str => sum("a", "b")

const hundred: i64 = sum(40, 60)

# In a node's hook, and lifted in a graph.
fn joined(value: i64) -> i64 {
    when valid(value) { return twice(value) }
}
fn graphed(value: f64) -> f64 => sum(value, value)

test values_are_instances {
    assert twice(1) == 11
    assert twice("a") == "aa"
    assert sum(1.5, 2.0) == 3.5
    assert outer(1) == 121
    assert same("x") == "x"
    assert paired(1) == "ab"
    assert hundred == 100
    assert twice([2]) == [22]
    assert eval(joined(value: [1, 2])) == [11, 22]
    assert eval(graphed(value: [1.5])) == [3.0]
    # TST-8: a value function an eval names is lifted.
    assert eval(twice(value: [3])) == [33]
}
