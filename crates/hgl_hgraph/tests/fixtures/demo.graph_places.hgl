module demo.graph_places

# EXPR-15: "In a graph, an assignment into a place of a `var` is copy on
# write. A graph's `var` denotes a connection (EXPR-4), and a field of a
# connection is no storage: `point.x = price` rebinds `point` to a new
# connection, which is `point` with its `x` from `price`. Nothing is
# changed in place: what read `point` before the assignment keeps the
# connection it had. The place, the type of its value, and a compound
# assignment are as EXPR-3 has them."

struct Quote {
    bid: i64
    ask: i64
}

struct Book {
    top: Quote
    depth: i64
}

fn quoted(bid: i64) -> Quote {
    when { return Quote(bid: bid, ask: bid + 1) }
}

fn digits(quote: Quote) -> i64 {
    when all_valid(quote) { return quote.bid * 100 + quote.ask }
}

# A field given a connection.
fn placed(a: i64, b: i64) -> i64 {
    var quote = quoted(a)
    quote.bid = b
    return digits(quote)
}

# What read the `var` before the assignment keeps its connection.
fn kept(a: i64, b: i64) -> i64 {
    var quote = quoted(a)
    let before = quote
    quote.bid = b
    return digits(before)
}

# A field given an ordinary value, and a compound assignment, which
# reads the place first (EXPR-3).
fn constant_ask(a: i64) -> i64 {
    var quote = quoted(a)
    quote.ask = 9
    return digits(quote)
}

fn added(a: i64, b: i64) -> i64 {
    var quote = quoted(a)
    quote.bid += b
    return digits(quote)
}

test a_field_of_a_connection_is_assigned_by_a_new_connection {
    assert eval(placed(a: [1, 2], b: [5, 6])) == [502, 603]
    assert eval(kept(a: [1, 2], b: [5, 6])) == [102, 203]
    assert eval(constant_ask(a: [1, 2])) == [109, 209]
    assert eval(added(a: [1, 2], b: [5, 6])) == [602, 803]
}

# A place at depth: a field of a field.
fn booked(a: i64) -> Book {
    when { return Book(top: Quote(bid: a, ask: a + 1), depth: a) }
}

fn book_digits(book: Book) -> i64 {
    when valid(book.top.bid) && valid(book.depth) { return book.top.bid * 100 + book.depth }
}

fn rebooked(a: i64, b: i64) -> i64 {
    var book = booked(a)
    book.top.bid = b
    return book_digits(book)
}

# A tuple's position and a fixed list's, under a constant index.
fn paired(a: i64) -> tuple<i64, i64> {
    when { return (a, a + 1) }
}

fn pair_digits(pair: tuple<i64, i64>) -> i64 {
    when all_valid(pair) { return pair[0] * 100 + pair[1] }
}

fn repaired(a: i64, b: i64) -> i64 {
    var pair = paired(a)
    pair[1] = b
    return pair_digits(pair)
}

fn listed(a: i64) -> list<i64, 2> {
    when { return [a, a + 1] }
}

fn list_digits(rows: list<i64, 2>) -> i64 {
    when all_valid(rows) { return rows[0] * 100 + rows[1] }
}

fn relisted(a: i64, b: i64) -> i64 {
    var rows = listed(a)
    rows[0] = b
    return list_digits(rows)
}

test a_place_inside_a_connection_is_assigned_by_a_new_connection {
    assert eval(rebooked(a: [1, 2], b: [5, 6])) == [501, 602]
    assert eval(repaired(a: [1, 2], b: [5, 6])) == [105, 206]
    assert eval(relisted(a: [1, 2], b: [5, 6])) == [502, 603]
}

# TYPE-14: "a T is a value where a T? is expected". A nullable field
# given a connection of its `T`, and given a null.
struct Maybe {
    value: i64?
    tag: i64
}

fn maybe(a: i64) -> Maybe {
    when { return Maybe(value: a, tag: a) }
}

fn maybe_digits(held: Maybe) -> i64 {
    when valid(held.value) && valid(held.tag) {
        let value = held.value
        if value == null { return held.tag }
        return value * 100 + held.tag
    }
}

fn given_maybe(a: i64, b: i64) -> i64 {
    var held = maybe(a)
    held.value = b
    return maybe_digits(held)
}

fn cleared_maybe(a: i64) -> i64 {
    var held = maybe(a)
    held.value = null
    return maybe_digits(held)
}

test a_nullable_field_of_a_connection_is_assigned {
    assert eval(given_maybe(a: [1, 2], b: [5, 6])) == [501, 602]
    assert eval(cleared_maybe(a: [1, 2])) == [1, 2]
}

# CTRL-14 through a place: a branch selected at runtime assigns a field.
fn chosen(flag: bool, a: i64, b: i64) -> i64 {
    var quote = quoted(a)
    if flag {
        quote.bid = b
    }
    return digits(quote)
}

test a_branch_assigns_a_field_of_a_connection {
    assert eval(chosen(flag: [true, false], a: [1, 2], b: [5, 6])) == [502, 203]
}
