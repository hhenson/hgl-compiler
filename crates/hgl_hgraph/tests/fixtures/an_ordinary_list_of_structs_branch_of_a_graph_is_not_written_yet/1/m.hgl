module m
struct Quote {
    bid: i64
}
fn quoted(bid: i64) -> list<Quote, 1> {
    when { return delta<list<Quote, 1>>(updated: [0: delta<Quote>(bid: bid)]) }
}
const fn fixed() -> list<Quote, 1> => [Quote(bid: 0)]
fn chosen(take: bool, bid: i64) -> list<Quote, 1> {
    if take { return quoted(bid) }
    return fixed()
}
