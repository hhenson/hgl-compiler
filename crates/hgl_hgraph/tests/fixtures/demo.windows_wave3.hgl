module demo.windows_wave3

# ---- Readiness of a window of ticks (TYPE-11, TIME-9, END-9) ----

# TYPE-11: "`valid` of a window is true once it holds a value, fewer than
# its minimum included. `all_valid` is true where it holds at least its
# minimum (TIME-9): of a tick count, Min values".
fn readings(reading: i64) -> rolling_window<i64, 3, 2> {
    when { return reading }
}

fn readiness(probe: bool, held: rolling_window<i64, 3, 2>) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [valid(held), all_valid(held)] }
}

fn observed(probe: bool, reading: i64) -> list<bool, 2> =>
    readiness(probe, readings(reading))

# "Omitted minimum equals maximum": all valid at its third value.
fn three(reading: i64) -> rolling_window<i64, 3> {
    when { return reading }
}

fn readiness_of_three(probe: bool, held: rolling_window<i64, 3>) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [valid(held), all_valid(held)] }
}

fn observed_three(probe: bool, reading: i64) -> list<bool, 2> =>
    readiness_of_three(probe, three(reading))

test a_window_is_valid_before_its_minimum_and_all_valid_at_it {
    assert eval(observed(probe: [true, true, true, true], reading: [_, 1, _, 2])) ==
        [[false, false], [true, false], [true, false], [true, true]]
    assert eval(observed_three(probe: [true, true, true, true], reading: [1, 2, _, 3])) ==
        [[true, false], [true, false], [true, false], [true, true]]
}

# ---- A window's value, a `list<V>` (TYPE-11, END-9, FN-12) ----

# TYPE-11: "That value, read in a hook ... is a `list<V>` of the values
# held, oldest first, and the read before `all_valid` fails with
# `value.unset_read`."
fn held_when_ready(held: rolling_window<i64, 3, 2>) -> list<i64> {
    when all_valid(held) { return held }
}

fn held_when_valid(held: rolling_window<i64, 3, 2>) -> list<i64> {
    when { return held }
}

# Under manual admission a `valid` guard admits the read (TIME-4), which
# is checked when it runs; an `all_valid` guard waits for the minimum.
fn guarded_by_valid(probe: bool, held: rolling_window<i64, 3, 2>) -> list<i64> {
    when valid([]) {
        if valid(held) { return held }
    }
}

fn guarded_by_all_valid(probe: bool, held: rolling_window<i64, 3, 2>) -> list<i64> {
    when valid([]) {
        if all_valid(held) { return held }
    }
}

fn ready_list(reading: i64) -> list<i64> => held_when_ready(readings(reading))
fn early_list(reading: i64) -> list<i64> => held_when_valid(readings(reading))
fn guarded_list(probe: bool, reading: i64) -> list<i64> =>
    guarded_by_valid(probe, readings(reading))
fn all_guarded_list(probe: bool, reading: i64) -> list<i64> =>
    guarded_by_all_valid(probe, readings(reading))

test a_windows_value_is_read_once_it_is_all_valid {
    assert eval(ready_list(reading: [1, 2, 3, 4])) == [_, [1, 2], [1, 2, 3], [2, 3, 4]]
    assert eval(all_guarded_list(probe: [true, true, true], reading: [1, _, 2])) ==
        [_, _, [1, 2]]
}

test a_windows_value_read_before_it_is_all_valid_fails {
    assert raises("value.unset_read") { eval(early_list(reading: [1, 2])) }
    assert raises("value.unset_read") {
        eval(guarded_list(probe: [true, true], reading: [1, 2]))
    }
}

# The list is compared, iterated, and its length counted, in a hook.
const fn count_of<T>(values: list<T>) -> i64 {
    var count: i64 = 0
    for value in values { count += 1 }
    return count
}

fn summed(held: rolling_window<i64, 3, 2>) -> i64 {
    when all_valid(held) {
        var sum: i64 = 0
        for value in held { sum += value }
        return sum
    }
}

fn is_first_pair(held: rolling_window<i64, 3, 2>) -> bool {
    when all_valid(held) { return held == [1, 2] }
}

fn counted(held: rolling_window<i64, 3, 2>) -> i64 {
    when all_valid(held) { return count_of(held) }
}

fn oldest_two(held: rolling_window<i64, 3, 2>) -> list<i64> {
    when all_valid(held) {
        let values: list<i64> = held
        return [values[0], values[1]]
    }
}

fn summed_flow(reading: i64) -> i64 => summed(readings(reading))
fn first_pair_flow(reading: i64) -> bool => is_first_pair(readings(reading))
fn counted_flow(reading: i64) -> i64 => counted(readings(reading))
fn oldest_two_flow(reading: i64) -> list<i64> => oldest_two(readings(reading))

test a_windows_list_is_compared_iterated_and_counted {
    assert eval(summed_flow(reading: [1, 2, 3, 4])) == [_, 3, 6, 9]
    assert eval(first_pair_flow(reading: [1, 2, 3])) == [_, true, false]
    assert eval(counted_flow(reading: [1, 2, 3, 4])) == [_, 2, 3, 3]
    assert eval(oldest_two_flow(reading: [1, 2, 3, 4])) == [_, [1, 2], [1, 2], [2, 3]]
}

fn first_held(held: rolling_window<i64, 3, 2>) -> i64 {
    when all_valid(held) { return held[0] }
}

fn first_held_flow(reading: i64) -> i64 => first_held(readings(reading))

test a_windows_list_is_indexed {
    assert eval(first_held_flow(reading: [1, 2, 3, 4])) == [_, 1, 1, 2]
}

# FN-12: "A window is passed only where it is `all_valid`: its value is
# not read before (TYPE-11)", once, as the whole list. Core's lifting
# table: a window that is not all valid is "No invocation".
const fn total(values: list<i64>) -> i64 {
    var sum: i64 = 0
    for value in values { sum += value }
    return sum
}

const fn longer(first: list<i64>, second: list<i64>) -> bool =>
    count_of(first) > count_of(second)

fn lifted_total(reading: i64) -> i64 => total(readings(reading))
fn lifted_count(reading: i64) -> i64 => count_of(readings(reading))
fn lifted_by_name(reading: i64) -> i64 => total(values: readings(reading))
fn lifted_pair(reading: i64, other: i64) -> bool =>
    longer(readings(reading), three(other))
fn lifted_beside(reading: i64, scale: i64) -> i64 => total(readings(reading)) * scale

test a_window_given_to_a_value_function_is_its_list {
    assert eval(lifted_total(reading: [1, 2, 3, 4])) == [_, 3, 6, 9]
    assert eval(lifted_count(reading: [1, 2, 3, 4])) == [_, 2, 3, 3]
    assert eval(lifted_by_name(reading: [1, 2, 3])) == [_, 3, 6]
    assert eval(lifted_pair(reading: [1, 2, 3, 4], other: [1, 2, 3, _])) == [_, _, false, false]
    assert eval(lifted_beside(reading: [1, 2], scale: [10, _])) == [_, 30]
}

# Two windows in one node, and a generic window, its sizes the call's.
fn both_ready(a: rolling_window<i64, 3, 2>, b: rolling_window<i64, 3>) -> list<i64> {
    when all_valid(a) && all_valid(b) { return [total(a), total(b)] }
}

fn windowed<T, const N: i64, const M: i64>(value: T) -> rolling_window<T, N, M> {
    when { return value }
}

fn held_generic<T, const N: i64, const M: i64>(values: rolling_window<T, N, M>) -> list<T> {
    when all_valid(values) { return values }
}

fn both_flow(reading: i64) -> list<i64> => both_ready(readings(reading), three(reading))
fn generic_flow(reading: i64) -> list<i64> =>
    held_generic<i64, 2, 2>(windowed<i64, 2, 2>(reading))

test two_windows_and_a_generic_window_are_read_as_lists {
    assert eval(both_flow(reading: [1, 2, 3, 4])) == [_, _, [6, 6], [9, 9]]
    assert eval(generic_flow(reading: [1, 2, 3])) == [_, [1, 2], [2, 3]]
}

# TIME-7: `out` read holds what it published, a window's the list it
# holds, all valid or failing as an input's (TYPE-11).
fn capped(price: i64) -> rolling_window<i64, 3, 2> {
    inject out
    when {
        if all_valid(out) && total(out) > 5 { return }
        out = price
    }
}

fn early_out(price: i64) -> rolling_window<i64, 3, 2> {
    inject out
    when {
        if valid(out) && total(out) > 100 { return }
        out = price
    }
}

# TIME-5: `stop` reads an input under its guard; a window read there is
# all valid or fails.
fn stopped(held: rolling_window<i64, 3, 2>) -> i64 {
    state last: i64 = 0
    when { return 1 }
    stop {
        if valid(held) { last = total(held) }
    }
}

fn stop_flow(reading: i64) -> i64 => stopped(readings(reading))

test a_windows_out_and_its_read_in_stop_are_lists {
    assert eval(capped(price: [1, 2, 3, 4, 5])) == [1, 2, 3, _, _]
    assert raises("value.unset_read") { eval(early_out(price: [1, 2])) }
    assert eval(stop_flow(reading: [1, 2])) == [1, 1]
    assert raises("value.unset_read") { eval(stop_flow(reading: [1])) }
}

# ---- A window within a value (TIME-1, TIME-9) ----

# TIME-9: `all_valid` of a struct asks each field's own `valid`, one level
# deep: a window field is valid at its first value, short of its minimum.
struct Book {
    prices: rolling_window<i64, 3, 2>
    last: i64
}

fn booked(price: i64) -> Book {
    when { return delta<Book>(prices: price, last: price) }
}

fn book_readiness(probe: bool, book: Book) -> list<bool, 3> {
    when modified(probe) && valid([]) {
        return [valid(book), all_valid(book), all_valid(book.prices)]
    }
}

# A field that is a window is read, where it is admitted, as its list,
# which fails where the window is not all valid (TYPE-11).
fn book_prices(book: Book) -> list<i64> {
    when all_valid(book.prices) { return book.prices }
}

fn early_book_prices(book: Book) -> list<i64> {
    when valid(book.prices) { return book.prices }
}

fn book_flow(probe: bool, price: i64) -> list<bool, 3> => book_readiness(probe, booked(price))
fn book_prices_flow(price: i64) -> list<i64> => book_prices(booked(price))
fn early_book_flow(price: i64) -> list<i64> => early_book_prices(booked(price))

fn slots(slot: i64, price: i64) -> list<rolling_window<i64, 2>, 2> {
    when { return delta<list<rolling_window<i64, 2>, 2>>(updated: [slot: price]) }
}

# TIME-1: "Elsewhere, `parts[i]`, it is checked when it runs": a child that
# is not valid fails, and so does a window that is not all valid.
fn slot_values(both: list<rolling_window<i64, 2>, 2>, at: i64) -> list<i64> {
    when modified(at) { return both[at] }
}

fn first_slot(both: list<rolling_window<i64, 2>, 2>) -> list<i64> {
    when all_valid(both[0]) { return both[0] }
}

fn slot_flow(slot: i64, price: i64, at: i64) -> list<i64> =>
    slot_values(slots(slot, price), at)
fn first_slot_flow(slot: i64, price: i64) -> list<i64> => first_slot(slots(slot, price))

# A dictionary's entry that is a window, at a key known when the program
# is compiled and at one known when it runs; a struct's window field
# within a list's element read when it runs.
fn keyed(key: str, price: i64) -> dict<str, rolling_window<i64, 2>> {
    when { return delta<dict<str, rolling_window<i64, 2>>>(updated: [key: price]) }
}

fn entry_a(prices: dict<str, rolling_window<i64, 2>>) -> list<i64> {
    when all_valid(prices["a"]) { return prices["a"] }
}

fn early_entry_a(prices: dict<str, rolling_window<i64, 2>>) -> list<i64> {
    when valid(prices["a"]) { return prices["a"] }
}

fn entry_at(prices: dict<str, rolling_window<i64, 2>>, key: str) -> list<i64> {
    when modified(key) { return prices[key] }
}

struct Row {
    prices: rolling_window<i64, 2>
}

fn rowed(slot: i64, price: i64) -> list<Row, 2> {
    when { return delta<list<Row, 2>>(updated: [slot: delta<Row>(prices: price)]) }
}

fn row_prices(rows: list<Row, 2>, at: i64) -> list<i64> {
    when modified(at) { return rows[at].prices }
}

fn entry_flow(key: str, price: i64) -> list<i64> => entry_a(keyed(key, price))
fn early_entry_flow(key: str, price: i64) -> list<i64> => early_entry_a(keyed(key, price))
fn entry_at_flow(key: str, price: i64, at: str) -> list<i64> => entry_at(keyed(key, price), at)
fn row_flow(slot: i64, price: i64, at: i64) -> list<i64> => row_prices(rowed(slot, price), at)

test a_window_within_a_value_is_read_as_its_list {
    assert eval(book_flow(probe: [true, true, true], price: [_, 1, 2])) ==
        [[false, false, false], [true, true, false], [true, true, true]]
    assert eval(book_prices_flow(price: [1, 2, 3])) == [_, [1, 2], [1, 2, 3]]
    assert eval(slot_flow(slot: [0, 0, 1, 1], price: [1, 2, 3, 4], at: [_, 0, _, 1])) ==
        [_, [1, 2], _, [3, 4]]
    assert eval(first_slot_flow(slot: [0, 0, 1], price: [1, 2, 3])) == [_, [1, 2], [1, 2]]
    assert eval(entry_flow(key: ["b", "a", "a", "a"], price: [1, 2, 3, 4])) ==
        [_, _, [2, 3], [3, 4]]
    assert eval(entry_at_flow(key: ["a", "a", "b"], price: [1, 2, 3], at: [_, "a", _])) ==
        [_, [1, 2], _]
    assert eval(row_flow(slot: [1, 1, 0], price: [1, 2, 3], at: [_, 1, _])) == [_, [1, 2], _]
}

test a_window_within_a_value_read_before_it_is_all_valid_fails {
    assert raises("value.unset_read") { eval(early_book_flow(price: [1, 2])) }
    assert raises("value.unset_read") {
        eval(slot_flow(slot: [0, 0], price: [1, 2], at: [0, _]))
    }
    assert raises("value.unset_read") {
        eval(slot_flow(slot: [0, 0], price: [1, 2], at: [1, _]))
    }
    assert raises("value.unset_read") { eval(early_entry_flow(key: ["a"], price: [1])) }
    assert raises("value.unset_read") {
        eval(entry_at_flow(key: ["a", "a"], price: [1, 2], at: ["b", _]))
    }
    assert raises("value.unset_read") {
        eval(row_flow(slot: [1, 1], price: [1, 2], at: [1, _]))
    }
}

# ---- A window of a duration (TYPE-11, END-9) ----

# TYPE-11's illustration, as hhenson/hgl_spec#146 has it, which hgraph
# 0.9.7 does (hhenson/hgraph#1818): "one that arrived at t is held at t +
# Max and leaves one smallest step later (RUN-3), whether or not a value
# arrives then. The window ticks for that exit": 1.0, of 0s, leaves at
# 3s + 1us.
# `all_valid`: "values whose arrival times, from the oldest held to the
# newest, span at least Min".
fn collect(price: f64) -> rolling_window<f64, 3s, 2s> {
    when { return price }
}

fn duration_readiness(prices: rolling_window<f64, 3s, 2s>) -> list<bool, 2> {
    when valid([]) { return [valid(prices), all_valid(prices)] }
}

fn observed_duration(price: f64) -> list<bool, 2> => duration_readiness(collect(price))

fn held_prices(probe: bool, prices: rolling_window<f64, 3s, 2s>) -> list<f64> {
    when modified(probe) && all_valid(prices) { return prices }
}

fn held_flow(probe: bool, price: f64) -> list<f64> => held_prices(probe, collect(price))

fn duration_list(prices: rolling_window<f64, 3s, 2s>) -> list<f64> {
    when { return prices }
}

fn duration_list_flow(price: f64) -> list<f64> => duration_list(collect(price))

const fn price_total(values: list<f64>) -> f64 {
    var sum: f64 = 0.0
    for value in values { sum += value }
    return sum
}

fn duration_total(price: f64) -> f64 => price_total(collect(price))

test a_window_of_a_duration_holds_and_drops_values_as_they_age {
    assert eval(observed_duration(price: [0s: 1.0, 1s: 2.0, 2s: 3.0, 4s: 4.0, 9s: 5.0])) ==
        [0s: [true, false], 1s: [true, false], 2s: [true, true],
         3000001us: [true, false], 4s: [true, true], 4000001us: [true, true],
         5000001us: [true, false], 7000001us: [true, false], 9s: [true, false],
         12000001us: [true, false]]
    # At 3.5s the window holds 2.0 and 3.0, which span less than 2s, and
    # is not read; at 4.5s, 3.0 and 4.0.
    assert eval(held_flow(
        probe: [2500ms: true, 3500ms: true, 4500ms: true],
        price: [0s: 1.0, 1s: 2.0, 2s: 3.0, 4s: 4.0, 9s: 5.0],
    )) == [2500ms: [1.0, 2.0, 3.0], 4500ms: [3.0, 4.0]]
    assert eval(duration_total(price: [0s: 1.0, 1s: 2.0, 2s: 3.0, 4s: 4.0, 9s: 5.0])) ==
        [2s: 6.0, 4s: 9.0, 4000001us: 7.0]
}

test a_window_of_a_duration_read_before_its_span_fails {
    assert raises("value.unset_read") { eval(duration_list_flow(price: [0s: 1.0, 1s: 2.0])) }
}

# TYPE-11 (hhenson/hgl_spec#146): "A minimum of `0s` is held by the
# first value, and an empty window is not all valid, whatever its
# minimum", and "Omitted minimum equals maximum".
fn collect_from_zero(price: f64) -> rolling_window<f64, 3s, 0s> {
    when { return price }
}

fn zero_readiness(prices: rolling_window<f64, 3s, 0s>) -> list<bool, 2> {
    when valid([]) { return [valid(prices), all_valid(prices)] }
}

fn collect_whole(price: f64) -> rolling_window<f64, 3s> {
    when { return price }
}

fn whole_readiness(prices: rolling_window<f64, 3s>) -> list<bool, 2> {
    when valid([]) { return [valid(prices), all_valid(prices)] }
}

fn zero_flow(price: f64) -> list<bool, 2> => zero_readiness(collect_from_zero(price))
fn whole_flow(price: f64) -> list<bool, 2> => whole_readiness(collect_whole(price))

test a_zero_minimum_and_an_omitted_one {
    assert eval(zero_flow(price: [0s: 1.0, 1s: 2.0, 2s: 3.0, 4s: 4.0, 9s: 5.0])) ==
        [0s: [true, true], 1s: [true, true], 2s: [true, true], 3000001us: [true, true],
         4s: [true, true], 4000001us: [true, true], 5000001us: [true, true],
         7000001us: [true, false], 9s: [true, true], 12000001us: [true, false]]
    assert eval(whole_flow(price: [0s: 1.0, 1s: 2.0, 2s: 3.0, 4s: 4.0, 9s: 5.0])) ==
        [0s: [true, false], 1s: [true, false], 2s: [true, false], 3000001us: [true, false],
         4s: [true, true], 4000001us: [true, false], 5000001us: [true, false],
         7000001us: [true, false], 9s: [true, false], 12000001us: [true, false]]
}
