module demo.scaling

const fn doubled(value: i64) -> i64 => value * 2

fn scaled(value: i64, const factor: i64) -> i64 {
    state seen: i64 = 0
    when {
        seen += 1
        if seen > 1 {
            return doubled(value) * factor
        } else {
            return value
        }
    }
}

fn wired(value: i64) -> i64 => scaled(value, 3)

fn sink(value: bool) {
    when { }
}

test scales {
    let seen = eval(wired(value: [1, _, 2]))
    assert seen == [1, _, 12]
    assert eval(scaled(value: [5], factor: 2)) != []
    eval(sink(value: [true]))
}
