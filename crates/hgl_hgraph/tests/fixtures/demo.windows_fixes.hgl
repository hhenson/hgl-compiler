module demo.windows_fixes

fn readings(reading: i64) -> rolling_window<i64, 3, 2> {
    when { return reading }
}

const fn total(values: list<i64>) -> i64 {
    var sum: i64 = 0
    for value in values { sum += value }
    return sum
}

# ---- A value function's generic given a window (FN-1, GEN-1, TYPE-11) ----

# FN-1: a value function's "parameter and result types are ordinary value
# types", and GEN-1: "ordinary positions require value types". TYPE-11: a
# window's value "given to a lifted helper (FN-12), is a `list<V>` of the
# values held". So its `T` given a window is that list.
const fn ident<T>(value: T) -> T => value
const fn same<T>(a: T, b: T) -> bool => a == b
const fn pick<T>(flag: bool, a: T, b: T) -> T {
    if flag { return a }
    return b
}
const fn one<T>(value: T) -> i64 => 1

fn listed(reading: i64) -> list<i64> => ident(readings(reading))
fn compared(a: i64, b: i64) -> bool => same(readings(a), readings(b))
fn picked(flag: bool, a: i64, b: i64) -> list<i64> => pick(flag, readings(a), readings(b))
fn counted(a: i64) -> i64 => one(readings(a))

test a_value_functions_generic_given_a_window_is_its_list {
    assert eval(listed(reading: [1, 2, 3, 4])) == [_, [1, 2], [1, 2, 3], [2, 3, 4]]
    assert eval(compared(a: [1, 2, 3], b: [1, 2, 4])) == [_, true, false]
    assert eval(picked(flag: [true, false], a: [1, 2], b: [5, 6])) == [_, [5, 6]]
    assert eval(counted(a: [1, 2, 3])) == [_, 1, 1]
}

# ---- A window that is a child of `out` (TIME-7, TYPE-11) ----

# TIME-7: "`inject out` exposes that same result for reads", and TYPE-11:
# a window's value, "read in a hook ... is a `list<V>`": a field, an
# element, a field of an element and an entry of `out` that is a window
# is read as its list, which fails where the window is not all valid.
# What is published to a window within a value is a window's delta
# (TYPE-16), which this target does not write: these nodes publish the
# parts that are no window, and are written, not run.
struct Tally {
    prices: rolling_window<i64, 3, 1>
    last: i64
}

fn capped_field(price: i64) -> Tally {
    inject out
    when {
        if all_valid(out) && total(out.prices) > 5 { return }
        return delta<Tally>(last: price)
    }
}

fn capped_bound(price: i64) -> Tally {
    inject out
    when {
        if all_valid(out) {
            let held: list<i64> = out.prices
            if total(held) > 5 { return }
        }
        return delta<Tally>(last: price)
    }
}

fn capped_loop(price: i64) -> Tally {
    inject out
    when {
        var sum: i64 = 0
        if all_valid(out) {
            for value in out.prices { sum += value }
        }
        if sum > 5 { return }
        return delta<Tally>(last: price)
    }
}

fn first_kept(price: i64) -> Tally {
    inject out
    when {
        if all_valid(out) { return delta<Tally>(last: out.prices[0]) }
        return delta<Tally>(last: price)
    }
}

fn capped_slots(slot: i64, price: i64) -> list<rolling_window<i64, 3, 1>, 2> {
    inject out
    when {
        if all_valid(out) && total(out[slot]) > 3 { return }
        return delta<list<rolling_window<i64, 3, 1>, 2>>(removed: [slot])
    }
}

fn capped_rows(price: i64) -> list<Tally, 1> {
    inject out
    when {
        if all_valid(out) && total(out[0].prices) > 3 { return }
        return delta<list<Tally, 1>>(updated: [0: delta<Tally>(last: price)])
    }
}

fn capped_keys(key: str, price: i64) -> dict<str, rolling_window<i64, 3, 1>> {
    inject out
    when {
        if valid(out) && total(out[key]) > 3 { return }
        return delta<dict<str, rolling_window<i64, 3, 1>>>(removed: [key])
    }
}


struct Book {
    prices: rolling_window<i64, 3, 2>
    last: i64
}

fn early_out(price: i64) -> Book {
    inject out
    when {
        if all_valid(out) && total(out.prices) > 100 { return }
        return delta<Book>(last: price)
    }
}

fn field_last(price: i64) -> i64 => capped_field(price).last
fn bound_last(price: i64) -> i64 => capped_bound(price).last
fn loop_last(price: i64) -> i64 => capped_loop(price).last
fn kept_last(price: i64) -> i64 => first_kept(price).last
fn slot_total(slot: i64, price: i64) -> i64 => total(capped_slots(slot, price)[0])
fn row_last(price: i64) -> i64 => capped_rows(price)[0].last
fn early_last(price: i64) -> i64 => early_out(price).last


# ---- A window's list indexed (TIME-9, TYPE-11) ----

# A window is no collection (TIME-9): `book.prices[0]` is a position of
# the list the window is read as, which `valid(book.prices)` admits, and
# which fails where the window is not all valid. These are written, and
# not run: nothing here publishes to the window.

fn first_price(book: Book) -> i64 {
    when all_valid(book.prices) { return book.prices[0] }
}

fn early_first_price(book: Book) -> i64 {
    when valid(book.prices) { return book.prices[0] }
}
