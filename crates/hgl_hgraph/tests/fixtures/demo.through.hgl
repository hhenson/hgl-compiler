module demo.through

operator pick<L, R, O>(lhs: L, rhs: R) -> O
impl const fn pick<T>(lhs: T, rhs: T) -> T => lhs

const fn first<T>(value: T) -> T requires pick(T, T) -> T => pick(value, value)
const fn wrapper<U>(value: U) -> U => first(value)
const fn outermost<V>(value: V) -> V => wrapper(value)
# GEN-13: a generic value read as a value, and handed on.
const fn width<const N: i64>() -> i64 => N
const fn wider<const M: i64>() -> i64 => width<M>() + 1

test a_caller_is_an_instance_too {
    assert wrapper(1) == 1
    assert outermost("a") == "a"
    assert width<3>() == 3
    assert wider<4>() == 5
}
