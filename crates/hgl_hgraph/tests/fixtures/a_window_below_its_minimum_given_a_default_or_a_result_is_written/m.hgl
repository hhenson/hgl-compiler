module m
const fn total(values: list<i64> = []) -> i64 {
    var sum: i64 = 0
    for value in values { sum += value }
    return sum
}
fn collect(reading: i64) -> rolling_window<i64, 3, 2> {
    when { return reading }
}
fn defaulted(reading: i64) -> i64 => total(collect(reading))
fn checked(both: list<rolling_window<i64, 2>, 2>, at: i64) -> result<list<i64>, error> {
    when { return both[at] }
}
