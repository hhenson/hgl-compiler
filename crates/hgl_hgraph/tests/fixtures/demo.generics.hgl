module demo.generics

# Graphs of core's generic temporal candidates.
fn identity_sum<T>(lhs: T, rhs: T) -> T
    requires add_(T, T) -> T => lhs +{invalid: .identity} rhs
fn identity_difference<T>(lhs: T, rhs: T) -> T
    requires sub_(T, T) -> T && neg_(T) -> T => lhs -{invalid: .identity} rhs
# A node, with an operation it requires in its hook.
fn doubled<T>(value: T) -> T requires add_(T, T) -> T {
    when valid(value) { return add_(value, value) }
}
# A graph of that node, twice.
fn quadrupled<T>(value: T) -> T requires add_(T, T) -> T => doubled(doubled(value))
# An operation a graph requires: the value candidate, lifted.
fn summed<T>(a: T, b: T) -> T requires add_(T, T) -> T {
    let both = add_(a, b)
    return both + both
}
# A generic value, read in a hook.
fn scaled<const by: i64>(value: i64) -> i64 {
    when valid(value) { return value * by }
}
# State of the generic type, and configuration of it.
fn latest<T>(value: T, const fallback: T) -> T {
    state held: T = fallback
    when valid(value) {
        let before = held
        held = value
        return before
    }
}
# A call from a graph with no generic parameter.
fn wired(a: i64, b: i64) -> i64 => identity_sum(a, b)
fn tripled(value: i64) -> i64 => scaled<3>(value)
# One no call gives its types to.
fn unused<T>(value: T) -> T {
    when valid(value) { return value }
}

test generics_are_instances {
    assert eval(identity_sum(lhs: [_, 1.5], rhs: [0.5])) == [0.5, 2.0]
    assert eval(identity_difference(lhs: [_, 1.5], rhs: [0.5])) == [-0.5, 1.0]
    assert eval(identity_sum(lhs: [_, 5m], rhs: [2m])) == [2m, 7m]
    assert eval(identity_sum(lhs: ["", _, "a"], rhs: [_, "b"])) == ["", "b", "ab"]
    assert eval(wired(a: [1, 2], b: [10])) == [11, 12]
    assert eval(doubled(value: [1, 2])) == [2, 4]
    assert eval(doubled(value: ["a"])) == ["aa"]
    assert eval(quadrupled(value: [1.5])) == [6.0]
    assert eval(summed(a: [1, 2], b: [10])) == [22, 24]
    assert eval(tripled(value: [2, 3])) == [6, 9]
    assert eval(scaled<4>(value: [2])) == [8]
    assert eval(latest(value: [1, 2], fallback: 0)) == [0, 1]
    assert eval(latest(value: ["a", "b"], fallback: "")) == ["", "a"]
}
