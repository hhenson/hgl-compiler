module demo.compare

const fn ordered(lhs: f64, rhs: f64) -> CmpResult => lhs <=> rhs
const fn mixed(lhs: i64, rhs: f64) -> CmpResult => lhs <=> rhs
const fn words(lhs: str, rhs: str) -> CmpResult => lhs <=> rhs
const fn both(lhs: bool, rhs: bool) -> bool => and_(lhs, rhs)
const fn either(lhs: bool, rhs: bool) -> bool => or_(lhs, rhs)
const fn neither(value: bool) -> bool => not_(value)

fn outcome(lhs: f64, rhs: f64) -> CmpResult => lhs <=> rhs

test outcomes {
    assert ordered(1.0, 2.0) == .less
    assert ordered(2.0, 1.0) == .greater
    assert ordered(0.0, -0.0) == .equivalent
    assert ordered(0.0 / 0.0, 1.0) == .unordered
    assert ordered(0.0 / 0.0, 0.0 / 0.0) == CmpResult.unordered
    assert mixed(9007199254740993, 9007199254740992.0) == .greater
    assert mixed(1, 1.0) == .equivalent
    assert words("a", "b") == .less
    assert (2 <=> 1) == .greater
    assert both(true, false) == false
    assert either(true, false)
    assert neither(false)
    assert eval outcome(lhs: [1.0, 2.0, 3.0], rhs: [2.0, 2.0, 2.0]) == [.less, .equivalent, .greater]
}
