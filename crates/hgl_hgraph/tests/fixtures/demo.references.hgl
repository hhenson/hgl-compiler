module demo.references

struct Quote {
    bid: i64
    ask: i64
}

# FN-16: a `ref` parameter is given a connection, which it designates,
# and a node that returns one to its `ref` result re-points what
# follows it.
fn pick(use_left: bool, ref left: i64, ref right: i64) -> ref i64 {
    when {
        if use_left { return left }
        return right
    }
}

# TIME-10: "a `ref` parameter is passive to what it designates": a
# publication of the target does not wake the node, and a designation
# given to it does (END-10).
fn designations(ref target: i64) -> i64 {
    state seen: i64 = 0
    when {
        seen = seen + 1
        return seen
    }
}

# A designation passed through a node.
fn kept(ref target: i64) -> ref i64 {
    when {
        if valid(target) && modified(target) { return target }
    }
}

# FN-16: the endpoint operations take a `ref` parameter. TIME-10:
# "`valid` of a `ref` parameter is whether a reference is present"; core's
# END-10, `modified` "whether the parameter was given a designation".
fn checked(ref target: i64) -> bool {
    when modified(target) { return valid(target) }
}

# GEN-11: a generic binds from the type of the connection it is given,
# at a `ref` parameter as at any other.
fn ticks<T>(value: T) -> i64 {
    state seen: i64 = 0
    when {
        seen = seen + 1
        return seen
    }
}

fn ref_ticks<T>(ref value: T) -> i64 {
    state seen: i64 = 0
    when {
        seen = seen + 1
        return seen
    }
}

fn same<T>(value: T) -> T {
    when { return value }
}

# FN-16: a `ref` result designates the element its `return` names of a
# list that is no `ref` parameter, which is not read: its reader follows
# the element, and the node is not woken by the element's ticks.
fn route(idx: i64, items: list<i64, 3>) -> ref i64 {
    when modified(idx) { return items[idx] }
}

# FN-16, proposed: `out = items[idx]` designates as the `return` does.
fn route_out(idx: i64, items: list<i64, 3>) -> ref i64 {
    inject out
    when modified(idx) { out = items[idx] }
}

# An input that is no `ref` parameter, designated whole.
fn hold(flag: bool, value: i64) -> ref i64 {
    when modified(flag) { return value }
}

fn set_one(slot: i64, reading: i64) -> list<i64, 3> {
    when { return delta<list<i64, 3>>(updated: [slot: reading]) }
}

fn follow(item: i64) -> i64 {
    when { return item }
}

const fn doubled(value: i64) -> i64 => value * 2

# TYPE-12: a `signal` input wakes its node and holds no payload.
fn sample(value: i64, tick: signal) -> i64 {
    when modified(tick) && valid(value) { return value }
}

fn counted(tick: signal) -> i64 {
    state seen: i64 = 0
    when {
        seen = seen + 1
        return seen
    }
}

# A `signal?` left out is never valid (UNIT-8).
fn maybe_sampled(value: i64, tick: signal?) -> i64 {
    when modified(tick) && valid(value) { return value }
    when modified(value) && valid(value) { return -value }
}

fn quoted(bid: i64, ask: i64) -> Quote {
    when { return Quote(bid: bid, ask: ask) }
}

# TYPE-9: `atomic<V>` publishes the whole V, and a hook reads it as a V.
const fn width(quote: Quote) -> i64 => quote.ask - quote.bid

fn snapshot(bid: i64, ask: i64) -> atomic<Quote> {
    when { return Quote(bid: bid, ask: ask) }
}

fn snapshot_width(quote: atomic<Quote>) -> i64 {
    when { return width(quote) }
}

fn raised(quote: atomic<Quote>) -> atomic<Quote> {
    when {
        let held: Quote = quote
        return Quote(bid: held.bid + 1, ask: held.ask)
    }
}

# `out` read back whole, as a V (TIME-7).
fn widened(bid: i64) -> atomic<Quote> {
    inject out
    when {
        out = Quote(bid: bid, ask: bid + 2)
        let whole: Quote = out
        out = Quote(bid: whole.bid, ask: out.ask + width(out))
    }
}

# An atomic input that may be left out (TYPE-14) is the atomic's port,
# and a valid one is read as its whole V: the `?` marks omission, and no
# null.
fn bid_or(value: i64, quote: atomic<Quote>?) -> i64 {
    when valid(value) {
        if valid(quote) {
            let whole: Quote = quote
            return whole.bid + quote.ask - quote.ask
        }
        return -value
    }
}

# A `var` given an atomic input's value has a value of its own (the
# owner's copy rule): changing it leaves the input's as it was.
struct Triple {
    a: i64
    b: i64
    c: i64
}

fn tripled(a: i64) -> atomic<Triple> {
    when { return Triple(a: a, b: a, c: a) }
}

fn changed_copy(triple: atomic<Triple>) -> i64 {
    when {
        var saved: Triple = triple
        saved.a = saved.a + 100
        return triple.a + saved.a
    }
}

# TYPE-16: an atomic's delta is the whole value, the field that did not
# change among it.
fn whole_ask(quote: atomic<Quote>) -> i64 {
    when { return delta_value(quote).ask }
}

fn followed(use_left: bool, left: i64, right: i64) -> i64 => pick(use_left, left, right)
fn repointed(use_left: bool, left: i64, right: i64) -> i64 => designations(pick(use_left, left, right))
fn kept_of(use_left: bool, left: i64, right: i64) -> i64 => kept(pick(use_left, left, right))
fn checked_of(use_left: bool, left: i64, right: i64) -> bool => checked(pick(use_left, left, right))
fn doubled_of(use_left: bool, left: i64, right: i64) -> i64 => doubled(pick(use_left, left, right))
# A graph passes a `ref` result on as the connection of `i64` it is.
fn passed_on(value: i64) -> i64 => value
fn through_graphs(use_left: bool, left: i64, right: i64) -> i64 =>
    passed_on(pick(use_left, passed_on(left), right))
# A graph's `if` selects a `ref` result as any connection.
fn branched(flag: bool, left: i64, right: i64) -> i64 => if flag { left } else { right }
fn branched_of(flag: bool, left: i64, right: i64) -> i64 => branched(flag, pick(true, left, left), right)
fn generic_follows(use_left: bool, left: i64, right: i64) -> i64 => ticks(pick(use_left, left, right))
fn generic_designates(use_left: bool, left: i64, right: i64) -> i64 =>
    ref_ticks(pick(use_left, left, right))
fn requested_ticks(left: i64) -> i64 => ref_ticks(same(left))
fn routed(idx: i64, slot: i64, reading: i64) -> i64 => follow(route(idx, set_one(slot, reading)))
fn routed_out(idx: i64, slot: i64, reading: i64) -> i64 =>
    follow(route_out(idx, set_one(slot, reading)))
fn followed_hold(flag: bool, value: i64) -> i64 => follow(hold(flag, value))

fn sampled_of(value: i64, probe: bool) -> i64 => sample(value, probe)
fn woken(value: i64) -> i64 => counted(value)
fn woken_by_struct(bid: i64, ask: i64) -> i64 => counted(quoted(bid, ask))
fn woken_by_reference(use_left: bool, left: i64, right: i64) -> i64 =>
    counted(pick(use_left, left, right))
fn passed_signal(tick: signal) -> i64 => counted(tick)
fn passed(value: i64) -> i64 => passed_signal(value)
fn left_out(value: i64) -> i64 => maybe_sampled(value)
# A captured call leaves the input out as a call does (ERR-7).
fn left_out_captured(value: i64) -> i64 {
    let boundary = capture(maybe_sampled, value)
    return boundary.value
}
fn given(value: i64, probe: bool) -> i64 => maybe_sampled(value, probe)

fn width_of(bid: i64, ask: i64) -> i64 => snapshot_width(snapshot(bid, ask))
fn raised_bid(bid: i64, ask: i64) -> i64 => raised(snapshot(bid, ask)).bid
fn widened_ask(bid: i64) -> i64 => widened(bid).ask
fn whole_asks(bid: i64, ask: i64) -> i64 => whole_ask(snapshot(bid, ask))
fn changed_copy_of(a: i64) -> i64 => changed_copy(tripled(a))
fn bids(value: i64, bid: i64, ask: i64) -> i64 => bid_or(value, snapshot(bid, ask))
fn bids_left_out(value: i64) -> i64 => bid_or(value)
fn snapshots(bid: i64, ask: i64) -> i64 => counted(snapshot(bid, ask))

test a_reader_observes_what_a_reference_designates {
    assert eval(followed(use_left: [true, _, false, _], left: [1, 2, 3, _], right: [10, _, _, 11])) ==
        [1, 2, 10, 11]
    assert eval(repointed(use_left: [true, _, false, _], left: [1, 2, 3, _], right: [10, _, _, 11])) ==
        [1, _, 2, _]
    assert eval(kept_of(use_left: [true, _, false, _], left: [1, 2, 3, _], right: [10, _, _, 11])) ==
        [1, 2, 10, 11]
    assert eval(checked_of(use_left: [true, _, false], left: [1, 2, 3], right: [10, _, _])) ==
        [true, _, true]
    assert eval(doubled_of(use_left: [true, _, false, _], left: [1, 2, 3, _], right: [10, _, _, 11])) ==
        [2, 4, 20, 22]
    assert eval(through_graphs(use_left: [true, _, false, _], left: [1, 2, 3, _], right: [10, _, _, 11])) ==
        [1, 2, 10, 11]
    assert eval(branched_of(flag: [true, _, false, _], left: [1, 2, 3, _], right: [10, _, _, 11])) ==
        [1, 2, 10, 11]
    assert eval(generic_follows(use_left: [true, _, false, _], left: [1, 2, 3, _], right: [10, _, _, 11])) ==
        [1, 2, 3, 4]
    assert eval(generic_designates(use_left: [true, _, false, _], left: [1, 2, 3, _], right: [10, _, _, 11])) ==
        [1, _, 2, _]
    assert eval(requested_ticks(left: [1, 2, 3])) == [1, _, _]
    # An eval of a `ref` result records what it designates.
    assert eval(pick(use_left: [true, _, false], left: [1, 2, 3], right: [10, _, _])) == [1, 2, 10]
}

test a_ref_result_designates_what_its_return_names {
    assert eval(routed(
        idx:     [ 1,  _,  _, 2,  _,  0],
        slot:    [ 1,  1,  0, _,  2,  0],
        reading: [20, 21, 10, _, 30, 11],
    )) ==        [20, 21,  _, _, 30, 11]
    assert eval(routed_out(
        idx:     [ 1,  _,  _, 2,  _,  0],
        slot:    [ 1,  1,  0, _,  2,  0],
        reading: [20, 21, 10, _, 30, 11],
    )) ==        [20, 21,  _, _, 30, 11]
    assert eval(followed_hold(flag: [true, _, true], value: [1, 2, 3])) == [1, 2, 3]
}

test a_signal_wakes_its_node {
    assert eval(sampled_of(value: [1, 2, _, 3], probe: [_, true, true, _])) == [_, 2, 2, _]
    assert eval(woken(value: [1, _, 2])) == [1, _, 2]
    assert eval(woken_by_struct(bid: [1, _, 2], ask: [5, _, _])) == [1, _, 2]
    assert eval(woken_by_reference(use_left: [true, _, false, _], left: [1, 2, 3, _], right: [10, _, _, 11])) ==
        [1, 2, 3, 4]
    assert eval(passed(value: [1, 2])) == [1, 2]
    assert eval(left_out(value: [1, 2])) == [-1, -2]
    assert eval(left_out_captured(value: [1, 2])) == [-1, -2]
    assert eval(given(value: [1, 2, _], probe: [_, true, true])) == [-1, 2, 2]
}

test an_atomic_struct_ticks_once_with_its_whole_value {
    assert eval(width_of(bid: [1, 2, _], ask: [5, _, 9])) == [4, 3, 7]
    assert eval(raised_bid(bid: [1, 2], ask: [5, _])) == [2, 3]
    assert eval(widened_ask(bid: [1, 2])) == [5, 6]
    assert eval(whole_asks(bid: [1, 2, _], ask: [5, _, 6])) == [5, 5, 6]
    assert eval(changed_copy_of(a: [1, 2])) == [102, 104]
    assert eval(bids(value: [1, 2], bid: [5, _], ask: [6, _])) == [5, 5]
    assert eval(bids_left_out(value: [1, 2])) == [-1, -2]
    assert eval(snapshots(bid: [1, 2, 3], ask: [5, 6, _])) == [1, 2, 3]
}

# TYPE-3: a struct's connection is given where an abstract struct it
# inherits from is expected, across a `ref` result and to a `ref`
# parameter (FN-16) as anywhere.
abstract struct Shape {
    id: i64
}

struct Circle : Shape {
    radius: i64
}

fn circled(id: i64) -> Circle {
    when { return Circle(id: id, radius: 1) }
}

fn shape_id(shape: Shape) -> i64 {
    when all_valid(shape) { return shape.id }
}

fn same_circle(circle: Circle) -> ref Circle {
    when { return circle }
}

fn shapes_designated(ref shape: Shape) -> i64 {
    state seen: i64 = 0
    when {
        seen = seen + 1
        return seen
    }
}

fn narrowed_follow(id: i64) -> i64 => shape_id(same_circle(circled(id)))
fn narrowed_designation(id: i64) -> i64 => shapes_designated(circled(id))

test a_struct_is_narrowed_across_a_ref {
    assert eval(narrowed_follow(id: [1, 2])) == [1, 2]
    assert eval(narrowed_designation(id: [1, 2])) == [1, _]
}
