module demo.copy_points

# The owner's rule for a `var` (the compiler's issue 151), for a struct:
# "The copy by value exception is for trivial structures (think
# sizeof(i64))". A struct of at most two scalar fields is a value: it is
# given and kept as it is, and a change of a field makes a new one. Any
# other struct is changed where it is, as a list is, and a copy is made
# at the points a list has one: a `let` or a loop whose place changes
# while the name is in scope, a call that is also given a `var`
# reference to it, what a place keeps, a result, and what is published.

struct Ticket {
    id: i64
    size: i64
    price: f64
}

struct Point {
    x: i64
    y: i64
}

struct Book {
    best: Ticket
    name: str
    at: Point
}

struct Key {
    name: str
    side: i64
}

abstract struct Sized {
    size: i64
}
struct Small : Sized {}

const fn ticket(size: i64) -> Ticket => Ticket(id: 1, size: size, price: 1.0)

# A result: a copy of what the function was given, and its own `var` as
# it is.
const fn same(given: Ticket) -> Ticket => given
const fn grown(given: Ticket, by: i64) -> Ticket {
    var mine = given
    mine.size += by
    return mine
}

# The owner's first case: the call has a `var` reference to what it is
# also given, and that argument stays as it was while the place changes
# (FN-13: "Each invocation observes a stable ordinary argument value").
const fn absorb(var into: Ticket, other: Ticket) {
    into.size += other.size
    into.size += other.size
}

# A call given a key and the entry it names: the entry is the one the
# key named when the arguments were evaluated (FN-15).
const fn rekeyed(var key: Key, var count: i64) {
    key.side = 2
    count += 1
}

# A `let` whose place changes no more while the name is in scope is a
# reference.
const fn size_after(by: i64) -> i64 {
    var mine = ticket(0)
    mine.size += by
    let read = mine
    return read.size
}

# A loop over what its own body changes runs over a copy; any other
# reads each entry where it is.
const fn sizes_seen(tickets: list<Ticket>) -> i64 {
    var mine = tickets
    var seen: i64 = 0
    for each in mine {
        mine[0].size = 0
        seen += each.size
    }
    return seen
}
const fn total_size(tickets: list<Ticket>) -> i64 {
    var total: i64 = 0
    for each in tickets { total += each.size }
    return total
}

# EXPR-3: "An assignment may name a place inside a value, at any depth",
# and TYPE-5: "later mutation of a source cannot change an earlier
# retained value". What took the old value is as it was.
test a_let_is_a_copy_where_its_place_changes {
    var mine = ticket(1)
    let before = mine
    mine.size = 2
    assert before.size == 1 && mine.size == 2
    assert size_after(3) == 3
    # A field of a struct inside another, and a struct taken out of one.
    var book = Book(best: ticket(1), name: "a", at: Point(x: 0, y: 0))
    let best = book.best
    book.best.size = 5
    book.at.x = 1
    assert best.size == 1 && book.best.size == 5 && book.at == Point(x: 1, y: 0)
}

test a_loop_runs_over_a_copy_where_its_body_changes_the_place {
    assert sizes_seen([ticket(1), ticket(2)]) == 3
    assert total_size([ticket(1), ticket(2)]) == 3
}

test what_a_place_keeps_is_a_copy {
    var first = ticket(1)
    # A `var` given another's struct, a function's own result, and one
    # written out.
    var second = first
    second.size = 2
    var third = grown(first, 2)
    third.size += 1
    var fourth = Ticket(id: 4, size: 4, price: 4.0)
    fourth.size += 1
    assert first.size == 1 && second.size == 2 && third.size == 4 && fourth.size == 5
    # A result is a copy of what the function was given.
    var back = same(first)
    back.size = 7
    assert first.size == 1 && back.size == 7
    # An element, an entry, a field and a tuple's position keep a copy.
    var tickets: list<Ticket> = [ticket(0)]
    tickets[0] = first
    append(tickets, first)
    append(tickets, ticket(3))
    first.size = 9
    tickets[1].size = 8
    assert tickets == [ticket(1), ticket(8), ticket(3)] && first.size == 9
    var named: dict<str, Ticket> = []
    named["a"] = first
    first.size = 10
    assert named["a"].size == 9
    var book = Book(best: ticket(0), name: "a", at: Point(x: 0, y: 0))
    book.best = first
    first.size = 11
    assert book.best.size == 10
    var pair: tuple<Ticket, i64> = (first, 1)
    pair[0].size = 12
    assert first.size == 11 && pair[0].size == 12
    # A dictionary keeps a copy of a key it has not.
    var key = Key(name: "a", side: 1)
    var counts: dict<Key, i64> = []
    counts[key] = 1
    key.side = 2
    assert counts[Key(name: "a", side: 1)] == 1 && get(counts, key) == null
}

test a_call_given_a_var_reference_copies_what_it_is_also_given {
    var mine = ticket(1)
    absorb(mine, mine)
    assert mine.size == 3
    var other = ticket(2)
    absorb(mine, other)
    assert mine.size == 7 && other.size == 2
    var key = Key(name: "a", side: 1)
    var counts: dict<Key, i64> = [Key(name: "a", side: 1): 5]
    rekeyed(key, counts[key])
    assert key.side == 2 && counts == [Key(name: "a", side: 1): 6]
}

test a_struct_of_two_scalars_is_a_value {
    var at = Point(x: 1, y: 2)
    var moved = at
    let before = at
    moved.x = 5
    at.y = 6
    assert at == Point(x: 1, y: 6) && moved == Point(x: 5, y: 2) && before == Point(x: 1, y: 2)
    # Held as its parent, a value is still not changed where it is.
    let small = Small(size: 1)
    var held: Sized = small
    held.size = 5
    var items: list<Sized> = []
    append(items, small)
    items[0].size = 7
    assert small.size == 1 && held.size == 5 && items[0].size == 7
}

# FN-15: "A function that fails leaves the place holding what its
# parameter held when it failed: no change it had made is undone."
const fn bump_then_fail(var count: i64, zero: i64) {
    count += 1
    count += 1 // zero
}
const fn grow_then_fail(var mine: Ticket, zero: i64) {
    mine.size += 1
    mine.size += 1 // zero
}
const fn move_then_fail(var at: Point, zero: i64) {
    at.x += 1
    at.y += 1 // zero
}
const fn replace_then_fail(var items: list<i64>, zero: i64) {
    items = [0]
    append(items, 1 // zero)
}
const fn passed_on_then_fail(var count: i64, zero: i64) {
    count += 10
    bump_then_fail(count, zero)
}

test a_function_that_fails_leaves_what_its_parameter_held {
    var count: i64 = 0
    assert raises("numeric.division_by_zero") { bump_then_fail(count, 0) }
    assert count == 1
    var mine = ticket(0)
    assert raises("numeric.division_by_zero") { grow_then_fail(mine, 0) }
    assert mine.size == 1
    var at = Point(x: 0, y: 0)
    assert raises("numeric.division_by_zero") { move_then_fail(at, 0) }
    assert at == Point(x: 1, y: 0)
    var items: list<i64> = [5, 6]
    assert raises("numeric.division_by_zero") { replace_then_fail(items, 0) }
    assert items == [0]
    var held: i64 = 0
    assert raises("numeric.division_by_zero") { passed_on_then_fail(held, 0) }
    assert held == 11
    # A place inside a value.
    var book = Book(best: ticket(0), name: "a", at: Point(x: 0, y: 0))
    assert raises("numeric.division_by_zero") { bump_then_fail(book.best.size, 0) }
    assert raises("numeric.division_by_zero") { move_then_fail(book.at, 0) }
    assert book.best.size == 1 && book.at == Point(x: 1, y: 0)
    # An argument that fails is evaluated before the call: the
    # function is not called, and the place is as it was.
    var zero: i64 = 0
    var untouched: i64 = 3
    assert raises("numeric.division_by_zero") { bump_then_fail(untouched, 1 // zero) }
    assert untouched == 3
    # A call that does not fail.
    bump_then_fail(count, 1)
    assert count == 3
}

# What is published is the runtime's to keep: a copy of a `state` that
# goes on changing (FN-13: "Retained results must remain independent of
# later temporal changes").
fn snapshot(size: i64) -> atomic<Ticket> {
    when { return ticket(size) }
}
fn kept_growing(step: i64, publish: bool) -> atomic<Ticket> {
    state mine: Ticket = Ticket(id: 1, size: 0, price: 1.0)
    when modified(step) {
        mine.size += step
        if publish { return mine }
    }
}
fn size_at(given: atomic<Ticket>, tick: bool) -> i64 {
    when modified(tick) { return given.size }
}
# A node that changes the configuration it was given changes its own
# copy of it: hgraph holds the configuration, the same at each tick.
fn counted_from(const initial: Ticket, tick: bool) -> i64 {
    when {
        var mine = initial
        mine.size += 1
        return mine.size
    }
}
fn published_then_read(step: i64, publish: bool, tick: bool) -> i64 =>
    size_at(kept_growing(step, publish), tick)
fn counted_from_one(tick: bool) -> i64 => counted_from(ticket(1), tick)

test what_is_published_is_never_changed_after {
    assert eval(published_then_read(
        step:    [   1,     2,    _],
        publish: [true, false,    _],
        tick:    [   _,     _, true],
    )) ==        [   _,     _,    1]
    assert eval(counted_from_one(tick: [true, true])) == [2, 2]
}

# FN-13: "Retained results must remain independent of later temporal
# changes", for a struct as core's `keep_readings` is for a list.
const fn keep_ticket(given: Ticket) -> Ticket => given

fn ticketed(size: i64) -> Ticket {
    when { return ticket(size) }
}

fn saved_size(current: Ticket, save: bool) -> i64 {
    cache saved: Ticket = Ticket(id: 0, size: 0, price: 0.0)
    when modified(save) {
        if save { saved = current }
        return saved.size
    }
}

fn observe_saved(size: i64, save: bool) -> i64 =>
    saved_size(keep_ticket(ticketed(size)), save)

test a_retained_struct_is_independent_of_later_input_changes {
    assert eval(observe_saved(size: [2, 7, _], save: [true, false, true])) == [2, 2, 7]
}
