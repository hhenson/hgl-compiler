module demo.out_reads

# TIME-7: "`inject out` exposes that same result for reads", and "`out` is
# read in a `when` and in `stop`". Until the node has published, `out`
# holds no payload, and a read of it is the catalogue's `value.unset_read`:
# "Executed operation requires an unset ordinary payload". That is an
# execution failure (ERR-1), which a capture takes (ERR-7: "Each
# evaluation failure ticks its canonical error").

struct Quote {
    bid: i64
    ask: i64
}

# `out` read whole, in a `when`.
fn bump(value: i64) -> i64 {
    inject out
    when { return out + value }
}

# Once the node has published, `out` holds what it published.
fn running(value: i64) -> i64 {
    inject out
    when {
        if !valid(out) { return value }
        return out + value
    }
}

fn coded(failure: error) -> str {
    when {
        let code = failure.code
        if code == null { return "none" }
        return code
    }
}

fn bump_captured(value: i64) -> str {
    let seen = capture(bump, value)
    return coded(seen.error)
}

test an_unset_out_read_fails_with_its_code {
    assert raises("value.unset_read") { eval bump(value: [1, 2]) }
    assert eval running(value: [1, 2, 3]) == [1, 3, 6]
}

test an_unset_out_read_is_captured {
    assert eval bump_captured(value: [1, 2]) == ["value.unset_read", "value.unset_read"]
}

# `out` read by a part: a field of a struct.
fn bid_bumped(value: i64) -> Quote {
    inject out
    when { return Quote(bid: out.bid + value, ask: value) }
}

test an_unset_part_of_out_read_fails_with_its_code {
    assert raises("value.unset_read") { eval bid_bumped(value: [1]) }
}

# `out` read in `stop`: it ends the run, and a failure there escapes
# (ERR-8: "Start/stop failures escape").
fn last_published(value: i64) -> i64 {
    inject out
    state last: i64 = 0
    when value > 0 { return value }
    stop { last = out }
}

test an_unset_out_read_in_stop_fails_with_its_code {
    assert eval last_published(value: [1, 0]) == [1]
    assert raises("value.unset_read") { eval last_published(value: [0, 0]) }
}

# `out` of a collection read whole: a list and a dictionary.
fn grown(value: i64) -> list<i64> {
    inject out
    when {
        var held = out
        append(held, value)
        return held
    }
}

fn grown_once_valid(value: i64) -> list<i64> {
    inject out
    when {
        if !valid(out) { return [value] }
        var held = out
        append(held, value)
        return held
    }
}

fn keyed(value: i64) -> dict<str, i64> {
    inject out
    when {
        var held = out
        held["k"] = value
        return held
    }
}

test an_unset_collection_out_read_fails_with_its_code {
    assert raises("value.unset_read") { eval grown(value: [1, 2]) }
    assert eval grown_once_valid(value: [1, 2]) == [[1], [1, 2]]
    assert raises("value.unset_read") { eval keyed(value: [1, 2]) }
}
