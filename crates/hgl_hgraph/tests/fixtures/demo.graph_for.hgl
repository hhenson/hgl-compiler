module demo.graph_for

# CTRL-15: "`for item in items` over an ordinary list, set, or
# dictionary composes its body once for each element, with ordinary
# values bound, and may carry a `var` from one pass to the next."
fn chained(price: i64, const factors: list<i64>) -> i64 {
    var running = price
    for factor in factors {
        running = running * factor
    }
    return running
}

fn weighted(price: i64, const weights: dict<str, i64>) -> i64 {
    var running = price
    for name, weight in weights {
        running = running + weight
    }
    return running
}

test a_wiring_time_for_carries_a_var {
    assert eval chained(price: [1, 2], factors: [2, 3]) == [6, 12]
    assert eval chained(price: [1, 2], factors: []) == [1, 2]
    assert eval weighted(price: [1, 2], weights: ["a": 10, "b": 100]) == [111, 112]
}

# CTRL-15: "Over a connection of `list<T, N>` it composes its body `N`
# times, `item` a connection of `T`".
fn both_positions(low: i64) -> list<i64, 2> {
    when { return [low, low + 1] }
}

fn summed(low: i64) -> i64 {
    var total = low
    for item in both_positions(low) {
        total = total + item
    }
    return total
}

test a_fixed_list_composes_its_body_for_each_position {
    assert eval summed(low: [1, 5]) == [4, 16]
}

# CTRL-7: "Dynamic independent dictionary/list bodies create one child
# per member key/index. Update keeps the child; removal stops it;
# reinsertion creates fresh state." A child is seen through the run's
# store: the child of the key "a" keeps there the ticks it has counted,
# and each child counts its starts and its stops. A reader reads the
# store when `tick` ticks, a cycle after the children write.
const fn started(global_state: GlobalState) {
    let before = if has(global_state, "started") { get<i64>(global_state, "started") } else { 0 }
    put(global_state, "started", before + 1)
}

const fn stopped(global_state: GlobalState) {
    let before = if has(global_state, "stopped") { get<i64>(global_state, "stopped") } else { 0 }
    put(global_state, "stopped", before + 1)
}

fn counted(name: str, price: i64) {
    inject global_state
    state seen: i64 = 0
    start { started(global_state) }
    when modified(price) {
        seen += 1
        if name == "a" { put(global_state, "a", seen) }
    }
    stop { stopped(global_state) }
}

fn stored(tick: bool, const key: str) -> i64 {
    inject global_state
    when modified(tick) {
        if has(global_state, key) { return get<i64>(global_state, key) }
        return 0
    }
}

# A dictionary that a negative price removes `key` from.
fn priced(key: str, price: i64) -> dict<str, i64> {
    when {
        if price < 0 { return delta<dict<str, i64>>(removed: [key]) }
        return delta<dict<str, i64>>(updated: [key: price])
    }
}

# CTRL-15: over a connection of `dict<K, V>` "`key` is an ordinary `K`
# and `value` a connection of `V`".
fn each_price(key: str, price: i64, tick: bool, const shown: str) -> i64 {
    for name, value in priced(key, price) {
        counted(name, value)
    }
    return stored(tick, shown)
}

test a_dictionary_has_a_child_for_each_key {
    # "a" ticks twice in one child, is removed, and is added again to a
    # fresh child; "b" has a child of its own throughout.
    assert eval each_price(
        key:   ["a", _,    "b", _,    "a", _,    "a", _,    "a", _],
        price: [1,   _,    7,   _,    2,   _,    -1,  _,    5,   _],
        tick:  [_,   true, _,   true, _,   true, _,   true, _,   true],
        shown: "a") ==
               [_,   1,    _,   1,    _,   2,    _,   2,    _,   1]
    assert eval each_price(
        key:   ["a", _,    "b", _,    "a", _,    "a", _,    "a", _],
        price: [1,   _,    7,   _,    2,   _,    -1,  _,    5,   _],
        tick:  [_,   true, _,   true, _,   true, _,   true, _,   true],
        shown: "started") ==
               [_,   1,    _,   2,    _,   2,    _,   2,    _,   3]
    assert eval each_price(
        key:   ["a", _,    "b", _,    "a", _,    "a", _,    "a", _],
        price: [1,   _,    7,   _,    2,   _,    -1,  _,    5,   _],
        tick:  [_,   true, _,   true, _,   true, _,   true, _,   true],
        shown: "stopped") ==
               [_,   0,    _,   0,    _,   0,    _,   1,    _,   1]
}

# A list of `[1, reading]`, or of `[1]` where the reading is negative.
# After the first, each is a delta, which ticks only the positions it
# names: a whole list publishes each of them (END-2).
fn readings(reading: i64) -> list<i64> {
    inject out
    when {
        if reading < 0 { return delta<list<i64>>(size_modified: 1) }
        if !valid(out) { return [1, reading] }
        return delta<list<i64>>(updated: [1: reading])
    }
}

fn tallied(item: i64) {
    inject global_state
    state seen: i64 = 0
    start { started(global_state) }
    when modified(item) {
        seen += 1
        put(global_state, "seen", seen)
    }
    stop { stopped(global_state) }
}

# CTRL-15: over a connection of `list<T>` "`item` is a connection of
# `T`", one child for each position.
fn each_reading(reading: i64, tick: bool, const shown: str) -> i64 {
    for item in readings(reading) {
        tallied(item)
    }
    return stored(tick, shown)
}

test a_list_has_a_child_for_each_position {
    # Position 1 changes, so its child counts a second tick; the list
    # shrinks, which stops it, and grows, which starts a fresh one.
    assert eval each_reading(
        reading: [5, _,    6, _,    -1, _,    7, _],
        tick:    [_, true, _, true, _,  true, _, true],
        shown: "seen") ==
                 [_, 1,    _, 2,    _,  2,    _, 1]
    assert eval each_reading(
        reading: [5, _,    6, _,    -1, _,    7, _],
        tick:    [_, true, _, true, _,  true, _, true],
        shown: "started") ==
                 [_, 2,    _, 2,    _,  2,    _, 3]
    assert eval each_reading(
        reading: [5, _,    6, _,    -1, _,    7, _],
        tick:    [_, true, _, true, _,  true, _, true],
        shown: "stopped") ==
                 [_, 0,    _, 0,    _,  1,    _, 1]
}

# CTRL-15: over a connection of `set<T>` the member is "an ordinary `T`,
# the member itself".
fn members(member: i64) -> set<i64> {
    when {
        if member < 0 { return delta<set<i64>>(removed: [0 - member]) }
        return delta<set<i64>>(added: [member])
    }
}

fn each_member(member: i64, tick: bool, const shown: str) -> i64 {
    for each in members(member) {
        tallied(each)
    }
    return stored(tick, shown)
}

test a_set_has_a_child_for_each_member {
    assert eval each_member(
        member: [1, _,    2, _,    -1, _,    1, _],
        tick:   [_, true, _, true, _,  true, _, true],
        shown: "started") ==
                [_, 1,    _, 2,    _,  2,    _, 3]
    assert eval each_member(
        member: [1, _,    2, _,    -1, _,    1, _],
        tick:   [_, true, _, true, _,  true, _, true],
        shown: "stopped") ==
                [_, 0,    _, 0,    _,  1,    _, 1]
}

# An `if` over a connection in a child: its branch's graph takes the
# key's port and the connection the loop reads from outside, which
# each child is given whole.
fn each_open(key: str, price: i64, open: bool, tick: bool, const shown: str) -> i64 {
    for name, value in priced(key, price) {
        if open { counted(name, value) }
    }
    return stored(tick, shown)
}

test a_child_reads_a_connection_from_outside {
    assert eval each_open(
        key:   ["a",  _,    "a", _,    "a",  _,    "a", _],
        price: [1,    _,    2,   _,    3,    _,    4,   _],
        open:  [true, _,    _,   _,    false, _,   true, _],
        tick:  [_,    true, _,   true, _,    true, _,   true],
        shown: "a") ==
               [_,    1,    _,   2,    _,    2,    _,   1]
}

# An `if` over a connection in a loop unrolled where the graph is built
# is a child graph on each pass, and carries the `var`.
fn boosted(price: i64, rising: bool, const factors: list<i64>) -> i64 {
    var running = price
    for factor in factors {
        if rising { running = running * factor }
    }
    return running
}

test an_if_over_a_connection_on_each_pass {
    assert eval boosted(price: [1, 2], rising: [true, false], factors: [2, 3]) == [6, 2]
}

# CTRL-15: "The condition of a `while` is an ordinary `bool`, tested
# while the graph is built".
fn doubled_times(price: i64, const times: i64) -> i64 {
    var running = price
    var left = times
    while left > 0 {
        running = running * 2
        left -= 1
    }
    return running
}

test a_while_composes_its_body_on_each_pass {
    assert eval doubled_times(price: [1, 2], times: 3) == [8, 16]
    assert eval doubled_times(price: [1, 2], times: 0) == [1, 2]
}

# CTRL-15: "a `switch` over an ordinary value composes the one case
# selected".
fn picked_by(price: i64, const route: i64) -> i64 {
    switch route {
        case 1: return price
        case 2: return price * 2
        default: return price * 3
    }
}

fn scaled_by(price: i64, const route: i64) -> i64 {
    var chosen = price
    switch route {
        case 1: chosen = price * 10
        default: chosen = price + 1
    }
    return chosen
}

# A case with a returning `if` over a connection has what follows the
# `switch` as that `if`'s other path.
fn routed_inside(flag: bool, price: i64, const route: i64) -> i64 {
    switch route {
        case 1:
            if flag { return price }
        default:
    }
    return price * 2
}

test a_wiring_time_switch_composes_one_case {
    assert eval picked_by(price: [1, 2], route: 1) == [1, 2]
    assert eval picked_by(price: [1, 2], route: 2) == [2, 4]
    assert eval picked_by(price: [1, 2], route: 5) == [3, 6]
    assert eval scaled_by(price: [1, 2], route: 1) == [10, 20]
    assert eval scaled_by(price: [1, 2], route: 2) == [2, 3]
    assert eval routed_inside(flag: [true, false], price: [1, 2], route: 1) == [1, 4]
    assert eval routed_inside(flag: [true, false], price: [1, 2], route: 2) == [2, 4]
}

# CTRL-2: "Only the selected temporal child runs. A changed selector
# stops the old child and starts the selected child fresh. Repeated
# equal selector values do not recreate it." CTRL-3: "An outputless if
# has no synthetic result; an omitted false branch performs no
# conditional work."
fn gated_count(open: bool, price: i64, tick: bool, const shown: str) -> i64 {
    if open { counted("a", price) }
    return stored(tick, shown)
}

test a_selected_child_keeps_its_state_until_another_is_selected {
    assert eval gated_count(
        open:  [true, _,    true, _,    false, _,    true, _],
        price: [1,    _,    2,    _,    3,     _,    4,    _],
        tick:  [_,    true, _,    true, _,     true, _,    true],
        shown: "a") ==
               [_,    1,    _,    2,    _,     2,    _,    1]
    assert eval gated_count(
        open:  [true, _,    true, _,    false, _,    true, _],
        price: [1,    _,    2,    _,    3,     _,    4,    _],
        tick:  [_,    true, _,    true, _,     true, _,    true],
        shown: "stopped") ==
               [_,    0,    _,    0,    _,     1,    _,    1]
}

# CTRL-14: "A `return value` in a branch of a temporal `if` makes the
# graph's result that value while the branch is selected and the
# continuation's otherwise", where the `if` gives a `let` its value.
fn returned_from_a_let(flag: bool, left: i64, right: i64) -> i64 {
    let taken = if flag { return left } else { right * 2 }
    return taken + 1
}

# The same for a return in a branch's value.
fn returned_in_a_branch_value(outer: bool, inner: bool, left: i64, right: i64) -> i64 {
    let taken = if outer { if inner { return left } else { right } } else { right * 2 }
    return taken + 1
}

# A returning `switch` over a connection in a branch with no value of a
# `let`'s wiring-time `if`.
fn switched_in_a_let(route: i64, price: i64, const wide: bool) -> i64 {
    let taken = if wide {
        switch route {
            case 1: return price
            default: return price * 10
        }
    } else {
        price * 2
    }
    return taken + 1
}

test a_return_in_an_if_that_gives_a_let_its_value {
    assert eval returned_from_a_let(flag: [true, false, _, true], left: [1, 2, 3, 4], right: [10, 20, 30, 40]) ==
        [1, 41, 61, 4]
    assert eval returned_in_a_branch_value(outer: [true, true, false], inner: [true, false, _], left: [1, 2, 3], right: [10, 20, 30]) ==
        [1, 21, 61]
    assert eval switched_in_a_let(route: [1, 2, 1], price: [1, 2, 3], wide: true) == [1, 20, 3]
    assert eval switched_in_a_let(route: [1, 2, 1], price: [1, 2, 3], wide: false) == [3, 5, 7]
}

# CTRL-8: "During node evaluation, traversal uses current values ...
# Lists preserve index order".
fn digits(values: list<i64>) -> i64 {
    when {
        var made = 0
        for value in values { made = made * 10 + value }
        return made
    }
}

fn digits_of(reading: i64) -> i64 => digits(readings(reading))

fn total_price(prices: dict<str, i64>) -> i64 {
    when {
        var sum = 0
        for name, price in prices { sum += price }
        return sum
    }
}

fn total_price_of(key: str, price: i64) -> i64 => total_price(priced(key, price))

test a_hook_loops_over_current_values {
    assert eval digits_of(reading: [5, -1, 7]) == [15, 1, 17]
    assert eval total_price_of(key: ["a", "b", "a", "a"], price: [1, 2, 3, -1]) == [1, 3, 5, 2]
}

# CTRL-10: "A block whose last statement is an expression has that
# expression's value and type ... With no `else` it is as if its `else`
# were null ... A branch that returns from the function gives the `if`
# no value".
const fn stepped_up(a: i64, up: bool) -> i64 {
    let made = if up {
        let doubled = a * 2
        doubled + 1
    } else {
        a
    }
    return made
}

const fn positive(a: i64) -> i64? {
    if a > 0 { a }
}

const fn labelled(a: i64) -> str {
    var label = "none"
    label = if a > 10 {
        let big = "big"
        big
    } else if a > 0 {
        "small"
    } else {
        "none"
    }
    return label
}

const fn early(a: i64) -> i64 {
    let made = if a < 0 { return 0 } else {
        let twice = a * 2
        twice
    }
    return made + 1
}

const fn tripled_if_positive(a: i64) -> i64? {
    let found = if a > 0 {
        let b = a * 3
        b
    }
    return found
}

fn shaped(value: i64) -> i64 {
    when {
        return if value > 0 {
            let up = value * 10
            up
        } else {
            value
        }
    }
}

const fn or_zero(value: i64?) -> i64 {
    if value == null { return 0 }
    return value
}

test a_block_and_an_if_are_values {
    assert stepped_up(3, true) == 7
    assert stepped_up(3, false) == 3
    assert or_zero(positive(2)) == 2
    assert positive(-2) == null
    assert labelled(20) == "big"
    assert labelled(5) == "small"
    assert labelled(-5) == "none"
    assert early(-1) == 0
    assert early(2) == 5
    assert or_zero(tripled_if_positive(2)) == 6
    assert tripled_if_positive(-2) == null
    assert eval shaped(value: [1, -1]) == [10, -1]
}
