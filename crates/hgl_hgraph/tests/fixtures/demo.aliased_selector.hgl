module demo.aliased_selector

use core as c

# TIME-9: "`modified` and `valid` are selectors in a `when` header
# (TIME-3): there they are forms of the language". Core's `valid` is the
# selector however it is named, and the guard in a body too.
fn qualified(a: i64, b: i64) -> i64 {
    when c::valid(a) {
        if c::valid(b) { return a + b }
        return a
    }
}

fn written_with_its_type(a: i64, b: i64) -> i64 {
    when c::valid<i64>(a) { return a }
}

test a_selector_named_through_an_alias {
    assert eval qualified(a: [1, _, 3], b: [_, 10, _]) == [1, 11, 13]
    assert eval written_with_its_type(a: [1, _], b: [_, 2]) == [1, 1]
}
