module m
struct Quotes {
    prices: rolling_window<i64, 3s, 1s>
    last: i64
}
struct Ticks {
    prices: rolling_window<i64, 3, 1>
    last: i64
}
fn relayed(quotes: Quotes) -> Quotes {
    when { return delta_value(quotes) }
}
fn slots(both: list<rolling_window<i64, 3s>, 2>) -> list<rolling_window<i64, 3s>, 2> {
    when { return delta_value(both) }
}
fn counted(ticks: Ticks) -> Ticks {
    when { return delta_value(ticks) }
}
fn prices(quotes: Quotes) -> delta<rolling_window<i64, 3s, 1s>> {
    when valid(quotes.prices) { return delta_value(quotes.prices) }
}
