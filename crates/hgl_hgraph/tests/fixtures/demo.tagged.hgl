module demo.tagged

fn tagged<T>(value: i64, const tag: T) -> i64 {
    when { return value }
}
fn optional<T>(value: i64, const tag: T? = null) -> i64 {
    when { return value }
}
fn wired(value: i64, const tags: list<i64>) -> i64 {
    return tagged<list<i64>>(value, tags)
}
fn defaulted(value: i64) -> i64 {
    return optional<list<i64>>(value)
}

test kept {
    assert eval(wired(value: [7, _, 9], tags: [1, 2])) == [7, _, 9]
    assert eval(defaulted(value: [7])) == [7]
    assert eval(tagged<list<i64>>(value: [7], tag: [1, 2])) == [7]
    assert eval(tagged<dict<str, i64>>(value: [7], tag: ["a": 1])) == [7]
    assert eval(tagged<i64>(value: [7], tag: 1)) == [7]
    assert eval(optional<tuple<i64, str>>(value: [7])) == [7]
}
