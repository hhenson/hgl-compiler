module demo.tuple_cells

# TST-5: "Each cell is one cycle's publication, written as a `return` is
# (TIME-7) ... a T, published whole, or a `delta<T>` (TYPE-16), published
# as that change. A list, a tuple, a struct and a dictionary are each
# written either way". A tuple written in a cell is the whole tuple where
# it is a T: its null is a published null, as `return (2, null)`
# publishes one (TIME-7: "a value that is a T is published whole").
fn second_null(pair: tuple<i64, i64?>) -> bool {
    when valid(pair[1]) { return pair[1] == null }
}

fn pairs(command: i64) -> tuple<i64, i64?> {
    when {
        if command == 0 { return (1, 5) }
        return (2, null)
    }
}

fn hook_second_null(command: i64) -> bool => second_null(pairs(command))

# A cell that is no T is the tuple's delta: a null position is one that
# does not change.
fn summed(pair: tuple<i64, i64>) -> i64 {
    when all_valid(pair) { return pair[0] + pair[1] }
}

test a_whole_tuple_cell_publishes_its_null {
    assert eval second_null(pair: [(1, 5), (2, null)]) == [false, true]
    assert eval hook_second_null(command: [0, 1]) == [false, true]
    assert eval summed(pair: [(1, 2), (null, 3)]) == [3, 4]
}

# TST-5: "An expectation's cell written as a `delta<T>` is compared with
# the delta its cycle published, and one written as a T with the value
# the result holds once its cycle has published."
fn first_only(command: i64) -> tuple<i64, i64> {
    inject out
    when {
        if command == 0 { out = (1, 2) } else { out[0] = command }
    }
}

test a_whole_tuple_expectation_is_the_value_held {
    assert eval pairs(command: [0, 1]) == [(1, 5), (2, null)]
    assert eval first_only(command: [0, 7]) == [(1, 2), (7, 2)]
    assert eval first_only(command: [0, 7]) == [(1, 2), (7, null)]
}
