module demo.moves

# A calendar of the program's own: one day closed, beside the weekend.
struct Closed {
    day: date
}

impl const fn business_day(calendar: Closed, day: date) -> bool =>
    day != calendar.day && business_day(Weekdays(), day)

# TEN-5, TEN-7: the options of `+`, each an argument of the candidate.
const fn settles(trade: date, calendar: Closed) -> date => trade +{calendar: calendar} 2B

const fn matures(spot: date) -> date => spot +{rolling_rule: Rolling.modified_following} 3M

const fn summed(lhs: tenor, rhs: tenor) -> tenor => lhs + rhs

test moves {
    # TEN-4: months first, to the last day of a shorter month.
    assert @2026-01-31 + 1M == @2026-02-28
    assert @2026-01-31 - 2W == @2026-01-17
    # TEN-6: a count of business days starts from a business day. The
    # 3rd is a Saturday: on to the Monday, or back to the Friday.
    assert @2026-01-03 + 2B == @2026-01-07
    assert @2026-01-03 - 0B == @2026-01-02
    assert settles(@2026-01-02, Closed(day: @2026-01-05)) == @2026-01-07
    # TEN-8: `modified_following` gives the business day before where
    # the one after is in another month.
    assert matures(@2025-10-31) == @2026-01-30
    # TEN-2, TEN-3, TEN-9: a tenor's own arithmetic, order and text.
    assert 6M + 6M == 1Y
    assert 2 * 1Y6M == 3Y
    assert -(1M2D) == -1 * 1M2D
    assert 1M < 2M
    assert !(1M < 45D)
    assert (1M <=> 45D) == CmpResult.unordered
    assert convert<str>(13D) == "1W6D"
    assert convert<str>(1M - 1D) == "1M-1D"
    assert raises("tenor.mixed_units") { summed(2B, 1M) }
    assert raises("numeric.out_of_range") { summed(9223372036854775807D, 1D) }
}
