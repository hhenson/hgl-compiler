module demo.shared

struct Holder {
    items: list<i64>
}

# A function that keeps nothing: its result is a scalar.
const fn total(values: list<i64>) -> i64 {
    var sum: i64 = 0
    for value in values { sum += value }
    return sum
}
# One that may keep what it is given: its result may hold it.
const fn same<T>(value: T) -> T { return value }
# One that does not know its place holds a list.
const fn keep<T>(var slot: T, value: T) { slot = value }
const fn push(var items: list<i64>, item: i64) { append(items, item) }
# FN-15: a function that fails leaves the place holding what it
# had made of it: the list it grew before it failed stays grown.
const fn failing(var items: list<i64>, zero: i64) {
    append(items, 2)
    let quotient = 1 //{zero: .fail} zero
}
# A function handed a run's store may keep there what it is given.
const fn save(store: GlobalState, values: list<i64>) {
    put(store, "saved", [values])
}
fn saving(value: i64) -> i64 {
    cache seen: list<i64> = []
    inject global_state
    when {
        append(seen, value)
        save(global_state, seen)
        append(seen, value)
        let saved: list<list<i64>> = get(global_state, "saved")
        if saved[0] == [value] { return 1 }
        return 0
    }
}
# A `var` of the function's own, written from what it was lent.
const fn longer(values: list<i64>) -> i64 {
    var mine: list<i64> = values
    append(mine, 0)
    return total(mine)
}
const fn built(count: i64) -> list<i64> {
    var out: list<i64> = []
    var i: i64 = 0
    while i < count {
        append(out, i)
        i += 1
    }
    return out
}
const fn doubled() -> list<i64> {
    var values: list<i64> = [1, 2]
    for item in values { append(values, item) }
    return values
}

test shared {
    # A `let` is the list as it was, however the place grows after.
    var entries: list<i64> = [1, 2]
    let before = entries
    append(entries, 3)
    assert before == [1, 2]
    assert entries == [1, 2, 3]
    assert total(entries) == 6
    assert longer(entries) == 6
    assert entries == [1, 2, 3]
    # What a function gave back is as it was.
    let through = same(entries)
    append(entries, 4)
    assert through == [1, 2, 3]
    # A `var` written from a `let` leaves the `let` as it was.
    let source = [7, 8]
    var copy: list<i64> = source
    push(copy, 9)
    assert source == [7, 8]
    assert copy == [7, 8, 9]
    var slot: list<i64> = [0]
    keep(slot, source)
    append(slot, 1)
    assert source == [7, 8]
    assert slot == [7, 8, 1]
    # A list inside another value, and one a list or a struct keeps.
    var rows: list<list<i64>> = [[1]]
    let row = rows[0]
    append(rows[0], 2)
    append(rows, entries)
    append(entries, 5)
    assert row == [1]
    assert rows == [[1, 2], [1, 2, 3, 4]]
    let held = Holder(items: entries)
    append(entries, 6)
    assert held.items == [1, 2, 3, 4, 5]
    assert doubled() == [1, 2, 1, 2]
    # A place given to `extend` as both of its lists.
    var twice: list<i64> = [1, 2]
    extend(twice, twice)
    assert twice == [1, 2, 1, 2]
    var grown: list<i64> = built(2)
    append(grown, 9)
    assert grown == [0, 1, 9]
    assert built(4) == [0, 1, 2, 3]
    var kept: list<i64> = [0]
    append(kept, 1)
    assert raises("numeric.division_by_zero") { failing(kept, 0) }
    assert kept == [0, 1, 2]
    failing(kept, 1)
    assert kept == [0, 1, 2, 2]
    assert eval saving(value: [7]) == [1]
}
