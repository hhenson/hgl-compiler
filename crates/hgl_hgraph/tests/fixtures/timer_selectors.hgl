module demo.timer_selectors

# TIME-3: "Selectors under negation or disjunction leave the default in
# place", and a wake by the scheduler "alone runs no other handler" than
# those that subscribe to no input or have `scheduled()` alone or as a
# top-level conjunct. So `!scheduled()` subscribes to every input, and an
# input's wake runs it where no wake of the scheduler is due (TIME-9).
fn unscheduled(value: i64) -> i64 {
    inject scheduler
    start {
        schedule(scheduler, 1s, tag: "with input")
        schedule(scheduler, 1500ms, tag: "alone")
    }
    when !scheduled() { return value }
}

# TIME-9: with an alarm `scheduled()` "holds where the node is evaluated
# and no temporal input has ticked": false at every input's wake.
fn unalarmed(value: i64) -> i64 {
    inject alarm
    start { schedule(alarm, 1s) }
    when !scheduled() { return value }
}

# A disjunction subscribes to every input and requires each valid, the
# defaults: `b` wakes it too, and a wake of the scheduler alone does not.
fn either(a: i64, b: i64) -> i64 {
    inject scheduler
    start {
        schedule(scheduler, 1s, tag: "with input")
        schedule(scheduler, 2500ms, tag: "alone")
    }
    when modified(a) || scheduled() { return b }
}

fn either_alarmed(a: i64, b: i64) -> i64 {
    inject alarm
    start { schedule(alarm, 1s) }
    when modified(a) || scheduled() { return b }
}

# `scheduled()` in a handler's body is what woke the node where it was
# entered: asking again under the tag that is due leaves it true.
fn still_due(value: i64) -> bool {
    inject scheduler
    start { schedule(scheduler, 1s, tag: "beat") }
    when modified(value) || scheduled() {
        if scheduled() { schedule(scheduler, 1s, tag: "beat") }
        return scheduled()
    }
}

# A node with no temporal input: its handlers subscribe to none, so the
# scheduler's wake runs each, and `!scheduled()` is false at every one.
fn beats_not(const every: duration) -> i64 {
    state wakes: i64 = 0
    inject scheduler
    start { schedule(scheduler, every) }
    when !scheduled() { return -1 }
    when wakes < 2 || scheduled() {
        wakes += 1
        if wakes < 3 { schedule(scheduler, every) }
        return wakes
    }
}

test a_negated_wake_is_run_by_an_input {
    # The wake at 1s lands with the input's tick and the handler does not
    # run; the one at 1.5s comes alone and runs nothing.
    assert eval(unscheduled(value: [0s: 1, 1s: 2, 2s: 3]), RunConfig(length: 2500ms)) == [0s: 1, 2s: 3]
    # The alarm due at 1s is not told from the input's tick there.
    assert eval(unalarmed(value: [0s: 1, 1s: 2, 2s: 3]), RunConfig(length: 2500ms)) == [0s: 1, 1s: 2, 2s: 3]
}

test a_disjunction_keeps_the_defaults {
    # 1s: `b` ticks with the wake due; 1.5s: `b` alone; 2s: `a`; 2.5s:
    # the scheduler alone.
    assert eval(either(a: [0s: 1, 2s: 3], b: [0s: 10, 1s: 20, 1500ms: 30]), RunConfig(length: 3s)) == [0s: 10, 1s: 20, 2s: 30]
    # Both inputs are required valid: `a` publishes before `b` has a
    # value, and the wake at 1s, which no input's tick lands with, runs
    # nothing.
    assert eval(either(a: [0s: 1], b: [500ms: 5]), RunConfig(length: 1500ms)) == []
    assert eval(either_alarmed(a: [0s: 1, 2s: 3], b: [0s: 10, 1s: 20, 1500ms: 30]), RunConfig(length: 3s)) == [0s: 10, 2s: 30]
}

test what_woke_the_node_is_read_once_in_a_body {
    assert eval(still_due(value: [0s: 1, 1s: 2, 2s: 3]), RunConfig(length: 3500ms)) == [0s: false, 1s: true, 2s: true]
}

test an_inputless_node_runs_each_handler_at_a_wake {
    assert eval(beats_not(every: 1s)) == [1s: 1, 2s: 2, 3s: 3]
}

# TIME-3: "Where the node injects neither ... nothing wakes it: the node is
# dormant". A handler that subscribes to no input is run by no wake.
@suppress_warning("node.no_activation")
fn null_sink(a: f64) {
    when modified([]) { }
}

@suppress_warning("node.no_activation")
fn dormant(a: i64) -> i64 {
    when modified([]) { return 0 }
}

@suppress_warning("node.no_activation")
fn half_dormant(a: i64) -> i64 {
    when modified([]) { return 0 }
    when modified(a) { return a }
}

fn idle() -> i64 {
    when { return 1 }
}

test a_dormant_handler_never_runs {
    eval(null_sink(a: [0s: 1.0, 1s: 2.0]))
    assert eval(dormant(a: [0s: 1, 1s: 2])) == []
    assert eval(half_dormant(a: [0s: 1, 1s: 2])) == [0s: 1, 1s: 2]
    assert eval(idle()) == []
}
