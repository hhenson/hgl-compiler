module reach
use reach.far as far

const fn fine(value: i64) -> i64 => value + 1
const fn looped(limit: i64, rest: ...i64) -> i64 {
    var total = 0
    total = total + limit
    return total
}
const fn outer(limit: i64) -> i64 => looped(limit) + 1
const fn lone(value: i64) -> i64 => value

test direct {
    assert fine(1) == 2
    assert fine(2) == 3
}
test reaches { assert outer(1) == 2 }
test own { let at = @9999-12-31T23:30:00-01:00 }
test across { assert far::relay(1) == 2 }
test wrong {
    assert fine(1) == 2
    assert fine(1) == 3
}
test overflows {
    let big = 9223372036854775807
    assert fine(big) == 0
}
# OPS-10: a duration result outside its range. The longest
# duration is a little over 106751991 days.
test too_long {
    let long = 106751991d
    assert long + 1d == 0s
}
# OPS-10: an instant result outside its range, core's own
# example.
test too_late {
    assert @9999-12-31T23:59:59Z + 1d == @9999-12-31T23:59:59Z
}
