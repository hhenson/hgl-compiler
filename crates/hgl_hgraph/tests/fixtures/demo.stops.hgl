module demo.stops

fn last_seen(value: i64, const scale: i64) -> i64 {
    state last: i64 = 0
    state ended: i64 = 0
    when {
        last = value
        return value * scale
    }
    stop {
        if valid(value) { ended = value * scale }
    }
}

fn ends_badly(value: i64) -> i64 {
    state ended: i64 = 0
    when { return value }
    stop {
        if valid(value) { ended = value // 0 }
    }
}

test stops {
    assert eval(last_seen(value: [1, 2, 3], scale: 2)) == [2, 4, 6]
    assert eval(last_seen(value: [_, _], scale: 2)) == []
    # The input is never valid: the guard does not hold, and the
    # division is not made.
    assert eval(ends_badly(value: [_, _])) == []
}
