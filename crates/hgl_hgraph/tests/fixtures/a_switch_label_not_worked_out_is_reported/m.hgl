module m
enum Side { buy, sell }
const fn sq(x: i64) -> i64 => x * x
const NINE: i64 = sq(3)
const TEN: i64 = 10
const fn the_buy() -> Side => Side.buy
const B: Side = the_buy()
fn by_call(route: i64, a: i64) -> i64 {
    switch route {
        case NINE: return a
        case 9: return a * 2
        default: return a * 3
    }
}
fn by_enum(side: Side, a: i64) -> i64 {
    switch side {
        case B: return a
        case .buy: return a * 2
        default: return a * 3
    }
}
fn valued(route: i64, a: i64) -> i64 {
    switch route {
        case TEN: return a
        case 9: return a * 2
        default: return a * 3
    }
}
fn alone(route: i64, a: i64) -> i64 {
    switch route {
        case NINE: return a
        default: return a * 3
    }
}
impl const fn neg_(value: i64, const shifted: bool) -> i64
    requires shifted == true => 7
fn negated(route: i64, a: i64) -> i64 {
    switch route {
        case -{shifted: true} 1: return a
        case -1: return a * 2
        default: return a * 3
    }
}
test graph_path_int {
    assert eval by_call(route: [9], a: [1]) == [1]
}
test graph_path_enum {
    assert eval by_enum(side: [Side.buy], a: [1]) == [1]
}
test graph_path_valued {
    assert eval valued(route: [9, 10], a: [1, 1]) == [2, 1]
    assert eval alone(route: [9, 10], a: [1, 1]) == [1, 3]
}
