module demo.div

const fn ratio(a: f64, b: f64) -> f64 => a / b
const fn nans(a: f64, b: f64) -> f64 => a /{zero: .nan} b
const fn strict(a: f64, b: f64) -> f64 => a /{zero: .fail} b
const fn named(a: f64, b: f64) -> f64 => div_(a, b, zero: ZeroPolicy.nan)
const fn grouped(a: f64, b: f64) -> f64 => div_(a, b, zero: (ZeroPolicy.nan))
const fn built(a: f64, b: f64) -> f64 => div_(a, b, zero: ZeroPolicy("nan"))
const fn floors(a: i64, b: i64) -> i64 => a // b
const fn rest(a: i64, b: i64) -> i64 => a % b

fn ratios(a: f64, b: f64) -> f64 => a / b
fn halves(a: i64) -> f64 => a / 2

test divides {
    assert ratio(6.0, 4.0) == 1.5
    assert 7 / 2 == 3.5
    assert 7.0 / 2 == 3.5
    assert 7 / 2.0 == 3.5
    # NUM-3: a signed infinity, whose sign combines both operands'.
    assert ratio(1.0, 0.0) > 1.0e308
    assert ratio(-1.0, 0.0) < -1.0e308
    assert ratio(1.0, -0.0) < -1.0e308
    # NaN is equal to nothing, itself included (NUM-5).
    assert ratio(0.0, 0.0) != ratio(0.0, 0.0)
    assert nans(1.0, 0.0) != nans(1.0, 0.0)
    assert nans(6.0, 4.0) == 1.5
    assert named(1.0, 0.0) != named(1.0, 0.0)
    assert grouped(1.0, 0.0) != grouped(1.0, 0.0)
    assert built(1.0, 0.0) != built(1.0, 0.0)
    assert strict(6.0, 4.0) == 1.5
    # NUM-1: floor division rounds toward negative infinity, and a
    # modulo has the divisor's sign.
    assert floors(7, 2) == 3
    assert floors(-7, 2) == -4
    assert rest(7, 2) == 1
    assert rest(-7, 2) == 1
    assert rest(7, -2) == -1
    assert 7.5 // 2 == 3.0
    assert 7.5 % 2 == 1.5
    assert -7.5 % 2 == 0.5
    # NUM-12: what IEEE arithmetic makes of the zero divisor.
    assert 1.0 // 0.0 > 1.0e308
    assert 1.0 % 0.0 != 1.0 % 0.0
    # NUM-1: "Where an f64 operand is an infinity or NaN and the
    # divisor is not zero, `//` is the floor of the IEEE quotient and
    # `%` what IEEE `fmod` gives". An infinite quotient stays one, with
    # the sign of both operands, and has no remainder.
    assert (1.0 / 0.0) // 2.0 > 1.0e308
    assert (1.0 / 0.0) // -2.0 < -1.0e308
    assert (-1.0 / 0.0) // 2.0 < -1.0e308
    assert (1.0 / 0.0) // (1.0 / 0.0) != (1.0 / 0.0) // (1.0 / 0.0)
    assert (1.0 / 0.0) % 2.0 != (1.0 / 0.0) % 2.0
    # A finite numerator over an infinity: a zero with the quotient's
    # sign, which a division by it shows, and "a remainder by an
    # infinity is the numerator as it is, whatever its sign".
    assert 1.0 // (1.0 / 0.0) == 0.0
    assert 1.0 / (1.0 // (1.0 / 0.0)) > 1.0e308
    assert 1.0 / (-1.0 // (1.0 / 0.0)) < -1.0e308
    assert 1.0 % (1.0 / 0.0) == 1.0
    assert -1.0 % (1.0 / 0.0) == -1.0
    assert 1.0 % (-1.0 / 0.0) == 1.0
    assert eval ratios(a: [6.0, 1.0], b: [4.0]) == [1.5, 0.25]
    assert eval halves(a: [3]) == [1.5]
}
