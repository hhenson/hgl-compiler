module demo.empty_delta_fixes_wave3

# TIME-7: "A delta that names no change ... ticks only where it changes
# validity. Where a `list<V>`, a dictionary or a set is not valid,
# never published or invalidated, it makes the value valid and empty, and
# ticks. Where it is valid the delta changes nothing, and is no tick ... A
# struct, a tuple and a `list<V, N>` are valid where a child is (TIME-9),
# and such a delta of one, `delta<Quote>()`, sets no child: it changes no
# validity, and is never a tick. ... A value published whole, the same
# again or empty, is no delta, and ticks as any publication does". Core's
# END-4: "Invalidation clears validity, modification, payload, and delta."

# Each reader below publishes at each wake (TIME-3): what the value holds,
# ten for each member, key or element and the sum of them, or -1 where it
# is not valid. A tick that does not come, or a value emptied or kept, is
# seen in what it publishes.
const fn member_total(members: set<i64>) -> i64 {
    var total: i64 = 0
    for member in members { total += member + 10 }
    return total
}

const fn entry_total(book: dict<str, i64>) -> i64 {
    var total: i64 = 0
    for key, price in book { total += price + 10 }
    return total
}

const fn element_total(readings: list<i64>) -> i64 {
    var total: i64 = 0
    for reading in readings { total += reading + 10 }
    return total
}

fn members_read(members: set<i64>) -> i64 {
    when valid([]) {
        if valid(members) { return member_total(members) }
        return -1
    }
}

fn book_read(book: dict<str, i64>) -> i64 {
    when valid([]) {
        if valid(book) { return entry_total(book) }
        return -1
    }
}

fn readings_read(readings: list<i64>) -> i64 {
    when valid([]) {
        if valid(readings) { return element_total(readings) }
        return -1
    }
}

fn relay_members(members: set<i64>) -> set<i64> {
    when { return delta_value(members) }
}

# Whether the set's delta names nothing added and nothing removed.
fn unchanged_members(members: set<i64>) -> bool {
    when { return delta_value(members) == delta<set<i64>>() }
}

# A struct and a tuple that hold a set: each reader publishes what the set
# holds where it is modified.
struct Bag {
    members: set<i64>
    count: i64
}

fn bag_members(bag: Bag) -> i64 {
    when valid([]) {
        if valid(bag.members) && modified(bag.members) { return member_total(bag.members) }
        return -1
    }
}

fn pair_members(pair: tuple<i64, set<i64>>) -> i64 {
    when valid([]) {
        if valid(pair[1]) && modified(pair[1]) { return member_total(pair[1]) }
        return -1
    }
}

# ---- 1. A trace's cell written whole, given again ----
#
# TST-5: "Each cell is one cycle's publication, written as a `return` is
# (TIME-7) ... a T, published whole". TIME-7: "A value published whole,
# the same again or empty, is no delta, and ticks as any publication
# does". A cell given again as it was is published whole again: it ticks,
# and leaves the value as it was.
test a_whole_cell_given_again_ticks_and_keeps_the_value {
    assert eval(members_read(members: [[], [], [1, 2], [1, 2], []])) == [0, 0, 23, 23, 0]
    assert eval(book_read(book: [[], [], ["a": 1, "b": 2], ["a": 1, "b": 2], []])) == [0, 0, 23, 23, 0]
    assert eval(readings_read(readings: [[], [], [1, 2], [1, 2], []])) == [0, 0, 23, 23, 0]
    # After a delta that made the value what the cell writes.
    assert eval(members_read(members: [delta<set<i64>>(added: [1]), [1]])) == [11, 11]
    assert eval(book_read(book: [delta<dict<str, i64>>(updated: ["a": 1]), ["a": 1]])) == [11, 11]
    assert eval(readings_read(readings: [delta<list<i64>>(updated: [0: 1]), [1]])) == [11, 11]
    # The set's delta then names nothing added and nothing removed.
    assert eval(unchanged_members(members: [[1, 2], [1, 2], []])) == [false, true, false]
}

# A `const fn` given the trace reads each cell as its delta (TST-16: "A T
# published whole is held as its delta too"): a set's that changes
# nothing names nothing added and nothing removed.
const fn unchanged(cells: list<tuple<datetime, delta<set<i64>>>>) -> list<bool> {
    var found: list<bool> = []
    for cell in cells { append(found, cell[1] == delta<set<i64>>()) }
    return found
}

test a_whole_cell_given_again_is_held_as_a_delta_that_names_nothing {
    var seen = eval(relay_members(members: [[1, 2]]))
    assert unchanged(seen) == [false]
    seen = [[1, 2], [1, 2], [2]]
    assert unchanged(seen) == [false, true, false]
}

# ---- 2. A source's set, as a node's ----
#
# SOURCE-1: a `yield` publishes as a `return` does (TIME-7). A delta that
# names no change ticks where it makes the set valid, and not after; a
# whole empty set, given again, ticks each time.
fn yielded_members() -> set<i64> {
    yield 1s: delta<set<i64>>()
    yield 1s: delta<set<i64>>()
    yield 1s: []
    yield 1s: []
    yield 1s: delta<set<i64>>(added: [1])
    yield 1s: delta<set<i64>>(removed: [9])
    yield 1s: delta<set<i64>>(added: [2])
}

fn yielded_members_read() -> i64 => members_read(yielded_members())

test a_source_set_ticks_as_a_node_does {
    assert eval(yielded_members_read(), RunConfig(length: 8s)) == [
        1s: 0, 3s: 0, 4s: 0, 5s: 11, 7s: 23,
    ]
}

# A struct's set yielded whole, empty, twice.
fn yielded_bags() -> Bag {
    yield 1s: Bag(members: [], count: 1)
    yield 1s: Bag(members: [], count: 1)
}

fn yielded_bag_members() -> i64 => bag_members(yielded_bags())

test a_sources_struct_with_an_empty_set_ticks_its_set {
    assert eval(yielded_bag_members(), RunConfig(length: 3s)) == [1s: 0, 2s: 0]
}

# ---- 3. A whole value published again, unchanged ----
#
# TIME-7: "A value published whole, the same again or empty, is no delta,
# and ticks as any publication does". Each way a node and a source
# publish one: it ticks, and the value is as it was.
fn returned_members(step: i64) -> set<i64> {
    when {
        if step == 0 { return [] }
        return [1, 2]
    }
}

fn assigned_members(step: i64) -> set<i64> {
    inject out
    when {
        if step == 0 { out = [] }
        if step == 1 { out = [1, 2] }
    }
}

fn returned_members_read(step: i64) -> i64 => members_read(returned_members(step))
fn assigned_members_read(step: i64) -> i64 => members_read(assigned_members(step))
fn returned_members_unchanged(step: i64) -> bool => unchanged_members(returned_members(step))

fn returned_book(step: i64) -> dict<str, i64> {
    when {
        if step == 0 { return [] }
        return ["a": 1, "b": 2]
    }
}

fn assigned_book(step: i64) -> dict<str, i64> {
    inject out
    when {
        if step == 0 { out = [] }
        if step == 1 { out = ["a": 1, "b": 2] }
    }
}

fn returned_book_read(step: i64) -> i64 => book_read(returned_book(step))
fn assigned_book_read(step: i64) -> i64 => book_read(assigned_book(step))

fn returned_readings(step: i64) -> list<i64> {
    when {
        if step == 0 { return [] }
        return [1, 2]
    }
}

fn assigned_readings(step: i64) -> list<i64> {
    inject out
    when {
        if step == 0 { out = [] }
        if step == 1 { out = [1, 2] }
    }
}

fn returned_readings_read(step: i64) -> i64 => readings_read(returned_readings(step))
fn assigned_readings_read(step: i64) -> i64 => readings_read(assigned_readings(step))

test a_whole_value_returned_or_assigned_again_ticks_and_keeps_the_value {
    assert eval(returned_members_read(step: [1, 1, 0, 0, 1])) == [23, 23, 0, 0, 23]
    assert eval(assigned_members_read(step: [1, 1, 0, 0, 1])) == [23, 23, 0, 0, 23]
    assert eval(returned_book_read(step: [1, 1, 0, 0, 1])) == [23, 23, 0, 0, 23]
    assert eval(assigned_book_read(step: [1, 1, 0, 0, 1])) == [23, 23, 0, 0, 23]
    assert eval(returned_readings_read(step: [1, 1, 0, 0, 1])) == [23, 23, 0, 0, 23]
    assert eval(assigned_readings_read(step: [1, 1, 0, 0, 1])) == [23, 23, 0, 0, 23]
    # The set's delta names what the value changed: nothing, again.
    assert eval(returned_members_unchanged(step: [1, 1, 0])) == [false, true, false]
}

fn yielded_again_members() -> set<i64> {
    yield 1s: [1, 2]
    yield 1s: [1, 2]
    yield 1s: [2]
}

fn yielded_again_readings() -> list<i64> {
    yield 1s: [1, 2]
    yield 1s: [1, 2]
    yield 1s: []
    yield 1s: []
}

fn yielded_again_members_read() -> i64 => members_read(yielded_again_members())
fn yielded_again_readings_read() -> i64 => readings_read(yielded_again_readings())

test a_whole_value_yielded_again_ticks_and_keeps_the_value {
    assert eval(yielded_again_members_read(), RunConfig(length: 4s)) == [1s: 23, 2s: 23, 3s: 12]
    assert eval(yielded_again_readings_read(), RunConfig(length: 5s)) == [1s: 23, 2s: 23, 3s: 0, 4s: 0]
}

# Inside a struct or a tuple published whole, from a `return`, from
# `out =`, from an assignment to the part, and from a lifted function:
# the set ticks as the value does.
fn returned_bag(step: i64) -> Bag {
    when { return Bag(members: [1, 2], count: step) }
}

fn assigned_bag(step: i64) -> Bag {
    inject out
    when { out = Bag(members: [1, 2], count: step) }
}

fn assigned_bag_part(step: i64) -> Bag {
    inject out
    when {
        out.count = step
        out.members = [1, 2]
    }
}

fn returned_pair(step: i64) -> tuple<i64, set<i64>> {
    when { return (step, [1, 2]) }
}

struct Tags {
    members: set<i64>
}

fn returned_tags(step: i64) -> Tags {
    when { return Tags(members: [1]) }
}

fn tags_woken(tags: Tags) -> bool {
    when valid([]) { return valid(tags.members) }
}

const fn both(step: i64) -> set<i64> {
    return [1, 2]
}

fn returned_bag_members(step: i64) -> i64 => bag_members(returned_bag(step))
fn assigned_bag_members(step: i64) -> i64 => bag_members(assigned_bag(step))
fn assigned_bag_part_members(step: i64) -> i64 => bag_members(assigned_bag_part(step))
fn returned_pair_members(step: i64) -> i64 => pair_members(returned_pair(step))
fn returned_tags_woken(step: i64) -> bool => tags_woken(returned_tags(step))
fn lifted_members_read(step: i64) -> i64 => members_read(both(step))

test a_set_inside_a_whole_value_published_again_ticks {
    assert eval(returned_bag_members(step: [1, 1])) == [23, 23]
    assert eval(assigned_bag_members(step: [1, 1])) == [23, 23]
    assert eval(assigned_bag_part_members(step: [1, 1])) == [23, 23]
    assert eval(returned_pair_members(step: [1, 1])) == [23, 23]
    assert eval(returned_tags_woken(step: [1, 1])) == [true, true]
    assert eval(lifted_members_read(step: [1, 1])) == [23, 23]
}

fn yielded_full_bags() -> Bag {
    yield 1s: Bag(members: [1, 2], count: 1)
    yield 1s: Bag(members: [1, 2], count: 1)
}

fn yielded_full_bag_members() -> i64 => bag_members(yielded_full_bags())

test a_set_inside_a_whole_value_yielded_again_ticks {
    assert eval(yielded_full_bag_members(), RunConfig(length: 3s)) == [1s: 23, 2s: 23]
}

# ---- 4. Invalidation empties what holds a dictionary or a set ----
#
# END-4: "Invalidation clears validity, modification, payload, and
# delta." TIME-7: where a dictionary or a set "is not valid, never
# published or invalidated, it makes the value valid and empty". At each
# depth: a struct's dictionary, a tuple's set, a dictionary in a struct in
# a tuple, a dictionary of sets, an unsized and a fixed list of
# dictionaries.
struct Shelf {
    book: dict<str, i64>
    tag: i64
}

# 0 sets "a", 1 writes a delta that names no change, any other invalidates.
fn write_shelf(step: i64) -> Shelf {
    inject out
    when {
        if step == 0 { return delta<Shelf>(book: delta<dict<str, i64>>(updated: ["a": 1])) }
        if step == 1 { return delta<Shelf>(book: delta<dict<str, i64>>()) }
        invalidate(out)
    }
}

fn shelf_book(shelf: Shelf) -> i64 {
    when valid([]) {
        if valid(shelf.book) { return entry_total(shelf.book) }
        return -1
    }
}

fn shelf_keys(step: i64) -> i64 => shelf_book(write_shelf(step))

fn write_tagged(step: i64) -> tuple<i64, set<i64>> {
    inject out
    when {
        let added: delta<tuple<i64, set<i64>>> = (null, delta<set<i64>>(added: [1]))
        let empty: delta<tuple<i64, set<i64>>> = (null, delta<set<i64>>())
        if step == 0 { return added }
        if step == 1 { return empty }
        invalidate(out)
    }
}

fn tagged_members(tagged: tuple<i64, set<i64>>) -> i64 {
    when valid([]) {
        if valid(tagged[1]) { return member_total(tagged[1]) }
        return -1
    }
}

fn tagged_check(step: i64) -> i64 => tagged_members(write_tagged(step))

fn write_held_shelf(step: i64) -> tuple<i64, Shelf> {
    inject out
    when {
        let added: delta<tuple<i64, Shelf>> = (null, delta<Shelf>(book: delta<dict<str, i64>>(updated: ["a": 1])))
        let empty: delta<tuple<i64, Shelf>> = (null, delta<Shelf>(book: delta<dict<str, i64>>()))
        if step == 0 { return added }
        if step == 1 { return empty }
        invalidate(out)
    }
}

fn held_shelf_book(held: tuple<i64, Shelf>) -> i64 {
    when valid([]) {
        if valid(held[1].book) { return entry_total(held[1].book) }
        return -1
    }
}

fn held_shelf_check(step: i64) -> i64 => held_shelf_book(write_held_shelf(step))

fn write_groups(step: i64) -> dict<str, set<i64>> {
    inject out
    when {
        if step == 0 { return delta<dict<str, set<i64>>>(updated: ["a": delta<set<i64>>(added: [1])]) }
        if step == 1 { return delta<dict<str, set<i64>>>(updated: ["a": delta<set<i64>>()]) }
        invalidate(out)
    }
}

const fn group_total(groups: dict<str, set<i64>>) -> i64 {
    var total: i64 = 0
    for key, members in groups { total += 100 + member_total(members) }
    return total
}

fn groups_read(groups: dict<str, set<i64>>) -> i64 {
    when valid([]) {
        if valid(groups) { return group_total(groups) }
        return -1
    }
}

fn groups_check(step: i64) -> i64 => groups_read(write_groups(step))

fn write_pages(step: i64) -> list<dict<str, i64>> {
    inject out
    when {
        if step == 0 { return delta<list<dict<str, i64>>>(updated: [0: delta<dict<str, i64>>(updated: ["a": 1])]) }
        if step == 1 { return delta<list<dict<str, i64>>>(updated: [0: delta<dict<str, i64>>()]) }
        invalidate(out)
    }
}

fn pages_read(pages: list<dict<str, i64>>) -> i64 {
    when valid([]) {
        if valid(pages[0]) { return entry_total(pages[0]) }
        return -1
    }
}

fn pages_check(step: i64) -> i64 => pages_read(write_pages(step))

fn write_two_pages(step: i64) -> list<dict<str, i64>, 2> {
    inject out
    when {
        if step == 0 { return delta<list<dict<str, i64>, 2>>(updated: [0: delta<dict<str, i64>>(updated: ["a": 1])]) }
        if step == 1 { return delta<list<dict<str, i64>, 2>>(updated: [0: delta<dict<str, i64>>()]) }
        invalidate(out)
    }
}

fn two_pages_read(pages: list<dict<str, i64>, 2>) -> i64 {
    when valid([]) {
        if valid(pages[0]) { return entry_total(pages[0]) }
        return -1
    }
}

fn two_pages_check(step: i64) -> i64 => two_pages_read(write_two_pages(step))

test an_invalidated_value_holds_no_key_or_member_after {
    assert eval(shelf_keys(step: [0, 9, 1])) == [11, -1, 0]
    assert eval(tagged_check(step: [0, 9, 1])) == [11, -1, 0]
    assert eval(held_shelf_check(step: [0, 9, 1])) == [11, -1, 0]
    assert eval(groups_check(step: [0, 9, 1])) == [111, -1, 100]
    assert eval(pages_check(step: [0, 9, 1])) == [11, -1, 0]
    assert eval(two_pages_check(step: [0, 9, 1])) == [11, -1, 0]
}

# ---- 5. A dictionary's entry delta that names no change ----
#
# TIME-7: "such a delta of one, `delta<Quote>()`, sets no child: it changes
# no validity, and is never a tick", wherever the struct, the tuple or the
# fixed list is: as a dictionary's value, in a struct in one, or in a
# dictionary of dictionaries. A key the dictionary does not hold is not
# added by one.
struct Pair {
    bid: i64
    ask: i64
}

struct Outer {
    inner: Pair
    tag: i64
}

fn write_quotes(step: i64) -> dict<str, Pair> {
    when {
        if step == 0 { return delta<dict<str, Pair>>(updated: ["a": delta<Pair>(bid: 1, ask: 2)]) }
        if step == 1 { return delta<dict<str, Pair>>(updated: ["a": delta<Pair>()]) }
        return delta<dict<str, Pair>>(updated: ["b": delta<Pair>()])
    }
}

const fn quote_total(quotes: dict<str, Pair>) -> i64 {
    var total: i64 = 0
    for key, quote in quotes { total += 100 + quote.bid }
    return total
}

fn quotes_read(quotes: dict<str, Pair>) -> i64 {
    when valid([]) {
        if valid(quotes) && all_valid(quotes) { return quote_total(quotes) }
        return -1
    }
}

fn quotes_check(step: i64) -> i64 => quotes_read(write_quotes(step))

fn quotes_woken(quotes: dict<str, Pair>) -> bool {
    when valid([]) { return modified(quotes) }
}

fn outer_quotes(step: i64) -> dict<str, Outer> {
    when {
        if step == 0 { return delta<dict<str, Outer>>(updated: ["a": delta<Outer>(inner: delta<Pair>(bid: 1, ask: 2), tag: 1)]) }
        return delta<dict<str, Outer>>(updated: ["a": delta<Outer>(inner: delta<Pair>())])
    }
}

fn outer_woken(quotes: dict<str, Outer>) -> bool {
    when valid([]) { return modified(quotes) }
}

fn outer_check(step: i64) -> bool => outer_woken(outer_quotes(step))

fn pair_quotes(step: i64) -> dict<str, tuple<i64, i64>> {
    when {
        let first: delta<tuple<i64, i64>> = (1, 2)
        let none: delta<tuple<i64, i64>> = (null, null)
        if step == 0 { return delta<dict<str, tuple<i64, i64>>>(updated: ["a": first]) }
        return delta<dict<str, tuple<i64, i64>>>(updated: ["a": none])
    }
}

fn pair_quotes_woken(quotes: dict<str, tuple<i64, i64>>) -> bool {
    when valid([]) { return modified(quotes) }
}

fn pair_quotes_check(step: i64) -> bool => pair_quotes_woken(pair_quotes(step))

fn fixed_quotes(step: i64) -> dict<str, list<i64, 2>> {
    when {
        if step == 0 { return delta<dict<str, list<i64, 2>>>(updated: ["a": delta<list<i64, 2>>(updated: [0: 1])]) }
        return delta<dict<str, list<i64, 2>>>(updated: ["a": delta<list<i64, 2>>()])
    }
}

fn fixed_quotes_woken(quotes: dict<str, list<i64, 2>>) -> bool {
    when valid([]) { return modified(quotes) }
}

fn fixed_quotes_check(step: i64) -> bool => fixed_quotes_woken(fixed_quotes(step))

fn nested_quotes(step: i64) -> dict<str, dict<str, Pair>> {
    when {
        if step == 0 {
            return delta<dict<str, dict<str, Pair>>>(updated: ["x": delta<dict<str, Pair>>(updated: ["a": delta<Pair>(bid: 1, ask: 2)])])
        }
        return delta<dict<str, dict<str, Pair>>>(updated: ["x": delta<dict<str, Pair>>(updated: ["a": delta<Pair>()])])
    }
}

fn nested_quotes_woken(quotes: dict<str, dict<str, Pair>>) -> bool {
    when valid([]) { return modified(quotes) }
}

fn nested_quotes_check(step: i64) -> bool => nested_quotes_woken(nested_quotes(step))

struct Desk {
    quotes: dict<str, Pair>
    tag: i64
}

fn write_desk(step: i64) -> Desk {
    when {
        if step == 0 { return delta<Desk>(quotes: delta<dict<str, Pair>>(updated: ["a": delta<Pair>(bid: 1, ask: 2)])) }
        return delta<Desk>(quotes: delta<dict<str, Pair>>(updated: ["a": delta<Pair>()]))
    }
}

fn desk_woken(desk: Desk) -> bool {
    when valid([]) { return modified(desk) }
}

fn desk_check(step: i64) -> bool => desk_woken(write_desk(step))

fn yielded_quotes() -> dict<str, Pair> {
    yield 1s: delta<dict<str, Pair>>(updated: ["a": delta<Pair>(bid: 1, ask: 2)])
    yield 1s: delta<dict<str, Pair>>(updated: ["a": delta<Pair>()])
    yield 1s: delta<dict<str, Pair>>(updated: ["a": delta<Pair>(bid: 3)])
}

fn yielded_quotes_check() -> i64 => quotes_read(yielded_quotes())

test a_dictionarys_entry_delta_that_names_no_change_is_no_tick {
    assert eval(quotes_check(step: [0, 1, 2])) == [101, _, _]
    assert eval(outer_check(step: [0, 1])) == [true, _]
    assert eval(pair_quotes_check(step: [0, 1])) == [true, _]
    assert eval(fixed_quotes_check(step: [0, 1])) == [true, _]
    assert eval(nested_quotes_check(step: [0, 1])) == [true, _]
    assert eval(desk_check(step: [0, 1])) == [true, _]
    assert eval(yielded_quotes_check(), RunConfig(length: 4s)) == [1s: 101, 3s: 103]
    assert eval(quotes_woken(quotes: [
        delta<dict<str, Pair>>(updated: ["a": delta<Pair>(bid: 1, ask: 2)]),
        delta<dict<str, Pair>>(updated: ["a": delta<Pair>()]),
        delta<dict<str, Pair>>(updated: ["b": delta<Pair>()]),
    ])) == [true, _, _]
}

# Where the dictionary is not valid, such an entry adds no key, and the
# delta names no change: it makes the dictionary valid and empty.
fn first_empty_quote(step: i64) -> dict<str, Pair> {
    when {
        if step == 0 { return delta<dict<str, Pair>>(updated: ["a": delta<Pair>()]) }
        return delta<dict<str, Pair>>(updated: ["b": delta<Pair>(bid: 2, ask: 3)])
    }
}

fn first_empty_quote_check(step: i64) -> i64 => quotes_read(first_empty_quote(step))

test an_entry_delta_that_names_no_change_adds_no_key {
    assert eval(first_empty_quote_check(step: [0, 1])) == [0, 102]
}

# ---- 6. A key or a member removed inside a tuple ----
#
# TYPE-16: a tuple's delta is "each position's delta, null where it did
# not change", and a dictionary's has "`removed`, a `set<K>`" of the keys
# it removes, a set's "`removed`" of its members. Removed inside a tuple,
# from a `return`, from `out =` and from a trace's cell, and inside a
# struct and a tuple within a struct, a key or a member that is held goes.
fn returned_tuple_book(step: i64) -> tuple<i64, dict<str, i64>> {
    when {
        let added: delta<tuple<i64, dict<str, i64>>> = (null, delta<dict<str, i64>>(updated: ["a": 1, "b": 2]))
        let gone: delta<tuple<i64, dict<str, i64>>> = (null, delta<dict<str, i64>>(removed: ["a"]))
        if step == 0 { return added }
        return gone
    }
}

fn assigned_tuple_book(step: i64) -> tuple<i64, dict<str, i64>> {
    inject out
    when {
        let added: delta<tuple<i64, dict<str, i64>>> = (null, delta<dict<str, i64>>(updated: ["a": 1, "b": 2]))
        let gone: delta<tuple<i64, dict<str, i64>>> = (null, delta<dict<str, i64>>(removed: ["a"]))
        if step == 0 { out = added }
        if step == 1 { out = gone }
    }
}

fn tuple_book_read(held: tuple<i64, dict<str, i64>>) -> i64 {
    when valid([]) {
        if valid(held[1]) { return entry_total(held[1]) }
        return -1
    }
}

fn returned_tuple_book_read(step: i64) -> i64 => tuple_book_read(returned_tuple_book(step))
fn assigned_tuple_book_read(step: i64) -> i64 => tuple_book_read(assigned_tuple_book(step))

fn returned_tuple_members(step: i64) -> tuple<i64, set<i64>> {
    when {
        let added: delta<tuple<i64, set<i64>>> = (null, delta<set<i64>>(added: [1, 2]))
        let gone: delta<tuple<i64, set<i64>>> = (null, delta<set<i64>>(removed: [1]))
        if step == 0 { return added }
        return gone
    }
}

fn assigned_tuple_members(step: i64) -> tuple<i64, set<i64>> {
    inject out
    when {
        let added: delta<tuple<i64, set<i64>>> = (null, delta<set<i64>>(added: [1, 2]))
        let gone: delta<tuple<i64, set<i64>>> = (null, delta<set<i64>>(removed: [1]))
        if step == 0 { out = added }
        if step == 1 { out = gone }
    }
}

fn tuple_members_read(held: tuple<i64, set<i64>>) -> i64 {
    when valid([]) {
        if valid(held[1]) { return member_total(held[1]) }
        return -1
    }
}

fn returned_tuple_members_read(step: i64) -> i64 => tuple_members_read(returned_tuple_members(step))
fn assigned_tuple_members_read(step: i64) -> i64 => tuple_members_read(assigned_tuple_members(step))

struct Drawer {
    book: dict<str, i64>
    members: set<i64>
    pair: tuple<i64, dict<str, i64>>
}

fn returned_drawer(step: i64) -> Drawer {
    when {
        let added: delta<tuple<i64, dict<str, i64>>> = (null, delta<dict<str, i64>>(updated: ["a": 1, "b": 2]))
        let gone: delta<tuple<i64, dict<str, i64>>> = (null, delta<dict<str, i64>>(removed: ["a"]))
        if step == 0 {
            return delta<Drawer>(
                book: delta<dict<str, i64>>(updated: ["a": 1, "b": 2]),
                members: delta<set<i64>>(added: [1, 2]),
                pair: added,
            )
        }
        return delta<Drawer>(
            book: delta<dict<str, i64>>(removed: ["a"]),
            members: delta<set<i64>>(removed: [1]),
            pair: gone,
        )
    }
}

fn drawer_read(drawer: Drawer) -> list<i64, 3> {
    when valid([]) {
        if valid(drawer.book) && valid(drawer.members) && valid(drawer.pair[1]) {
            return [entry_total(drawer.book), member_total(drawer.members), entry_total(drawer.pair[1])]
        }
        return [-1, -1, -1]
    }
}

fn returned_drawer_read(step: i64) -> list<i64, 3> => drawer_read(returned_drawer(step))

fn returned_shelves(step: i64) -> dict<str, tuple<i64, dict<str, i64>>> {
    when {
        let added: delta<tuple<i64, dict<str, i64>>> = (null, delta<dict<str, i64>>(updated: ["a": 1, "b": 2]))
        let gone: delta<tuple<i64, dict<str, i64>>> = (null, delta<dict<str, i64>>(removed: ["a"]))
        if step == 0 { return delta<dict<str, tuple<i64, dict<str, i64>>>>(updated: ["x": added]) }
        return delta<dict<str, tuple<i64, dict<str, i64>>>>(updated: ["x": gone])
    }
}

fn shelves_read(shelves: dict<str, tuple<i64, dict<str, i64>>>) -> i64 {
    when valid([]) {
        if valid(shelves["x"][1]) { return entry_total(shelves["x"][1]) }
        return -1
    }
}

fn returned_shelves_read(step: i64) -> i64 => shelves_read(returned_shelves(step))

test a_held_key_or_member_removed_inside_a_tuple_goes {
    assert eval(returned_tuple_book_read(step: [0, 1])) == [23, 12]
    assert eval(assigned_tuple_book_read(step: [0, 1])) == [23, 12]
    assert eval(tuple_book_read(held: [
        (null, delta<dict<str, i64>>(updated: ["a": 1, "b": 2])),
        (null, delta<dict<str, i64>>(removed: ["a"])),
    ])) == [23, 12]
    assert eval(returned_tuple_members_read(step: [0, 1])) == [23, 12]
    assert eval(assigned_tuple_members_read(step: [0, 1])) == [23, 12]
    assert eval(tuple_members_read(held: [
        (null, delta<set<i64>>(added: [1, 2])),
        (null, delta<set<i64>>(removed: [1])),
    ])) == [23, 12]
    assert eval(returned_drawer_read(step: [0, 1])) == [[23, 23, 23], [12, 12, 12]]
    assert eval(returned_shelves_read(step: [0, 1])) == [23, 12]
}
