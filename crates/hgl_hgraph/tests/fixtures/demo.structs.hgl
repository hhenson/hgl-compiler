module demo.structs

export const fn origin() -> Point => Point(x: 0.0)

const fn moved(point: Point, by: f64) -> Point {
    var next = point
    next.x = next.x + by
    next.y += by
    return next
}

const fn stretched(line: Line, by: f64) -> Line {
    var next = line
    next.end.x += by
    next.class = 4
    return next
}

const fn held(base: Base<str>) -> str => base.held
const fn order() -> Order => Order(held: "a")
const fn boxed(value: i64) -> Box<i64> => Box(value: value)

impl const fn add_(lhs: Point, rhs: Point) -> Point => Point(x: lhs.x + rhs.x, y: lhs.y + rhs.y)

enum Side { buy, sell }

abstract struct Base<T> {
    id: i64 = 1
    held: T
    rate: f64 = 2
}

struct Order : Base<str> {
    id = 7
    side: Side = .buy
    note: str? = null
}

export struct Point {
    x: f64
    y: f64 = 0.0
}

struct Line {
    start: Point
    end: Point = Point(x: 1.0)
    class: i64 = 3
}

struct Box<T> {
    value: T
    count: i64 = 0
}

struct Empty {}

abstract struct Shape {}
struct Tagged<T> : Shape { tag: T }
struct Plain : Shape {}
const fn same(lhs: Shape, rhs: Shape) -> bool => lhs == rhs

fn travelled(step: f64) -> f64 {
    state at: Point = Point(x: 0.0)
    state seen: Box<i64> = boxed(0)
    when {
        at.x += step
        at.y = at.x * 2.0
        seen.count += 1
        return at.x + at.y
    }
}

test points {
    let point = Point(y: 2.0, x: 1.0)
    assert point.x == 1.0
    assert point.y == 2.0
    assert origin() == Point(x: 0.0, y: 0.0)
    assert moved(point, 1.5) == Point(x: 2.5, y: 3.5)
    assert point == Point(x: 1.0, y: 2.0)
    assert point != origin()
    assert point + Point(x: 3.0) == Point(x: 4.0, y: 2.0)
}

test lines {
    let line = Line(start: origin())
    assert line.end == Point(x: 1.0, y: 0.0)
    assert line.class == 3
    let longer = stretched(line, 2.0)
    assert longer.end.x == 3.0
    assert longer.class == 4
    assert line.end.x == 1.0
    assert longer.start == line.start
}

test orders {
    let made = order()
    assert made.id == 7
    assert made.held == "a"
    assert made.rate == 2.0
    assert made.side == Side.buy
    assert made.note == null
    assert held(made) == "a"
    assert Order(held: "b", note: "n", id: 9).id == 9
    assert Order(held: "b", note: "n").note != null
}

test generic {
    assert boxed(3) == Box(value: 3, count: 0)
    assert boxed(3).count == 0
    assert Empty() == Empty()
}

test identity {
    assert same(Tagged(tag: 1), Tagged(tag: 1))
    assert !same(Tagged(tag: 1), Tagged(tag: 1.0))
    assert !same(Tagged(tag: 1), Plain())
    let odd = Point(x: 0.0 / 0.0)
    assert odd != odd
    assert !(odd == odd)
    assert Tagged(tag: [odd.x]) != Tagged(tag: [odd.x])
}

test walks {
    assert eval(travelled(step: [1.0, _, 2.0])) == [3.0, _, 9.0]
}
