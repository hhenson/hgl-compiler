module demo.names

const fn lambda() -> i64 => 1
const fn lambda_() -> i64 => 2
const fn graph() -> i64 => 3
const fn _kept() -> i64 => 4
const fn test_me() -> i64 => 5
const fn float() -> i64 => 6
const fn sized(frozenset: i64, int: i64) -> set<i64> => [frozenset, int]

const fn doubled(value: i64) -> i64 => value * 2
fn doubled(value: i64) -> i64 {
    when { return doubled(value) + 1 }
}

const fn eight() -> i64 => doubled(4)

fn pass(target: i64) -> i64 {
    when { return target }
}

test names {
    assert lambda() + lambda_() + graph() + _kept() + test_me() + float() == 21
    assert eight() == 8
    assert sized(1, 2) == sized(2, 1)
    assert eval(doubled(value: [4])) == [9]
    assert eval(pass(target: [1])) == [1]
}
