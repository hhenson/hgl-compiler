module demo.timers_wave3

# TIME-3: "The empty selection `modified([])` makes every temporal input
# passive for its handler ... In that handler's body `modified([])`, as a
# bool, is true, at a wake that lands with an input's tick included: what
# the header selected is taken as nothing modified."
fn selected(value: i64) -> list<bool, 2> {
    inject scheduler
    start { schedule(scheduler, 1s) }
    when modified([]) && valid([]) { return [modified([]), modified(value)] }
}

# The same with an alarm, whose wake is told from the inputs.
fn selected_alarm(value: i64) -> bool {
    inject alarm
    start { schedule(alarm, 1s) }
    when modified([]) {
        if modified([]) { return true }
        return false
    }
}

# "Elsewhere, in another body or under a negation or a disjunction, it is
# true in a cycle where no temporal input was modified": in the body of a
# handler whose header is `scheduled()`, false at a wake where `value` has
# ticked.
fn elsewhere(value: i64) -> bool {
    inject scheduler
    start {
        schedule(scheduler, 1s, tag: "with input")
        schedule(scheduler, 2s, tag: "alone")
    }
    when scheduled() { return modified([]) }
}

# Under a negation, beside `scheduled()`: the wake that lands with a tick.
fn wake_with_input(value: i64) -> i64 {
    inject alarm
    start { schedule(alarm, 1s) }
    when scheduled() && !modified([]) { return value }
    when modified(value) { return -value }
}

fn wake_with_input_scheduled(value: i64) -> i64 {
    inject scheduler
    start {
        schedule(scheduler, 1s, tag: "with input")
        schedule(scheduler, 2s, tag: "alone")
    }
    when scheduled() && !modified([]) { return value }
}

# A node that no scheduler wakes is woken by an input that is invalidated,
# which publishes nothing (END-4). `modified([])` is true there: in a body,
# under a negation, and in a disjunction, where the handler keeps the
# default subscription.
fn produce(command: i64) -> i64 {
    inject out
    when {
        if command != 0 { return command }
        invalidate(out)
    }
}

fn watch(input: i64) -> list<bool, 2> {
    when valid([]) { return [modified([]), !modified([])] }
}

fn watch_either(input: i64) -> bool {
    when valid([]) && (modified([]) || modified(input)) { return valid(input) }
}

fn watch_not(input: i64) -> bool {
    when valid([]) && !modified([]) { return valid(input) }
}

fn observed(command: i64) -> list<bool, 2> => watch(produce(command))

fn observed_either(command: i64) -> bool => watch_either(produce(command))

fn observed_not(command: i64) -> bool => watch_not(produce(command))

# Two inputs: either one's publication is a temporal input modified.
fn either_published(a: i64, b: i64) -> bool {
    inject scheduler
    start {
        schedule(scheduler, 1s, tag: "a")
        schedule(scheduler, 2s, tag: "b")
        schedule(scheduler, 3s, tag: "none")
    }
    when scheduled() { return modified([]) }
}

# A node with no temporal input: no input is modified at any wake.
fn inputless() -> bool {
    inject scheduler
    start { schedule(scheduler, 1s) }
    when scheduled() { return modified([]) }
}

# A `ref` parameter is modified where it is given a designation, and not
# where its target publishes (TIME-10, core's END-10).
fn wake_on_ref(ref target: i64) -> bool {
    inject scheduler
    start { schedule(scheduler, 1s) }
    when scheduled() { return modified([]) }
}

fn ref_wake(value: i64) -> bool => wake_on_ref(value)

# A generic node, written for its instance.
fn generic_elsewhere<T>(value: T) -> bool {
    inject scheduler
    start { schedule(scheduler, 1s) }
    when scheduled() { return modified([]) }
}

fn generic_wake(value: f64) -> bool => generic_elsewhere(value)

test the_empty_selection_read_as_a_bool {
    # The wake at 1s lands with the tick of `value`.
    assert eval(selected(value: [0s: 7, 1s: 9]), RunConfig(length: 1500ms)) == [1s: [true, true]]
    assert eval(selected(value: [0s: 7]), RunConfig(length: 1500ms)) == [1s: [true, false]]
    assert eval(selected_alarm(value: [0s: 7]), RunConfig(length: 1500ms)) == [1s: true]
    assert eval(elsewhere(value: [1s: 9]), RunConfig(length: 2500ms)) == [1s: false, 2s: true]
    assert eval(wake_with_input(value: [0s: 7, 1s: 9]), RunConfig(length: 1500ms)) == [0s: -7, 1s: -9]
    assert eval(wake_with_input_scheduled(value: [0s: 7, 1s: 9]), RunConfig(length: 2500ms)) == [1s: 9]
    assert eval(observed(command: [7, 0, 7])) == [[false, true], [true, false], [false, true]]
    assert eval(observed_either(command: [7, 0, 7])) == [true, false, true]
    assert eval(observed_not(command: [7, 0, 7])) == [true, _, true]
    assert eval(either_published(a: [1s: 1], b: [2s: 2]), RunConfig(length: 3500ms)) == [1s: false, 2s: false, 3s: true]
    assert eval(inputless(), RunConfig(length: 1500ms)) == [1s: true]
    assert eval(ref_wake(value: [0s: 1, 1s: 2]), RunConfig(length: 1500ms)) == [1s: true]
    assert eval(generic_wake(value: [0s: 1.0, 1s: 2.0]), RunConfig(length: 1500ms)) == [1s: false]
}

# TIME-8: "A wake asked for with a `duration` takes one more than zero, but
# in `start`, which takes zero too ... A duration that is not admitted, a
# negative one in `start` included, ... elsewhere fails the call as the
# program runs." Core's CAP-5: the alarm alike.
fn wake_after(delay: duration) -> bool {
    inject scheduler
    when modified(delay) {
        schedule(scheduler, delay, tag: "next")
        return true
    }
}

fn alarm_after(delay: duration) -> bool {
    inject alarm
    when modified(delay) {
        schedule(alarm, delay)
        return true
    }
}

fn configured(value: i64, const every: duration) -> str {
    inject scheduler
    start { schedule(scheduler, every) }
    when scheduled() && valid([]) { return "scheduled" }
    when modified(value) { return "input" }
}

fn configured_alarm(value: i64, const every: duration) -> str {
    inject alarm
    start { schedule(alarm, every) }
    when scheduled() && valid([]) { return "alarm" }
    when modified(value) { return "input" }
}

fn asked_in_stop(value: i64, const every: duration) -> i64 {
    inject scheduler
    when { return value }
    stop { schedule(scheduler, every) }
}

# EXPR-2: the call's arguments are evaluated in order before it is made,
# and the duration is checked by the call: a later argument that fails
# fails first.
fn tag_first(delay: duration) -> bool {
    inject scheduler
    when modified(delay) {
        let names: dict<str, str> = ["a": "x"]
        schedule(scheduler, delay, tag: names["b"])
        return true
    }
}

# A constant expression of core's arithmetic on durations, which the
# target works out to be more than zero, is given as it is.
const STEP: duration = 500ms

fn stepped(value: i64) -> bool {
    inject alarm
    when modified(value) {
        schedule(alarm, STEP * 2 - 1s + 1us)
        return true
    }
}

# A generic value parameter, a nullable input proved present, and a sum,
# each known only as the program runs.
fn generic_after<const D: duration>(value: i64) -> bool {
    inject scheduler
    when modified(value) {
        schedule(scheduler, D)
        return true
    }
}

fn maybe_after(delay: duration?) -> bool {
    inject alarm
    when modified(delay) {
        if delay != null {
            schedule(alarm, delay + 1us)
            return true
        }
        return false
    }
}

test a_duration_not_more_than_zero_fails_as_the_program_runs {
    assert eval(wake_after(delay: [1s]), RunConfig(length: 1us)) == [true]
    assert raises("schedule.non_positive_duration") { eval(wake_after(delay: [1us, 0s])) }
    assert raises("schedule.non_positive_duration") { eval(wake_after(delay: [-1s])) }
    assert raises("schedule.non_positive_duration") { eval(alarm_after(delay: [0s])) }
    assert raises("schedule.non_positive_duration") { eval(alarm_after(delay: [-1us])) }
    # In `start` a zero asks for a wake at the start, and less fails.
    assert eval(configured(value: [_, 7], every: 0s)) == ["scheduled", "input"]
    assert eval(configured_alarm(value: [_, 7], every: 0s)) == ["alarm", "input"]
    assert raises("schedule.non_positive_duration") { eval(configured(value: [_, 7], every: -1us)) }
    assert raises("schedule.non_positive_duration") { eval(configured_alarm(value: [_, 7], every: -1us)) }
    # `stop` is no `start`.
    assert eval(asked_in_stop(value: [1], every: 1s)) == [1]
    assert raises("schedule.non_positive_duration") { eval(asked_in_stop(value: [1], every: 0s)) }
    assert eval(stepped(value: [1]), RunConfig(length: 1us)) == [true]
    assert raises("value.missing_key") { eval(tag_first(delay: [0s])) }
    assert eval(generic_after<1s>(value: [1]), RunConfig(length: 1us)) == [true]
    assert raises("schedule.non_positive_duration") { eval(generic_after<0s>(value: [1])) }
    assert eval(maybe_after(delay: [null, 0s]), RunConfig(length: 2us)) == [false, true]
    assert raises("schedule.non_positive_duration") { eval(maybe_after(delay: [-1us])) }
}

# CAP-4: `is_scheduled_now` "stays true for the rest of that evaluation
# after `un_schedule` or `reset` in it", and TIME-9's `scheduled()` with
# it: read as the property, as the selector in a body, and by a function
# given the scheduler; and in a later handler.
enum Cancel { earliest, due_tag, every }

const fn due(scheduler: Scheduler) -> bool => scheduler.is_scheduled_now

fn still_due(const cancel: Cancel) -> list<bool, 3> {
    inject scheduler
    start {
        schedule(scheduler, 1s, tag: "due")
        schedule(scheduler, 2s, tag: "later")
    }
    when scheduled() {
        if cancel == .earliest { un_schedule(scheduler) }
        if cancel == .due_tag { un_schedule(scheduler, tag: "due") }
        if cancel == .every { reset(scheduler) }
        return [scheduler.is_scheduled_now, scheduled(), due(scheduler)]
    }
}

fn due_in_a_later_handler() -> bool {
    inject scheduler
    start {
        schedule(scheduler, 1s, tag: "first")
        schedule(scheduler, 2s, tag: "second")
    }
    when scheduled() { reset(scheduler) }
    when scheduled() { return scheduler.is_scheduled_now }
}

test a_wake_stays_due_for_the_rest_of_its_evaluation {
    # The wake due at 1s was taken as the node was entered: `un_schedule`
    # cancels the one pending, at 2s.
    assert eval(still_due(cancel: .earliest)) == [1s: [true, true, true]]
    assert eval(still_due(cancel: .due_tag)) == [1s: [true, true, true], 2s: [true, true, true]]
    assert eval(still_due(cancel: .every)) == [1s: [true, true, true]]
    assert eval(due_in_a_later_handler()) == [1s: true]
}
