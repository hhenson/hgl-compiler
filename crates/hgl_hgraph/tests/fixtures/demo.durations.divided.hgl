module demo.durations.divided
const fn shared(length: duration, among: i64) -> duration => length / among
const fn scaled(length: duration, by: f64) -> duration => length / by
const fn ratio(first: duration, second: duration) -> f64 => first / second
const fn whole(first: duration, second: duration) -> i64 => first // second
const fn checked(length: duration, among: i64) -> result<duration, error> =>
    length /{zero: .error} among
const fn steps(first: duration, second: duration) -> result<i64, error> =>
    first //{zero: .error} second
test a_duration_is_divided {
    # Core's own examples (its OPS-10).
    assert shared(5m, 3) == 100s
    assert shared(1us, 3) == 0us
    assert shared(2us, 3) == 1us
    # A tie goes to the even count.
    assert scaled(3us, 2.0) == 2us
    assert scaled(1us, 2.0) == 0us
    assert ratio(90m, 1h) == 1.5
    # NUM-1: `//` rounds toward negative infinity.
    assert whole(7s, 2s) == 3
    assert whole(-7s, 2s) == -4
    # NUM-9: under `error` a zero divisor is an `err`, and any other
    # an `ok`.
    assert is_ok(checked(1s, 2)) && is_err(checked(1s, 0))
    assert is_ok(steps(1s, 1ms)) && is_err(steps(1s, 0s))
    # NUM-3: and under `fail`, which these take by default, an error.
    assert raises("numeric.division_by_zero") { shared(1s, 0) }
    assert raises("numeric.division_by_zero") { scaled(1s, 0.0) }
    assert raises("numeric.division_by_zero") { whole(1s, 0s) }
    # OPS-10: a result outside the range a duration has, and a
    # duration divided by an infinity.
    assert raises("numeric.out_of_range") { scaled(106751991d, 0.5) }
    assert raises("numeric.out_of_range") { scaled(1s, 1.0 / 0.0) }
}
