module demo.mixed

operator blend_<L, R, O>(lhs: L, rhs: R) -> O

impl const fn blend_(lhs: i64, rhs: i64) -> i64 => lhs * 10 + rhs
impl const fn blend_(lhs: f64, rhs: i64) -> f64 => lhs * 10 + rhs

fn mixed(count: i64, price: f64) -> f64 => count * price + 1
fn blended(left: i64, right: i64) -> i64 => blend_(left, right)

test mixes {
    assert 1.5 + 1 == 2.5
    assert 2.0 == 2
    assert 2.5 != 2
    assert blend_(1, 2) == 12
    assert blend_(1.5, 2) == 17.0
    assert eval(mixed(count: [2], price: [1.5])) == [4.0]
    assert eval(blended(left: [1, 2], right: [3])) == [13, 23]
}
