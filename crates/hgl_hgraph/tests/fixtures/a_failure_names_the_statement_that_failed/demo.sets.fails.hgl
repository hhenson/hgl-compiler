module demo.sets.fails
fn members(command: i64) -> set<i64> {
    when {
        if command == 1 { return delta<set<i64>>(added: [1]) }
        if command == 2 { return delta<set<i64>>(removed: [1]) }
    }
}
test removed_is_not_added {
    assert eval(members(command: [1, 2])) == [delta<set<i64>>(added: [1]), delta<set<i64>>(added: [1])]
}
test one_more {
    assert eval(members(command: [1])) == [delta<set<i64>>(added: [1]), delta<set<i64>>(removed: [1])]
}
# The division is written first, and fails first: the addition
# after it would overflow.
const fn swapped(divisor: i64, value: i64) -> delta<set<i64>> =>
    delta<set<i64>>(removed: [1 // divisor], added: [value + 1])
test removed_first { let change = swapped(0, 9223372036854775807) }
