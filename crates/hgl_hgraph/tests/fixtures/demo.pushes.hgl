module demo.pushes

operator push<C, V>(values: C, item: V)

impl const fn push(var values: list<i64>, item: i64) {
    append(values, item)
}

impl const fn push(var values: dict<str, i64>, item: str) {
    values[item] = 1
}

struct Book {
    orders: list<i64>
}

test pushes {
    var entries: list<i64> = [1]
    let before = entries
    push(entries, 2)
    assert before == [1]
    assert entries == [1, 2]
    var seen: dict<str, i64> = []
    push(seen, "a")
    assert seen == ["a": 1]
    var book: Book = Book(orders: [1])
    push(book.orders, 2)
    assert book == Book(orders: [1, 2])
}
