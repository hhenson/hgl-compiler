module demo.bundles

struct Quote {
    bid: i64
    ask: i64
}

struct Order {
    quote: Quote
    size: i64
}

# TYPE-9: a struct publishes to its fields, and a whole value sets each.
fn quoted(bid: i64, ask: i64) -> Quote {
    when { return Quote(bid: bid, ask: ask) }
}

# TYPE-16: a struct's delta, built from its properties.
fn moved(is_bid: bool, price: i64) -> Quote {
    when {
        if is_bid { return delta<Quote>(bid: price) }
        return delta<Quote>(ask: price)
    }
}

# Each field set by its own handler, both in one cycle where both tick.
fn touched(bid: i64, ask: i64) -> Quote {
    inject out
    when modified(bid) { out = delta<Quote>(bid: bid) }
    when modified(ask) { out = delta<Quote>(ask: ask) }
}

# A temporal struct input read whole, and by a field, in a hook.
fn spread(quote: Quote) -> i64 {
    when { return quote.ask - quote.bid }
}

fn whole_spread(quote: Quote) -> i64 {
    when {
        let held = quote
        return held.ask - held.bid
    }
}

# A struct's delta read by its properties: null where a field is silent.
fn bid_changes(quote: Quote) -> i64 {
    when {
        let bid = delta_value(quote).bid
        if bid == null { return -1 }
        return bid
    }
}

# A struct with a struct field: the field's own fields are ports too.
fn ordered(bid: i64, size: i64) -> Order {
    when { return delta<Order>(quote: delta<Quote>(bid: bid), size: size) }
}

fn order_bid(order: Order) -> i64 {
    when { return order.quote.bid }
}

# TYPE-9: `atomic<V>` publishes the whole V.
fn snapshot(bid: i64, ask: i64) -> atomic<Quote> {
    when { return Quote(bid: bid, ask: ask) }
}

fn snapshot_ask(quote: atomic<Quote>) -> i64 {
    when { return quote.ask }
}

fn spread_of(bid: i64, ask: i64) -> i64 => spread(quoted(bid, ask))
fn whole_spread_of(bid: i64, ask: i64) -> i64 => whole_spread(quoted(bid, ask))
fn ask_of(is_bid: bool, price: i64) -> i64 => moved(is_bid, price).ask
fn bids_of(bid: i64, ask: i64) -> i64 => bid_changes(touched(bid, ask))
fn order_bid_of(bid: i64, size: i64) -> i64 => order_bid(ordered(bid, size))
fn nested_bid_of(bid: i64, size: i64) -> i64 => ordered(bid, size).quote.bid
fn atomic_ask_of(bid: i64, ask: i64) -> i64 => snapshot(bid, ask).ask
fn atomic_read_of(bid: i64, ask: i64) -> i64 => snapshot_ask(snapshot(bid, ask))

test struct_fields_tick_as_their_own {
    assert eval(spread_of(bid: [1, 2, _], ask: [5, _, 9])) == [4, 3, 7]
    assert eval(whole_spread_of(bid: [1, 2], ask: [5, _])) == [4, 3]
    assert eval(ask_of(is_bid: [false, true, false], price: [7, 3, 8])) == [7, _, 8]
    assert eval(bids_of(bid: [1, _, 3], ask: [5, 6, _])) == [1, -1, 3]
    assert eval(order_bid_of(bid: [4, 5], size: [1, _])) == [4, 5]
    assert eval(nested_bid_of(bid: [4, _, 6], size: [1, 2, _])) == [4, 4, 6]
    assert eval(moved(is_bid: [true, false], price: [3, 4])) ==
        [delta<Quote>(bid: 3), delta<Quote>(ask: 4)]
}

test an_atomic_struct_publishes_whole {
    assert eval(atomic_ask_of(bid: [1, 2, _], ask: [5, _, 6])) == [5, 5, 6]
    assert eval(atomic_read_of(bid: [1, 2], ask: [5, _])) == [5, 5]
}
