module demo.sides.right
enum Side { up = 5, down }
fn kept(side: Side) -> Side {
    when { return side }
}
fn outcome(value: CmpResult) -> CmpResult {
    when { return value }
}
test right_sides {
    assert eval kept(side: [.up, .down]) == [.up, .down]
    assert eval outcome(value: [.less, .greater, .unordered]) == [.less, .greater, .unordered]
}
