module demo.inside

struct Book {
    bids: dict<i64, i64>
    orders: list<i64>
    name: str
}

const fn total(values: list<i64>) -> i64 {
    var sum: i64 = 0
    for value in values { sum += value }
    return sum
}

# A function whose result cannot be the struct: it is lent it, and
# marks the list it gives of it.
const fn orders_of(book: Book) -> list<i64> => book.orders

# A struct's dictionary and its list, each changed a step at a time.
const fn built(count: i64) -> Book {
    var book: Book = Book(bids: [], orders: [], name: "a")
    var i: i64 = 0
    while i < count {
        book.bids[i] = i * 2
        append(book.orders, i)
        i += 1
    }
    return book
}

# Lists in a dictionary, under a key that is an expression.
const fn grouped(count: i64) -> dict<i64, list<i64>> {
    var groups: dict<i64, list<i64>> = [0: [], 1: []]
    var i: i64 = 0
    while i < count {
        append(groups[i % 2], i)
        i += 1
    }
    return groups
}

# A loop's name holds an entry that the list holds too.
const fn copied(rows: list<list<i64>>) -> list<list<i64>> {
    var out: list<list<i64>> = []
    for row in rows { append(out, row) }
    return out
}

const fn rows_kept() -> bool {
    var rows: list<list<i64>> = [[1], [2]]
    let copy = copied(rows)
    append(rows[0], 9)
    rows[1][0] = 7
    return copy == [[1], [2]] && rows == [[1, 9], [7]]
}

# EXPR-7: the way in is read before the value is evaluated: a key
# the dictionary has not fails first.
const fn missing(zero: i64) -> i64 {
    var groups: dict<str, list<i64>> = ["a": [1]]
    groups["nope"][0] = 1 //{zero: .fail} zero
    return 1
}

# What is put in holds a collection on the way in: the value the
# place had, and not the one it is given. Evaluating the argument
# marks `rows`, after the way in has been read and before anything
# is changed.
const fn grafted() -> bool {
    var rows: list<list<any>> = [[1]]
    append(rows[0], 2)
    append(rows[0], rows)
    return rows == [[1, 2, [[1, 2]]]]
}

const fn planted() -> bool {
    var rows: list<list<any>> = [[1]]
    append(rows[0], 2)
    rows[0][0] = rows
    return rows == [[[[1, 2]], 2]]
}

# A node's `state` that is a struct of collections.
fn gathered(value: i64) -> i64 {
    state book: Book = Book(bids: [], orders: [], name: "s")
    when {
        append(book.orders, value)
        book.bids[value] = value * 2
        return total(book.orders) + book.bids[value]
    }
}

test inside {
    # A `let` is the struct as it was, however what is inside the
    # place changes.
    var book: Book = Book(bids: [1: 10], orders: [1], name: "a")
    let before = book
    append(book.orders, 2)
    book.bids[2] = 20
    assert before == Book(bids: [1: 10], orders: [1], name: "a")
    assert book == Book(bids: [1: 10, 2: 20], orders: [1, 2], name: "a")
    # A collection taken out of a value is as it was.
    let orders = book.orders
    append(book.orders, 3)
    assert orders == [1, 2]
    assert total(book.orders) == 6
    let taken = orders_of(book)
    append(book.orders, 4)
    assert taken == [1, 2, 3]
    # A field that is no collection: the struct, of three fields, is
    # changed where it is, and its collections are still its own.
    book.name = "b"
    append(book.orders, 5)
    assert book.orders == [1, 2, 3, 4, 5]
    assert before.orders == [1]
    var groups: dict<str, list<i64>> = ["a": [1]]
    let group = groups["a"]
    append(groups["a"], 2)
    groups["a"][0] = 9
    groups["b"] = group
    append(groups["b"], 5)
    assert group == [1]
    assert groups == ["a": [9, 2], "b": [1, 5]]
    assert rows_kept()
    assert grafted()
    assert planted()
    assert raises("value.missing_key") { missing(0) }
    assert built(3) == Book(bids: [0: 0, 1: 2, 2: 4], orders: [0, 1, 2], name: "a")
    assert grouped(5) == [0: [0, 2, 4], 1: [1, 3]]
    assert eval(gathered(value: [1, _, 2])) == [3, _, 7]
}
