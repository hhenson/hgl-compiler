module m
const fn entry_at(entries: list<i64>, position: i64) -> i64 => entries[position]
const fn repeated(text: str, count: i64) -> str => text * count
test indexed {
    assert raises("value.index_out_of_range") { entry_at([1, 2], 2) }
}
test repeated_below_zero {
    assert raises("numeric.out_of_range") { repeated("ab", -1) }
    assert raises("numeric.out_of_range") { "ab" * -1 }
}
test other_codes {
    assert raises("numeric.out_of_range") { entry_at([1], 0) * 9223372036854775807 * 2 }
}
