module demo.sources

fn two_values() -> i64 {
    yield 1us: 7
    yield 1us: 9
}

fn greeting(const every: duration = 1us) -> str {
    inject logger
    start { log_info(logger, "greeting starts") }
    {
        yield every: "hello"
        yield every: "world"
    }
    stop { log_info(logger, "greeting ends") }
}

fn counter(const every: duration = 1us, const limit: i64 = 3) -> i64 {
    inject logger
    cache count: i64 = 0
    while count < limit {
        count += 1
        yield every: count
    }
    stop { if count > 0 { log_info(logger, "counted") } }
}

# SOURCE-3: "a current target publishes now".
fn at_once(const first: i64) -> i64 {
    yield 0us: first
    yield 2us: first + 1
}

# SOURCE-2: "A duration is relative to current evaluation time; a
# datetime is absolute." The clock is read where the source is
# resumed.
fn absolute() -> i64 {
    inject clock
    {
        yield clock.evaluation_time + 3us: 1
        yield earliest_start + 5us: 2
        yield clock.evaluation_time + 1us: 3
    }
}

# SOURCE-3: "A past absolute target is skipped".
fn late() -> i64 {
    yield earliest_start + 1us: 1
    yield earliest_start + 4us: 2
}

# SOURCE-4: "A bare return ... finishes the source", and an
# unbounded `while`.
fn ended(const limit: i64) -> i64 {
    cache count: i64 = 0
    while {
        if count == limit { return }
        count += 1
        yield 1us: count
    }
}

# A block that ends with an expression: a call after its yields,
# and an `if` that holds them.
fn trailed(const first: i64) -> i64 {
    inject logger
    {
        yield 1us: first
        log_info(logger, "done")
    }
}

fn guarded(const wanted: bool) -> i64 {
    {
        if wanted { yield 1us: 1 }
    }
}

# A `start` that returns early still leaves a source to resume.
fn started(const quiet: bool) -> i64 {
    inject logger
    start {
        if quiet { return }
        log_info(logger, "started")
    }
    {
        yield 1us: 4
    }
}

fn doubled(value: i64) -> i64 {
    when { return value * 2 }
}

fn wired() -> i64 => doubled(two_values())

fn backwards() -> i64 {
    yield 2us: 1
    yield earliest_start + 1us: 2
}

fn negative() -> i64 {
    yield -1us: 1
}

test sources {
    assert eval(two_values()) == [_, 7, 9]
    assert eval(greeting()) == [_, "hello", "world"]
    assert eval(greeting(every: 2us)) == [_, _, "hello", _, "world"]
    assert eval(counter()) == [_, 1, 2, 3]
    assert eval(counter(limit: 0)) == []
    assert eval(at_once(first: 5)) == [5, _, 6]
    assert eval(absolute()) == [_, _, _, 1, _, 2, 3]
    assert eval(late(), RunConfig(start: earliest_start + 2us)) == [_, _, 2]
    assert eval(ended(limit: 2)) == [_, 1, 2]
    assert eval(wired()) == [_, 14, 18]
    assert eval(trailed(first: 6)) == [_, 6]
    assert eval(guarded(wanted: true)) == [_, 1]
    assert eval(guarded(wanted: false)) == []
    assert eval(started(quiet: true)) == [_, 4]
    assert eval(started(quiet: false)) == [_, 4]
    # CRUN-2: a run ends before its `end`, with the source suspended.
    assert eval(counter(limit: 9), RunConfig(length: 3us)) == [_, 1, 2]
    assert raises("yield.non_increasing_time") { eval(backwards()) }
    assert raises("yield.negative_duration") { eval(negative()) }
}
