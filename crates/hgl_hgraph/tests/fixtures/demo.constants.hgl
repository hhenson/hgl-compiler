module demo.constants
export enum Side { buy, sell }
export const scale: i64 = 2
# A constant written after the one that reads it.
const first: i64 = 3 * late + 1
const late: i64 = scale
export const side: Side = .sell
const fn seed() -> i64 => first
export const fn choose(base: i64, value: i64 = seed()) -> i64 => base + value
test constants_are_read {
    assert first == 7
    assert choose(1) == 8
    assert side == Side.sell
}
