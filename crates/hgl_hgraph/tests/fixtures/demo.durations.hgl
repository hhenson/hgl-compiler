module demo.durations
const pause: duration = 1h30m
const fn total(first: duration, second: duration) -> duration => first + second
const fn less(first: duration, second: duration) -> duration => first - second
const fn times(length: duration, count: i64) -> duration => length * count
const fn scaled(length: duration, by: f64) -> duration => length * by
fn sum(lhs: duration, rhs: duration) -> duration => lhs + rhs
test durations_are_values_and_ticks {
    assert total(1s, 250ms) == 1250ms
    assert less(1s, 250ms) == 750ms
    assert -less(250ms, 1s) == 750ms
    assert times(pause, 2) == 3h
    # Core writes a count times a duration as the duration times it.
    assert 2 * pause == 3h
    # OPS-10: half a microsecond is a tie, and goes to the even one.
    assert scaled(1us, 0.5) == 0us
    assert scaled(3us, 0.5) == 2us
    # OPS-10: a duration times an infinity is out of range.
    assert raises("numeric.out_of_range") { scaled(1s, 1.0 / 0.0) }
    assert eval sum(lhs: [1s, _, 5m], rhs: [2s, 3s]) == [3s, 4s, 5m3s]
}
