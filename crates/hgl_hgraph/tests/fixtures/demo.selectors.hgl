module demo.selectors

fn both_valid(a: i64, b: i64, c: i64) -> i64 {
    when valid(a) && valid(b) { return a + b }
}

fn repeated(a: i64, b: i64) -> i64 {
    when modified(a, a) { return a }
    when modified(b) { return b }
}

fn recovering(command: i64) -> i64 {
    inject out
    when valid(out) && valid(command) && command > 0 { return command }
    when { return 1 }
}

test selectors {
    assert eval both_valid(a: [1, _], b: [_, 2], c: []) == [_, 3]
    assert eval repeated(a: [1, _, 3], b: [_, 2, _]) == [_, 2, 3]
    assert eval recovering(command: [0, 5]) == [1, 5]
}
