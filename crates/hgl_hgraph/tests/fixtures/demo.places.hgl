module demo.places

struct Book {
    orders: list<i64>
    name: str
}

const fn bump(var count: i64, by: i64) {
    count += by
}
const fn set_first(var items: list<i64>, value: i64) {
    items[0] = value
}
# A `var` parameter is given on to another.
const fn through(var count: i64) { bump(count, 1) }
# A result beside the place.
const fn take(var count: i64) -> i64 {
    let before = count
    count = 0
    return before
}
const fn both(var left: i64, var right: i64) {
    let held = left
    left = right
    right = held
}
# Every way out gives the place what the parameter holds there.
const fn early(var count: i64, halt: bool) -> i64 {
    if halt { return -1 }
    count += 1
    return count
}

const fn total(values: list<i64>) -> i64 {
    var sum: i64 = 0
    for value in values {
        bump(sum, value)
    }
    return sum
}
# "a value taken from the place before the call is as it was".
const fn kept() -> bool {
    var entries: list<i64> = [1, 2]
    let before = entries
    set_first(entries, 9)
    return before == [1, 2] && entries == [9, 2]
}
const fn nested() -> i64 {
    var book: Book = Book(orders: [1, 2], name: "a")
    set_first(book.orders, 5)
    bump(book.orders[1], 3)
    return book.orders[0] + book.orders[1]
}
const fn taken() -> i64 {
    var held: i64 = 7
    let was = take(held)
    return was * 10 + held
}
const fn swapped() -> i64 {
    var a: i64 = 1
    var b: i64 = 2
    both(a, b)
    return a * 10 + b
}
const fn stepped() -> i64 {
    var n: i64 = 0
    through(n)
    let first = early(n, true)
    let second = early(n, false)
    return first * 100 + second * 10 + n
}
fn counted(value: i64) -> i64 {
    state seen: i64 = 0
    cache held: i64 = 0
    when {
        bump(seen, 1)
        bump(held, value)
        return seen * 100 + held
    }
}
# The place is the one named when the call's arguments are
# evaluated: `items[i]` is `items[0]`, though the call moves `i`.
const fn change(var index: i64, var item: i64) {
    index = 1
    item = 9
}
# EXPR-2: the first argument fails first, though the second's
# index is held before the call.
const fn apply(value: i64, var item: i64) { item = value }
const fn ordered(zero: i64, indices: dict<str, i64>) -> i64 {
    var items: list<i64> = [5, 6]
    apply(1 //{zero: .fail} zero, items[indices["missing"]])
    return items[0]
}
# What an index is of is read before the index is evaluated: a
# missing `key` fails before the division does.
const fn deep(key: str, zero: i64) -> i64 {
    var rows: dict<str, list<i64>> = ["a": [5, 6]]
    bump(rows[key][1 //{zero: .fail} zero], 1)
    return rows["a"][1]
}
# Two places inside one root: each assignment reads the root as
# the one before it left it.
const fn crossed(key: str, i: i64, j: i64) -> i64 {
    var rows: dict<str, list<i64>> = ["a": [5, 6]]
    both(rows[key][i], rows[key][j])
    return rows["a"][0] * 10 + rows["a"][1]
}
const fn moved() -> i64 {
    var i: i64 = 0
    var items: list<i64> = [5, 6]
    change(i, items[i])
    return items[0] * 100 + items[1] * 10 + i
}

test places {
    assert total([1, 2, 3]) == 6
    assert kept()
    assert nested() == 10
    assert taken() == 70
    assert swapped() == 21
    assert stepped() == -100 + 20 + 2
    var count: i64 = 1
    bump(count, 4)
    assert count == 5
    assert moved() == 961
    assert raises("numeric.division_by_zero") { ordered(0, ["a": 1]) }
    assert raises("value.missing_key") { ordered(1, ["a": 1]) }
    assert ordered(1, ["missing": 1]) == 5
    assert raises("value.missing_key") { deep("b", 0) }
    assert raises("numeric.division_by_zero") { deep("a", 0) }
    assert deep("a", 1) == 7
    assert crossed("a", 0, 1) == 65
    assert eval(counted(value: [1, _, 2])) == [101, _, 203]
}
