module sizes
fn resize(size: i64) -> list<i64> {
    when {
        if size == 3 { return [10, 20, 30] }
        return delta<list<i64>>(size_modified: size)
    }
}
const fn total(values: list<i64>) -> i64 {
    var sum: i64 = 0
    for value in values { sum += value }
    return sum
}
fn total_after(size: i64) -> i64 => total(resize(size))
test shrinks {
    assert eval total_after(size: [3, 1]) == [60, 10]
}
test negative {
    assert eval total_after(size: [3, -1, -5]) == [60, 30, 0]
}
