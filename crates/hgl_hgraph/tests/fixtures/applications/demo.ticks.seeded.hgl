application demo.ticks.seeded
use demo.ticks::{limited}
const base: i64 = 2
# A value function written for each call of it (GEN-2).
const fn sum<T>(a: T, b: T) -> T requires add_(T, T) -> T => a + b
# UNIT-14: what sets the run's store, before the run. The
# store is `put`'s first parameter, wherever it is written.
inject global_state
put(key: "limit", store: global_state, value: sum(base, 1))
eval(limited())
